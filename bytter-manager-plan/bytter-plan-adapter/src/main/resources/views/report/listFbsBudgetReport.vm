<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
    <input type="hidden" name="eqs_timeType" id="eqs_timeType" value="${timeType}"/>
    <input type="hidden" name="eqs_corpId" id="eqs_corpId" value="${corpId}"/>
    <input type="hidden" name="ged_beginDate" id="ged_beginDate"
           value="$!date.format('yyyy-MM-dd', ${seachBeginDate})"/>
    <input type="hidden" name="led_endDate" id="led_endDate" value="$!date.format('yyyy-MM-dd',${seachEndDate})"/>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fbsBudgetReport.corpId')</th>
        <th>#springMessage('table.fbsBudgetReport.beginDate')</th>
        <th>#springMessage('table.fbsBudgetReport.endDate')</th>
        <th>#springMessage('table.fbsBudgetReport.status')</th>
        <th>#springMessage('table.fbsBudgetReport.timeType')</th>
        <th>#springMessage('table.fbsBudgetDetail.curId')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudget.report.list.js?_btv=${resourceVersion}"></script>
</html>

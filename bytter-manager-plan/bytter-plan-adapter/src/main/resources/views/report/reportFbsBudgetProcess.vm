<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body class="full-body">

<form class="layui-form " id="inputForm">
    <input type="hidden" name="eqs_timeType" id="eqs_timeType" value="${timeType}"/>
    <input type="hidden" name="eqs_corpId" id="eqs_corpId" value="${corpId}"/>
    <input type="hidden" name="ged_beginDate" id="ged_beginDate"
           value="$!date.format('yyyy-MM-dd', ${beginDate})"/>
    <input type="hidden" name="led_endDate" id="led_endDate" value="$!date.format('yyyy-MM-dd',$!{endDate})"/>
    <input type="hidden" id="curId" value="$!{fbsBudget.curId}"/>
    <table  class="layui-table" style="width:100%;">
        <tr>
            <td align="center">
                #springMessage('fbs.item.level.show')
                <div class="bt-biz-dict" data-type="select" data-group="fbs.item.level"
                     data-defaultvalue="$!{level}" data-name="level" data-biz-name="level"
                     data-callback="chooseLevel"></div>
            </td>
        </tr>
    </table>
    <div id="print">
        <div style="align-content: center">
            <table  class="layui-table" style="width:100%;">
                <tr>
                    <td align="center" >
                        <h5>
                        $!{corpName}#springMessage('table.fbsBudgetReport.corpId')
                        #springMessage('table.fbsBudgetProcessReport.title')
                        $!date.format('yyyy-MM-dd', $!{beginDate})~$!date.format('yyyy-MM-dd',$!{endDate})
                        $!{currencyTag.getCurName($!{fbsBudget.curId})}
                        </h5>
                    </td>
                </tr>
            </table>
        </div>
        <div style="display:inline-block;width:100%;">
            <div id="maingrid1" data-biz-name="chooseLevel"></div>
        </div>
        <div style="width: 100%;overflow-x: scroll;margin-bottom: 10px;display: none">
            <table id="appTable" class="layui-table layui-form treeTable" style="width:100%;">
            <thead>
            <tr>
                <th rowspan="2">#springMessage('table.fbsBudgetYear.number')</th>
                <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.itemCode')</th>
                <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.itemName')</th>
                <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.bMoney')</th>
                <th colspan="2">#springMessage('table.fbsBudgetProcessReport.bsuperMoney')</th>
                <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.bMoneySum')</th>
                <th colspan="2">#springMessage('table.fbsBudgetProcessReport.inProcessMoney')</th>
                <th colspan="2">#springMessage('table.fbsBudgetProcessReport.outProcessMoney')</th>
                <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.canBMoney')</th>
                <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.canBMoneyRatio')</th>
                <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.ExerciseRatio')</th>
                <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.errorRate')</th>
            </tr>
            <tr>
                <th>#springMessage('table.fbsBudgetProcessReport.bsuperMoney.success')</th>
                <th>#springMessage('table.fbsBudgetProcessReport.bsuperMoney.temp')</th>
                <th>#springMessage('table.fbsBudgetProcessReport.inProcessMoney.success')</th>
                <th>#springMessage('table.fbsBudgetProcessReport.inProcessMoney.temp')</th>
                <th>#springMessage('table.fbsBudgetProcessReport.outProcessMoney.success')</th>
                <th>#springMessage('table.fbsBudgetProcessReport.outProcessMoney.temp')</th>
            </tr>
            </thead>
            <tbody>
                #foreach($report in $reportList)
                <tr data-tt-id="$!{report.itemCode}" data-tt-parent-id="$!{report.item.superItemCode}"
                    data-tt-subject-sort="$!{report.itemCode}">
                    <td>$!{velocityCount}</td>
                    <td data-name="itemCode">$!{report.itemCode}</td>
                    <td data-name="itemName">$!{report.itemName}</td>
                    <td class="textRight" align="right"  data-name="bMoney">$!number.formatNumeric($!{report.bMoney})</td>
                    <td class="textRight" align="right"  data-name="bsuperMoney">
                        <a class="" href="#" data-row="$!{velocityCount}"
                           onclick="openSuperadd($report.itemCode,95)"> $!number.formatNumeric($!{report.bsuperMoney}) </a>
                    </td>
                    <td class="textRight" align="right"  data-name="btempMoney">
                        <a class="" href="#" data-row="$!{velocityCount}"
                           onclick="openSuperadd($report.itemCode,0)"> $!number.formatNumeric($!{report.btempMoney}) </a>
                    </td>
                    <td class="textRight" align="right"  data-name="bMoneySum">$!number.formatNumeric($!{report.bMoneySum})</td>
                    <td class="textRight" align="right"  data-name="inProcessMoney">
                        <a class="" href="#" data-row="$!{velocityCount}"
                           onclick="openProcess($report.itemCode,95, 1)"> $!number.formatNumeric($!{report.inProcessMoney}) </a>
                    </td>
                    <td class="textRight" align="right"  data-name="inTempProcessMoney">
                        <a class="" href="#" data-row="$!{velocityCount}"
                           onclick="openProcess($report.itemCode,0, 1)"> $!number.formatNumeric($!{report.inTempProcessMoney}) </a>
                    </td>
                    <td class="textRight" align="right"  data-name="outProcessMoney">
                        <a class="" href="#" data-row="$!{velocityCount}"
                           onclick="openProcess($report.itemCode, 95, 0)"> $!number.formatNumeric($!{report.outProcessMoney}) </a>
                    </td>
                    <td class="textRight" align="right"  data-name="outTempProcessMoney">
                        <a class="" href="#" data-row="$!{velocityCount}"
                           onclick="openProcess($report.itemCode, 0, 0)"> $!number.formatNumeric($!{report.outTempProcessMoney}) </a>
                    </td>
                    #if($!{report.item.sign} == 1)
                        <td class="textRight" align="right"  data-name="canBMoney">--</td>
                        <td class="textRight" align="right"  data-name="canBMoneyRatio">--</td>
                        <td class="textRight" align="right"  data-name="exerciseRatio">$!number.formatNumeric($!{report.exerciseRatio})%</td>
                        <td class="textRight" align="right"  data-name="errorRate">$!number.formatNumeric($!{report.errorRate})%</td>
                    #else
                        <td class="textRight" align="right"  data-name="canBMoney">$!number.formatNumeric($!{report.canBMoney})</td>
                        <td class="textRight" align="right"  data-name="canBMoneyRatio">$!number.formatNumeric($!{report.canBMoneyRatio})%</td>
                        <td class="textRight" align="right"  data-name="exerciseRatio">$!number.formatNumeric($!{report.exerciseRatio})%</td>
                        <td class="textRight" align="right"  data-name="errorRate">$!number.formatNumeric($!{report.errorRate})%</td>
                    #end
                </tr>
                #end
                #if(!$reportList || $reportList.size() == 0)
                <tr>
                    <td colspan="15" class="center" data-name="null">
                        <span style="color: red">#springMessage('fbs.budgetReport.message.query.null')</span>
                    </td>
                </tr>
                #end
            </tbody>
        </table>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" onclick="viewDtlProcess('$!{fbsBudget.id}')">#springMessage(
                'fbs.button.viewdtlprocess')</button>
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage(
                'common.button.print')</button>
            <button class="layui-btn" type="button" lay-submit onclick="exports()">#springMessage(
                'common.button.exports')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudgetProcess.report.js?_btv=${resourceVersion}"></script>
</html>

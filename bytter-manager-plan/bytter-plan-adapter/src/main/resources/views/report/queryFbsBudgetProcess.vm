<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <td class="textRight" width="20%">#springMessage('table.fbsBudgetReport.timeType')</td>
            <td >
                <div data-name="timeType" data-biz-name="timeType" class="bt-biz-selectType" data-required="true"
                     data-url="${basePath}/budget/budgetreportutil/getTimeType" data-valueField="value"
                     data-textField="name" data-defaultvalue="5" data-selecttext="false" data-extraData="false"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight" width="20%">#springMessage('table.fbsBudgetReport.seachDate')</td>
            <td >
                <div class="layui-input-inline" >
                    <input type="text" name="beginDate" data-biz-name="beginDate" data-required="true"
                           class="layui-input bt-input-inline bt-biz-dateType" data-today="true" data-endid="endDate">
                    <span class="date-mid">~</span>
                    <input type="text" name="endDate" data-biz-name="endDate" data-required="true"
                           class="layui-input bt-input-inline bt-biz-dateType" data-today="true" id="endDate">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight" width="20%">#springMessage('table.fbsBudgetReport.corp')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-name="corpId" data-biz-name="corpId" data-biz-type="corp" data-required="true"
                         data-type="selectTree" data-resource="fbs:report:fbsBudgetProcess:query" data-tree-type="check"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight" width="20%">#springMessage('table.fbsBudgetReport.viewType')</td>
            <td >
                <div class="bt-biz-dict" data-type="radio" data-group="fbsBudgetProcess.viewType"
                     data-name="eqs_viewType" data-biz-name="viewType"  data-defaultvalue="0" data-callback="viewTypeCallback"></div>
            </td>
        </tr>
        <tr id="itemCodeTr" style="display: none;">
            <td class="textRight" width="20%">#springMessage('table.fbsBudgetYear.itemCode')</td>
            <td >
                <div class="layui-input-inline itemCode" id="itemCode" data-required="true"></div>
                <input type="hidden" id="itemCodeHid" data-required="true"/>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn"  lay-submit lay-filter="submit" type="button" id="manyButton" style="display:none;">#springMessage('common.button.search')</button>
                <button class="layui-btn" lay-submit lay-filter="search" type="button" id="singleButton">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.fbsBudgetReport.period')</th>
            <th>#springMessage('table.fbsBudgetReport.corpId')</th>
            <th>#springMessage('table.fbsBudgetReport.beginDate')</th>
            <th>#springMessage('table.fbsBudgetReport.endDate')</th>
            <th>#springMessage('table.fbsBudgetReport.timeType')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/budget/fbsBudgetProcessQuery.report.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <td class="textRight" width="40%">#springMessage('table.fbsBudgetReport.timeType')</td>
            <td>
                <div data-name="eqs_timeType" data-biz-name="timeType" class="bt-biz-selectType"
                     data-url="${basePath}/budget/budgetreportutil/getTimeType" data-valueField="value"
                     data-textField="name" data-defaultvalue="5" data-selecttext="false" data-extraData="false"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fbsBudgetReport.seachDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="ged_beginDate" data-biz-name="beginDate"
                           class="layui-input bt-input-inline bt-biz-dateType" data-today="true" data-endid="endDate">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_endDate" data-biz-name="endDate"
                           class="layui-input bt-input-inline bt-biz-dateType" data-today="true" id="endDate">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fbsBudgetReport.corp')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-name="ins_corpId" data-biz-name="corpId" data-biz-type="corp" data-required = "true" data-tree-type="check"
                         data-type="selectTree" data-resource="fbs:report:superAddFbsBudget:query"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisPersonnelDetail.corpId')</th>
        <th>#springMessage('table.fbsBudget.beginDate')</th>
        <th>#springMessage('table.fbsBudget.endDate')</th>
        <th>#springMessage('table.fbsBudget.status')</th>
        <th>#springMessage('table.fbsBudgetReport.timeType')</th>
        <th>#springMessage('table.fbsBudgetDetail.curId')</th>
        <th>#springMessage('table.fbsBudget.superAdd.count')</th>
        <th>#springMessage('table.createRepayPlan.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/budget/superAddFbsBudgetQuery.report.js?_btv=${resourceVersion}"></script>
</body>
</html>

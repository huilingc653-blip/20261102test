<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding-bottom:20px;">
<input type="hidden" id="corpIds" />
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReport.netName')</td>
            <td colspan="3">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-name="netId" data-biz-type="net" data-type="selectTree"
                         data-scope="net" data-biz-name="netId" data-defaultvalue="$!{netId}"
                         data-tree-type="radio" data-required = "true"
                         data-checkkboxtype='{"Y":"s","N":"s"}'></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fbsBudgetReport.timeType')</td>
            <td width="40%">
                <div data-name="timeType" data-biz-name="timeType" class="bt-biz-selectType"
                     data-url="${basePath}/budget/budgetreportutil/getTimeType" data-valueField="value"
                     data-textField="name" data-defaultvalue="$!{timeType}" data-selecttext="false" data-extraData="false"></div>
            </td>
            <td class="textRight">#springMessage('table.fbsBudgetReport.seachDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="beginDate" data-biz-name="beginDate"
                           class="layui-input bt-input-inline bt-biz-dateType" data-today="true" value="$!{beginDate}">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fbsBudgetReport.showMoney')</td>
            <td>
                <div class="bt-biz-dict" data-type="checkbox" data-group="fbsBudgetReport.showMoney"
                     data-defaultvalue="$!{showMoney}" data-required = "true"
                     data-name="showMoney" data-biz-name="showMoney"></div>
            </td>
            <td class="textRight">#springMessage('table.fbsBudgetReport.showItem')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-displayData="$!{maxLevelShow}" data-defaultvalue="$!{showItem}"
                     data-group="fbsBudgetReport.showItem" data-name="showItem" data-biz-name="showItem"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" type="button" onclick="query()">#springMessage(
                    'common.button.search')</button>
                <button class="layui-btn" type="button" onclick="seach()">#springMessage('budget.button.query.report')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
    <table id="corp-table" class="layui-table layui-form treeTable" style="width:100%;" expandable="true">
        <thead>
        <tr>
            <th colspan="4">#springMessage('table.fbsBudgetReport.selectMergeCorp')</th>
        </tr>
        <tr>
            <th width="20%">#springMessage('table.fbsBudgetReport.allCorp')</th>
            <th width="20%">
                #springMessage('table.fbsBudgetReport.allChildCorp')
            </th>
            <th width="20%">
                #springMessage('table.fbsBudgetReport.directChildCorp')
            </th>
            <th width="20%">
                #springMessage('table.fbsBudgetReport.leafChildCorp')
            </th>
        </tr>
        </thead>
        <tbody>
            #foreach($corp in $corpDate)
            <tr data-tt-id="$!{corp.id}" data-tt-parent-id="$!{corp.parentId}" data-tt-subject-sort="$!{corp.sort}">
                <td>
                    <input type="checkbox" name="corpIds" class="corpIds" lay-skin="primary" value="${corp.id}"
                           data-parent-id="$!{corp.parentId}" data-type="$!{corp.type}"/>
                    &nbsp;&nbsp;($!{corp.code})&nbsp;&nbsp;$!{corp.name}
                    #if(${corp.type} == 0)
                        <font color="red">(#springMessage('table.fbsBudget.net'))</font>
                    #end
                </td>
                #if($corp.type==0)
                    <td>
                        <input type="checkbox" class="checkAll" name="checkAll" lay-skin="primary"
                               lay-filter="checkAll" data-all-parent-id="$!{corp.id}">
                        &nbsp;&nbsp;#springMessage('table.fbsBudgetReport.allChildCorp')
                    </td>
                    <td>
                        <input type="checkbox" class="checkAll" name="checkDirect" lay-skin="primary"
                               lay-filter="checkDirect" data-direct-parent-id="$!{corp.id}">
                        &nbsp;&nbsp;#springMessage('table.fbsBudgetReport.directChildCorp')
                    </td>
                    <td>
                        <input type="checkbox" class="checkAll" name="checkLeaf" id="$!{corp.id}" lay-skin="primary"
                               lay-filter="checkLeaf" data-leaf-parent-id="$!{corp.id}">
                        &nbsp;&nbsp;#springMessage('table.fbsBudgetReport.leafChildCorp')
                    </td>
                #else
                    <td></td>
                    <td></td>
                    <td></td>
                #end
            </tr>
            #end
        </tbody>
    </table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/budget/fbsBudgetMergeQuery.report.js?_btv=${resourceVersion}"></script>
</body>
</html>

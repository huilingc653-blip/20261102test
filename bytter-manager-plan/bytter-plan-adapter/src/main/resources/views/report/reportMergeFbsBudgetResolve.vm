<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <div id="print">
        <table class="layui-table">
            <tbody>
            <tr>
            ##类型
                <td class="textRight">#springMessage('table.fbsBudget.timeType')</td>
                <td width="40%">$dictTag.get("fbs.timeType",$!{timeType})</td>
            ##日期
                <td class="textRight">#springMessage('table.fbsBudgetReport.seachDate')</td>
                <td>$!date.format('yyyy-MM-dd',$!{seachBeginDate}) ~ $!date.format('yyyy-MM-dd',$!{seachEndDate})</td>
            </tr>
            <tr>
            ##币种
                <td class="textRight">#springMessage('table.fbsBudgetDetail.curId')</td>
                <td>$!{cur.curName}</td>
                <td class="textRight"></td>
                <td></td>
            </tr>
            </tbody>
        </table>
        <table id="appTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th rowspan="4">#springMessage('table.fbsBudgetYear.number')</th>
                <th rowspan="4">#springMessage('table.fbsBudgetYear.itemCode')</th>
                <th rowspan="4">#springMessage('table.fbsBudgetYear.itemName')</th>
                <th rowspan="4">#springMessage('table.fbsBudgetReport.mergeMoney')</th>
            </tr>
            <tr>
                #set($col=$!{moneyMap.size()} * $!{corpMap.size()})
                #foreach($month in [1..$!{maxDateCount}])
                    <th colspan="$col">
                        $!{month}#if($timeType == 1)#springMessage(
                        'table.fbsBudgetReport.month')#elseif($timeType == 3)#springMessage(
                        'table.fbsBudgetReport.week')#end
                    </th>
                #end
            </tr>
            <tr>
                #foreach($month in [1..$!{maxDateCount}])
                    #if($!{bMoneyShow})
                        <th colspan="$corpMap.size()">
                            #springMessage('table.fbsBudgetYear.bMoney')
                        </th>
                    #end
                    #if($!{bsuperMoneyShow})
                        <th colspan="$corpMap.size()">
                            #springMessage('table.fbsBudgetYear.bsuperMoney')(#springMessage('table.fbsBudgetYear.pass'))
                        </th>
                    #end
                    #if($!{btempMoneyShow})
                        <th colspan="$corpMap.size()">
                            #springMessage('table.fbsBudgetYear.btempMoney')(#springMessage(
                            'table.fbsBudgetYear.notPass'))
                        </th>
                    #end
                #end
            </tr>
            <tr>
                #foreach($month in [1..$!{maxDateCount}])
                    #foreach($money in $!{moneyMap.entrySet()})
                        #foreach($corp in $!{corpMap.entrySet()})
                            #if($!{timeType} == 1)
                                <th>
                                    $!{corp.value}
                                </th>
                            #elseif($!{timeType} == 3)
                                <th>
                                    $!{corp.value}
                                </th>
                            #end
                        #end
                    #end
                #end
            </tr>
            </thead>
            <tbody>
                #foreach($item in $!{itemMap.entrySet()})
                <tr data-tt-id="$!{item.value.itemCode}" data-tt-parent-id="$!{item.value.superItemCode}"
                    data-tt-subject-sort="$!{item.itemCode}">
                    <td>$!{velocityCount}</td>
                    <td>$!{item.value.itemCode}</td>
                    <td>$!{item.value.itemName}</td>
                ## 汇总金额
                    #foreach($collect in $!{collectMap.entrySet()})
                        #if(${item.value.itemCode}== $!{collect.key})
                            <td class="textRight">$!number.formatNumeric($!{collect.value})</td>
                        #end
                    #end
                ## 上报金额
                    #foreach($date in $!{dtlMap.entrySet()})
                        #if(${item.value.itemCode} == $!{date.key})
                            #foreach($money in $date.value.entrySet())
                                <td class="textRight">$!number.formatNumeric($!{money.value})</td>
                            #end
                        #end
                    #end
                </tr>
                #end
                #if(!${itemMap} || ${itemMap.size()} == 0)
                <tr>
                    <td colspan="4" class="center">
                        <span style="color: red">#springMessage('fbs.budgetReport.message.query.null')</span>
                    </td>
                </tr>
                #end
            </tbody>
        </table>
    </div>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage(
                'common.button.print')</button>
            <button class="layui-btn" type="button" lay-submit onclick="exports()">#springMessage('common.button.exports')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form', 'treeTable', 'printType'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.printType.init();
        bt.treeTable.init({elem: "#appTable", column: 1});
        /**
         * 导出功能
         */
        exports = function () {
            var url = basePath + "/budget/fbsbudgetreport/exportsMergeBudge";
            window.location.href = url;
        };
    });
</script>
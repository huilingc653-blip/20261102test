<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
    <input type="hidden"  name="opType" id="opType" value="0"/>
    <table class="layui-table">
        <tr>
            ##单位
            <td class="textRight">#springMessage('table.fbsBudgetProcess.corpId')</td>
            <td width="20%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="ins_corpId"
                         data-resource="fbs:report:fbsBudgetDetail:query"
                         data-scope="all"></div>
                </div>
            </td>
            ##科目代码
            <td class="textRight">#springMessage('table.fbsItem.itemCode')</td>
            <td width="20%">
                <input type="text" name="likes_itemCode"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsItem.itemCode')">
            </td>
            ##科目名称
            <td class="textRight">#springMessage('table.fbsItem.itemName')</td>
            <td width="20%">
                <input type="text" name="likes_itemName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsItem.itemName')">
            </td>
        </tr>
        <tr>
            ##部门
            <td class="textRight">#springMessage('table.fbsBudgetDetail.corpName')</td>
            <td width="20%">
                <input type="text" name="likes_deptName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetDetail.corpName')">
            </td>
            ##执行归属
            <td class="textRight">#springMessage('table.fbsBudgetDetail.vestingDate')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_vestingDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="t2">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_vestingDate" class="layui-input bt-input-inline bt-biz-dateType" id="t2">
                </div>
            </td>
            ##币别
            <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
            <td width="20%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="eqs_curId" data-valueField="id" data-textField="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                #if($shiro.hasPermission("fbs:process:fbsBudgetProcess:query"))
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                #end
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fbsBudgetProcess.corpId')</th>
        <th>#springMessage('table.fbsBudgetDetail.corpName')</th>
        <th>#springMessage('table.fbsBudgetProcess.itemCode')</th>
        <th>#springMessage('table.fbsBudgetProcess.itemName')</th>
        <th>#springMessage('table.fbsBudgetDetail.bMoney')</th>
        <th>#springMessage('table.fbsBudgetDetail.curId')</th>
        <th>#springMessage('table.fbsBudgetDetail.vestingDate')</th>
        <th>#springMessage('table.eNoticeBill.payType')</th>
        <th>#springMessage('table.fbsBudgetDetail.purpose')</th>
        <th>#springMessage('table.fbsBudgetDetail.wishPayday')</th>
        <th>#springMessage('table.fbsBudgetDetail.payerAcc')</th>
        <th>#springMessage('table.fbsBudgetDetail.payeeAccName')</th>
        <th>#springMessage('table.fbsBudgetDetail.payeeAcc')</th>
        <th>#springMessage('table.fbsBudgetDetail.payeeBank')</th>
        <th>#springMessage('table.fbsBudgetDetail.contract')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudgetDetailQuery.report.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .center{
            height:31px;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <td class="textRight" width="10%">#springMessage('table.fbsBudgetReport.timeType')</td>
            <td width="20%">
                <div data-name="eqs_timeType" data-biz-name="eqs_timeType" class="bt-biz-selectType"
                     data-url="${basePath}/budget/budgetreportutil/getTimeType" data-valueField="value"
                     data-textField="name" data-defaultvalue="5" data-selecttext="false" data-extraData="false"></div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.fbsBudgetReport.seachDate')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="beginDate" data-biz-name="beginDate"
                           class="layui-input bt-input-inline bt-biz-dateType" data-today="true" data-endid="endDate">
                    <span class="date-mid">~</span>
                    <input type="text" name="endDate" data-biz-name="endDate"
                           class="layui-input bt-input-inline bt-biz-dateType" data-today="true" id="endDate">
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.fbsBudgetReport.corp')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-name="ins_corpId" data-biz-name="ins_corpId" data-biz-type="corp"
                         data-type="selectTree" data-resource="fbs:report:fbsBudget:query" data-tree-type="check"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fbsBudgetReport.corpId')</th>
        <th>#springMessage('table.fbsBudgetReport.beginDate')</th>
        <th>#springMessage('table.fbsBudgetReport.endDate')</th>
        <th>#springMessage('table.fbsBudgetReport.status')</th>
        <th>#springMessage('table.fbsBudgetReport.timeType')</th>
        <th>#springMessage('table.fbsBudgetDetail.curId')</th>
        <th>#springMessage('table.fbsBudgetReport.viewType')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/budget/fbsBudgetQuery.report.js?_btv=${resourceVersion}"></script>
</body>
</html>

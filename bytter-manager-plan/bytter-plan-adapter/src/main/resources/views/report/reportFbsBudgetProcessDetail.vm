<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form " id="inputForm">
    <input type="hidden" id="eqs_budgetId" name="eqs_budgetId" value="$!{id}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            ##收款账户名称
            <td class="textRight">#springMessage('table.fbsBudgetDetail.payeeAccName')</td>
            <td>
                <input type="text" name="likes_payeeAccName"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.fbsBudgetDetail.payeeAccName')">
            </td>
            ##科目代码
            <td class="textRight">#springMessage('table.fbsBudgetProcess.itemCode')</td>
            <td>
                <input type="text" name="likes_itemCode"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.fbsBudgetProcess.itemCode')">
            </td>
            ##科目名称
            <td class="textRight">#springMessage('table.fbsBudgetProcess.itemName')</td>
            <td>
                <input type="text" name="likes_itemName"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.fbsBudgetProcess.itemName')">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                                'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th rowspan="2">#springMessage('table.nisBillhead.corpId')</th>
            <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.itemCode')</th>
            <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.itemName')</th>
            <th rowspan="2">#springMessage('table.fbsBudgetDetail.payeeAccName')</th>
            <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.bMoney')</th>
            <th colspan="2">#springMessage('table.fbsBudgetProcessReport.bsuperMoney')</th>
            <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.bMoneySum')</th>
            <th colspan="2">#springMessage('table.fbsBudgetProcessReport.inProcessMoney')</th>
            <th colspan="2">#springMessage('table.fbsBudgetProcessReport.outProcessMoney')</th>
            <th rowspan="2">#springMessage('table.fbsBudgetProcessReport.canBMoney')</th>
        </tr>
        <tr>
            <th>#springMessage('table.fbsBudgetProcessReport.bsuperMoney.success')</th>
            <th>#springMessage('table.fbsBudgetProcessReport.bsuperMoney.temp')</th>
            <th>#springMessage('table.fbsBudgetProcessReport.inProcessMoney.success')</th>
            <th>#springMessage('table.fbsBudgetProcessReport.inProcessMoney.temp')</th>
            <th>#springMessage('table.fbsBudgetProcessReport.outProcessMoney.success')</th>
            <th>#springMessage('table.fbsBudgetProcessReport.outProcessMoney.temp')</th>
        </tr>
        </thead>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudgetProcessDetail.report.js?_btv=${resourceVersion}"></script>
</html>

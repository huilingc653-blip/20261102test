<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
    <input type="hidden" name="eqs_itemCode" id="eqs_itemCode" value="${itemCode}"/>
    <input type="hidden" name="eqs_corpId" id="eqs_corpId" value="${corpId}"/>
    <input type="hidden" name="timeType" id="timeType" value="${timeType}"/>
    <input type="hidden" name="ged_createDate" id="ged_createDate"
           value="$!date.format('yyyy-MM-dd', ${beginDate})"/>
    <input type="hidden" name="led_createDate" id="led_createDate" value="$!date.format('yyyy-MM-dd',${endDate})"/>
    #if($!{statusFlag})
        <input type="hidden" name="eqi_status" id="eqi_status" value="95"/>
    #else
        <input type="hidden" name="gti_status" id="gti_status" value="-2"/>
        <input type="hidden" name="lti_status" id="lti_status" value="95"/>
    #end
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th colspan="15">$!{corpName}#springMessage('table.fbsBudgetReport.corpId')
            #springMessage('table.fbsBudgetSuperaddInfoReport.title')
            $!date.format('yyyy-MM-dd', $!{beginDate})~$!date.format('yyyy-MM-dd',$!{endDate})</th>
    </tr>
    <tr>
        <th>#springMessage('table.fbsBudgetProcess.corpId')</th>
        <th>#springMessage('table.fbsBudgetProcess.itemCode')</th>
        <th>#springMessage('table.fbsBudgetProcess.itemName')</th>
        <th>#springMessage('table.fbsBudgetProcessReport.bsuperMoney')</th>
        <th>#springMessage('table.fbsBudgetSuperadd.status')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudgetSuperaddInfo.report.js?_btv=${resourceVersion}"></script>
</html>

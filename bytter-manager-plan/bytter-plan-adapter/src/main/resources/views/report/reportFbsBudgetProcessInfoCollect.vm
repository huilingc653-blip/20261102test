<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
    <input type="hidden" name="opType" id="opType" value="S"/>
    <input type="hidden" name="rlikes_itemCode" id="rlikes_itemCode" value="${itemCode}"/>
    <input type="hidden" name="eqs_corpId" id="eqs_corpId" value="${corpId}"/>
    <input type="hidden" name="ged_processDate" id="ged_processDate"
           value="$!date.format('yyyy-MM-dd', ${beginDate})"/>
    <input type="hidden" name="led_processDate" id="led_processDate" value="$!date.format('yyyy-MM-dd',${endDate})"/>
    <input type="hidden" name="eqs_innerSign" id="eqs_innerSign" value="${innerSign}"/>
    #if($!{statusFlag})
        <input type="hidden" name="eqi_status" id="eqi_status" value="95"/>
    #else
        <input type="hidden" name="gti_status" id="gti_status" value="-2"/>
        <input type="hidden" name="lti_status" id="lti_status" value="95"/>
    #end
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th colspan="15">
            #springMessage('table.reportFbsBudgetProcessInfoCollect.title')
        </th>
    </tr>
    <tr>
        <th>#springMessage('table.fbsBudgetProcess.corpId')</th>
        <th>#springMessage('table.fbsBudgetProcess.itemCode')</th>
        <th>#springMessage('table.fbsBudgetProcess.itemName')</th>
        <th>#springMessage('table.fbsBudgetProcess.businessName')</th>
        <th>#springMessage('table.fbsBudgetProcess.billNo')</th>
        <th>#springMessage('table.fbsBudgetProcess.processDate')</th>
        <th>#springMessage('table.fbsBudgetProcess.processMoney')</th>
        <th>#springMessage('table.fbsBudgetDetail.curId')</th>
        <th>#springMessage('table.fbsBudgetProcess.payeeAccName')</th>
        <th>#springMessage('table.fbsBudgetProcess.status')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudgetProcessInfoCollect.report.js?_btv=${resourceVersion}"></script>
</html>

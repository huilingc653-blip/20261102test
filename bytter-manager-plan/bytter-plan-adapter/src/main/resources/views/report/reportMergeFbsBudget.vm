<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <div id="print">
        <table class="layui-table">
            <tbody>
            <tr>
            ##类型
                <td class="textRight">#springMessage('table.fbsBudget.timeType')</td>
                <td width="40%">$dictTag.get("fbs.timeType",$!{timeType})</td>
            ##日期
                <td class="textRight">#springMessage('table.fbsBudgetReport.seachDate')</td>
                <td>$!date.format('yyyy-MM-dd',$!{seachBeginDate}) #if($timeType != 5) ~ $!date.format('yyyy-MM-dd',$!{seachEndDate})#end</td>
            </tr>
            <tr>
            ##币种
                <td class="textRight">#springMessage('table.fbsBudgetDetail.curId')</td>
                <td>$!{cur.curName}</td>
                <td class="textRight"></td>
                <td></td>
            </tr>
            </tbody>
        </table>
        <table id="appTable" class="layui-table layui-form treeTable" style="width:100%;">
            <thead>
            <tr>
                <th rowspan="2">#springMessage('table.fbsBudgetYear.number')</th>
                <th rowspan="2">#springMessage('table.fbsBudgetYear.itemCode')</th>
                <th rowspan="2">#springMessage('table.fbsBudgetYear.itemName')</th>
                <th rowspan="2">#springMessage('table.fbsBudgetReport.mergeMoney')</th>
                #set($timeSize=$corpMap.size() * $!moneyMap.size())
                #set($col= $!timeMap.size() * $!corpMap.size() * $!moneyMap.size())
                #foreach($time in $!{timeMap.entrySet()})
                    #if($!{bMoneyShow})
                        <th colspan="$corpMap.size()">
                            #springMessage('table.fbsBudgetYear.bMoney')
                        </th>
                    #end
                    #if($!{bsuperMoneyShow})
                        <th colspan="$corpMap.size()">
                            #springMessage('table.fbsBudgetYear.bsuperMoney')(#springMessage('table.fbsBudgetYear.pass'))
                        </th>
                    #end
                    #if($!{btempMoneyShow})
                        <th colspan="$corpMap.size()">
                            #springMessage('table.fbsBudgetYear.btempMoney')(#springMessage(
                            'table.fbsBudgetYear.notPass'))
                        </th>
                    #end
                #end
            </tr>
            <tr>
                #foreach($foo in $!{moneyMap.entrySet()})
                    #foreach($corp in $!{corpMap.entrySet()})
                        <th>
                            $!{corp.value}
                        </th>
                    #end
                #end
            </tr>
            </thead>
            <tbody>
                $!{html}
                #if(!$itemList)
                <tr>
                    <td colspan="4" class="center">
                        <span style="color: red">#springMessage('fbs.budgetReport.message.query.null')</span>
                    </td>
                </tr>
                #end
            </tbody>
        </table>
        <div style="display:inline-block;width:100%;">
            <div id="maingrid1" ></div>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage(
                'common.button.print')</button>
            <button class="layui-btn" type="button" lay-submit onclick="exports()">#springMessage('common.button.exports')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','treeTable','printType','toLigerTree'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.printType.init();


        // var height = $(window).height();
        // var corpTableHeight = height - 100;
        // if (corpTableHeight < 400){
        //     corpTableHeight = 400;
        // }
        // bt.treeTable.init({elem: "#appTable", column: 1});
        // if ($("#appTable").find("tbody tr").find("td").length > 1){
        //     //生成冻结表格
        //     bt.freezeTable.init({
        //         elem:'#appTable',//表格id
        //         freezeRowNum:'2',//冻结几行
        //         freezeColumnNum:'2',//冻结几列
        //         height:corpTableHeight +'px' //表格高度
        //     })
        // }

         bt.toLigerTree.init2({
            elem: '#appTable',
            newElem: '#maingrid1',
            rownumbers: true,//序号列数，默为无， 1代表左边第一列为序号列
            isDoubleHeader: true,//是否有双表头
            allowHideColumn: false,
            resize: false,
            height: "100%",
            fixedLeftColumns: 2,
            columnName: 'itemCode'
        });
        /**
         * 导出功能
         */
        exports = function () {
            var url = basePath + "/budget/fbsbudgetreport/exportsMergeBudge";
            window.location.href = url;
        };
    });
</script>
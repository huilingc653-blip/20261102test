<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form  id="tempForm" method="post">
    <input type="hidden" id="corpIds" name="corpIds"/>
    <input type="hidden" id="timeType" name="timeType" value="${timeType}"/>
    <input type="hidden" id="seachDate" name="seachDate" value="$!date.format('yyyy-MM-dd',$!{seachDate})"/>
    <input type="hidden" id="showMoney" name="showMoney" value="${showMoney}"/>
    <input type="hidden" id="showItem" name="showItem" value="${showItem}"/>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form'], function () {
        var webObj = bt.navtab.getParentDom();
        if(webObj){
            $("#corpIds").val(webObj.document.getElementById("corpIds").value);
        }
        var action = basePath + "/budget/fbsbudgetreport/seachMergeFbsBudgetPost";
        $("#tempForm").attr("action",action);
        $("#tempForm").submit();
    });
</script>
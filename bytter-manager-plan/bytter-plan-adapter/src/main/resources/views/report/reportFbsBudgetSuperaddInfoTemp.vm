<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body class="full-body">

<form class="layui-form " id="inputForm" method="post">
    <input type="hidden" name="timeType" id="timeType" value="${timeType}"/>
    <input type="hidden" name="corpId" id="corpId" />
    <input type="hidden" name="beginDate" id="beginDate" value="$!date.format('yyyy-MM-dd', ${beginDate})"/>
    <input type="hidden" name="endDate" id="endDate" value="$!date.format('yyyy-MM-dd',$!{endDate})"/>
    <input type="hidden" name="itemCode" id="itemCode" value="$!{itemCode}"/>
    <input type="hidden" name="statusFlag" id="statusFlag" value="$!{statusFlag}"/>
</form>
    #parse("views/common/footer.vm")
</body>
<script>
    var webObj = bt.navtab.getParentDom();
    var corpId = webObj.$("#eqs_corpId").val();
    $("#corpId").val(corpId);
    var action =basePath + "/budget/fbsBudgetProcessReport/openSuperaddInfoCollect";
    $("#inputForm").attr("action",action);
    $("#inputForm").submit();
</script>
</html>

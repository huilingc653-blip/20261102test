<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        table.layui-table{
            border:none!important;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table" id="corp-table" lay-even="" lay-skin="nob">
        <tbody>
        <tr >
            <td class="right" colspan="2">
                <input type="checkbox" name="" data-name="checkAllCollectCorp" lay-skin="primary" lay-filter="checkAllCollectCorp">&nbsp;&nbsp; #springMessage('table.mulselect.corpAndNet')
            </td>
        </tr>
            #foreach($corp in $corpList)
                #set($corpMaps=$corpMap.get($corp.id))
            <tr data-tt-id="$!{corpMaps.corpId}" data-tt-parent-id="$!{corpMaps.corpParentId}" >
                <td width="25%" class="left" style="border:none">
                    <input type="checkbox" class="check" name="checkCollect"  data-name="checkCollect" value="$!{corpMaps.corpId}" lay-skin="primary" lay-filter="checkCollectCorp"
                           data-collect-id="$!{corpMaps.corpId}" data-collect-parent-id="$!{corpMaps.corpParentId}" data-collect-name="${corpMaps.corpName}" data-collect-code="${corpMaps.corpCode}"
                           data-collect-corptype="${corpMaps.corpType}" data-collect-netid="${corpMaps.corpNetId}">

                    (${corpMaps.corpCode})&nbsp;&nbsp;${corpMaps.corpName}
                    #if( ($!{netId}=="null" || $!{netId}==${corpMaps.corpId}) && $!{corpMaps.corpType} == 0 )<font color="red">(#springMessage('table.fbsBudget.net'))</font>#end
                </td>
                #if(($!{netId}=="null" || $!{netId}==${corpMaps.corpId}) && $!{corpMaps.corpType} == 0 && $!{corpMaps.childCount} > 0)
                    <td width="10%" class="center" style="border:none">
                        <input type="checkbox" class="checkAll" name="checkCollectAll" data-name="checkCollectAll" data-collect-child-id="$!{corpMaps.corpId}" data-collect-parent-id="$!{corpMaps.corpParentId}"
                               data-childCount="$!{corpMaps.childCount}" lay-skin="primary" lay-filter="checkCollectCorp">&nbsp;&nbsp;#springMessage('common.check.all') 下级单位
                    </td>
                #else
                    <td width="10%" class="center" style="border:none">
                        #if($!{corpMaps.childCount} > 0)
                            <input type="checkbox" class="checkAll" name="checkCollectAll" data-name="checkCollectAll" data-collect-child-id="$!{corpMaps.corpId}" data-collect-parent-id="$!{corpMaps.corpParentId}"
                                   data-childCount = "$!{corpMaps.childCount}" lay-skin="primary" lay-filter="checkCollectCorp" >&nbsp;&nbsp;#springMessage('common.check.all') 下级单位
                        #end
                    </td>
                #end

            </tr>
            #end
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" onClick="transferData()" >#springMessage('common.button.submit')</button>
            <button type="button" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/mulCorp.add.js?_btv=${resourceVersion}"></script>
</html>
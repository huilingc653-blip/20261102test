<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tr>
            ##币别
                <td class="textRight"  width="50%">#springMessage('table.nisBillhead.curId')</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="2" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.fbsExcrateAdjust.curCode')</th>
            <th>#springMessage('table.fbsExcrateAdjust.curName')</th>
            <th>#springMessage('table.fbsExcrateAdjust.englishCode')</th>
            <th>#springMessage('table.fbsExcrateAdjust.referCurName')</th>
            <th>#springMessage('table.fbsExcrateAdjust.referEnglishCode')</th>
            <th>#springMessage('table.fbsExcrateAdjust.exchangeRate')</th>
            <th>#springMessage('table.fbsExcrateAdjust.example')</th>
            <th>#springMessage('table.fbsExcrateAdjust.preTime')</th>
            <th>#springMessage('table.fbsBudgetPeriod.rmk')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsExcrateAdjust.list.js?_btv=${resourceVersion}"></script>
</html>



























<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{fbsBudgetPeriodPage.id}">
        <table class="layui-table">
            <tbody>
				<tr>
					##年份
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.year')</td>
    				<td width="40%">
						<!--number-->
						<input type="text" id="year" name="year"
							   lay-verify="required"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.year')" value="$!{fbsBudgetPeriodPage.year}">
											</td>
					##月
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.month')</td>
    				<td width="40%">
						<!--number-->
						<input type="text" id="month" name="month"
							   lay-verify="required"
							   decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.month')" value="$!{fbsBudgetPeriodPage.month}">
											</td>
        		</tr>
				<tr>
					##周次
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.week')</td>
    				<td >
						<!--number-->
						<input type="text" id="week" name="week"
							   lay-verify="required"
							   decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.week')" value="$!{fbsBudgetPeriodPage.week}">
											</td>
					##周顺序
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.weekNo')</td>
    				<td >
						<!--number-->
						<input type="text" id="weekNo" name="weekNo"
							   
							   decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.weekNo')" value="$!{fbsBudgetPeriodPage.weekNo}">
											</td>
        		</tr>
				<tr>
					##开始日期
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.beginDate')</td>
    				<td >
												<div type="date" field="beginDate" defaultVal="$!{fbsBudgetPeriodPage.beginDate}"></div>
					</td>
					##结束日期
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.endDate')</td>
    				<td >
												<div type="date" field="endDate" defaultVal="$!{fbsBudgetPeriodPage.endDate}"></div>
					</td>
        		</tr>
				<tr>
					##本周天数
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.weekdays')</td>
    				<td >
						<!--number-->
						<input type="text" id="weekdays" name="weekdays"
							   
							   decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.weekdays')" value="$!{fbsBudgetPeriodPage.weekdays}">
											</td>
					##工作日天数
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.workdays')</td>
    				<td >
						<!--number-->
						<input type="text" id="workdays" name="workdays"
							   
							   decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.workdays')" value="$!{fbsBudgetPeriodPage.workdays}">
											</td>
        		</tr>
				<tr>
					##假期天数
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.holidays')</td>
    				<td >
						<!--number-->
						<input type="text" id="holidays" name="holidays"
							   
							   decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.holidays')" value="$!{fbsBudgetPeriodPage.holidays}">
											</td>
					##备注
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
    				<td >
						<!--number-->
						<input type="text" id="rmk" name="rmk"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.rmk')" value="$!{fbsBudgetPeriodPage.rmk}">
											</td>
        		</tr>
				<tr>
					##创建人名称
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.createName')</td>
    				<td >
						<!--number-->
						<input type="text" id="createName" name="createName"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.createName')" value="$!{fbsBudgetPeriodPage.createName}">
											</td>
					##创建人登录名称
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.createBy')</td>
    				<td >
						<!--number-->
						<input type="text" id="createBy" name="createBy"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.createBy')" value="$!{fbsBudgetPeriodPage.createBy}">
											</td>
        		</tr>
				<tr>
					##创建日期
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.createDate')</td>
    				<td >
												<div type="date" field="createDate" defaultVal="$!{fbsBudgetPeriodPage.createDate}"></div>
					</td>
					##更新人名称
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.updateName')</td>
    				<td >
						<!--number-->
						<input type="text" id="updateName" name="updateName"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.updateName')" value="$!{fbsBudgetPeriodPage.updateName}">
											</td>
        		</tr>
				<tr>
					##更新人登录名称
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.updateBy')</td>
    				<td >
						<!--number-->
						<input type="text" id="updateBy" name="updateBy"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetPeriod.updateBy')" value="$!{fbsBudgetPeriodPage.updateBy}">
											</td>
					##更新日期
					<td class="textRight">#springMessage('table.fbsBudgetPeriod.updateDate')</td>
    				<td >
												<div type="date" field="updateDate" defaultVal="$!{fbsBudgetPeriodPage.updateDate}"></div>
					</td>
        		</tr>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudgetPeriod.edit.js?_btv=${resourceVersion}"></script>
</html>
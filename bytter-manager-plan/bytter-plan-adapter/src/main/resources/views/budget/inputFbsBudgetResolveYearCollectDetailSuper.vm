#parse("views/common/head.vm")
<!-- 不同上报模式，上报提交方法不一样 -->
<input id="saveMethod" name="saveMethod" type="hidden" value="$!{saveMethod}">
<div style="width: 100%;overflow-x: scroll;margin-bottom: 10px">
    <table id="appTable" class="layui-table" style="width:100%;">
        <thead>
        <tr>
            <th rowspan="2">#springMessage('table.fbsBudgetYear.number')</th>
            <th rowspan="2">#springMessage('table.fbsBudgetYear.itemCode')</th>
            <th rowspan="2">#springMessage('table.fbsBudgetYear.itemName')</th>
            <th rowspan="2">#springMessage('table.fbsBudgetYear.bMoney')</th>
            <th rowspan="2">#springMessage('table.fbsBudgetYear.bsuperMoney')(#springMessage('table.fbsBudgetYear.pass'))</th>
            <th rowspan="2">#springMessage('table.fbsBudgetYear.btempMoney')</th>
            #foreach($month in $months.entrySet())
                <th colspan="2">$!{month.key}#springMessage('table.fbsBudgetYear.monthShow')</th>
            #end
            <th rowspan="2">#springMessage('table.fbsBudgetYear.dtl')</th>
        </tr>
        <tr>
            #foreach($month in $months.entrySet())
                <th>#springMessage('table.fbsBudgetYear.remainBMoney')</th>
                <th>#springMessage('table.fbsBudgetYear.btempMoney')</th>
            #end
        </tr>
        </thead>
        <tbody>
            #foreach($date in $resolveList)
            <tr data-tt-id="$!{date.itemCode}" data-tt-parent-id="$!{date.item.superItemCode}"
                data-tt-subject-sort="$!{date.itemCode}">
                <td>$!{velocityCount}</td>
                <td>
                    $!{date.itemCode}
                    <input type="hidden" id="detailId_$!{date.itemCode}" name="detailId" value="$!{date.detailId}">
                    <input type="hidden" id="itemCode_$!{date.itemCode}" name="itemCode" value="$!{date.itemCode}">
                    <input type="hidden" id="itemRelation_$!{date.itemCode}" name="itemRelation"
                           data-curItemCode="$!{date.itemCode}" value="$!{date.item.itemRelation}">
                    <input type="hidden" id="sign_$!{date.itemCode}" name="sign" value="$!{date.item.sign}">
                    <input type="hidden" id="isBeginPeriod_$!{date.itemCode}" name="isBeginPeriod"
                           value="$!{date.item.isBeginPeriod}">
                    <input type="hidden" id="isEndPeriod_$!{date.itemCode}" name="isEndPeriod"
                           value="$!{date.item.isEndPeriod}">
                    <input type="hidden" id="resolveId_$!{date.itemCode}" name="resolveId" value="$!{date.id}">
                    <input type="hidden" id="superaddDtlId_$!{date.itemCode}" name="superaddDtlId" value="$!{date.superaddDtlId}">
                    <input type="hidden" id="rmk_$!{date.itemCode}" name="rmk" value="$!{date.rmk}">
                </td>
                <td>$!{date.itemName}</td>
                <td align="right">
                    <input type="hidden" id="bMoney_$!{date.itemCode}" name="bMoney" data-name="bMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{date.bMoney}" data-key=""
                           data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}"
                           data-biz-name="bMoney_$!{date.itemCode}"
                           data-isBeginPeriod="$!{date.item.isBeginPeriod}"
                           data-isEndPeriod="$!{date.item.isEndPeriod}">
                    <div id="bMoneyDiv_$!{date.itemCode}" name="bMoneyDiv" class="clearDiv">$!number.formatNumeric($!{date.bMoney})</div>
                </td>
                <!-- 计划追加 -->
                <td class="textRight">$!number.formatNumeric($!{date.bsuperMoney})</td>
                <td align="right">
                    <input type="hidden" id="btempMoney_$!{date.itemCode}" name="btempMoney"
                           data-name="btempMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{date.btempMoney}"
                           data-key=""
                           data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}"
                           data-biz-name="btempMoney_$!{date.itemCode}"
                           data-isBeginPeriod="$!{date.item.isBeginPeriod}"
                           data-isEndPeriod="$!{date.item.isEndPeriod}">
                    <div id="btempMoneyDiv_$!{date.itemCode}" name="btempMoneyDiv"
                         class="clearDiv">$!number.formatNumeric($!{date.btempMoney})</div>
                </td>
                #foreach($money in $date.btempMoneyMap.entrySet())
                    <td class="textRight">
                        <input type="hidden" id="remainBMoney$!{money.key}_$!{date.itemCode}"
                               name="remainBMoney$!{money.key}"
                               data-name="remainBMoney$!{money.key}"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               value="$!{date.remainBMoneyMap.get($!{money.key})}" data-key="$!{money.key}"
                               data-itemCode="$!{date.itemCode}"
                               data-superItemCode="$!{date.item.superItemCode}"
                               data-biz-name="remainBMoney$!{money.key}_$!{date.itemCode}"
                               data-isBeginPeriod="$!{date.item.isBeginPeriod}"
                               data-isEndPeriod="$!{date.item.isEndPeriod}">
                        <div id="remainBMoneyDiv$!{money.key}_$!{date.itemCode}" name="remainBMoneyDiv"
                             class="clearDiv">$!number.formatNumeric($!{date.remainBMoneyMap.get($!{money.key})})</div>
                    </td>
                    <td align="right">
                        <input type="hidden" id="btempMoney$!{money.key}_$!{date.itemCode}"
                               name="btempMoney$!{money.key}"
                               data-name="btempMoney$!{money.key}"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               value="$!{money.value}" data-key="$!{money.key}"
                               data-itemCode="$!{date.itemCode}"
                               data-superItemCode="$!{date.item.superItemCode}"
                               data-biz-name="btempMoney$!{money.key}_$!{date.itemCode}"
                               data-isBeginPeriod="$!{date.item.isBeginPeriod}"
                               data-isEndPeriod="$!{date.item.isEndPeriod}">
                        <div id="btempMoneyDiv$!{money.key}_$!{date.itemCode}" name="btempMoneyDiv"
                             class="clearDiv">$!number.formatNumeric($!{money.value})</div>
                    </td>
                #end
                    <td>
                        #if($!{date.item.isWrite} == "1" && $!{date.item.isBeginPeriod} != "1" && $!{date.item.isEndPeriod} != "1")
                            <a class="" href="#"
                               onclick="inputDtl('$!{fbsBudgetPage.id}','$!{date.detailId}')">#springMessage(
                                'common.button.dtl')</a>
                        #end
                    </td>
            </tr>
            #end
            #if($!{fbsBudgetPage.id} != "")
            <tr>
                <td class="textRight" colspan="3">#springMessage('table.fbsBudget.msg')</td>
                <td width="70%" colspan="15">
                    <textarea name="msg" id="msg" autocomplete="off" class="layui-textarea" lay-verify="strlength" data-maxlength="150" placeholder="#springMessage('table.fbsBudget.showMsg')"></textarea>
                </td>
            </tr>
            #end
        </tbody>
    </table>
</div>
<div>
    #if($!{fbsBudgetPage.id} != "")
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
        </div>
    #else
        <div>
                        <span style="text-align: center;color: red">#springMessage(
							'fbs.budget.input.message.itmecode')</span>
        </div>
    #end
</div>
#if($!{target} == "input")
    <!-- 附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden" value="$!{fbsBudgetPage.attachmentId}">
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
#end
<!-- 日志 -->
<div id="tagMsg"></div>
<script src="${basePath}/static/modules/budget/fbsBudget.inputResolveCollectDetail.js?_btv=${resourceVersion}"></script>
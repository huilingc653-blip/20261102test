<html>
<head>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="font-src *  data:">
    <meta name="viewport"
          content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0, user-scalable=no">
    <title>上报情况</title>
    <!-- 引入 FrozenUI -->
    <link rel="stylesheet" href="${basePath}/static/mobile/plugins/fixedTable/table.min.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css" media="all"/>
    <link rel="stylesheet" href="${basePath}/static/css/mobile/index.css" media="all"/>
    <style>
        body{
            background-color: #F5F5F5;
        }
        .cho-body {
            background-color: #F5F5F5;
        }
        .box-head{
            height: 1.26rem;
            margin-top: 0.1rem;
            margin-left: 0.15rem;
            margin-right: 0.15rem;
            background:rgba(255,255,255,1);
            box-shadow:0 0 0.04rem 0 rgba(178,178,178,0.2);
            border-radius:0.04rem;
        }
        .box-left-style{
            background-color: #2988FF;
            float: left;
            width: 0.04rem;
            height: 1.26rem;
            border-bottom-left-radius: 0.04rem;
            border-top-left-radius: 0.04rem;
        }
        .box-left-info-icon{
            width:0.16rem;
            height:0.14rem;
            background-repeat: no-repeat;
            background-size: contain;
            display: inline-block;
            background-color: #2988FF;
            padding: 0.035rem 0.03rem 0.035rem 0.03rem;
            border-radius: 50%;
        }
        .box-left-info-icon img{
            margin-left: 0.02rem;
            width:0.13rem;
        }
        .box-left-info-title{
            position: absolute;
            margin-left: 0.2rem;
            margin-top: 0.16rem;
            font-size:0.16rem;
            font-family:PingFangSC-Medium,PingFang SC;
            font-weight:500;
            color:rgba(41,136,255,1);
            line-height:0.16rem;
        }
        .box-left-info-item{
            position: absolute;
            margin-left: 0.2rem;
            margin-top: 0.49rem;
            font-size:0.14rem;
            font-family:PingFangSC-Medium,PingFang SC;
            font-weight:400;
            color:#333333;
            line-height:0.14rem;
        }
        .box-left-info-date{
            position: absolute;
            margin-left: 0.2rem;
            margin-top: 1rem;
            font-size:0.14rem;
            font-family:PingFangSC-Medium,PingFang SC;
            font-weight:400;
            color:#999999;
            line-height:0.14rem;
        }
        .box-right-item{
            position: absolute;
            margin-left: 67%;
            font-size:0.12rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(153,153,153,1);
            line-height:0.12rem;
            margin-top: 0.49rem;
        }

        .box-body{
            margin-top: 0.11rem;
            background:linear-gradient(270deg,rgba(41,136,255,0.6) 0%,rgba(95,146,240,1) 100%);
            font-size:0.14rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(255,255,255,1);
            line-height:0.14rem;
        }
        .box-body-title1{
            padding: 0.15rem 0 0.15rem 0.17rem;
            display: inline-block;
            width: 20%;
            text-align: left;
        }
        .box-body-title2{
            border-left: 0.01rem solid rgb(95,153,242);
            padding: 0.15rem 0 0.15rem 0.17rem;
            display: inline-block;
            width: 20%;
            text-align: left;
        }
        .box-body-title3{
            display: inline-block;
            width:25%;
            text-align: right;
        }
        .box-body-title4{
            width:20%;
            text-align: right;
            display: inline-block;
            padding-right: 0.05rem;
        }

        .box-data{
            font-size:0.12rem;
            background:rgba(255,255,255,1);
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(0,0,0,1);
            line-height:0.12rem;
            border-bottom: 0.01rem solid #D4DADF;
        }
        .box-data-title1{
            padding: 0.15rem 0 0.15rem 0.17rem;
            display: inline-block;
            width: 20%;
            text-align: left;
            overflow-x:auto;
        }
        .box-data-title2{
            border-left: 0.01rem solid #D4DADF;
            padding: 0.15rem 0 0.15rem 0.17rem;
            display: inline-block;
            width: 20%;
            white-space:nowrap;
            overflow-x:auto;
        }
        .box-data-title3{
            display: inline-block;
            width:25%;
            padding: 0.15rem 0 0.15rem 0;
            text-align: right;
            overflow-x:auto;
        }
        .box-data-title4{
            width:20%;
            text-align: right;
            display: inline-block;
            padding: 0.15rem 0 0.15rem 0;
            padding-right: 0.05rem;
            overflow-x:auto;
        }
    </style>

</head>
<body>
<section class="cho-body ui-container">
    <div class="box-head">
        <div class="box-left-style"></div>
        <div class="box-left-info-title">
            <span class="box-left-info-icon">
                <img src="${basePath}/static/modules/images/reqcompanyinfo.png">
            </span>
            <span>$!{fbsBudgetVO.corpName}</span>
        </div>
        <div class="box-left-info-item">类型： $dictTag.get("fbs.timeType",$!{fbsBudgetVO.timeType})</div>
        <div class="box-left-info-item" style="margin-top: 0.77rem">周期： $!date.format('yyyy-MM-dd',$!{fbsBudgetVO.beginDate})-$!date.format('yyyy-MM-dd',$!{fbsBudgetVO.endDate})</div>
        <div class="box-right-item">币别：$!{fbsBudgetVO.curName}</div>
        <div class="box-right-item" style="margin-top: 0.77rem"></div>
    </div>
##    <div class="box-body">
##        <div class="box-body-title1">科目代码</div>
##        <div class="box-body-title2">名称</div>
##        <div class="box-body-title3">上报</div>
##        <div class="box-body-title4">追加通过</div>
##    </div>
##    #foreach($dtl in $!{fbsBudgetVO.dtlList})
##        <div class="box-data">
##            <div class="box-data-title1">${dtl.itemCode}</div>
##            <div class="box-data-title2">${dtl.itemName}</div>
##            <div class="box-data-title3">$!number.formatNumeric($!{dtl.bMoney})</div>
##            <div class="box-data-title4">$!number.formatNumeric($!{dtl.bsuperMoney})</div>
##        </div>
##    #end
    <div class="data-content" style="margin-bottom: 0.1rem;margin-top: 20px; height: calc(100% - 2rem);overflow-y: auto;" id="tableList">
        <div id="sp-list" class="data-table" >
            <!--1.0 冻列 -->
            <div class="t_l" style="width: 100px;">
                <!--1.1 冻结列表头-->
                <table>
                    <tbody id="biBody">
                    <tr>
                        <th>科目代码</th>
                    </tr>
                    </tbody>
                </table>
                <!--1.2 冻结列表体-->
                <div class="t_l_freeze">
                    <table width="100%">
                        <tbody id="biLeft">
                            #foreach($dtl in $!{fbsBudgetVO.dtlList})
                            <tr>
                                <td>$!{dtl.itemCode}</td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
            <!--2.0 表格-->
            <div class="t_r" style="margin-left: 100px;">
                <!--2.1　冻结行表头-->
                <div class="t_r_t">
                    <table style="width: 300px;">
                        <tbody id="biHead">
                        <tr>
                            <th>名称</th>
                            <th>上报</th>
                            <th>追加通过</th>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <!--2.2 表格中心内容区域-->
                <div class="t_r_content">
                    <table style="width: 300px;">
                        <tbody id="biRight">
                            #foreach($dtl in $!{fbsBudgetVO.dtlList})
                            <tr>
                                <td>${dtl.itemName}</td>
                                <td  style="text-align: right">$!number.formatNumeric($!{dtl.bMoney})</td>
                                <td  style="text-align: right">$!number.formatNumeric($!{dtl.bsuperMoney})</td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div id="sp-map" class="chart-wrapper" style="display: none;margin-left: 0px">
        </div>
        <div></div>
    </div>
</section>
<!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
<script src="${basePath}/static/mobile/plugins/zepto/zepto.min.js"></script>
<script src="${basePath}/static/js/mobile/date.js"></script>
<script src="${basePath}/static/js/mobile/money.js"></script>
<script src="${basePath}/static/js/iscroll-probe.min.js?_btv=${resourceVersion}" id="probe"></script>
<script src="${basePath}/static/mobile/plugins/fixedTable/table.min.js?_btv=${resourceVersion}" id="tableJS"></script>

<script>
    (function (doc, win) {

    })(document, window);

</script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fbsProcessRulePage.id}">
    <table class="layui-table">
        <tbody >
        <tr >
            <td class="textRight" width="40%">#springMessage('table.fbsProcessRule.processRule')</td>
            <td width="60%">
                $dictTag.get("plan.action.rule",$!{fbsProcessRulePage.processRule})
            </td>
        </tr>
        <tr >
            <td class="textRight">#springMessage('table.fbsProcessRule.sort')</td>
            <td>
                $!{fbsProcessRulePage.sort}
            </td>
        </tr>
        <tr #if($!{fbsProcessRulePage.processRule}=="5")style="display: none"#end>
            <td class="textRight">#springMessage('table.fbsBudgetProcessReport.ExerciseRatio')</td>
            <td>
                $!rateTag.show($!{fbsProcessRulePage.processRatio},2)
            </td>
        </tr>
        <tr >
            <td class="textRight">#springMessage('fcVoucherType.validSign')</td>
            <td>
                $dictTag.get("valid_sign",$!{fbsProcessRulePage.validSign})
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

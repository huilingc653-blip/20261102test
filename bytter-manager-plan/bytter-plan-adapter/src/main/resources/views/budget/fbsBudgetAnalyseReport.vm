<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form ignore-required-icon" method="post" id="inputForm">
        <input id="cdSign" name="cdSign" type="hidden" value="$!{fbsBudgetAnalyse.cdSign}">
        <table class="layui-table">
            <tbody>
            <tr>
				##周期类型
                <td class="textRight" width="40%"><font color="red">*</font></font>#springMessage('table.fbsBudget.timeType')</td>
                <td width="60%">
                    <div class="bt-biz-dict" data-type="select" data-value="$!{fbsBudgetAnalyse.timeType}" data-displayData="$!{itemTypes}"
                         data-group="fbs.timeType" data-name="timeType"></div>
                </td>
            </tr>
            <tr>
				##日期
                <td class="textRight" width="40%"><font color="red">*</font></font>#springMessage('table.fcOutSubjectDay.optDate')</td>
                <td width="60%">
                    <input type="text" name="queryDate" class="layui-input bt-input-inline bt-biz-dateType" value="$!{fbsBudgetAnalyse.queryDate}" data-biz-name="queryDate">
                </td>
            </tr>
            <tr>
                <td colspan="2" style="text-align: center;">
                    <button class="layui-btn" id="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
        #if($!{showFlag})
            <div>
        #else
            <div style="display: none">
        #end
            <table id="appTable" class="layui-table" style="width:100%;">
                <thead>
                <tr>
                    <th>#springMessage('table.fbsBudgetYear.number')</th>
                    <th>#springMessage('table.fbsBudget.corpId')</th>
                    <th>#springMessage('table.fbsBudget.enrolDate')</th>
                    <th>#springMessage('table.fbsBudgetProcess.curCode')</th>
                    #if($!{fbsBudgetAnalyse.cdSign}=="0")
                        <th>#springMessage('table.fbsBudget.planIncomeMoney')</th>
                        <th>#springMessage('table.fbsBudget.factIncomeMoney')</th>
                    #else
                        <th>#springMessage('table.fbsBudget.planPayMoney')</th>
                        <th>#springMessage('table.fbsBudget.factPayMoney')</th>
                    #end
                    <th>#springMessage('table.fbsBudget.diffMoney')</th>
                    <th>#springMessage('table.fbsBudget.diffRatio')</th>
                    #if($!{fbsBudgetAnalyse.cdSign}=="0")
                        <th>#springMessage('table.fbsBudget.processIncomeRatio')</th>
                    #else
                        <th>#springMessage('table.fbsBudget.processPayRatio')</th>
                    #end
                </tr>
                </thead>
                <tbody>
                    #foreach($date in $dltList)
                    <tr>
                        <td align="center">$!{velocityCount}</td>
                        <td>($!{date.corpCode})$!{date.corpName}</td>
                        <td align="center">$!{date.enrolDate}</td>
                        <td align="center">$!{date.curName}</td>
                        <td class="textRight">$!number.formatNumeric($!{date.planMoney})</td>
                        <td class="textRight">$!number.formatNumeric($!{date.factMoney})</td>
                        <td class="textRight">$!number.formatNumeric($!{date.diffMoney})</td>
                        <td class="textRight">$!number.formatNumeric($!{date.diffRatio})</td>
                        <td class="textRight">$!number.formatNumeric($!{date.processRatio})</td>
                    </tr>
                    #end
                </tbody>
            </table>
        </div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudget.analysereport.js?_btv=${resourceVersion}"></script>
</html>
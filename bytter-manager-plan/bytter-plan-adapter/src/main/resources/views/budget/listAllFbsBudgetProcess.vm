<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
    <input type="hidden"  name="opType" id="opType" value="S"/>
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('table.fbsBudgetProcess.corpId')</td>
            <td><div class="layui-inline">
                <div class="bt-biz-corp"
                     data-type="selectTree"
                     data-tree-type="check"
                     data-name="ins_corpId"
					 data-resource="fbs:processQuery:fbsBudgetProcess:query"
                     data-scope="all"></div>
            </div>
            </td>
        ##单据号
            <td class="textRight">#springMessage('table.fbsBudgetProcess.billNo')</td>
            <td >
                <input type="text" id="billNo" name="likes_billNo"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetProcess.billNo')">
            </td>
        ##执行日期
            <td class="textRight">#springMessage('table.fbsBudgetProcess.processDate')</td>
            <td >
                <input type="text" name="ged_processDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="t2">
                <span class="date-mid">~</span>
                <input type="text" name="led_processDate" class="layui-input bt-input-inline bt-biz-dateType" id="t2">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fbsBudgetProcess.itemName')</td>
            <td><input type="text" id="itemName" name="likes_itemName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetProcess.itemName')"></td>
            <td class="textRight">#springMessage('table.fbsBudgetProcess.status')</td>
            <td>
                <div class="layui-inline">
                    <select lay-filter="status" name="eqi_status" >
                        <option value=" ">#springMessage('common.placeholder.select')</option>
                        #foreach($dict in $dictTag.list("fbsBudgetProcess.status"))
                            <option value="$dict.code">$dict.name</option>
                        #end
                    </select>
                </div>
            </td>
            <td class="textRight">#springMessage('table.fbsBudgetProcess.processMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_processMoney" class="layui-input bt-biz-moneyType textRight"
                           data-moneyendid="leg_processMoney" autocomplete="off" placeholder="#springMessage('table.fbsBudgetProcess.processMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" id="leg_processMoney" data-name="leg_processMoney" class="layui-input bt-biz-moneyType textRight"
                           autocomplete="off" placeholder="#springMessage('table.fbsBudgetProcess.processMoney')">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fbsBudgetProcess.corpId')</th>
        <th>#springMessage('table.fbsBudgetProcess.itemCode')</th>
        <th>#springMessage('table.fbsBudgetProcess.itemName')</th>
        <th>#springMessage('table.nisBillhead.curId')</th>
        <th>#springMessage('table.fbsBudgetProcess.processMoney')</th>
        <th>#springMessage('table.fbsBudgetProcess.processDate')</th>
        <th>#springMessage('table.fbsBudgetProcess.billNo')</th>
        <th>#springMessage('table.fbsBudgetProcess.createDate')</th>
        <th>#springMessage('table.fbsBudgetProcess.status')</th>
        <th>#springMessage('table.fbsBudgetProcess.rmk')</th>
		<th>#springMessage('table.fbsBudgetProcess.businessName')</th>
		<th>#springMessage('table.fbsBudgetProcess.processSysname')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudgetProcess.listAll.js?_btv=${resourceVersion}"></script>
</html>

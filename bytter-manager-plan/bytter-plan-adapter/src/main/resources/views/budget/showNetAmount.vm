<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" class="ignore-required-icon" id="inputForm">
		<input id="id" name="id" type="hidden" value="$!{fbsBudgetPage.id}">
        <table class="layui-table">
            <tbody>
            <tr>
				##单位
                <td class="textRight">#springMessage('table.fbsBudget.corpId')</td>
                <td>$!{fbsBudgetPage.corpName}</td>
				##周期类型
                <td class="textRight">#springMessage('table.fbsBudget.timeType')</td>
                <td>$dictTag.get("fbs.timeType",$!{fbsBudgetPage.timeType})</td>
            </tr>
            <tr>
				##开始日期
                <td class="textRight">#springMessage('table.fbsBudget.beginDate')</td>
                <td>$!date.format('yyyy-MM-dd',$!{fbsBudgetPage.beginDate})</td>
				##结束日期
                <td class="textRight">#springMessage('table.fbsBudget.endDate')</td>
                <td>$!date.format('yyyy-MM-dd',$!{fbsBudgetPage.endDate})</td>
            </tr>
            </tbody>
        </table>
        <table id="curTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th width="20%">#springMessage('table.fbsBudget.corpId')</th>
				<th width="10%">#springMessage('table.fbsBudget.status')</th>
				#if($!{showNetAmount} == "1")
					#if($!{fbsBudgetPage.timeType} == "3")
						<td width="15%">#springMessage('table.fbsBudget.yearNetAmount')</td>
						<td width="15%">#springMessage('table.fbsBudget.monthProcessNetAmount')</td>
					#else
                        <td width="15%">#springMessage('table.fbsBudget.monthNetAmount')</td>
                        <td width="15%">#springMessage('table.fbsBudget.weekProcessNetAmount')</td>
					#end
				#end
            </tr>
            </thead>
        	<tbody>
            	#foreach($date in $childCorpData)
            		<tr>
            			<td>
							(${date.corpCode})&nbsp;&nbsp;${date.corpName}
							<input id="childId_${date.id}" name="childId" type="hidden" value="$!{date.id}">
							<input id="childCorpId_${date.id}" name="childCorpId" type="hidden" value="$!{date.corpId}">
						</td>
        				<td align="center">
        					#if($!{date.status} == "-2")
                                <font color="red">$dictTag.get("fbsBudget.status",$!{date.status})</font>
        					#else
        						$dictTag.get("fbsBudget.status",$!{date.status})
        					#end
        				</td>
						#if($!{showNetAmount} == "1")
                            <td class="textRight">$!number.formatNumeric($!{date.netAmount})</td>
                            <td class="textRight">$!number.formatNumeric($!{date.processNetAmount})</td>
						#end
            		</tr>
				#end
            </tbody>
        </table>	
	</form>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form', 'layedit', 'btdate', 'moneyType', 'date'], function () {
        var $ = bt.jquery, form = bt.form();
    });
</script>
</html>
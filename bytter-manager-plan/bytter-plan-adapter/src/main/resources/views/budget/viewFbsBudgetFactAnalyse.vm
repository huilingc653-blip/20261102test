<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
    <ul class="layui-tab-title">
        <li class="layui-this">#springMessage('table.fbsBudget.plandtl')</li>
        <li>#springMessage('table.fbsBudget.factdtl')</li>
    </ul>
	<div class="layui-tab-content">
		<div class="layui-tab-item layui-show">
    		<table id="curTable" class="layui-table layui-form treeTable" style="width:100%;" expandable="true">
                <thead>
                <tr>
                    <th>#springMessage('table.fbsBudgetYear.itemCode')</th>
                    <th>#springMessage('table.fbsBudgetYear.itemName')</th>
                    <th>#springMessage('table.fbsBudget.cdSign')</th>
                    <th>#springMessage('table.fbsBudgetDetail.curId')</th>
                    <th>#springMessage('table.fbsBudgetDetail.vestingDate')</th>
                    <th>#springMessage('table.fbsBudget.planMoney')</th>
                    <th>#springMessage('table.fbsBudgetDetail.natualMoney')</th>
                    <th>#springMessage('table.nisAllocationReport.oppCorpName')</th>
                    <th>#springMessage('table.bisAccDtl.summary')</th>
                </tr>
                </thead>
            	<tbody>
                	#foreach($data in $planData)
                		<tr>
                			<td>${data.itemCode}</td>
                			<td>$!{data.itemName}</td>
                            <td align="center">$dictTag.get("fbsItem.cdSign",$!{data.item.sign})</td>
            				<td style="text-align:center">$!{data.curName}</td>
                            <td style="text-align:center">$!date.format('yyyy-MM-dd',$!{data.vestingDate})</td>
                            <td class="textRight">$!number.formatNumeric($!{data.bMoney})</td>
                            <td class="textRight">$!number.formatNumeric($!{data.natualMoney})</td>
                            <td>$!{data.payeeAccName}</td>
							<td>$!{data.purpose}</td>
                		</tr>
                	#end
                <tr>
                    <td class="textRight" colspan="5">#springMessage('table.datatable.total')</td>
                    <td class="textRight">$!number.formatNumeric($!{planTotal})</td>
                    <td class="textRight">$!number.formatNumeric($!{planNatualTotal})</td>
                    <td colspan="2"></td>
                </tr>
                </tbody>
            </table>
    	</div>
        <div class="layui-tab-item">
    		<table id="nextTable" class="layui-table layui-form treeTable" style="width:100%;">
                <thead>
                <tr>
                    <th>#springMessage('table.fbsBudgetYear.itemCode')</th>
                    <th>#springMessage('table.fbsBudgetYear.itemName')</th>
                    <th>#springMessage('table.fbsBudget.cdSign')</th>
                    <th>#springMessage('table.fbsBudgetDetail.curId')</th>
                    <th>#springMessage('table.btNetChalk.transTime')</th>
                    <th>#springMessage('table.bisAccDtl.amt')</th>
                    <th>#springMessage('table.fbsBudgetDetail.natualMoney')</th>
                    <th>#springMessage('table.nisAllocationReport.oppCorpName')</th>
                    <th>#springMessage('table.bisAccDtl.summary')</th>
                </tr>
                </thead>
            	<tbody>
					#foreach($data in $factData)
                        <tr>
                            <td>${data.itemCode}</td>
                            <td>$!{data.itemName}</td>
                            <td align="center">$dictTag.get("fbsItem.cdSign",$!{data.item.sign})</td>
                            <td style="text-align:center">$!{data.curName}</td>
                            <td style="text-align:center">$!date.format('yyyy-MM-dd',$!{data.processDate})</td>
                            <td class="textRight">$!number.formatNumeric($!{data.processMoney})</td>
                            <td class="textRight">$!number.formatNumeric($!{data.processNatualMoney})</td>
                            <td>$!{data.payeeAccName}</td>
                            <td>$!{data.purpose}</td>
                        </tr>
					#end
                    <tr>
                        <td class="textRight" colspan="5">#springMessage('table.datatable.total')</td>
                        <td class="textRight">$!number.formatNumeric($!{factTotal})</td>
                        <td class="textRight">$!number.formatNumeric($!{factNatualPayTotal})</td>
                        <td colspan="2"></td>
                    </tr>
                </tbody>
            </table>
    	</div>
	</div>
</div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudget.factview.js?_btv=${resourceVersion}"></script>
</html>

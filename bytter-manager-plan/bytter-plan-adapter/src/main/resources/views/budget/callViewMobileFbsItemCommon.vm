#if($voList)
<li class="mui-table-view-cell">
    #springMessage('table.fbsbudgetprocess.title')
</li>
#end
#foreach($vo in $voList)
<li class="mui-table-view-cell  mui-collapse keep-unfold">
    <a class="mui-navigate-right" href="#">
        #springMessage('table.fbsBudgetProcess.itemName')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.itemName}
        </span>
    </a>
    <ul class="mui-table-view H-theme-background-color-white">
        <li class="mui-table-view-cell">
            #springMessage('table.fbsBudgetProcess.itemBalance')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{vo.itemMoney})
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.fbsBudgetProcess.superItemBalance')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{vo.superItemMoney})
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.fbsBudgetProcess.topItemBalance')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{vo.topItemMoney})
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.fbsBudgetProcess.processMoney')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{vo.processMoney})
            </span>
        </li>
    </ul>
</li>
#end
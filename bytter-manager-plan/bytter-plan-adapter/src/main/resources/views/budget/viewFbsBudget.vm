<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body class="full-body">
<input id="id" name="id" type="hidden" value="$!{fbsBudgetPage.id}">
<input id="superaddId" name="superaddId" type="hidden" value="$!{fbsBudgetPage.superaddId}">
<input id="busName" name="busName" type="hidden" value="$!{busName}">
<input id="target" name="target" type="hidden" value="$!{target}">
<input id="timeType" name="timeType" type="hidden" value="$!{fbsBudgetPage.timeType}">
<div id="print">
    <form id="searchForm" class="layui-form">
        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title"></h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table">
                        <tbody>
                        <tr>
                        ##单位
                            <td class="textRight">#springMessage('table.fbsBudget.corpId')</td>
                            <td>$!{fbsBudgetPage.corpName}</td>
                        ##周期类型
                            <td class="textRight">#springMessage('table.fbsBudget.timeType')</td>
                            <td>$dictTag.get("fbs.timeType",$!{fbsBudgetPage.timeType})</td>
                        </tr>
                        <tr>
                        ##开始日期
                            <td class="textRight">#springMessage('table.fbsBudget.beginDate')</td>
                            <td>$!date.format('yyyy-MM-dd',$!{fbsBudgetPage.beginDate})</td>
                        ##结束日期
                            <td class="textRight">#springMessage('table.fbsBudget.endDate')</td>
                            <td>$!date.format('yyyy-MM-dd',$!{fbsBudgetPage.endDate})</td>
                        </tr>
                        <tr>
                        ##币种
                            <td class="textRight">#springMessage('table.fbsBudgetDetail.curId')</td>
                            <td>$!{currencyTag.getCurName($!{fbsBudgetPage.curId})}</td>
                        ##科目显示级别
                            <td class="textRight"><div class="noprint">#springMessage('fbs.item.level.show')</div></td>
                            <td>
                                <div class="noprint">
                                    <div class="bt-biz-dict" data-type="select" data-group="fbs.item.level"
                                         data-defaultvalue="$!{level}" data-name="level" data-biz-name="level"
                                         data-callback="chooseLevel"></div>
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>
    <div style="display:inline-block;width:100%;">
        <div id="maingrid1" data-biz-name="chooseLevel"></div>
    </div>
    <div style="width: 100%;overflow-x: scroll;margin-bottom: 10px;display: none;">
        <table id="appTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.fbsBudgetYear.number')</th>
                <th>#springMessage('table.fbsBudgetYear.itemCode')</th>
                <th>#springMessage('table.fbsBudgetYear.itemName')</th>
                <th>#springMessage('table.fbsBudgetYear.bMoney')</th>
                <th>#springMessage('table.fbsBudgetYear.bsuperMoney')(#springMessage('table.fbsBudgetYear.pass'))</th>
                <th>#springMessage('table.fbsBudgetYear.bMoneySum')</th>
                <th>#springMessage('table.fbsBudgetYear.btempMoney')(#springMessage('table.fbsBudgetYear.notPass'))</th>
                <th>#springMessage('table.fbsBudgetPeriod.rmk')</th>
                <th>#springMessage('table.fbsBudgetYear.dtl')</th>
            </tr>
            </thead>
            <tbody>
                #foreach($date in $dltList)
                <tr data-tt-id="$!{date.itemCode}" data-tt-parent-id="$!{date.item.superItemCode}"
                    data-tt-subject-sort="$!{date.itemCode}">
                    <td>$!{velocityCount}</td>
                    <td data-name="itemCode">$!{date.itemCode}</td>
                    <td data-name="itemName">$!{date.itemName}</td>
                    <td align="right" data-name="bMoney">
                        $!number.formatNumeric($!{date.bMoney})
                    </td>
                    <td align="right" data-name="bsuperMoney">$!number.formatNumeric($!{date.bsuperMoney})</td>
                    <td align="right" data-name="bMoneySum">$!number.formatNumeric($!{date.bMoneySum})</td>
                    <td align="right" data-name="btempMoney">$!number.formatNumeric($!{date.btempMoney})</td>
                    <td data-name="rmk">$!{date.rmk}</td>
                    <td data-name="dtl" align="center">
                        #if($!{date.item.isWrite} == "1"  && $!{date.item.isBeginPeriod} !=
                            "1" && $!{date.item.isEndPeriod} != "1")
                            #if($!{target} == "super")
                                <a class="" href="#"
                                   onclick="viewDtl('$!{fbsBudgetPage.superaddId}','$!{date.id}','$!{target}')">#springMessage(
                                    'common.button.dtl.view')</a>
                            #else
                                <a class="" href="#"
                                   onclick="viewDtl('$!{fbsBudgetPage.id}','$!{date.id}','$!{target}')">#springMessage(
                                    'common.button.dtl.view')</a>
                            #end
                        #end
                    </td>
                </tr>
                #end
            </tbody>
        </table>
    </div>
</div>
<!-- 附件上传 -->
<input id="attachmentId" name="attachmentId" type="hidden" value="$!{fbsBudgetPage.attachmentId}">
<div id="uploader" class="layui-input-inline" style="width:100%"></div>
<!-- 日志 -->
<div id="tagMsg"></div>
<p>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div class="layui-input-block">
        #if($!{target} == "super")
            <button type="button" class="layui-btn"
                    onclick="bt.trackFlowByBusinessId('$!{fbsBudgetPage.superaddId}')">#springMessage(
                'common.button.trackFlow')</button>
        #else
            <button type="button" class="layui-btn"
                    onclick="bt.trackFlowByBusinessId('$!{fbsBudgetPage.id}')">#springMessage(
                'common.button.trackFlow')</button>
        #end
        <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage(
            'common.button.print')</button>
        <button type="button" class="layui-btn" onclick="exports()">#springMessage('common.button.exports')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    var dicts, tree;
    bt.use(['form', 'layedit', 'toLigerTree', 'btUpload', 'printType', 'dicts'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.printType.init();
        dicts = bt.dicts.init();
        tree = bt.toLigerTree.init2({
            elem: '#appTable',
            newElem: '#maingrid1',
            rownumbers: true,//序号列数，默为无， 1代表左边第一列为序号列
            isDoubleHeader: false,//是否有双表头
            allowHideColumn: true,
            resize: false,
            height: "70%",
            fixedLeftColumns: 0,
            columnName:'itemCode',
            onAfterShowData:function(currentData){
                var level = dicts.get('level').val();
                for(var i=0;i<currentData.Rows.length;i++){
                    var row=currentData.Rows[i];
                    if(row.children && row.children.length>0){
                        if(level == 0 || level == ""){

                        }else if(level == 1){
                            this.collapse(row);
                            collapseChild(row.children,this);
                        }else if(level == 2 || level == 3){
                            var row2 = row.children;
                            for(var j = 0,len2 = row2.length;j< len2;j++){
                                if(row2[j].children && row2[j].children.length){
                                    if(level == 2){
                                        this.collapse(row2[j]);
                                        collapseChild(row2[j].children,this);
                                    }else if(level == 3){
                                        var row3 = row2[j].children;
                                        for(var k = 0,len3 = row3.length;k< len3;k++){
                                            if(row3[k].children && row3[k].children.length){
                                                this.collapse(row3[k]);
                                                collapseChild(row3[k].children,this);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        });
        function collapseChild(node,treeObj){
            for(var j = 0,len2 = node.length;j< len2;j++){
                if(node[j].children && node[j].children.length){
                    treeObj.collapse(node[j]);
                    var child = node[j].children;
                    collapseChild(node[j].children,treeObj);
                }
            }
        }
        var up = bt.btUpload.init({
            elem: "#uploader",
            auto: false,
            hasDelete: false,
            hasUpload: false,
            isExpand: true,
            gid: $("#attachmentId").val()
        });

        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml= function () {
            var url = basePath + "/budget/fbsmessage/list/" + $('#id').val() + "/" + $("#busName").val() + "?timestamp=" + new Date().getTime();
            if ($("#target").val() == "super") {
                url = basePath + "/budget/fbsmessage/list/" + $('#superaddId').val() + "/" + $("#busName").val() + "?timestamp=" + new Date().getTime();
            }
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                    form.render();
                }
            });
        }
            $genMsgHtml();

        /**
         * 导出
         */
        exports = function () {
            var url = basePath + "/budget/fbsBudgetDownloadAndImport/exportBudget?id=" + $('#id').val() + "&timeType=" + $("#timeType").val() + "&target=" + $("#target").val();
            window.location.href = url;
        };

        /**
         * 查看明细
         * @param id
         * @param detailId
         * @param target
         */
        viewDtl = function (id, detailId, target) {
            var action = "/budget/fbsbudgetdetail/view?budgetId=" + id + "&detailId=" + detailId;
            if (target == "super") {
                action = "/budget/fbsbudgetdetail/view?superaddId=" + id + "&detailId=" + detailId;
            }
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + action);
                return;
            }
            parent.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: basePath + action
            });
        };
    });
    var data;
    chooseLevel = function () {
        var level = dicts.get('level').val();
        if(data == null) {
            data = tree.get('chooseLevel').getData();//获取数据的方法；
        }
        tree.get('chooseLevel').loadData();
    }
</script>
#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<!-- 系统参数 -->
<input id="id" name="id" type="hidden" value="$!{fbsBudgetProcessPage.id}">
<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetProcess.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{fbsBudgetProcessPage.corpName}
        </span>
    </li>
	<li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetProcess.itemCode')
        <span class="mui-badge mui-badge-inverted">
			$!{fbsBudgetProcessPage.itemCode}
        </span>
    </li>
	<li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetProcess.itemName')
        <span class="mui-badge mui-badge-inverted">
			$!{fbsBudgetProcessPage.itemName}
        </span>
    </li>
	<li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetProcess.processMoney')
        <span class="mui-badge mui-badge-inverted">
			$!number.formatNumeric($!{fbsBudgetProcessPage.processMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetProcess.processDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fbsBudgetProcessPage.processDate})
        </span>
    </li>
	<li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetProcess.billNo')
        <span class="mui-badge mui-badge-inverted">
			$!{fbsBudgetProcessPage.billNo}
        </span>
    </li>
	<li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetProcess.createDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fbsBudgetProcessPage.createDate})
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tbody>
			<tr>
	       		##原始货币名称
				<td class="textRight">#springMessage('table.fbsExcrateAdjust.curName')</td>
				<td width="35%">($!{fbsExcrateAdjustPage.curCode})$!{fbsExcrateAdjustPage.curName}</td>
				##原始货币英文简码
				<td class="textRight">#springMessage('table.fbsExcrateAdjust.englishCode')</td>
				<td width="35%">$!{fbsExcrateAdjustPage.englishCode}</td>
       		</tr>
       		<tr>
				##目标货币名称
				<td class="textRight">#springMessage('table.fbsExcrateAdjust.referCurName')</td>
				<td width="35%">($!{fbsExcrateAdjustPage.referCurCode})$!{fbsExcrateAdjustPage.referCurName}</td>
				##目标货币英文简码
				<td class="textRight">#springMessage('table.fbsExcrateAdjust.referEnglishCode')</td>
				<td width="35%">$!{fbsExcrateAdjustPage.referEnglishCode}</td>
       		</tr>
       		<tr>
	       		##计划汇率
				<td class="textRight">#springMessage('table.fbsExcrateAdjust.exchangeRate')</td>
				<td width="35%">$!number.formatDoubles($!{fbsExcrateAdjustPage.exchangeRate},4)</td>

				##示例说明
				<td class="textRight">#springMessage('table.fbsExcrateAdjust.preTime')</td>
				<td width="35%">$!date.format('yyyy-MM-dd HH:mm:ss',$!fbsExcrateAdjustPage.preTime)</td>
       		</tr>
            <tr>
			##示例说明
                <td class="textRight">#springMessage('table.fbsExcrateAdjust.example')</td>
                <td colspan="3">$!{fbsExcrateAdjustPage.example}</td>
            </tr>
            <tr>
			##备注
                <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
                <td colspan="3">$!{fbsExcrateAdjustPage.rmk}</td>
            </tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form','moneyType'], function(){
        var moneyObj = bt.moneyType.init();
    });
</script>
</html>
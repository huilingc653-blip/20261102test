#set($basePath=$springMacroRequestContext.contextPath)
<input id="myId" name="myId" type="hidden" value="$!{fbsBudgetProjectDetailVO.id}">
<input id="myCorpId" name="myCorpId" type="hidden" value="$!{fbsBudgetProjectDetailVO.corpId}">
<input id="myProcessDate" name="myProcessDate" type="hidden" value="$!date.format('yyyy-MM-dd',$!{fbsBudgetProjectDetailVO.processDate})">
<input id="myItemCode" name="myItemCode" type="hidden" value="$!{fbsBudgetProjectDetailVO.itemCode}">
<input id="defItemCode" name="defItemCode" type="hidden" value="$!{fbsBudgetProjectDetailVO.defItemCode}">
<input id="myBillNo" name="myBillNo" type="hidden" value="$!{fbsBudgetProjectDetailVO.billNo}">
<input id="myBillId" name="myBillId" type="hidden" value="$!{fbsBudgetProjectDetailVO.billId}">
<input id="businessName" name="businessName" type="hidden" value="$!{fbsBudgetProjectDetailVO.businessName}">
<input id="processSysname" name="processSysname" type="hidden" value="$!{fbsBudgetProjectDetailVO.processSysname}">
<!-- 科目明细参数 -->
<input id="myDetailControl" name="myDetailControl" type="hidden" value="$!{fbsBudgetProjectDetailVO.detailControl}">
<input id="myDtlColSel" name="myDtlColSel" type="hidden" value="$!{configTag.getConfig('fbs','dtlColSel')}">
<input id="myCurId" name="myCurId" type="hidden" value="$!{fbsBudgetProjectDetailVO.curId}">
<input id="mySettlType" name="mySettlType" type="hidden" value="$!{fbsBudgetProjectDetailVO.settlType}">
<input id="myCorpName" name="myCorpName" type="hidden" value="$!{fbsBudgetProjectDetailVO.corpName}">
<input id="myPurpose" name="myPurpose" type="hidden" value="$!{fbsBudgetProjectDetailVO.purpose}">
<input id="myWishPayday" name="myWishPayday" type="hidden" value="$!date.format('yyyy-MM-dd',$!{fbsBudgetProjectDetailVO.wishPayday})">
<input id="myPayerAcc" name="myPayerAcc" type="hidden" value="$!{fbsBudgetProjectDetailVO.payerAcc}">
<input id="myPayeeAccName" name="myPayeeAccName" type="hidden" value="$!{fbsBudgetProjectDetailVO.payeeAccName}">
<input id="myPayeeAcc" name="myPayeeAcc" type="hidden" value="$!{fbsBudgetProjectDetailVO.payeeAcc}">
<input id="myPayeeBank" name="myPayeeBank" type="hidden" value="$!{fbsBudgetProjectDetailVO.payeeBank}">
<input id="myContract" name="myContract" type="hidden" value="$!{fbsBudgetProjectDetailVO.contract}">
<input id="isRMB" name="isRMB" type="hidden" value="$!{isRMB}">
<link rel="stylesheet" href="${basePath}/static/css/gridsystem.css"  media="all" />
<style>
    .budgetX2{
        word-break: keep-all!important;
        white-space: nowrap!important;
        text-overflow: ellipsis!important;
        overflow: hidden!important;
    }
    #budgetProcessDataTable .grid-title {
        background-color:#f2f2f2;
    }
    .dark-skin #budgetProcessDataTable .grid-title {
        background-color:#1B1C20;
        border: none;
    }
    .dark-skin .line_head_border, .dark-skin .line_border {
        border: 1px solid #2E2F34;
    }
    .dark-skin .line_head_border > div {
        background-color: #262936;
        border-right:1px solid #2E2F34;
    }
    .dark-skin .line_border > div {
        border-right:1px solid #2E2F34;
    }
</style>
<div class="layui-table" style="width:100%;" id="budgetProcessDataTable">
    <div class="line line_border grid-title">
        <div class="x2 border0"></div>
        <div class="x2 border0"></div>
        <div class="x2 border0"></div>
        <div class="x2 border0"></div>
        <div class="x2 border0"></div>
        <div class="x2 border0">
            <input type="text" data-name="sumMoney" data-biz-name="sumMoney"
                   class="layui-input bt-biz-moneyType" autocomplete="off" readonly="readonly" placeholder="#springMessage('table.fbsBudgetProcess.sumMoney')">
        </div>
    </div>
    <div class="line " >
        <div class="x10 line line_head_border">
            <div class="x2">#springMessage('table.fbsBudgetProcess.itemCode')</div>
            <div class="x2 budgetX2" title="#springMessage('table.fbsBudgetProcess.itemBalance')（$!{currencyTag.getCurName($!{fbsBudget.curId})}）">#springMessage('table.fbsBudgetProcess.itemBalance')（$!{currencyTag.getCurName($!{fbsBudget.curId})}）</div>
            <div class="x2">#springMessage('table.fbsBudgetProcess.superItemBalance')</div>
            <div class="x2">#springMessage('table.fbsBudgetProcess.topItemBalance')</div>
            <div class="x2 budgetX2" title="#springMessage('table.fbsBudgetProcess.processMoney')（$!{currencyTag.getCurName($!{fbsBudgetProjectDetailVO.curId})}）">
                #springMessage('table.fbsBudgetProcess.processMoney')（$!{currencyTag.getCurName($!{fbsBudgetProjectDetailVO.curId})}）
            </div>
            <div class="x2 budgetX2" title="$!{currencyTag.getCurName($!{fbsBudgetProjectDetailVO.curId})}#springMessage('table.fbsBudgetProcess.exchange')$!{currencyTag.getCurName($!{fbsBudget.curId})}#springMessage('table.btCurrency.curExrate')">
                $!{currencyTag.getCurName($!{fbsBudgetProjectDetailVO.curId})}#springMessage('table.fbsBudgetProcess.exchange')$!{currencyTag.getCurName($!{fbsBudget.curId})}#springMessage('table.btCurrency.curExrate')
            </div>
        </div>
        <div class="x2 line line_head_border" style="border-left: none!important;">
            <div class="x6 textRight budgetX2" title="#springMessage('table.fbsBudgetProcess.processMoney')（#springMessage('table.fbsBudgetProcess.convert')$!{currencyTag.getCurName($!{fbsBudget.curId})}）" style="border-left: none!important;">
                #springMessage('table.fbsBudgetProcess.processMoney')（#springMessage('table.fbsBudgetProcess.convert')$!{currencyTag.getCurName($!{fbsBudget.curId})}）
            </div>
            <div class="x6">#springMessage('table.fbsBudgetProcess.status')</div>
        </div>
    </div>
    #foreach($date in $listProcess)
        #set($row = $!{velocityCount} - 1)
        <div class="line" row="$row">
            <div class="x10 line line_border">
                <div class="x2 textLeft budgetX2" title="($!{date.itemCode})&nbsp;$!{date.itemName}">
                    ($!{date.itemCode})&nbsp;$!{date.itemName}
                    <input type="hidden" id="initItemCode$row" name="initItemCode" value="$!{date.itemCode}"/>
                </div>
                <div class="x2 textRight">
                    $!number.formatNumeric($!{date.itemMoney})
                </div>
                <div class="x2 textRight">
                    $!number.formatNumeric($!{date.superItemMoney})
                </div>
                <div class="x2 textRight">
                    $!number.formatNumeric($!{date.topItemMoney})
                </div>
                <div class="x2 textRight">
                    $!number.formatNumeric($!{date.processMoney})
                    <input type="hidden" id="processMoney$row" data-name="processMoney"
                           data-biz-name="processMoney$row" iptRow="$row" class="layui-input bt-biz-moneyType" value="$!{date.processMoney}"/>
                </div>
                <div class="x2 textRight" >
                    $!excRateTag.getBuget($!{date.exchangeRate})
                </div>
            </div>
            <div class="x2 line line_border" style="border-left: none!important;">
                <div class="x6 center" style="border-left: none;!important;">
                    $!number.formatNumeric($!{date.processCurMoney})
                </div>
                <div class="x6 center">
                    $dictTag.get("fbsBudgetProcess.status",$!{status})
                </div>
            </div>
        </div>
        #if($!{fbsBudgetProjectDetailVO.detailControl} && $dtlColSel)
            <div class="table_grid" id="projectDetail$row" style="display: none"></div>
        #end
    #end
</div>
<script src="${basePath}/static/modules/budget/callViewFbsItem.common.js?_btv=${resourceVersion}"></script>

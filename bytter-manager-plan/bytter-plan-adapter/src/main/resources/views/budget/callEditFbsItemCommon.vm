#set($basePath=$springMacroRequestContext.contextPath)
<input id="myId" name="myId" type="hidden" value="$!{fbsBudgetProjectDetailVO.id}">
<input id="myCorpId" name="myCorpId" type="hidden" value="$!{fbsBudgetProjectDetailVO.corpId}">
<input id="myProcessDate" name="myProcessDate" type="hidden" value="$!date.format('yyyy-MM-dd',$!{fbsBudgetProjectDetailVO.processDate})">
<input id="myItemCode" name="myItemCode" type="hidden" value="$!{fbsBudgetProjectDetailVO.itemCode}">
<input id="myBillNo" name="myBillNo" type="hidden" value="$!{fbsBudgetProjectDetailVO.billNo}">
<input id="myBillId" name="myBillId" type="hidden" value="$!{fbsBudgetProjectDetailVO.billId}">
<input id="myBusinessName" name="myBusinessName" type="hidden" value="$!{fbsBudgetProjectDetailVO.businessName}">
<input id="myProcessSysname" name="myProcessSysname" type="hidden" value="$!{fbsBudgetProjectDetailVO.processSysname}">
<input id="fbsItemBalance" name="fbsItemBalance" type="hidden" value="$!{fbsBudgetProjectDetailVO.fbsItemBalance}">
<input id="myDefItemCode" name="myDefItemCode" type="hidden" value="$!{fbsBudgetProjectDetailVO.defItemCode}">
<input id="myControlBudget" name="myControlBudget" type="hidden" value="$!{fbsBudgetProjectDetailVO.controlBudget}">
<input id="isMultiItem" name="isMultiItem" type="hidden" value="$!{fbsBudgetProjectDetailVO.isMultiItem}">

<!-- 科目明细参数 -->
<input id="myDetailControl" name="myDetailControl" type="hidden" value="$!{fbsBudgetProjectDetailVO.detailControl}">
<input id="myDtlColSel" name="myDtlColSel" type="hidden" value="$!{configTag.getConfig('fbs','dtlColSel')}">
<input id="myCurId" name="myCurId" type="hidden" value="$!{fbsBudgetProjectDetailVO.curId}">
<input id="mySettlType" name="mySettlType" type="hidden" value="$!{fbsBudgetProjectDetailVO.settlType}">
<input id="myCorpName" name="myCorpName" type="hidden" value="$!{fbsBudgetProjectDetailVO.corpName}">
<input id="myPurpose" name="myPurpose" type="hidden" value="$!{fbsBudgetProjectDetailVO.purpose}">
<input id="myWishPayday" name="myWishPayday" type="hidden" value="$!date.format('yyyy-MM-dd',$!{fbsBudgetProjectDetailVO.wishPayday})">
<input id="myPayerAcc" name="myPayerAcc" type="hidden" value="$!{fbsBudgetProjectDetailVO.payerAcc}">
<input id="myPayeeAccName" name="myPayeeAccName" type="hidden" value="$!{fbsBudgetProjectDetailVO.payeeAccName}">
<input id="myPayeeAcc" name="myPayeeAcc" type="hidden" value="$!{fbsBudgetProjectDetailVO.payeeAcc}">
<input id="myPayeeBank" name="myPayeeBank" type="hidden" value="$!{fbsBudgetProjectDetailVO.payeeBank}">
<input id="myContract" name="myContract" type="hidden" value="$!{fbsBudgetProjectDetailVO.contract}">
<input id="isRMB" name="isRMB" type="hidden" value="$!{isRMB}">

<link rel="stylesheet" href="${basePath}/static/css/gridsystem.css"  media="all" />
<style>
    .budgetX2{
        word-break: keep-all!important;
        white-space: nowrap!important;
        text-overflow: ellipsis!important;
        overflow: hidden!important;
    }
    #budgetProcessDataTable .grid-title {
        background-color:#f2f2f2;
    }
    .dark-skin #budgetProcessDataTable .grid-title {
        background-color:#1B1C20;
        border: none;
    }
    .dark-skin .line_head_border, .dark-skin .line_border {
        border: 1px solid #2E2F34;
    }
    .dark-skin .line_head_border > div {
        background-color: #262936;
        border-right:1px solid #2E2F34;
    }
    .dark-skin .line_border > div {
        border-right:1px solid #2E2F34;
    }
    #budgetProcessDataTable .line_border > div {
        height: auto;
        min-height: 38px;
    }
    #budgetProcessDataTable .line_border > div .bt-selectTree-close {
        top: 50%;
        transform: translateY(-50%);
    }
</style>

<div class="layui-table" style="width:100%;" id="budgetProcessDataTable">
    <div class="line" #if($!{fbsBudgetProjectDetailVO.isMultiItem} == "0")
         style="margin-bottom: 5px;margin-top: 5px; display: none"
    #else
         style="margin-bottom: 5px;margin-top: 5px;"
    #end>
        <div class="x2">
            <button class="layui-btn" type="button" onclick="add()">#springMessage('common.addTr')</button>
        </div>
    </div>
    <div class="line line_border grid-title">
        <div class="x2 border0"></div>
        <div class="x2 border0"></div>
        <div class="x2 border0"></div>
        <div class="x2 border0"></div>
        <div class="x2 border0"></div>
        <div class="x2">
            <input type="text" data-name="sumMoney" data-biz-name="sumMoney" data-minus="true"
                   class="layui-input bt-biz-moneyType" autocomplete="off" readonly="readonly" placeholder="#springMessage('总金额')">
        </div>
    </div>
    <div class="line line_head_border" >
        <div class="x10 line line_head_border">
            <div class="x2"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fbsBudgetProcess.itemCode')</div>
            <div class="x2 budgetX2" title="#springMessage('table.fbsBudgetProcess.itemBalance')（$!{currencyTag.getCurName($!{fbsBudget.curId})}）">#springMessage('table.fbsBudgetProcess.itemBalance')（$!{currencyTag.getCurName($!{fbsBudget.curId})}）</div>
            <div class="x2">#springMessage('table.fbsBudgetProcess.superItemBalance')</div>
            <div class="x2">#springMessage('table.fbsBudgetProcess.topItemBalance')</div>
            <div class="x2 budgetX2" title="#springMessage('table.fbsBudgetProcess.processMoney')（$!{currencyTag.getCurName($!{fbsBudgetProjectDetailVO.curId})}）"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fbsBudgetProcess.processMoney')（$!{currencyTag.getCurName($!{fbsBudgetProjectDetailVO.curId})}）</div>
            <div class="x2 budgetX2" title="$!{currencyTag.getCurName($!{fbsBudgetProjectDetailVO.curId})}#springMessage('table.fbsBudgetProcess.exchange')$!{currencyTag.getCurName($!{fbsBudget.curId})}#springMessage('table.btCurrency.curExrate')">$!{currencyTag.getCurName($!{fbsBudgetProjectDetailVO.curId})}#springMessage('table.fbsBudgetProcess.exchange')$!{currencyTag.getCurName($!{fbsBudget.curId})}#springMessage('table.btCurrency.curExrate')</div>
        </div>
        <div class="x2 line line_head_border">
            <div class="x6 textRight budgetX2" title="#springMessage('table.fbsBudgetProcess.processMoney')（#springMessage('table.fbsBudgetProcess.convert')$!{currencyTag.getCurName($!{fbsBudget.curId})}）">#springMessage('table.fbsBudgetProcess.processMoney')（#springMessage('table.fbsBudgetProcess.convert')$!{currencyTag.getCurName($!{fbsBudget.curId})}）</div>
            <div class="x6">#springMessage('common.table.thead.operation')</div>
        </div>
    </div>
    #foreach($date in $listProcess)
        #set($row = $!{velocityCount} - 1)
        <div class="line" row="$row">
            <div class="x10 line line_border">
                <div class="x2">
                    <div class="bt-biz-itemType"
                         data-type="selectTree"
                         id="itemCode"
                         data-name="itemCode"
                         data-biz-name="itemCode$row"
                         data-corpId="$!{fbsBudgetProjectDetailVO.corpId}"
                         data-itemCode="$!{fbsBudgetProjectDetailVO.itemCode}"
                         data-processDate="$!{fbsBudgetProjectDetailVO.wishPaydayStr}"
                         data-tree-type="radio"
                         data-defaultvalue="$!{date.itemCode}"
                         data-initComplete="initItemComplete"
                         data-callbackData="itemChange"
                         data-scope="" data-required="true"></div>
                    <input type="hidden" id="itemName$row" name="itemName" autocomplete="off" class="layui-input"/>
                    <input type="hidden" id="initItemCode$row" name="initItemCode" value="$!{date.itemCode}"/>
                    <input type="hidden" id="processRule$row" name="processRule" autocomplete="off" class="layui-input" value="$!{date.processRule}"/>
                </div>
                <div class="x2">
                    <input type="text" id="itemBalance$row" name="itemBalance" data-biz-name="itemBalance$row" readonly="readonly" data-minus="true"
                           class="layui-input bt-biz-moneyType" value="$!{date.itemMoney}"/>
                </div>
                <div class="x2">
                    <input type="text" id="superItemBalance$row" name="superItemBalance" data-biz-name="superItemBalance$row" data-minus="true"
                           readonly="readonly" class="layui-input bt-biz-moneyType" value="$!{date.superItemMoney}"/>
                </div>
                <div class="x2">
                    <input type="text" id="topItemBalance$row" name="topItemBalance" data-biz-name="topItemBalance$row" data-minus="true"
                           readonly="readonly" class="layui-input bt-biz-moneyType" value="$!{date.topItemMoney}"/>
                </div>
                <div class="x2">
                    <input type="text" lay-verify="required" id="processMoney$row" data-name="processMoney" data-minus="true"
                           data-biz-name="processMoney$row" data-callback="bt.callSumProcessMoney" iptRow="$row"
                           class="layui-input bt-biz-moneyType ignore-required-icon" value="$!{date.processMoney}"/>
                </div>
                <div class="x2">
                    <input type="text" lay-verify="number2" id="exchangeRate$row" data-name="exchangeRate" readonly="readonly"
                           data-biz-name="exchangeRate$row" data-decimal="4" data-minus="false" data-type="percent" data-budget ="true"
                           class="layui-input bt-biz-moneyType" data-min="0.0001" data-max="100" value="$!{date.exchangeRate}"/>
                </div>
            </div>
            <div class="x2 line line_border">
                <div class="x6 textRight">
                    <input type="hidden" lay-verify="required" id="processCurMoney$row" data-name="processCurMoney" data-minus="true"
                           data-biz-name="processCurMoney$row" class="layui-input bt-biz-moneyType"/>
                    <div id="processCurMoneyDiv$row"></div>
                </div>
                <div class="x6">
                    #if($row != 0)
                        <a href="javascript:void(0)" onclick="del($row)"> #springMessage("common.button.delete")</a>
                    #end
                </div>
            </div>
        </div>
        #if($!{fbsBudgetProjectDetailVO.detailControl} && $dtlColSel)
            <div class="table_grid" id="projectDetail$row" style="display: none"></div>
        #end
    #end
</div>
<script src="${basePath}/static/modules/budget/callEditFbsItem.common.js?_btv=${resourceVersion}"></script>
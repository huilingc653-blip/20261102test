<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>

        #tagItemDetail .bt-selectTree-close, .bt-selectTableType-close {
            right: 15px!important;
            top: 8px!important;
            height: 16px!important;
        }
        #tagItemDetail .line_border {
            border-top:none;
        }
        #tagItemDetail x* {
            position: relative;
        }
        #tagItemDetail .x10.line.line_border {
            border-right: none!important;
        }
    </style>
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{fbsBudgetProcessPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{fbsBudgetProcessPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fbsBudgetProcessPage.updateBy}">
        <input id="updateDate" name="updateDate" type="hidden" value="$!{fbsBudgetProcessPage.updateDate}">
		<input id="processDate" name="processDate" type="hidden" value="$!{fbsBudgetProcessPage.processDate}">
		<input id="businessName" name="businessName" type="hidden" value="$!{fbsBudgetProcessPage.businessName}">
		<input id="processSysname" name="processSysname" type="hidden" value="$!{fbsBudgetProcessPage.processSysname}">
		<input id="id" name="id" type="hidden" value="$!{fbsBudgetProcessPage.id}">
		<input id="corpId" name="corpId" type="hidden" value="$!{fbsBudgetProcessPage.corpId}">
        <input id="curId" name="curId" type="hidden" value="$!{fbsBudgetProcessPage.curId}">
        <table class="layui-table">
            <tbody>
                <tr>
                ##单位
                    <td class="textRight">#springMessage('table.fbsBudgetProcess.corpId')</td>
                    <td >&nbsp;
                        ($!{corpCode})$!{fbsBudgetProcessPage.corpName}
                    </td>
                    ##单据号
                    <td class="textRight">#springMessage('table.fbsBudgetProcess.billNo')</td>
                    <td >
                        <input type="text" id="billNo" name="billNo" lay-verify="langKey"
                               autocomplete="off" class="layui-input" value="$!{fbsBudgetProcessPage.billNo}" placeholder="#springMessage('table.fbsBudgetProcess.billNo')">
                    </td>
                </tr>
                <tr>
                ##执行金额
                    <td class="textRight">#springMessage('table.fbsBudgetProcess.processMoney')</td>
                ##金额（小写）
                    <td>
                        <input type="text" lay-verify="required" data-name="processMoney" data-biz-name="processMoney"
                               class="layui-input bt-biz-moneyType" data-minus="true" data-toUp="moneyUp" readonly="readonly"
                               autocomplete="off" value="$!{fbsBudgetProcessPage.processMoney}"  placeholder="#springMessage('table.nisAllocationReq.money.lower')">

                    </td>
                    <td class="textRight">#springMessage('table.nisAllocationReq.money.upper')</td>
                    <td>
                    ##金额（大写）
                        <div id="moneyUp" name="moneyUp" readonly="true" data-name="moneyUp"
                             autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.money.upper')">
                        </div>
                    </td>

                </tr>
                <tr>
                ##内转标识
                    <td class="textRight">#springMessage('table.fbsBudgetProcess.innerSign')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{fbsBudgetProcessPage.innerSign}" data-name="innerSign" data-biz-name="innerSign" data-callback="bt.innerSign"></div>
                    </td>
                ##收款账号名称
                    <td class="textRight">#springMessage('bisBifRule.payeeName')</td>
                    <td>
                        <div id="corp1" #if($fbsBudgetProcessPage.innerSign == 1) style="display: none" #end>
                            <div class="layui-input-inline">
                                <input type="text" id="payeeAccName" name="payeeAccName"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetProcess.payeeAccName')" value="$!{fbsBudgetProcessPage.payeeAccName}">
                                <div class="bt-div-search" id="pledgeeNameDiv">
                                    <button class="bt-biz-externalCorpBankAcc" id="bt-biz-externalCorpBankAcc" type="button"  data-callback="bt.payeeAccCallback" title="#springMessage('common.button.select')">
                                        <i class="layui-icon">&#xe615;</i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div id="corp2" #if($fbsBudgetProcessPage.innerSign == 0) style="display: none" #end>
                                <div class="bt-biz-selectType" data-name="payeeAccName" data-defaultvalue="$!{fbsBudgetProcessPage.payeeAccName}" data-biz-name="payeeAccName"
                                     data-url="${basePath}/budget/fbsBudgetProcess/json?corpId=$!{fbsBudgetProcessPage.corpId}" data-valuefield="id" data-textfield="name"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                ##执行日期
                    <td class="textRight">#springMessage('table.fbsBudgetProcess.processDate')</td>
                    <td >$!date.format('yyyy-MM-dd',$!{fbsBudgetProcessPage.processDate})
                    </td>
                ##币别
                    <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
                    <td >
                        <div class="bt-biz-selectType" data-name="curId" data-biz-name="curId" data-defaultvalue="$!{fbsBudgetProcessPage.curId}"
                             data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-textfield="curName" data-required="true"></div>
                    </td>
                </tr>
                <tr>
                ##备注
                    <td class="textRight">#springMessage('table.fbsBudgetProcess.rmk')</td>
                    <td colspan="3">
                        <input type="text" id="rmk" name="rmk"
                               autocomplete="off" class="layui-input" value="$!{fbsBudgetProcessPage.rmk}"  placeholder="#springMessage('table.fbsBudgetProcess.rmk')">
                    </td>
                </tr>
				<tr>
					<td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" value="11" lay-filter="submit">#springMessage('common.button.submit')</button>
                        <button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.temp')</button>
					</td>
				</tr>
			</tbody>
		</table>
        <div id="tagItemDetail">

        </div>
	</form>
    #parse("views/common/footer.vm")
    <script src="${basePath}/static/modules/budget/fbsBudgetProcess.edit.js?_btv=${resourceVersion}"></script>
</body>
</html>
<html>
<head>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="font-src *  data:">
    <meta name="viewport"
          content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0, user-scalable=no">
    <title>科目执行明细</title>
    <!-- 引入 FrozenUI -->
    <link rel="stylesheet" href="${basePath}/static/mobile/plugins/fixedTable/table.min.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css" media="all"/>
    <link rel="stylesheet" href="${basePath}/static/css/mobile/index.css" media="all"/>
    <style>
        body{
            font-size: 0;
        }
        .cho-body {
            background-color: #F5F5F5;
        }
        .popup-block * {
            font-size: 0.14rem;
        }

        .ui-tab-content li {
            display: none;
        }

        .ui-tab-content li.bt-show {
            display: list-item;
        }

        .ui-actionsheet.show .ui-actionsheet-cnt {
            transition: none;
        }

        .ui-actionsheet .ui-actionsheet-cnt {
            transition: none;
        }

        .bt-select-popup input {
            border: none;
            width: 0.58rem;
            height: 0.32rem;
            background-color: #F5F5F5;
            border-radius: 0.16rem;
            padding: 0 0.15rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 600;
            color: rgba(102, 102, 102, 1);
        }

        .bt-select-popup.active input {
            color: #2988FF;
            background-color: #E9F1FF;
        }


        .ui-row-flex .ui-col {
            text-align: center;
        }

        .ui-btn-date input {
            border: none;
            width: 0.64rem;
            height: 0.12rem;
            background-color: #F5F5F5;
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(51, 51, 51, 1);
            line-height: 0.14rem;
            text-align: center;
        }


        #tab1 {
            background-color: #F5F5F5;
            margin-top: 0.04rem;
        }


        .nis-tab-title span {
            display: inline-block;
            height: 0.24rem;
            border-radius: 0.12rem;
            margin: 0.06rem;
            margin-top: 0.1rem;
            color: #333;
            padding: 0 0.1rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            margin-left: 0;
        }

        .nis-tab-title span:nth-child(3) {
            margin-right: 0;
        }

        .nis-tab-title .active {
            background-color: #2988FF;
            color: #fff !important;
        }

        .cho-date-item-bottom > div > div {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.22rem;
            height: 0.22rem;
        }
            ##调拨数据样式
        #tab1 .cho-content-item {
            height: 70px;
            background: rgba(255, 255, 255, 1);
            border-radius: 0.06rem;
            margin: 0.1rem 0.15rem;
            margin-top: 0;
        }

        .cho-content-item .cho-content-item-money-left {
            width: 108px;
            height: 18px;
            font-size: 18px;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(51, 51, 51, 1);
            line-height: 18px;
            padding: 0.14rem 0.14rem;
        }


        .cho-content-item .cho-content-item-date-right {
            font-size: 12px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(153, 153, 153, 1);
            line-height: 12px;
            padding-top: 0.18rem;
            padding-right: 0.18rem;
            text-align: right;
        }

        .bt-card .active {
            color: #2988FF;
            font-weight: 700;
        }


        .bt-card-body .ui-col:nth-last-child(1) .bt-card-item {
            margin-right: 0;
        }

        /*浮框的按钮*/
        .bt-popup-bottom button {
            height: 0.4rem;
            line-height: 0.4rem;
            border-radius: 0.2rem;
            font-size: 0.16rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
        }

        .bt-popup-bottom .bt-popup-submit {
            width: 2.1rem;
            background: linear-gradient(90deg, rgba(75, 226, 255, 1) 0%, rgba(50, 104, 249, 1) 100%);
            color: rgba(255, 255, 255, 1);
        }

        .bt-popup-bottom .bt-popup-reset {
            width: 1.1rem;
            background: rgba(255, 255, 255, 1);
            border: 1px solid rgba(212, 212, 212, 1);
            color: rgba(102, 102, 102, 1);
        }



        .ui-sp-btn > input{
            /*margin-left: 0.01rem;*/
            font-size: 0.12rem;
            font-family:苹方-简 常规体;
            font-weight:400;
            color:#333333;
            width: 1.11rem;
        }


        .ui-form-item input{
            padding-left: 0.16rem;
        }

        .ui-tab-nav li {
            text-align: left;
        }
        .box-left-info-icon img{
            margin-left: 0.02rem;
            width:0.13rem;
        }

        .box-body{
            padding: 0.15rem 0 0.15rem 0;
            border-right: 1px solid rgb(95,153,242);
            display: inline-block;
            text-align: center;
            overflow-x:auto;
            width: 1rem;
            font-size: 12px;
        }

        .box-data{
            background-color: #ffffff;
            border-right: 1px solid #D4DADF;
            border-bottom:1px solid #D4DADF;
        }
    </style>

</head>

    <div class="data-content" style="margin-bottom: 0.1rem; height: 100%;overflow-y: auto;" id="tableList">
        <div id="sp-list" class="data-table" >
            <!--1.0 冻列 -->
            <div class="t_l" style="width: 200px;">
                <!--1.1 冻结列表头-->
                <table>
                    <tbody id="biBody">
                    <tr>
                        <th>单位</th>
                        <th>科目代码</th>
                    </tr>
                    </tbody>
                </table>
                <!--1.2 冻结列表体-->
                <div class="t_l_freeze">
                    <table width="100%">
                        <tbody id="biLeft">
                            #foreach($report in $fbsBudgetProcessVOList)
                                <tr>
                                    <td>$!{report.corpName}</td>
                                    <td>$!{report.itemCode}</td>
                                </tr>
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
            <!--2.0 表格-->
            <div class="t_r" style="margin-left: 200px;">
                <!--2.1　冻结行表头-->
                <div class="t_r_t">
                    <table style="width: 700px;">
                        <tbody id="biHead">
                        <tr>
                            <th>科目名称</th>
                            <th>执行业务名称</th>
                            <th>单据号</th>
                            <th>执行日期</th>
                            <th>执行金额</th>
                            <th>收款账号名称</th>
                            <th>状态</th>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <!--2.2 表格中心内容区域-->
                <div class="t_r_content">
                    <table style="width: 700px;">
                        <tbody id="biRight">
                            #foreach($report in $fbsBudgetProcessVOList)
                            <tr>
                                <td>$!{report.itemName}</td>
                                <td>$dictTag.get("fbsBudgetProcess.businessName",$!{report.businessName})&nbsp;</td>
                                <td>$!{report.billNo}&nbsp;</td>
                                <td>$!date.format('yyyy-MM-dd',$!{report.processDate})&nbsp;</td>
                                <td style="text-align: right">$!number.formatNumeric($!{report.processMoney})&nbsp;</td>
                                <td>$!{report.payeeAccName}&nbsp;</td>
                                <td style="border-right: none">
                                    #if($!{report.status} == 95)
                                        执行
                                    #else
                                        在途
                                    #end
                                </td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div id="sp-map" class="chart-wrapper" style="display: none;margin-left: 0px">
        </div>
        <div></div>
    </div>
</section>

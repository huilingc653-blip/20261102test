<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fbsItemPage.id}">
    <input type="hidden" id="isSystem" name="isSystem" value="$!{fbsItemPage.isSystem}">
    <input type="hidden" id="superItemCodeHide" name="superItemCodeHide" value="$!{fbsItemPage.superItemCode}">
    <table class="layui-table">
        <tr>
        ##父科目
            <td class="textRight">#springMessage('table.fbsItem.superItemCode')</td>
            <td>
                #if($!{fbsItemPage.superItemName} != "")
                    ($!{fbsItemPage.superItemCode})$!{fbsItemPage.superItemName}
                #end
            </td>
        ##科目代码
            <td class="textRight">#springMessage('table.fbsItem.itemCode')</td>
            <td width="40%">
                $!{fbsItemPage.itemCode}
            </td>
        </tr>
        <tr>
        ##科目名称
            <td class="textRight">#springMessage('table.fbsItem.itemName')</td>
            <td width="40%">
                <div class="layui-inline">
                    <input style="display: inline;" type="text" id="itemName" name="itemName" lay-verify="required" class="layui-input"
                           autocomplete="off" placeholder="#springMessage('table.fbsItem.itemName')"
                           value="$!{fbsItemPage.itemName}">
                    <span data-toggle="i18n" data-key-id="$!{fbsItemPage.id}"/>
                </div>
            </td>
        ##资金流向
            <td class="textRight">#springMessage('table.fbsItem.sign')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="fbsItem.sign" data-name="sign"
                     data-defaultvalue="1" data-value="$!{fbsItemPage.sign}" data-biz-name="sign"></div>
            </td>
        </tr>
        <tr>

        ##是否允许填写计划 1-是 0-否
            <td class="textRight">#springMessage('table.fbsItem.isWrite')</td>
            <td>
                #if($!{fbsItemPage.itemRelation} && $!{fbsItemPage.itemRelation}!="")
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isWrite" data-disabled="true"
                         data-defaultvalue="$!{fbsItemPage.isWrite}" data-biz-name="isWrite"></div>
                #else
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isWrite"
                         data-defaultvalue="$!{fbsItemPage.isWrite}" data-biz-name="isWrite"></div>
                #end
            </td>
        ##是否计划控制科目
            <td class="textRight">#springMessage('table.fbsItem.isControl')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isControl"
                     data-defaultvalue="$!{fbsItemPage.isControl}" data-biz-name="isControl"></div>
            </td>
        </tr>

        <tr>
        ##是否期初科目
            <td class="textRight">#springMessage('table.fbsItem.isBeginPeriod')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isBeginPeriod"
                     data-defaultvalue="$!{fbsItemPage.isBeginPeriod}" data-biz-name="isBeginPeriod"></div>
            </td>
        ##是否期末科目
            <td class="textRight">#springMessage('table.fbsItem.isEndPeriod')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isEndPeriod"
                     data-defaultvalue="$!{fbsItemPage.isEndPeriod}" data-biz-name="isEndPeriod"></div>
            </td>
        </tr>
        <tr style="display:none">
        ##是否刚性科目
            <td class="textRight">#springMessage('table.fbsItem.isRigid')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isRigid"
                     data-defaultvalue="$!{fbsItemPage.isRigid}" data-biz-name="isRigid"></div>
            </td>
        ##是否冲抵科目
            <td class="textRight">#springMessage('table.fbsItem.isInternal')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isInternal"
                     data-defaultvalue="$!{fbsItemPage.isInternal}" data-biz-name="isInternal"></div>
            </td>
        </tr>
        <tr>
            ##科目明细是否必须录入
            <td class="textRight">#springMessage('table.fbsItem.isWriteDetail')</td>
            <td >
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isWriteDetail" data-defaultvalue="$!{fbsItemPage.isWriteDetail}" data-biz-name="isWriteDetail"></div>
            </td>
        ##有效标志
            <td class="textRight">#springMessage('table.fbsItem.validSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-name="validSign"
                     data-defaultvalue="$!{fbsItemPage.validSign}" data-biz-name="validSign"></div>
            </td>
        </tr>
        <tr>
        ##超计划比例
            <td class="textRight">#springMessage('table.fbsItem.overPerSpend')</td>
            <td colspan="3">
                <input type="text" id="overPerSpend" name="overPerSpend"
                       autocomplete="off" class="layui-input bt-biz-rateType" placeholder="#springMessage('table.fbsItem.overPerSpend')" value="$!{fbsItemPage.overPerSpend}">
            </td>
        </tr>
        #*<tr>
            ##现金流科目代码
            <td class="textRight">#springMessage('table.fbsItem.cashItemCode')</td>
            <td width="40%">
                <input type="text" id="cashItemCode" name="cashItemCode"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsItem.cashItemCode')" value="$!{fbsItemPage.cashItemCode}">
            </td>
            ##现金流科目名称
            <td class="textRight">#springMessage('table.fbsItem.cashItemName')</td>
            <td width="40%">
                <input type="text" id="cashItemName" name="cashItemName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsItem.cashItemName')" value="$!{fbsItemPage.cashItemName}">
            </td>
        </tr>
        <tr>
            ##调拨科目
            <td class="textRight">#springMessage('table.fbsItem.allotItemCode')</td>
            <td colspan="3">
                <div class="layui-input-inline">
                    <div class="allotItemTree"></div>
                </div>
                <input type="hidden" name="allotItemCodeHide" id="allotItemCodeHide" value="$!{fbsItemPage.allotItemCode}"/>
            *##*<input type="text" id="allotItemCode" name="allotItemCode"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsItem.allotItemCode')" value="$!{fbsItemPage.allotItemCode}">*##*
            </td>
        </tr>*#
        <tr>
        ##备注
            <td class="textRight">#springMessage('table.fbsItem.rmk')</td>
            <td colspan="3">
                <input type="text" id="rmk" name="rmk" style="width: 100%" class="layui-input"
                       autocomplete="off" placeholder="#springMessage('table.fbsItem.rmk')" value="$!{fbsItemPage.rmk}">
            </td>
        </tr>
        <tr>
        ##同级科目关系
            <td class="textRight">#springMessage('table.fbsItem.itemRelation')</td>
            <td colspan="3">
                <input type="text" id="itemRelation" name="itemRelation" style="width: 100%" class="layui-input"
                       autocomplete="off" placeholder="#springMessage('table.fbsItem.itemRelation')"
                       value="$!{fbsItemPage.itemRelation}">
            </td>
        </tr>
        <tr>
            <td colspan="6">
        				<span style="color: #663399">
                            #springMessage('table.fbsItem.itemRelation.rmk')<br>
                            #springMessage('table.fbsItem.itemRelation.rmk1')<br>
                            #springMessage('table.fbsItem.itemRelation.rmk2')<br>
                            #springMessage('table.fbsItem.itemRelation.rmk3')
        				</span>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary" data-callBack="resetCallBack">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsItem.edit.js?_btv=${resourceVersion}"></script>
</html>
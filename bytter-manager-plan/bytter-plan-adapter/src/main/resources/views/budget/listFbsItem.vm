<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding: 0 10px">
    <form id="searchForm" class="layui-form" method="post">
        <table class="layui-table">
            <tbody>
            <tr>
            ##科目代码
                <td class="textRight">#springMessage('table.fbsItem.itemCode')</td>
                <td width="20%">
                    <input type="text" id="itemCode" name="itemCode" value="$!{fbsItemPage.itemCode}"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsItem.itemCode')">
                </td>
            ##科目名称
                <td class="textRight">#springMessage('table.fbsItem.itemName')</td>
                <td width="20%">
                    <input type="text" id="itemName" name="itemName" value="$!{fbsItemPage.itemName}"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsItem.itemName')">
                </td>
                <td class="textRight">#springMessage('table.fbsBudgetReport.showItem')</td>
                <td width="20%">
                    <div class="bt-biz-dict" data-type="select" data-displayData="$!{maxLevelShow}" data-defaultvalue="$!{fbsItemPage.showItem}"
                         data-group="fbsBudgetReport.showItem" data-name="showItem"></div>
                </td>
            </tr>
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button id="search" class="layui-btn" lay-submit="">#springMessage('common.button.search')</button>
                    <button id="reset" type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    </form>
    <div class="dt-buttons" style="display: block;padding-bottom: 10px">
        <button class="layui-btn" type="button" onclick="add()">#springMessage('common.button.add')</button>
    </div>
    <div style="display:inline-block;width:100%;">
        <div id="maingrid1"></div>
    </div>
    <div style="width: 100%;overflow-x: scroll;margin-bottom: 10px;display: none">
        <table id="appTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.fbsItem.itemCode')</th>
                <th>#springMessage('table.fbsItem.itemName')</th>
                <th>#springMessage('table.fbsItem.sign')</th>
                <th>#springMessage('table.fbsItem.isWrite')</th>
                <th>#springMessage('table.fbsItem.isControl')</th>
                <th>#springMessage('table.fbsItem.isBeginPeriod')</th>
                <th>#springMessage('table.fbsItem.isEndPeriod')</th>
                <!--<th>#springMessage('table.fbsItem.isInternal')</th> -->
                <th>#springMessage('table.fbsItem.isWriteDetail')</th>
                <th>#springMessage('table.fbsItem.validSign')</th>
                #*<th>#springMessage('table.fbsItem.allotItemCode')</th>*#
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
            <tbody>
                #foreach($data in $treeData)
                <tr data-tt-id="$!{data.itemCode}" data-tt-parent-id="$!{data.superItemCode}" data-id="$!{data.id}">
                    <td>
                        <div class="inline-block" style="width: 180px;">
                            $!{data.itemCode}
                        </div>
                    </td>
                    <td>$!{data.itemName}</td>
                    <td align="center">
                        #if($!{data.sign} == "-1")
                            <font color="#ff0000">$!{data.signName}</font>
                        #else
                            $!{data.signName}
                        #end
                    </td>
                    <td align="center">
                        #if($!{data.isWrite} == "0")
                            <font color="#ff0000">$!{data.isWriteName}</font>
                        #else
                            $!{data.isWriteName}
                        #end
                    </td>
                    <td align="center">
                        #if($!{data.isControl} == "0")
                            <font color="#ff0000">$!{data.isControlName}</font>
                        #else
                            $!{data.isControlName}
                        #end
                    </td>
                    <td align="center">
                        #if($!{data.isBeginPeriod} == "0")
                            <font color="#ff0000">$!{data.isBeginPeriodName}</font>
                        #else
                            $!{data.isBeginPeriodName}
                        #end
                    </td>
                    <td align="center">
                        #if($!{data.isEndPeriod} == "0")
                            <font color="#ff0000">$!{data.isEndPeriodName}</font>
                        #else
                            $!{data.isEndPeriodName}
                        #end
                    </td>
                    <!--
				<td align="center">
					#if($!{data.isInternal} == "0")
						<font color="#ff0000">$!{data.isInternalName}</font>
					#else
						$!{data.isInternalName}
					#end
				</td> -->
                    <td align="center">
                        #if($!{data.isWriteDetail} == "0")
                            <font color="#ff0000">$!{data.isWriteDetailName}</font>
                        #else
                            $!{data.isWriteDetailName}
                        #end
                    </td>
                    <td align="center">
                        #if($!{data.validSign} == "0")
                            <font color="#ff0000">$!{data.validSignName}</font>
                        #else
                            $!{data.validSignName}
                        #end
                    </td>
                    #*<td>$!{data.allotItemCode}</td>*#
                    <td align="center">
                        <a class="" href="#" onclick="addChild('$!{data.id}')">#springMessage('common.button.addChildItemCode')</a>
                        <span class="text-explode">|</span>
                        <a class="" href="#" onclick="update('$!{data.id}')">#springMessage('common.button.edit')</a>
                        #if(${data.isSystem} != "1")
                            <span class="text-explode">|</span>
                            <a class="" href="#" onclick="del('$!{data.id}')">#springMessage('common.button.delete')</a>
                        #end
                    </td>
                </tr>
                #end
            </tbody>
        </table>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsItem.list.js?_btv=${resourceVersion}"></script>
</html>

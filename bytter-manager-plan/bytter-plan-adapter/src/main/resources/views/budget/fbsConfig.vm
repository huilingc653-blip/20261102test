<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.fbs.param.titile.input')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="25%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="75%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                        ##上期计划余额下期是否可用
                    <tr>
                        <td width="25%" class="textRight">#springMessage('config.fbs.useBalance')</td>
                        <td width="75%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="fbs.useBalance"
                                     data-biz-name="fbs.useBalance" data-defaultvalue="$config.fbs.useBalance"></div>
                            </div>
                            ##<div class="layui-input-inline" style="color:red">#springMessage('config.fbs.useBalance.desc')</div>
                            <div class="layui-input-inline">
                                <i id="useBalance-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                        ##是否有年计划及控制
                    <tr>
                        <td class="textRight">#springMessage('config.fbs.ycrl')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="fbs.control.sign" data-name="fbs.ycrl"
                                 data-biz-name="fbs.ycrl" data-defaultvalue="$config.fbs.ycrl" data-callback="ycrlCallBack"></div>
                        </td>
                    </tr>
                        ##是否有季计划及控制
                    <tr>
                        <td class="textRight">#springMessage('config.fbs.qcrl')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="fbs.control.sign" data-name="fbs.qcrl"
                                 data-biz-name="fbs.qcrl" data-defaultvalue="$config.fbs.qcrl" data-callback="qcrlCallBack"></div>
                        </td>
                    </tr>
                        ##是否有月计划及控制
                    <tr>
                        <td class="textRight">#springMessage('config.fbs.mcrl')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="fbs.control.sign" data-name="fbs.mcrl"
                                 data-biz-name="fbs.mcrl" data-defaultvalue="$config.fbs.mcrl" data-callback="mcrlCallBack"></div>
                        </td>
                    </tr>
                        ##是否有周计划及控制
                    <tr>
                        <td class="textRight">#springMessage('config.fbs.wcrl')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="fbs.control.sign" data-name="fbs.wcrl"
                                 data-biz-name="fbs.wcrl" data-defaultvalue="$config.fbs.wcrl" data-callback="wcrlCallBack"></div>
                        </td>
                    </tr>
                        ##是否有天计划及控制
                    <tr>
                        <td class="textRight">#springMessage('config.fbs.dcrl')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="fbs.control.sign.day" data-name="fbs.dcrl"
                                 data-biz-name="fbs.dcrl" data-defaultvalue="$config.fbs.dcrl" data-callback="dcrlCallBack"></div>
                        </td>
                    </tr>
                        ##年计划上报模式
                    <tr id="yimodeTr">
                        <td class="textRight">#springMessage('config.fbs.yimode')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="fbs.year.mode" data-name="fbs.yimode"
                                 data-biz-name="fbs.yimode" data-defaultvalue="$config.fbs.yimode" data-callback="yimodeCallBack"></div>
                        </td>
                    </tr>
                        ##年分解月（月是否上报计划）
                    <tr id="yimodeMTr">
                        <td class="textRight">#springMessage('config.fbs.yimodeM')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="fbs.yimodeM"
                                 data-biz-name="fbs.yimodeM" data-defaultvalue="$config.fbs.yimodeM" data-callback="yimodeMCallBack"></div>
                        </td>
                    </tr>
                        ##季计划上报模式
                    <tr id="qimodeTr">
                        <td class="textRight">#springMessage('config.fbs.qimode')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="fbs.quarter.mode" data-name="fbs.qimode"
                                 data-biz-name="fbs.qimode" data-defaultvalue="$config.fbs.qimode" data-callback="qimodeCallBack"></div>
                        </td>
                    </tr>
                        ##季滚动模式
                    <tr id="qimodeRollTr">
                        <td class="textRight">#springMessage('config.fbs.qimodeRoll')</td>
                        <td>
                            <div class="layui-input-inline">T+</div>
                            <div class="layui-input-inline">
                                <input type="text" name="fbs.qimodeRoll" data-name="fbs.qimodeRoll" data-decimal="0" data-separator="" data-max="12" data-min="3"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$config.fbs.qimodeRoll">
                            </div>
                            <div class="layui-input-inline">
                                &nbsp;&nbsp;&nbsp;&nbsp;#springMessage('config.fbs.rollSubperiod')
                            </div>
                            <div class="layui-input-inline">
                                <input type="text" name="fbs.qRollSubperiod" data-name="fbs.qRollSubperiod" data-decimal="0" data-separator="" data-min="0"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$config.fbs.qRollSubperiod">
                            </div>
                        </td>
                    </tr>
                        ##月计划上报模式
                    <tr id="mimodeTr">
                        <td class="textRight">#springMessage('config.fbs.mimode')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-group="fbs.month.mode" data-name="fbs.mimode" data-displayData="0,1,3"
                                     data-biz-name="fbs.mimode" data-defaultvalue="$config.fbs.mimode" data-callback="mimodeCallBack"></div>
                            </div>
                            ##<div class="layui-input-inline" style="color:red">#springMessage('config.fbs.mimode.desc')</div>
##                            <div class="layui-input-inline">
##                                <i id="mimode-desc" class="layui-icon">&#xe60b;</i>
##                            </div>
                        </td>
                    </tr>
                        ##月滚动模式
                    <tr id="mimodeRollTr">
                        <td class="textRight">#springMessage('config.fbs.mimodeRoll')</td>
                        <td>
                            <div class="layui-input-inline">T+</div>
                            <div class="layui-input-inline">
                                <input type="text" name="fbs.mimodeRoll" data-name="fbs.mimodeRoll" data-decimal="0" data-separator="" data-max="12" data-min="3"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$config.fbs.mimodeRoll">
                            </div>
                            <div class="layui-input-inline">
                                &nbsp;&nbsp;&nbsp;&nbsp;#springMessage('config.fbs.rollSubperiod')
                            </div>
                            <div class="layui-input-inline">
                                <input type="text" name="fbs.mRollSubperiod" data-name="fbs.mRollSubperiod" data-decimal="0" data-separator="" data-min="0" data-max="12"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$config.fbs.mRollSubperiod">
                            </div>
                        </td>
                    </tr>
                        ##周计划上报模式
                    <tr id="wimodeTr">
                        <td class="textRight">#springMessage('config.fbs.wimode')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="fbs.week.mode" data-name="fbs.wimode"
                                 data-biz-name="fbs.wimode" data-defaultvalue="$config.fbs.wimode" data-callback="wimodeCallBack"></div>
                        </td>
                    </tr>
                        ##周滚动模式
                    <tr id="wimodeRollTr">
                        <td class="textRight">#springMessage('config.fbs.wimodeRoll')</td>
                        <td>
                            <div class="layui-input-inline">T+</div>
                            <div class="layui-input-inline">
                                <input type="text" name="fbs.wimodeRoll" data-name="fbs.wimodeRoll" data-decimal="0" data-separator="" data-max="12" data-min="3"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$config.fbs.wimodeRoll">
                            </div>
                            <div class="layui-input-inline">
                                &nbsp;&nbsp;&nbsp;&nbsp;#springMessage('config.fbs.rollSubperiod')
                            </div>
                            <div class="layui-input-inline">
                                <input type="text" name="fbs.wRollSubperiod" data-name="fbs.wRollSubperiod" data-decimal="0" data-separator="" data-min="0"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$config.fbs.wRollSubperiod">
                            </div>
                        </td>
                    </tr>
                        ##周计划是否整月一起上报
                    <tr id="wimodeOneTimeTr">
                        <td class="textRight">#springMessage('config.fbs.wimodeOneTime')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="fbs.wimodeOneTime"
                                 data-biz-name="fbs.wimodeOneTime" data-defaultvalue="$config.fbs.wimodeOneTime"></div>
                        </td>
                    </tr>
                        ##天计划是否连续上报
                    <tr id="dimodeOneTimeTr">
                        <td class="textRight">#springMessage('config.fbs.dimodeOneTime')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="fbs.dimodeOneTime"
                                 data-biz-name="fbs.dimodeOneTime" data-defaultvalue="$config.fbs.dimodeOneTime" data-callback="dimodeOneTimeCallBack"></div>
                        </td>
                    </tr>
                        ##天计划连续上报天数
                    <tr id="dimodeOneTimeDaysTr">
                        <td class="textRight">#springMessage('config.fbs.dimodeOneTimeDays')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="fbs.dimodeOneTimeDays" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-separator="" value="$!{config.fbs.dimodeOneTimeDays}">
                            </div>
                            <div class="layui-input-inline">#springMessage('config.nis.day')</div>
                        </td>
                    </tr>
                        ##分解计划上报余额控制方式
                    <tr>
                        <td class="textRight">#springMessage('config.fbs.inputBlance')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-group="fbs.blance.control.mode" data-name="fbs.inputBlance"
                                     data-biz-name="fbs.inputBlance" data-defaultvalue="$config.fbs.inputBlance"></div>
                            </div>
                            ##<div class="layui-input-inline" style="color:red">#springMessage('config.fbs.inputBlance.desc')</div>
                            <div class="layui-input-inline">
                                <i id="inputBlance-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                        ##明细字段
                    <tr>
                        <td class="textRight">#springMessage('config.fbs.dtlCol')</td>
                        <td>
                            #set($dtlCol = "")
                            #foreach($col in $config.fbs.dtlCol )
                                #if($dtlCol != "")
                                    #set($dtlCol =  $dtlCol + "," + $col)
                                #else
                                    #set($dtlCol =  $col)
                                #end
                            #end
                            <div class="bt-biz-dict" data-type="checkbox" data-group="fbsBudget.detailCol" data-name="fbs.dtlCol"
                                 data-biz-name="fbs.dtlCol" data-defaultvalue="$dtlCol" data-filterData="curId,natualMoney"></div>


                            #*<div class="layui-input-inline">
                                <input type="text" name="fbs.dtlCol"  style="width:500px" class="layui-input"  value="$!{config.fbs.dtlCol}" title="$!{config.fbs.dtlCol}"
                                       placeholder="#springMessage('config.fbs.dtlColDetail')">
                            </div>
                            <div class="layui-input-inline" style="color:red">#springMessage('config.fbs.dtlCol.desc')</div>*#
                        </td>
                    </tr>
                        ##汇总时是否允许修改直属下级单位的计划
                    <tr>
                        <td class="textRight">#springMessage('config.fbs.allowEditDirectUderCorp')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="fbs.allowEditDirectUderCorp"
                                 data-biz-name="fbs.allowEditDirectUderCorp" data-defaultvalue="$config.fbs.allowEditDirectUderCorp"></div>
                        </td>
                    </tr>
                        ##汇总时是否允许修改跨级下级单位的计划
                    <tr>
                        <td class="textRight">#springMessage('config.fbs.allowEditUderCorp')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="fbs.allowEditUderCorp"
                                 data-biz-name="fbs.allowEditUderCorp" data-defaultvalue="$config.fbs.allowEditUderCorp"></div>
                        </td>
                    </tr>
                        ##汇总时是否允许修改上报金额
                    <tr>
                        <td class="textRight">#springMessage('config.fbs.allowEditCollectMoney')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="fbs.allowEditCollectMoney"
                                 data-biz-name="fbs.allowEditCollectMoney" data-defaultvalue="$config.fbs.allowEditCollectMoney"></div>
                        </td>
                    </tr>
                        ##审批时是否允许修改上报金额
                    <tr>
                        <td class="textRight">#springMessage('config.fbs.allowEditMoney')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="fbs.allowEditMoney"
                                 data-biz-name="fbs.allowEditMoney" data-defaultvalue="$config.fbs.allowEditMoney"></div>
                        </td>
                    </tr>
                        #*<tr>
                            <td class="textRight">#springMessage('config.fbs.salesReturnItem')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" name="fbs.salesReturnItem"  style="width:500px" class="layui-input"  value="$!{config.fbs.salesReturnItem}" title="$!{config.fbs.salesReturnItem}"
                                           placeholder="#springMessage('config.fbs.salesReturnItem')">
                                </div>
                                <div class="layui-input-inline" style="color:red">#springMessage('config.fbs.salesReturnItem.desc')</div>
                            </td>
                        </tr>*#
                    </tbody>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.fbs.param.titile.process')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="25%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="75%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td width="25%" class="textRight">#springMessage('config.fbs.timeType')</td>
                        <td width="75%">
                            <div class="bt-biz-dict" data-type="radio" data-group="fbs.timeType" data-name="fbs.timeType"
                                 data-biz-name="fbs.timeType" data-defaultvalue="$config.fbs.timeType"></div>
                        </td>
                    </tr>

                    <tr>
                        <td class="textRight">#springMessage('config.fbs.dtlColSel')</td>
                        <td>
                            #set($dtlColSel = "")
                            #foreach($col in $config.fbs.dtlColSel )
                                #if($dtlColSel != "")
                                    #set($dtlColSel =  $dtlColSel + "," + $col)
                                #else
                                    #set($dtlColSel =  $col)
                                #end
                            #end
                            <div class="bt-biz-dict" data-type="checkbox" data-group="fbsBudget.detailCol" data-name="fbs.dtlColSel"
                                 data-biz-name="fbs.dtlColSel" data-defaultvalue="$dtlColSel" data-filterData="curId,natualMoney"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="25%" class="textRight">#springMessage('config.fbs.itemBalance')</td>
                        <td width="75%">
                            <div class="bt-biz-dict" data-type="radio" data-group="fbs.item.balance.control.mode" data-name="fbs.itemBalance"
                                 data-biz-name="fbs.itemBalance" data-defaultvalue="$config.fbs.itemBalance"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="25%" class="textRight">#springMessage('config.fbs.collectBalance')</td>
                        <td width="75%">
                            <div class="bt-biz-dict" data-type="radio" data-group="fbs.item.balance.collect" data-name="fbs.collectBalance"
                                 data-biz-name="fbs.collectBalance" data-defaultvalue="$config.fbs.collectBalance"></div>
                        </td>
                    </tr>
                        #*<tr>
                            <td class="textRight">#springMessage('config.fbs.lowerLmit')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" name="fbs.lowerLmit" style="text-align:right" data-name="fbs.lowerLmit" lay-verify="required|number2"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{config.fbs.lowerLmit}" placeholder="#springMessage('config.fbs.lowerLmit')">
                                </div>
                                <div class="layui-input-inline">#springMessage('config.choBank.moneyUnit')</div>
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight">#springMessage('config.fbs.ratioLimit')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" name="fbs.ratioLimit" style="text-align:right" data-name="fbs.ratioLimit" lay-verify="required" value="$!{config.fbs.ratioLimit}"
                                           autocomplete="off" class="layui-input bt-biz-rateType" placeholder="#springMessage('config.fbs.ratioLimit')">
                                </div>
                            </td>
                        </tr>*#
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="25%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/budget/fbs.config.js?_btv=${resourceVersion}"></script>
</body>
</html>

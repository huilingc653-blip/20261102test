<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
	<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
    <input type="hidden"  name="opType" id="opType" value="S"/>
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td width="40%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-resource="fbs:process:fbsBudgetProcess:query"
                         data-scope="all"></div>
                </div>
            </td>
        ##执行日期
            <td class="textRight">#springMessage('table.fbsBudgetProcess.processDate')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" name="ged_processDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="t2">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_processDate" class="layui-input bt-input-inline bt-biz-dateType" id="t2">
                </div>
            </td>
        </tr>
        <tr>
        ##单据号
            <td class="textRight">#springMessage('table.fbsBudgetProcess.billNo')</td>
            <td >
                <!--number-->
                <input type="text" id="billNo" name="likes_billNo"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetProcess.billNo')">
            </td>
            <td class="textRight">#springMessage('table.fbsBudgetProcess.createDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="ged_createDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="t1">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_createDate" class="layui-input bt-input-inline bt-biz-dateType" id="t1">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fbsBudgetProcess.corpId')</th>
        <th>#springMessage('table.fbsBudgetProcess.itemCode')</th>
        <th>#springMessage('table.fbsBudgetProcess.itemName')</th>
        <th>#springMessage('table.fbsBudgetProcess.processMoney')</th>
        <th>#springMessage('table.fbsBudgetProcess.processDate')</th>
        <th>#springMessage('table.fbsBudgetProcess.billNo')</th>
        <th>#springMessage('table.fbsBudgetProcess.createDate')</th>
##        <th>#springMessage('table.fbsBudgetProcess.status')</th>
        <th>#springMessage('table.fbsBudgetProcess.rmk')</th>
            <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
	#workFlowHtml()
    #parse("views/common/footer.vm")
	#workFlowScript()
	<script src="${basePath}/static/modules/budget/fbsBudgetProcessApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

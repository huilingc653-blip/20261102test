<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form  class="layui-form" method="post" id="fbsPeriodForm">
<table class="layui-table">
	<tr>
		<td align="center">#springMessage('table.fbsBudgetPeriod.chooseYear')
			<div class="layui-inline">
			<input type="hidden" id="defaultYear" value="$!{defaultYear}"/>
       		<div class="selectYear"></div>
       		<button class="layui-btn" type="button" onclick="autoAenerate();">#springMessage('table.fbsBudgetPeriod.autoNatural')</button>
			<button class="layui-btn" type="button" onclick="autoStandard();">#springMessage('table.fbsBudgetPeriod.autoStandard')</button>
       		<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
       		</div>
		</td>
	</tr>
</table>
<table class="layui-table layui-table-border ignore-required-icon" id="dataTable">
	<thead>
		<tr>
			<th align="center" colspan="8" style="text-align: center;" >#springMessage('table.fbsBudgetPeriod.title')</th>
		</tr>
		<tr>
			<th style="text-align: center;">#springMessage('table.fbsBudgetPeriod.month')</th>
			<th style="text-align: center;">#springMessage('table.fbsBudgetPeriod.week')</th>
			<th style="text-align: center;">#springMessage('table.fbsBudgetPeriod.beginDate')</th>
			<th style="text-align: center;">#springMessage('table.fbsBudgetPeriod.endDate')</th>
			<th style="text-align: center;">#springMessage('table.fbsBudgetPeriod.weekdays')</th>
			<th style="text-align: center;">#springMessage('table.fbsBudgetPeriod.workdays')</th>
			<th style="text-align: center;">#springMessage('table.fbsBudgetPeriod.holidays')</th>
			<th style="text-align: center;">#springMessage('table.fbsBudgetPeriod.rmk')</th>
		</tr>
	</thead>
</table>
</form>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudgetPeriod.list.js?_btv=${resourceVersion}"></script>
</html>

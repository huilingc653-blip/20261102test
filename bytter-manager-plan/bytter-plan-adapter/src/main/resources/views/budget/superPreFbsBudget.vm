<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body id="budgetBody" style="display: none">
	<table id="curTable" class="layui-table layui-form" style="width:100%;" expandable="true">
        <thead>
        <tr>
            <th width="20%">#springMessage('table.fbsBudget.corpId')</th>
    		<th width="15%">#springMessage('table.fbsBudget.enrolDate')</th>
            <th width="15%">#springMessage('table.fbsBudget.beginDate')</th>
            <th width="15%">#springMessage('table.fbsBudget.endDate')</th>
            <th width="7%">#springMessage('table.fbsBudget.status')</th>
			<th width="7%">#springMessage('table.fbsBudget.childCorp')</th>
            <th width="8%">#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    	<tbody>
        	#foreach($date in $curDate)
        		<tr data-tt-id="$!{date.corpId}" data-tt-parent-id="$!{date.parentCorpId}" data-tt-subject-sort="$!{date.id}" >
        			<td>
						(${date.corpCode})&nbsp;&nbsp;${date.corpName}
                        #if($!{date.corpType} == "0")<font color="red">(#springMessage('table.fbsBudget.net'))</font>#end	
					</td>
        			<td style="text-align:center">$!{date.enrolDateStr}</td>
    				<td style="text-align:center">$!{date.beginDateStr}</td>
    				<td style="text-align:center">$!{date.endDateStr}</td>
    				<td>
    					#if($!{date.status} == "-2")
                            <font color="red">$dictTag.get("fbsBudget.status",$!{date.status})</font>
    					#else
    						$dictTag.get("fbsBudget.status",$!{date.status})
    					#end
    				</td>
					<td>$!{date.childCorp}</td>
        			<td>
    					#if($!{date.status} == "95")
						<a class="" href="#" onclick="superadd('$!{date.id}','$!{date.superaddId}')">#springMessage('common.button.superCreate')</a>
						#else
							#if($!{date.status} == "96" || $!{date.status} == "97")
    						<a class="" href="#" onclick="superadd('$!{date.id}','$!{date.superaddId}')">#springMessage('common.button.edit')</a>
							<span class="text-explode">|</span>
    						<a class="" href="#" onclick="del('$!{date.id}','$!{date.superaddId}')">#springMessage('common.button.delete')</a>
							<span class="text-explode">|</span>
							#end
							<a class="" href="#" onclick="view('$!{date.id}')">#springMessage('common.button.view')</a>
##							<span class="text-explode">|</span>
##							<a class="" href="#" onclick="bt.trackFlowByBusinessId('$!{date.superaddId}')">#springMessage('common.button.trackFlow')</a>
						#end
						#if($!{date.collectFlag} == "1")<span class="text-explode">|</span><a class="" href="#" onclick="curView('$!{date.corpId}','$!{date.timeType}','$!{date.beginDateStr}','$!{date.endDateStr}')">#springMessage('common.button.curView')</a>#end
        			</td>
        		</tr>
        	#end
        </tbody>
    </table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudgetSuperadd.superPre.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding: 0 10px">
	<form class="layui-form ignore-required-icon" method="post" id="inputForm">
        <input id="layId" name="layId" type="hidden" value="$!{layId}">
		<input id="id" name="id" type="hidden" value="$!{fbsBudgetPage.id}">
		<input id="createBy" name="createBy" type="hidden" value="$!{fbsBudgetPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{date.format('yyyy-MM-dd HH:mm:ss',$!{fbsBudgetPage.createDate})}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fbsBudgetPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{date.format('yyyy-MM-dd HH:mm:ss',$!{fbsBudgetPage.updateDate})}">
		<input id="status" name="status" type="hidden" value="$!{fbsBudgetPage.status}">
		<input id="corpId" name="corpId" type="hidden" value="$!{fbsBudgetPage.corpId}">
		<input id="timeType" name="timeType" type="hidden" value="$!{fbsBudgetPage.timeType}">
		<input id="beginDate" name="beginDate" type="hidden" value="$!{date.format('yyyy-MM-dd',$!{fbsBudgetPage.beginDate})}">
		<input id="endDate" name="endDate" type="hidden" value="$!{date.format('yyyy-MM-dd',$!{fbsBudgetPage.endDate})}">
        <!-- 是否有调拨科目-->
        <input id="isAllotItemCode" name="isAllotItemCode" type="hidden" value="$!{isAllotItemCode}">
		<!-- 追加 -->
        <input id="superaddId" name="superaddId" type="hidden" value="$!{fbsBudgetPage.superaddId}">
        <input id="target" name="target" type="hidden" value="$!{target}">
        <input id="busName" name="busName" type="hidden" value="$!{busName}">
        <input id="isCollect" name="isCollect" type="hidden" value="$!{isCollect}">

        <!-- 新增币种 -->
        <div class="layui-input-inline" style="padding: 10px; float: right">
            <div class="layui-input-inline">
                #if($!{fbsBudgetPage.isEditCur}=="0")
                    #springMessage('table.fbsBudgetDetail.curId')：
                #else
                    <span class="pl"><span class="required-icon">*</span>#springMessage('table.fbsBudgetDetail.curId')</span>
                #end
            </div>
            <div class="layui-input-inline">
                #if($!{fbsBudgetPage.isEditCur}=="0")
                    <input type="hidden" id="curId" name="curId" lay-verify="required" value="$!{fbsBudgetPage.curId}">
                    $!{currencyTag.getCurName($!{fbsBudgetPage.curId})}
                #else
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="curId" data-biz-name ="curId" data-value="$!{fbsBudgetPage.curId}"
                     data-valueField="id" data-textField="curName" data-required = "true" data-callback="bt.curIdCallback"></div>
                #end
            </div>
            <div class="layui-input-inline">
                <input type="hidden" id="exchangeRate" name="exchangeRate" value="$!{fbsBudgetPage.exchangeRate}">
            </div>
        </div>

        <div style="display:inline-block;width:100%;">
            <div id="maingrid1"></div>
        </div>
        <div style="width: 100%;margin-bottom: 10px;display: none">
		<table id="appTable" class="layui-table" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.fbsBudgetYear.number')</th>
        		<th>#springMessage('table.fbsBudgetYear.itemCode')</th>
                <th>#springMessage('table.fbsBudgetYear.itemName')</th>
				<!-- 计划追加的时候显示上报金额 ，留存金额-->
				#if($!{target} == "super")
                    <th>#springMessage('table.fbsBudgetYear.bMoney')</th>
                    <th>#springMessage('table.fbsBudgetYear.bsuperMoney')(#springMessage('table.fbsBudgetYear.pass'))</th>
                    <th>#springMessage('table.fbsBudgetYear.remainBMoney')</th>
				#end
				<!-- 非年计划且非追加显示 ‘可上报金额’，追加显示‘可追减金额’-->
				#if($!{fbsBudgetPage.parentTimeType} != "")
					#if($!{target} == "super")
					<th>#springMessage('table.fbsBudgetYear.canBSuperMoney')</th>
					#else
					<th>#springMessage('table.fbsBudgetYear.canBMoney')</th>
					#end
				#end
				<th>
					<!-- 计划追加的时候显示追加金额 -->
					#if($!{target} == "super")
						#springMessage('table.fbsBudgetYear.btempMoney')
					#else
						#springMessage('table.fbsBudgetYear.bMoney')
					#end
				</th>
                <th>#springMessage('table.fbsBudgetPeriod.rmk')</th>
                <th>#springMessage('table.fbsBudgetYear.dtl')</th>
            </tr>
            </thead>
        	<tbody>
            	#foreach($date in $dltList)
            		<tr data-tt-id="$!{date.itemCode}" data-tt-parent-id="$!{date.item.superItemCode}" data-tt-subject-sort="$!{date.itemCode}">
            			<td>$!{velocityCount}</td>
            			<td>
                            $!{date.itemCode}
                            <input type="hidden" id="detailId_$!{date.itemCode}" name="detailId" value="$!{date.id}">
                            <input type="hidden" id="itemRelation_$!{date.itemCode}" name="itemRelation" data-curItemCode="$!{date.itemCode}" value="$!{date.item.itemRelation}">
                            <input type="hidden" id="sign_$!{date.itemCode}" name="sign" value="$!{date.item.sign}">
                            <input type="hidden" id="superaddDtlId_$!{date.itemCode}" name="superaddDtlId" value="$!{date.superaddDtlId}">
                        </td>
        				<td>$!{date.itemName}</td>
						<!-- 计划追加的时候显示上报金额 -->
						#if($!{target} == "super")
                            <td align="right">$!{number.formatNumeric($!{date.bMoney})}</td>
                            <td align="right">$!{number.formatNumeric($!{date.bsuperMoney})}</td>
                            <td align="right">
                                <input type="hidden" id="remainBMoney_$!{date.itemCode}" data-name="remainBMoney"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{date.remainBMoney}"
                                       data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="remainBMoney_$!{date.itemCode}">
                                $!{number.formatNumeric($!{date.remainBMoney})}
                            </td>
						#end
						<!-- 非年计划且非追加显示 ‘可上报金额’，追加显示‘可追减金额’-->
        				#if($!{fbsBudgetPage.parentTimeType} != "")
							<td align="right">
            					<input type="hidden" id="canBMoney_$!{date.itemCode}" data-name="canBMoney"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{date.canBMoney}"
                                       data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="canBMoney_$!{date.itemCode}">
                                <div id="canBMoneyDiv_$!{date.itemCode}" name="canBMoneyDiv">$!number.formatNumeric($!{date.canBMoney})</div>
            				</td>	
        				#end
						<!-- 计划追加 -->
        				#if($!{target} == "super")
                            <td align="right">
                                #if($!{date.item.isWrite} == "1")
                                    <input type="text" id="btempMoney_$!{date.itemCode}" lay-verify="required" data-name="btempMoney" data-minus="true"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="calItemMoney"
                                        #if($!{date.hasDetail})
                                           value="$!{date.detailMoney}"  readonly="readonly"
                                        #else
                                           value="$!{date.btempMoney}"
                                        #end
                                        #if($!{date.item.isWriteDetail} == "1")
                                           readonly="readonly"
                                        #end
                                        #if($!{date.item.isBeginPeriod} == "1" || $!{date.item.isEndPeriod} == "1")
                                           data-minus="true"
                                        #end
                                           data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="btempMoney_$!{date.itemCode}" >
                                #else
                                    <input type="hidden" id="btempMoney_$!{date.itemCode}" lay-verify="required" data-name="btempMoney"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="calItemMoney" value="$!{date.btempMoney}" data-minus="true"
                                           data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="btempMoney_$!{date.itemCode}">
                                    <div id="btempMoneyDiv_$!{date.itemCode}" name="btempMoneyDiv" class="clearDiv">$!number.formatNumeric($!{date.btempMoney})</div>
                                #end
                            </td>
        				#else
                            <td align="right" >
                                #if($!{date.item.isWrite} == "1")
                                    <!-- 可填写的期初期末科目允许为负数 -->
                                    <input type="text" id="bMoney_$!{date.itemCode}" name="bMoney" lay-verify="required" data-name="bMoney"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="calItemMoney"
                                        #if($!{date.hasDetail})
                                           value="$!{date.detailMoney}"  readonly="readonly"
                                        #else
                                           value="$!{date.bMoney}"
                                        #end
                                        #if($!{date.item.isWriteDetail} == "1")
                                           readonly="readonly"
                                        #end
                                        #if($!{date.item.isBeginPeriod} == "1" || $!{date.item.isEndPeriod} == "1")
                                           data-minus="true"
                                        #end
                                           data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="bMoney_$!{date.itemCode}">
                                #else
                                    <input type="hidden" id="bMoney_$!{date.itemCode}" name="bMoney" lay-verify="required" data-name="bMoney"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="calItemMoney" value="$!{date.bMoney}"
                                           data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="bMoney_$!{date.itemCode}">
                                    <div id="bMoneyDiv_$!{date.itemCode}" name="bMoneyDiv" class="clearDiv">$!number.formatNumeric($!{date.bMoney})</div>
                                #end
                            </td>
						#end
                        <td align="center">
                            <input style="width: 100%" type="text" id="rmk_$!{date.itemCode}" name="rmk" autocomplete="off"
                                   lay-verify="strlength" data-maxlength="200"  class="layui-input" value="$!{date.rmk}">
                        </td>
						<td>
                            #if($!{date.item.isWrite} == "1" && $!{date.item.isBeginPeriod} != "1" && $!{date.item.isEndPeriod} != "1")
								<!-- 计划追加 -->
								#if($!{target} == "super")
##									#if($!{date.isHasDetail} == "1")
                                        <a class="" href="#" onclick="inputDtlSuper('$!{fbsBudgetPage.superaddId}','$!{date.superaddDtlId}','$!{date.canBMoney}')">#springMessage('common.button.dtl')</a>
##									#end
								#else
									<a class="" href="#" onclick="inputDtl('$!{fbsBudgetPage.id}','$!{date.id}','$!{date.canBMoney}')">#springMessage('common.button.dtl')</a>
								#end
							#end
						</td>
            		</tr>
				#end
            </tbody>
        </table>
        </div>
        <div>
            #if($!{fbsBudgetPage.id} != "")
                <div style="width: 100%;">
                    <table class="layui-table" >
                        <tr>
                            <td class="textRight" width="15%">#springMessage('table.fbsBudget.msg')</td>
                            <td width="85%">
                                <textarea name="msg" id="msg" autocomplete="off" class="layui-textarea" lay-verify="strlength" data-maxlength="150" placeholder="#springMessage('table.fbsBudget.showMsg')"></textarea>
                            </td>
                        </tr>
                    </table>
                </div>
                <p></p>
                <div style="text-align: center; padding-top: 10px;">
                    <!-- 汇总编辑 -->
                    #if($!{isCollect} == "1")
                        <button class="layui-btn" lay-submit="" lay-filter="submit" value="$!{fbsBudgetPage.status}">#springMessage('common.button.save')</button>
                    #else
                        <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
                        <button class="layui-btn" lay-submit="" lay-filter="submit" value="0" id="saveBtn">#springMessage('common.button.temp')</button>
                        <button class="layui-btn" lay-submit="" type="button" onclick="importExcel()" >#springMessage('common.button.imports')</button>
                        <button class="layui-btn" lay-submit="" type="button" onclick="importDtlExcel()" >#springMessage('common.button.imports.fbsbudget.dtl')</button>
                        <button type="reset" class="layui-btn layui-btn-primary" data-callback="clearAll">#springMessage('common.button.reset')</button>
                    #end
                    <!-- 避免刷新，保存明细自动保存计划 -->
                    <button style="display: none" class="layui-btn" lay-submit="" lay-filter="submitAuto" id="saveBut" value="0">#springMessage('common.button.save')</button>
                </div>
            #else
                <div>
                        <span style="text-align: center;color: red">#springMessage(
							'fbs.budget.input.message.itmecode')</span>
                </div>
            #end
        </div>
		<!-- 附件上传 -->
		<input id="attachmentId" name="attachmentId" type="hidden" value="$!{fbsBudgetPage.attachmentId}">
		<div id="uploader" class="layui-input-inline" style="width:100%"></div>
		<!-- 日志 -->
		<div id="tagMsg"></div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsBudget.input.js?_btv=${resourceVersion}"></script>
</html>
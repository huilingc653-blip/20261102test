<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding: 0 10px">
<form class="layui-form layui-form-pane">
    <input id="id" name="id" type="hidden" value="$!{fbsBudgetPage.id}">
    <input id="timeType" name="timeType" type="hidden" value="$!{fbsBudgetPage.timeType}">
    <input id="busName" name="busName" type="hidden" value="$!{busName}">
    <div id="print">
        <table class="layui-table">
            <tbody>
            <tr>
            ##单位
                <td class="textRight">#springMessage('table.fbsBudget.corpId')</td>
                <td>$!{fbsBudgetPage.corpName}</td>
            ##周期类型
                <td class="textRight">#springMessage('table.fbsBudget.timeType')</td>
                <td>$dictTag.get("fbs.timeType",$!{fbsBudgetPage.timeType})</td>
            </tr>
            <tr>
            ##开始日期
                <td class="textRight">#springMessage('table.fbsBudget.beginDate')</td>
                <td>$!date.format('yyyy-MM-dd',$!{fbsBudgetPage.beginDate})</td>
            ##结束日期
                <td class="textRight">#springMessage('table.fbsBudget.endDate')</td>
                <td>$!date.format('yyyy-MM-dd',$!{fbsBudgetPage.endDate})</td>
            </tr>
            <tr>
            ##币种
                <td class="textRight">#springMessage('table.fbsBudgetDetail.curId')</td>
                <td>$!{fbsBudgetPage.curName}</td>
                <td class="textRight"></td>
                <td></td>
            </tr>
            </tbody>
        </table>
        <div style="display:inline-block;width:100%;">
            <div id="maingrid1"></div>
        </div>
        <div style="display: none">
            <table id="appTable" class="layui-table layui-form" style="width:100%;">
                <thead>
                <tr>
                    <th rowspan="2">#springMessage('table.fbsBudgetYear.number')</th>
                    <th rowspan="2">#springMessage('table.fbsBudgetYear.itemCode')</th>
                    <th rowspan="2">#springMessage('table.fbsBudgetYear.itemName')</th>
                    #foreach($week in $weeks)
                        <th >#springMessage('table.fbsBudgetYear.the')$week#springMessage(
                            'table.fbsBudgetPeriod.weeks')</th>
                    #end
                    #foreach($month in $months)
                        <th>$month#springMessage('table.fbsbudget.month')</th>
                    #end
                    <th rowspan="2">#springMessage('table.fbsBudgetYear.dtl')</th>
                </tr>
                <tr>
                    #foreach($week in $weeks)
                        <th>#springMessage('table.fbsBudgetDetail.bMoney')</th>
                    #end
                    #foreach($month in $months)
                        <th>#springMessage('table.fbsBudgetDetail.bMoney')</th>
                    #end
                </tr>
                </thead>
                <tbody>
                    #foreach($date in $rollMonthList)
                        #set($key = 1)
                        #set($b = $!{key} - 1)
                    <tr data-tt-id="$!{date.itemCode}" data-tt-parent-id="$!{date.item.superItemCode}"
                        data-tt-subject-sort="$!{date.itemCode}">
                        <td>$!{velocityCount}</td>
                        <td>$!{date.itemCode}</td>
                        <td>$!{date.itemName}</td>
                        #foreach($weekDate in $date.childWeekBudget)
                            <td align="right">
                                <div name="bMoneyDiv">$!number.formatNumeric($!{weekDate.bMoney})</div>
                            </td>
                        #end
                        #foreach($month in $months)
                            <td align="right" >
                                $!number.formatNumeric($!{date.bMoney.get($!{b})})
                            </td>
                            #set($b = $!{b} + 1)
                            #set($key = $!{key} + 1)
                        #end
                        <td>
                            #if($!{date.item.isWrite} == "1" && $!{date.item.isBeginPeriod} != "1" && $!{date.item.isEndPeriod} != "1")
                                <a class="" href="#" onclick="view('$!{fbsBudgetPage.id}','$!{date.id.get(0)}')">#springMessage('common.button.dtl.view')</a>
                            #end
                        </td>
                    </tr>
                    #end
                </tbody>
            </table>
        </div>
    </div>
    <div style="width: 100%;overflow-x: scroll;margin-bottom: 10px;">
        <table id="appTable" class="layui-table" style="width:100%;">
            <td class="textRight">#springMessage('table.fbsBudget.msg')</td>
            <td width="80%" colspan="15">
                <textarea name="msg" id="msg" autocomplete="off" class="layui-textarea" lay-verify="strlength" readonly="readonly" data-maxlength="150" ></textarea>
            </td>
            </tr>
        </table>
    </div>
    <!-- 附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden" value="$!{fbsBudgetPage.attachmentId}">
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
    <!-- 日志 -->
    <div id="tagMsg"></div>
    <p>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{fbsBudgetPage.id}')">#springMessage('common.button.trackFlow')</button>
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
            <button type="button" class="layui-btn" onclick="exports()">#springMessage('common.button.exports')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form', 'layedit', 'moneyType', 'toLigerTree', 'btUpload', 'printType'], function () {
        var $ = bt.jquery, form = bt.form();
        var moneyType = bt.moneyType.init();
        var moneyFun = bt.moneyType.getFun();
        bt.printType.init();
        bt.toLigerTree.init({
            elem: '#appTable',
            newElem: '#maingrid1',
            rownumbers: true,//序号列数，默为无， 1代表左边第一列为序号列
            isDoubleHeader: true,//是否有双表头
            allowHideColumn: true,
            resize:false,
            height: "80%",
            fixedLeftColumns: 2,
        });
        var up = bt.btUpload.init({
            elem: "#uploader",
            auto: false,
            hasDelete: false,
            hasUpload: false,
            isExpand: true,
            gid: $("#attachmentId").val()
        });

        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml= function () {
            var url = basePath + "/budget/fbsmessage/list/" + $('#id').val() + "/" + $("#busName").val() + "?timestamp=" + new Date().getTime();
            if ($("#target").val() == "superadd") {
                url = basePath + "/budget/fbsmessage/list/" + $('#superaddId').val() + "/" + $("#busName").val() + "?timestamp=" + new Date().getTime();
            }
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                    form.render();
                }
            });
        }
            $genMsgHtml();

        /**
         * 导出
         */
        exports = function () {
            var url = basePath + "/budget/fbsBudgetDownloadAndImport/exportBudgetRollMonth?id=" + $('#id').val() + "&timeType=" + $('#timeType').val() ;
            window.location.href = url;
        };
    });

    //查看明细
    function view(id, detailId) {
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/budget/fbsbudgetdetail/view?budgetId=" + id + "&detailId=" + detailId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/budget/fbsbudgetdetail/view?budgetId=" + id + "&detailId=" + detailId
        });
    };
</script>
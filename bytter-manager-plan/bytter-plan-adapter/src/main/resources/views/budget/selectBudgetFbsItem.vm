<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding: 0 10px">
<form id="searchForm" class="layui-table" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##科目代码
            <td class="textRight">#springMessage('table.fbsItem.itemCode')</td>
            <td>
                <input type="text" id="itemCode" name="itemCode" value="$!{fbsItemPage.itemCode}" style="width: 240px;"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsItem.itemCode')">
            </td>
            ##科目名称
            <td class="textRight">#springMessage('table.fbsItem.itemName')</td>
            <td>
                <input type="text" id="itemName" name="itemName" value="$!{fbsItemPage.itemName}" style="width: 240px;"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsItem.itemName')">
            </td>
            <td >
                <button id="search" class="layui-btn" lay-submit="">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<div style="display:inline-block;width:100%;">
    <div id="maingrid1"></div>
</div>
<div style="width: 100%;overflow-x: scroll;margin-bottom: 10px;">
    <table id="appTable" class="layui-table" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('common.table.thead.operation')</th>
            <th>#springMessage('table.fbsItem.itemCode')</th>
            <th>#springMessage('table.fbsItem.itemName')</th>
            <th>#springMessage('科目流向')</th>
            <th>#springMessage('科目状态')</th>
        </tr>
        </thead>
        <tbody>
        #foreach($data in $treeData)
        <tr data-tt-id="$!{data.itemCode}" data-tt-parent-id="$!{data.superItemCode}" data-id="$!{data.id}">
            <td align="center" class="center ">
                <div class="layui-input-inline">
                    <input type="checkbox" name="checkSingle" class="checkSingle" lay-skin="primary"
                           #if($!{data.isChecked} == 1) checked #end
                           #if($!{data.validSign} == 0) disabled #end>
                </div>
            </td>

            <td>
                <div class="inline-block class-my-data" data-all-name="$!{data.itemCode}($!{data.itemName})">
                    $!{data.itemCode}
                </div>
            </td>
            <td>$!{data.itemName}</td>
            <td align="center">
                #if($!{data.sign} == "-1")
                <font color="#ff0000">$!{data.signName}</font>
                #else
                $!{data.signName}
                #end
            </td>
            <td align="center">
                #if($!{data.validSign} == "0")
                <font color="#ff0000">$!{data.validSignName}</font>
                #else
                $!{data.validSignName}
                #end
            </td>

        </tr>
        #end

        </tbody>
    </table>
</div>

<form class="layui-table" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            <td colspan="6" style="text-align: right;">
                <button class="layui-btn" onClick="fanhui()" type="button"
                        style="font-family: FZLTHIW; height: 32px; background: #fff; border-radius: 2px; color: #333; padding: 0 16px; border: 1px solid #c9c9c9;"
                >#springMessage('返回')</button>
                <button class="layui-btn" onClick="transferData()" type="button"
                style="font-family: FZLTHIW; height: 32px; background: #C70D0D; border-radius: 2px; color: #fff; border: none; padding: 0 15px;"
                >#springMessage('确定')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

#parse("views/common/footer.vm")
<script>

    bt.use(['form', 'toLigerTree', 'selectType', 'dicts', 'datatable'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.selectType.init();
        bt.dicts.init();
        bt.toLigerTree.init({
            elem: '#appTable',
            newElem: '#maingrid1',
            rownumbers: false,//序号列数，默为无， 1代表左边第一列为序号列
            isDoubleHeader: false,//是否有双表头
            allowHideColumn: false,
            resize:false,
            fixedLeftColumns: 2,
        });
        $("#search").click(function () {
            var action = basePath + "/budget/fbsitem/selectBudgetFbsItemQueryList";
            $("#searchForm").attr("action", action);
            $("#searchForm").submit();
        });
        $("#reset").click(function () {
            $("#itemCode").val("");
            $("#itemName").val("");
            return false;
        });

        function adjustViewWidth(){
            $("#maingrid1").width($(".l-grid-header-inner").eq(0).width()+$(".l-grid-header-table").eq(1).width());
        }
        adjustViewWidth();

    });

    //点击提交数据到前台页面
    transferData=function(){
        var info= {};
        var itemCodeStr = '';
        var itemNameStr = '';
        //内置方法返回选中的数据
        //var data=bt.datatable.getSelectData('#appTable');

        $('.checkSingle:checked').each(function(){
            var $row = $(this).closest('tr');
            var itemCode = $row.find('td:eq(1)').text().trim();

            itemCodeStr += itemCode + ';';
            itemNameStr += $row.find('td:eq(1)').find(".class-my-data").attr("data-all-name") + ';';

        });

        //删除结尾的';'
        if (itemCodeStr.endsWith(';')) {
            itemCodeStr = itemCodeStr.slice(0,-1);
        }
        if (itemNameStr.endsWith(';')) {
            itemNameStr = itemNameStr.slice(0,-1);
        }

        info.itemCodeStr = itemCodeStr;
        info.itemNameStr = itemNameStr;

        var currentParentIframe = top.$('.layui-tab-content > .layui-show').find('iframe')[0]['name'];
        var func = top.frames[currentParentIframe].window.btSelectCallBack['bt-biz-budgetFbsItem']['callback'];
        if (func) {
            var data =info;
            func(data);
        }
    }

    function fanhui(){
       parent.layer.closeAll()
    }

</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form  class="layui-form" method="post" id="fbsDtlForm">
<table id="dtlTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('fbs.budget.input.message.itmename')</th>
        <th>#springMessage('fbs.budget.input.message.inputmoney')</th>
        #*<th>#springMessage('table.fbsBudgetDetail.natualMoney')</th>*#
        <th>#springMessage('table.fbsBudgetYear.bsuperMoney')</th>
        #*<th>#springMessage('table.fbsBudgetDetail.natualMoney')</th>*#
        #if($flag == "add")
            <th>#springMessage('table.fbsBudgetYear.btempMoney')</th>
            #*<th>#springMessage('table.fbsBudgetDetail.natualMoney')</th>*#
        #end
        #*<th>#springMessage('table.fbsBudgetDetail.curId')</th>*#
        <th>#springMessage('table.fbsBudgetDetail.vestingDate')</th>
        #foreach($data in $dtlColList)
            #if($data != "")
                <th>$!{data}</th>
            #end
        #end
    </tr>
    </thead>
    <tbody>
    	<input type="hidden" id="detailId" name= "detailId" value="$!{budgetDtl.id}"/>
    	<input type="hidden" id="budgetId" name="budgetId" value="$!{budget.id}"/>
    	<input type="hidden" id="flag" name="flag" value="$!{flag}"/>
    	#foreach($data in $dataList)
    	<tr>
    		<input type="hidden"  name="id" value="$!{data.id}"/>
            <td>($!{budgetDtl.itemCode})$!{budgetDtl.itemName}</td>
            <td align="right"><div  name="bMoneyDiv">$!number.formatNumeric($!{data.bMoney})</div></td>
            #*<td align="right"><div  name="bMoneyDiv">$!number.formatNumeric($!{data.natualMoney})</div></td>*#
            <td align="right"><div  name="bMoneyDiv">$!number.formatNumeric($!{data.bsuperMoney})</div></td>
            #*<td align="right"><div  name="bMoneyDiv">$!number.formatNumeric($!{data.bsuperNatualMoney})</div></td>*#
            #if($flag == "add")
                <td align="right"><div  name="bMoneyDiv">$!number.formatNumeric($!{data.btempMoney})</div></td>
                #*<td align="right"><div  name="bMoneyDiv">$!number.formatNumeric($!{data.btempNatualMoney})</div></td>*#
            #end
            #*<td>
                $!{data.curName}
            </td>*#
            <td>
                $!date.format('yyyy-MM-dd',$!{data.vestingDate})
            </td>
        	#foreach($col in $dtlColValueList)
                #if($col == "settlType")
                <td>
                    $dictTag.get("settlType",$!{data.settlType})
                </td>
                #end
                #if($col == "corpName")
                <td>
                    $!{data.corpName}
                </td>
                #end
                #if($col == "purpose")
                <td>
                    $!{data.purpose}
                </td>
                #end
                #if($col == "wishPayday")
                <td>
                    $!date.format('yyyy-MM-dd',$!{data.wishPayday})
                </td>
                #end
                #if($col == "payerAcc")
                <td>
                    $!{data.payerAcc}
                </td>
                #end
                #if($col == "payeeAccName")
                <td>
                    $!{data.payeeAccName}
                </td>
                #end
                #if($col == "payeeAcc")
                <td>
                    $!{data.payeeAcc}
                </td>
                #end
                #if($col == "payeeBank")
                <td>
                    $!{data.payeeBank}
                </td>
                #end
                #if($col == "contract")
                <td>
                    $!{data.contract}
                </td>
                #end
        	#end
    	</tr>
    	#end
    </tbody>
</table>
</form>
#parse("views/common/footer.vm")
</body>
</html>

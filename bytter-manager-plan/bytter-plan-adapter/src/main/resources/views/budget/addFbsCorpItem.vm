<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
	<input id="itemCorp" name="itemCorp" type="hidden" value="$!{itemCorp}" title="$!{itemCorp}"/>
        <table class="layui-table table-border">
			<tbody>
        	<tr>
        		##单位ID
				<td class="textLeft" style="width: 5%; text-align: right">#springMessage('table.fbsCorpItem.corpId')</td>
				<td style="width: 95%">
					<div class="layui-input-inline">
						<div class="bt-biz-corp"
							 data-biz-type="corp"
							 data-type="selectTree"
							 data-tree-type="check"
							 data-name="corpId"
							 data-scope="all"
							 data-callback="bt.corpId"
                             data-defaultvalue="$!{corpId}"
                             data-ctlBudget="1"
                             data-checkkboxtype="{ 'Y': 's', 'N': 's' }"
                        	 data-textStyle="bt.corpFont"
							 data-clearCallback="bt.clearValue"
                             data-required="true"
							 data-width="450px"
							 data-resource="fbs:fbscorpitem:query"></div>
					</div>
					<span style="font-size:12px; color:red">#springMessage('fbsCorpItem.info')</span>
				</td>
			</tr>
		<tr>
       		##科目代码
			<td class="textLeft" style="width: 5%; text-align: right">#springMessage('table.fbsCorpItem.itemCode')</td>
			<td style="width: 95%" id="innerTree">
				<table class="layui-table" id="corpItem">
					<tbody>
					#foreach($data in $listItem)
						<tr data-tt-id="$!{data.itemCode}" data-tt-parent-id="$!{data.superItemCode}" data-id="$!{data.id}" >
						  <td width="10px" align="center">
						  #if($isSubCorp && !$superCorpItemCode.get($data.itemCode))

						  #else
						  <input type="checkbox" name="itemCodes" class="itemCodes"
							 lay-skin="primary" value="$!{data.itemCode}" lay-filter="itemCorp"
						  #foreach($f in $fbs)
							  #if($f.itemCode == $data.itemCode)
								  checked="true"
							  #end
						  #end
							/>&nbsp;&nbsp;&nbsp;&nbsp;
							#end
						  </td>
						<td>    $!{data.itemName}&nbsp;&nbsp;($!{data.itemCode})</td>
						</tr>
					#end
					</tbody>
				</table>
       		</td>
       	</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" type="button" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button class="layui-btn all" lay-filter="checkall" type="button" id="checkAll">#springMessage('common.check.all')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsCorpItem.add.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fbsExcrateAdjustPage.id}">
    <input id="createBy" name="createBy" type="hidden" value="$!{fbsExcrateAdjustPage.createBy}">
    <input id="createDate" name="createDate" type="hidden" value="$!{fbsExcrateAdjustPage.createDate}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{fbsExcrateAdjustPage.updateBy}">
    <input id="updateDate" name="updateDate" type="hidden" value="$!{fbsExcrateAdjustPage.updateDate}">
    <table class="layui-table">
        <tbody>
        <tr>
        ##原始货币名称
            <td class="textRight">#springMessage('table.fbsExcrateAdjust.curName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-valuefield="id" data-textfield="curName" data-name="curId"
                     data-required="true" data-biz-name="curId" data-initcallback="bt.initCur"
                     data-callback="bt.curCallback"
                     data-defaultvalue="$!{fbsExcrateAdjustPage.curId}"
                     data-itemdisabled="$!{fbsExcrateAdjustPage.referCurId}"></div>
            </td>
        ##原始货币英文简码
            <td class="textRight">#springMessage('table.fbsExcrateAdjust.englishCode')</td>
            <td>
                <input type="text" id="englishCode" class="layui-input" readonly="readonly" lay-verify="required"
                       placeholder="#springMessage('table.fbsExcrateAdjust.englishCode')"
                       value="$!{fbsExcrateAdjustPage.englishCode}">
            </td>
        </tr>
        <tr>
        ##目标货币名称
            <td class="textRight">#springMessage('table.fbsExcrateAdjust.referCurName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-valuefield="id" data-textfield="curName" data-name="referCurId"
                     data-required="true" data-biz-name="referCurId" data-initcallback="bt.initreferCur"
                     data-callback="bt.referCurCallback" data-defaultvalue="$!{fbsExcrateAdjustPage.referCurId}"
                     data-itemdisabled="$!{fbsExcrateAdjustPage.curId}"></div>
            </td>
        ##目标货币英文简码
            <td class="textRight">#springMessage('table.fbsExcrateAdjust.referEnglishCode')</td>
            <td>
                <input type="text" id="referEnglishCode" class="layui-input" readonly="readonly" lay-verify="required"
                       placeholder="#springMessage('table.fbsExcrateAdjust.referEnglishCode')"
                       value="$!{fbsExcrateAdjustPage.referEnglishCode}">
            </td>
        </tr>
        <tr>
        ##计划汇率
            <td class="textRight">#springMessage('table.fbsExcrateAdjust.exchangeRate')</td>
            <td>
                <input type="text" data-biz-name="exchangeRate" data-name="exchangeRate"
                       class="layui-input bt-biz-moneyType" data-decimal="4" data-minus="false" data-type="percent"
                       placeholder="#springMessage('table.fbsExcrateAdjust.exchangeRate')" lay-verify="required"
                       data-callback="bt.setRate" data-min="0.0001" data-separator=""
                       value="$!{fbsExcrateAdjustPage.exchangeRate}">
            </td>
            <td class="textRight" width="15%">#springMessage('table.fbsBudgetPeriod.rmk')</td>
            <td>
                <input type="text" id="rmk" name="rmk" class="layui-input" value="$!{fbsExcrateAdjustPage.rmk}"
                       placeholder="#springMessage('table.fbsBudgetPeriod.rmk')">
            </td>
        </tr>
        <tr>
        ##示例说明
            <td class="textRight" width="15%">#springMessage('table.fbsExcrateAdjust.example')</td>
            <td colspan="3">
                <input type="text" id="example" name="example" class="layui-input" readonly="readonly"
                       value="$!{fbsExcrateAdjustPage.example}" style="width: 40%"
                       placeholder="#springMessage('table.fbsExcrateAdjust.example')">
            </td>

        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/budget/fbsExcrateAdjust.edit.js?_btv=${resourceVersion}"></script>
</html>
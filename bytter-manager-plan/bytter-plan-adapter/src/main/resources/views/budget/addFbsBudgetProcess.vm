<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
    <style>

        #tagItemDetail .bt-selectTree-close, .bt-selectTableType-close {
            right: 15px!important;
            top: 8px!important;
            height: 16px!important;
        }
        #tagItemDetail .line_border {
            border-top:none;
        }
        #tagItemDetail x* {
            position: relative;
        }
        #tagItemDetail .x10.line.line_border {
            border-right: none!important;
        }
        #tagItemDetail .line_border > div{
            line-height: normal;
        }
        #tagItemDetail a {
            color: #3D8EFF;
        }
    </style>
</head>
<body>
<form class="layui-form verify" method="post">
    <input id="createBy" name="createBy" type="hidden" value="$!{fbsBudgetProcessPage.createBy}">
    <input id="createDate" name="createDate" type="hidden" value="$!{fbsBudgetProcessPage.createDate}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{fbsBudgetProcessPage.updateBy}">
    <input id="id" name="id" type="hidden" value="$!{fbsBudgetProcessPage.id}">
    <input id="curCode" name="curCode" type="hidden" value="$!{fbsBudgetProcessPage.curCode}">
    <input id="settlType" name="settlType" type="hidden" value="$!{fbsBudgetProcessPage.settlType}">
    <input id="corpName" name="corpName" type="hidden" value="$!{fbsBudgetProcessPage.corpName}">
    <input id="purpose" name="purpose" type="hidden" value="$!{fbsBudgetProcessPage.purpose}">
    <input id="wishPayday" name="wishPayday" type="hidden" value="$!{fbsBudgetProcessPage.wishPayday}">
    <input id="payerAcc" name="payerAcc" type="hidden" value="$!{fbsBudgetProcessPage.payerAcc}">
    <input id="payeeAcc" name="payeeAcc" type="hidden" value="$!{fbsBudgetProcessPage.payeeAcc}">
    <input id="payeeBank" name="payeeBank" type="hidden" value="$!{fbsBudgetProcessPage.payeeBank}">
    <input id="contract" name="contract" type="hidden" value="$!{fbsBudgetProcessPage.contract}">
    <input id="vestingDate" name="vestingDate" type="hidden" value="$!{fbsBudgetProcessPage.vestingDate}">
    <input id="businessName" name="businessName" type="hidden" value="$!{fbsBudgetProcessPage.businessName}">
    <input id="processSysname" name="processSysname" type="hidden" value="$!{fbsBudgetProcessPage.processSysname}">
    <input id="corpsList" name="corpsList" type="hidden" value="$!{corpsList}">
    <table class="layui-table">
        <tbody>
        <tr>
		##单位
            <td class="textRight">#springMessage('table.fbsBudgetProcess.corpId')</td>
            <td width="40%">
##                <div class="layui-input-inline">
##                    <div class="demo-selectTree-normal" ></div>
##                </div>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                     data-biz-type="corp"
                     data-type="selectTree"
                     data-name="corpId"
                     data-biz-name="corpId"
                     data-scope="all"
                     data-resource="fbs:process:fbsBudgetProcess:apply"
                     data-required="true"
                     data-callback="bt.corpCallback"></div>
                </div>
            </td>
		##单据号
            <td class="textRight">#springMessage('table.fbsBudgetProcess.billNo')</td>
            <td width="40%">
                <input type="text" id="billNo" name="billNo" lay-verify="langKey" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetProcess.billNo')">
            </td>
        </tr>
        <tr>
		##执行金额
            <td class="textRight">#springMessage('table.fbsBudgetProcess.processMoney')</td>
		##金额（小写）
            <td>
                <input type="text" data-name="processMoney" data-biz-name="processMoney"
                       class="layui-input bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                       autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.money.lower')">

            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.money.upper')</td>
            <td>
			##金额（大写）
                <div id="moneyUp" name="moneyUp" readonly="true" data-name="moneyUp"
                     autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.money.upper')">
                </div>
            </td>

        </tr>
        <tr>
            ##内转标识
            <td class="textRight">#springMessage('table.fbsBudgetProcess.innerSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="innerSign" data-biz-name="innerSign" data-callback="bt.innerSign"></div>
            </td>
            ##收款账号名称
            <td class="textRight">#springMessage('bisBifRule.payeeName')</td>
            <td>
                <div id="corp1">
                    <div class="layui-input-inline">
                    <input type="text" id="payeeAccName" name="payeeAccName"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetProcess.payeeAccName')">
                        <div class="bt-div-search" id="pledgeeNameDiv">
                            <button class="bt-biz-externalCorpBankAcc" id="bt-biz-externalCorpBankAcc" type="button"  data-callback="bt.payeeAccCallback" title="#springMessage('common.button.select')">
                                <i class="layui-icon">&#xe615;</i>
                            </button>
                        </div>
                    </div>
                </div>
                <div id="corp2" style="display:none">
                    <div class="bt-biz-selectType" data-name="payeeAccName" data-biz-name="payeeAccName"
                         data-url="" data-valuefield="id" data-textfield="name"></div>
                </div>
            </td>
        </tr>
        <tr>
		##执行日期
            <td class="textRight">#springMessage('table.fbsBudgetProcess.processDate')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" name="processDate" lay-verify="required" data-callback="clickDate" data-today="true" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="processDate" lay-verify="date">
                </div>
            </td>
        ##币别
            <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
            <td>
                <div class="bt-biz-selectType" data-name="curId" data-biz-name="curId" data-defaultvalue="$!{currencyTag.getNatualCurrency().id}" data-callback="bt.curIdCallback"
                     data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-textfield="curName" data-required="true"></div>
            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight">#springMessage('table.fbsBudgetProcess.rmk')</td>
            <td colspan="3">
                <input type="text" id="rmk" name="rmk" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetProcess.rmk')">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" type="button" id="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" type="button" id="temp">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallback">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <div id="tagItemDetail">

    </div>
</form>
	#parse("views/common/footer.vm")
<script src="${basePath}/static/modules/budget/fbsBudgetProcess.add.js?_btv=${resourceVersion}"></script>
</body>
</html>

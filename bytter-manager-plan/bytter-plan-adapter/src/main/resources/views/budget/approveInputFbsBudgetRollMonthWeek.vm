<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        table .layui-input {
            width: 148px;
        }
    </style>
</head>
<body style="padding: 0 10px">
<form class="layui-form ignore-required-icon" method="post" id="inputForm">
    <input id="id" name="id" type="hidden" value="$!{fbsBudgetPage.id}">
    <input id="createBy" name="createBy" type="hidden" value="$!{fbsBudgetPage.createBy}">
    <input id="createDate" name="createDate" type="hidden" value="$!{fbsBudgetPage.createDate}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{fbsBudgetPage.updateBy}">
    <input id="updateDate" name="updateDate" type="hidden" value="$!{fbsBudgetPage.updateDate}">
    <input id="status" name="status" type="hidden" value="$!{fbsBudgetPage.status}">
    <input id="corpId" name="corpId" type="hidden" value="$!{fbsBudgetPage.corpId}">
    <input id="timeType" name="timeType" type="hidden" value="$!{fbsBudgetPage.timeType}">
    <input id="beginDate" name="beginDate" type="hidden" value="$!date.format('yyyy-MM-dd',$!{fbsBudgetPage.beginDate})">
    <input id="endDate" name="endDate" type="hidden" value="$!date.format('yyyy-MM-dd',$!{fbsBudgetPage.endDate})">
    <input id="target" name="target" type="hidden" value="$!{target}">
    <input id="isApprove" name="isApprove" type="hidden" value="true">
    <input type="hidden" id="curId" name="curId" lay-verify="required" value="$!{fbsBudgetPage.curId}">
    <input type="hidden" id="exchangeRate" name="exchangeRate" value="$!{fbsBudgetPage.exchangeRate}">
    <input id="busName" name="busName" type="hidden" value="$!{busName}">
    #foreach($budget in $fbsBudgetList)
        <input  name="nextId" type="hidden" value="$!{budget.id}">
    #end
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage('table.fbsBudget.corpId')</td>
            <td>$!{fbsBudgetPage.corpName}</td>
        ##周期类型
            <td class="textRight">#springMessage('table.fbsBudget.timeType')</td>
            <td>$dictTag.get("fbs.timeType",$!{fbsBudgetPage.timeType})</td>
        </tr>
        <tr>
        ##开始日期
            <td class="textRight">#springMessage('table.fbsBudget.beginDate')</td>
            <td>$!date.format('yyyy-MM-dd',$!{fbsBudgetPage.beginDate})</td>
        ##结束日期
            <td class="textRight">#springMessage('table.fbsBudget.endDate')</td>
            <td>$!date.format('yyyy-MM-dd',$!{fbsBudgetPage.endDate})</td>
        </tr>
        <tr>
        ##币种
            <td class="textRight">#springMessage('table.fbsBudgetDetail.curId')</td>
            <td>$!{fbsBudgetPage.curName}</td>
            <td class="textRight"></td>
            <td class="textRight">
                #if($!{collectFlag} == "1")
                    <button class="layui-btn" type="button" onclick="dtlView();" >#springMessage('common.button.dtlView')</button>
                #end
            </td>
        </tr>
        </tbody>
    </table>
    <div style="display:inline-block;width:100%;">
        <div id="maingrid1"></div>
    </div>
<div style="width: 100%;overflow-x: scroll;margin-bottom: 10px;display: none;">
<table id="appTable" class="layui-table" style="width:100%;">
    <thead>
    <tr>
        <th rowspan="2">#springMessage('table.fbsBudgetYear.number')</th>
        <th rowspan="2">#springMessage('table.fbsBudgetYear.itemCode')</th>
        <th rowspan="2">#springMessage('table.fbsBudgetYear.itemName')</th>
        #if($!{fbsBudgetPage.parentTimeType} != "")
            <th rowspan="2">#springMessage('table.fbsBudgetYear.canBMoney')</th>
        #end
        #foreach($month in $months)
            #if($!month.childList)
                #set($weekSize = $!month.childList.size())
                #if($!{weekSize} > 1)
                    #set($weekSize = ${weekSize}+1)
                #end
                <th colspan="$!{weekSize}">$month.paternal#springMessage('table.fbsbudget.month')</th>
            #else
                <th rowspan="2">$month.paternal#springMessage('table.fbsbudget.month')</th>
            #end
        #end
            <th rowspan="2">#springMessage('table.fbsBudgetPeriod.rmk')</th>
            <th rowspan="2">#springMessage('table.fbsBudgetYear.dtl')</th>
    </tr>
    <tr>
        #foreach($month in $months)
            #if($!month.childList)
                #foreach($week in $month.childList)
                    <th >#springMessage('table.fbsBudgetYear.the')$week#springMessage('table.fbsBudgetPeriod.weeks')</th>
                #end
                <th>$month.paternal#springMessage('table.fbsbudget.month')</th>
            #end
        #end
    </tr>
    </thead>
<tbody>
    #set($length = $rollMonthList.size())
    #foreach($date in $rollMonthList)
        #set($i = 0)
        #set($key = 1)
        #set($b = $!{key} - 1)
    <tr data-tt-id="$!{date.itemCode}" data-tt-parent-id="$!{date.item.superItemCode}" data-tt-subject-sort="$!{date.itemCode}">
        <td>
            $!{velocityCount}
        </td>
        <td>
            <div class="inline-block" style="width: 160px;">
                $!{date.itemCode}
                <input type="hidden"  name="detailId" value="$!{date.id.get($!{b})}">
                <input type="hidden" id="itemCode_$!{date.itemCode}" name="itemCode" value="$!{date.itemCode}">
                <input type="hidden" id="itemRelation_$!{date.itemCode}" name="itemRelation" data-curItemCode="$!{date.itemCode}" value="$!{date.item.itemRelation}">
                <input type="hidden" id="sign_$!{date.itemCode}" name="sign" value="$!{date.item.sign}">
                <input type="hidden" id="isBeginPeriod_$!{date.itemCode}" name="isBeginPeriod" value="$!{date.item.isBeginPeriod}">
                <input type="hidden" id="isEndPeriod_$!{date.itemCode}" name="isEndPeriod" value="$!{date.item.isEndPeriod}">
            </div>
        </td>
        <td>$!{date.itemName}</td>
        #if($!{fbsBudgetPage.parentTimeType} != "")
            <td align="right">
                <input type="hidden" id="canBMoney_$!{date.itemCode}" data-name="canBMoney"
                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{date.canBMoney}"
                       data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="canBMoney_$!{date.itemCode}"
                       data-isBeginPeriod="$!{date.item.isBeginPeriod}" data-isEndPeriod="$!{date.item.isEndPeriod}">
            $!number.formatNumeric($!{date.canBMoney})</div>
            </td>
        #end
        #set( $weekNumber = $months.size() +1 )
        #foreach($weekDateList in $date.childWeekBudget)
            #set($i = $!{i} + 1)
            #foreach($weekDate in $weekDateList)
                <td align="right">
                    <input type="hidden" id="weekDetailId_$!{date.itemCode}_$weekNumber" name="weekDetailId$!{weekNumber}" value="$!{weekDate.id}">
                    #if($!{date.item.isWrite} == "1")
                        <input type="text" id="bMoney${weekNumber}_$!{date.itemCode}" name="bMoneyWeek$!{weekNumber}" lay-verify="required" data-name="bMoneyWeek$!{weekNumber}"
                               autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="calItemMoney" data-key="${weekNumber}"
                            #if($!{weekDate.detailMoney})
                               value="$!{weekDate.detailMoney}"  readonly="readonly"
                            #else
                               value="$!{weekDate.bMoney}"
                            #end
                            #if($!{date.item.isWriteDetail} == "1")
                               readonly="readonly"
                            #end
                            #if($!{date.item.isBeginPeriod} == "1" || $!{date.item.isEndPeriod} == "1")
                               data-minus="true"
                            #end
                               data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="bMoney${weekNumber}_$!{date.itemCode}"
                               data-period-name="bMoney${weekNumber}" data-isBeginPeriod="$!{date.item.isBeginPeriod}" data-isEndPeriod="$!{date.item.isEndPeriod}">
                    #else
                        <input type="hidden" id="bMoney${weekNumber}_$!{date.itemCode}" name="bMoneyWeek$!{weekNumber}" data-name="bMoneyWeek$!{weekNumber}"
                               autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="calItemMoney" value="$!{weekDate.bMoney}" data-key="${weekNumber}"
                               data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="bMoney${weekNumber}_$!{date.itemCode}"
                               data-period-name="bMoney${weekNumber}" data-isBeginPeriod="$!{date.item.isBeginPeriod}" data-isEndPeriod="$!{date.item.isEndPeriod}">
                        <div id="bMoneyDiv${weekNumber}_$!{date.itemCode}" name="bMoneyDiv">$!number.formatNumeric($!{weekDate.bMoney})</div>
                    #end
                </td>
                #set($weekNumber = $weekNumber+1)
            #end
            <td align="right" >
                <input type="hidden" id="weekNumber$!{velocityCount}" value="${weekNumber}"/>
                <input type="hidden"  name="detailId$!{key}" value="$!{date.id.get($!{b})}">
                <input type="hidden" id="bMoney$!{key}_$!{date.itemCode}" name="bMoney$!{key}" data-name="bMoney$!{key}"
                       autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="calItemMoney" value="$!{date.bMoney.get($!{b})}" data-key="$!{key}"
                       data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="bMoney$!{key}_$!{date.itemCode}"
                       data-isBeginPeriod="$!{date.item.isBeginPeriod}" data-isEndPeriod="$!{date.item.isEndPeriod}">
                <div id="bMoneyDiv$!{key}_$!{date.itemCode}" name="bMoneyDiv">$!number.formatNumeric($!{date.bMoney.get($!{b})})</div>
            </td>
            #set($key = $!{key} + 1)
            #set($b = $!{b} + 1)
        #end
        #foreach($month in $months)
            #if( $!{key} >$!{i} && $!{key} <= ${months.size()})
                <td align="right" >
                    <input type="hidden"  name="detailId$!{key}" value="$!{date.id.get($!{b})}">
                    #if($!{date.item.isWrite} == "1")
                        <input type="text" id="bMoney$!{key}_$!{date.itemCode}" name="bMoney$!{key}" lay-verify="required" data-name="bMoney$!{key}"
                               autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="calItemMoney" data-key="$!{key}"
                               data-period-name="bMoney${key}" data-isBeginPeriod="$!{date.item.isBeginPeriod}" data-isEndPeriod="$!{date.item.isEndPeriod}"
                            #if($!{date.detailMoney.get($!{b})})
                               value="$!{date.detailMoney.get($!{b})}"  readonly="readonly"
                            #else
                               value="$!{date.bMoney.get($!{b})}"
                            #end
                            #if($!{date.item.isBeginPeriod} == "1" || $!{date.item.isEndPeriod} == "1")
                               data-minus="true"
                            #end
                               data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="bMoney$!{key}_$!{date.itemCode}">
                    #else
                        <input type="hidden" id="bMoney$!{key}_$!{date.itemCode}" name="bMoney$!{key}" data-name="bMoney$!{key}"
                               autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="calItemMoney" value="$!{date.bMoney.get($!{b})}" data-key="$!{key}"
                               data-itemCode="$!{date.itemCode}" data-superItemCode="$!{date.item.superItemCode}" data-biz-name="bMoney$!{key}_$!{date.itemCode}"
                               data-period-name="bMoney${key}" data-isBeginPeriod="$!{date.item.isBeginPeriod}" data-isEndPeriod="$!{date.item.isEndPeriod}">
                        <div id="bMoneyDiv$!{key}_$!{date.itemCode}" name="bMoneyDiv" class="clearDiv">$!number.formatNumeric($!{date.bMoney.get($!{b})})</div>
                    #end
                </td>
                #set($b = $!{b} + 1)
                #set($key = $!{key} + 1)
            #end
            #set($i = $!{i} - 1)
        #end
            <td>
                <input type="text" id="rmk_$!{date.itemCode}" name="rmk" autocomplete="off" class="layui-input" value="$!{date.rmk}">
            </td>
            <td data-width="80">
                #if($!{date.item.isWrite} == "1" && $!{date.item.isBeginPeriod} != "1" && $!{date.item.isEndPeriod} != "1")
                    #if($!{collectFlag} != "1")
                        <a class="" href="#" onclick="inputDtl('$!{fbsBudgetPage.id}','$!{date.id.get(0)}','$!{date.canBMoney}')">#springMessage('common.button.dtl')</a>
                    #else
                        <a class="" href="#" onclick="viewDtl('$!{fbsBudgetPage.id}','$!{date.id.get(0)}')">#springMessage('common.button.dtl.view')</a>
                    #end
                #end
            </td>
        </tr>
    #end
    </tbody>
    </table>
    </div>

    <div>
        #if($!{fbsBudgetPage.id} != "")
            <div style="text-align: center;">
                #if($!{collectFlag} != "1")
                    <button class="layui-btn" lay-submit="" lay-filter="submit" value="$!{fbsBudgetPage.status}">#springMessage('common.button.submit')</button>
                #end
            </div>
        #end
    </div>
    <!-- 附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden" value="$!{fbsBudgetPage.attachmentId}">
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
    <!-- 日志 -->
    <div id="tagMsg"></div>
</form>
    #parse("views/common/footer.vm")
    #if($!{showNetAmount} == "1")
        #set($btnPrependHtml = '<button type="button" class="layui-btn" id="showNetAmount" onclick="showNetAmount()">'+"#springMessage('fbsBudget.button.viewNetAmount')"+'</button>')
        #workFlowHtml($!{btnPrependHtml})
    #else
        #workFlowHtml()
    #end
    #workFlowScript()
</body>
<script>
    var months = $monthsHid;
    var toWeeks = $!{mRollSubperiod};
</script>
<script src="${basePath}/static/modules/budget/fbsBudgetRollMonthWeek.input.js?_btv=${resourceVersion}"></script>
</html>
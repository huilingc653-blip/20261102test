<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bytter.job.admin.dao.XxlJobOperateLogDao">

    <resultMap id="XxlJobOperateLog" type="com.bytter.job.admin.core.model.XxlJobOperateLog" >
        <result column="id" property="id" />
        <result column="operate_time" property="operateTime" />
        <result column="user_id" property="userId" />
        <result column="username" property="username" />
        <result column="job_id" property="jobId" />
        <result column="operate_type" property="operateType" />
        <result column="ip" property="ip" />
        <result column="description" property="description" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
        <result column="is_deleted" property="isDeleted" />
    </resultMap>

    <sql id="Base_Column_List">
        t.id,
		t.operate_time,
		t.user_id,
		t.username,
		t.job_id,
		t.operate_type,
		t.ip,
		t.description,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.is_deleted
    </sql>

    <insert id="save" parameterType="com.bytter.job.admin.core.model.XxlJobOperateLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO xxl_job_operate_log (
        `operate_time`,
        `user_id`,
        `username`,
        `job_id`,
        `operate_type`,
        `ip`,
        `description`,
        `create_by`,
        `create_time`,
        `update_by`,
        `update_time`,
        `is_deleted`
        ) VALUES (
        #{operateTime},
        #{userId},
        #{username},
        #{jobId},
        #{operateType},
        #{ip},
        #{description},
        #{createBy},
        #{createTime},
        #{updateBy},
        #{updateTime},
        #{isDeleted}
        );
    </insert>

    <select id="pageList" resultMap="XxlJobOperateLog">
        SELECT <include refid="Base_Column_List" /> ,i.job_desc jobDesc
            from xxl_job_operate_log AS t left join xxl_job_info i on t.job_id = i.id
        <trim prefix="WHERE" prefixOverrides="AND | OR" >
            <if test="username != null and username != ''">
                AND t.username like CONCAT(CONCAT('%', #{username}), '%')
            </if>
            <if test="jobDesc != null and jobDesc != ''">
                AND i.job_desc like CONCAT(CONCAT('%', #{jobDesc}), '%')
            </if>
            <if test="operateType != null and operateType != ''">
                AND t.operate_type = #{operateType}
            </if>
            <if test="operateTimeStart != null">
                AND t.operate_time <![CDATA[ >= ]]> #{operateTimeStart}
            </if>
            <if test="operateTimeEnd != null">
                AND t.operate_time <![CDATA[ <= ]]> #{operateTimeEnd}
            </if>
        </trim>
        ORDER BY t.operate_time DESC
        LIMIT #{offset}, #{pagesize}
    </select>
    <select id="pageListCount" resultType="java.lang.Integer">
        SELECT count(1) FROM xxl_job_operate_log AS t left join xxl_job_info i on t.job_id = i.id
        <trim prefix="WHERE" prefixOverrides="AND | OR" >
            <if test="username != null and username != ''">
                AND t.username like CONCAT(CONCAT('%', #{username}), '%')
            </if>
            <if test="jobDesc != null and jobDesc != ''">
                AND i.job_desc like CONCAT(CONCAT('%', #{jobDesc}), '%')
            </if>
            <if test="operateType != null and operateType != ''">
                AND t.operate_type = #{operateType}
            </if>
            <if test="operateTimeStart != null">
                AND t.operate_time <![CDATA[ >= ]]> #{operateTimeStart}
            </if>
            <if test="operateTimeEnd != null">
                AND t.operate_time <![CDATA[ <= ]]> #{operateTimeEnd}
            </if>
        </trim>
    </select>
</mapper>
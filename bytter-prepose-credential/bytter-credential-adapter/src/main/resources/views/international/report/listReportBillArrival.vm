<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="searchForm">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('international.credit.lcInter')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" id="lcInter" data-type="select" data-group="letter_of_credit_inter"  value="$!{lcEnrol.lcInter}"
                         data-name="eqs_lcInter" data-biz-name="lcInter" >
                    </div>
                </div>
            </td>
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <input type="text" class="layui-input" name="likes_creditNo" />
            </td>
        </tr>
        <tr>
            <td class="textRight">
                #springMessage('table.internation.arrival.com.no')
            </td>
            <td>
                <input type="text" class="layui-input" name="likes_arrivalCode" />
            </td>
            <td class="textRight">
                #springMessage('table.internation.payment.money')
            </td>
            <td>
                <div>
                    <input style="display: inline-block;width: 30%" data-biz-name="gti_payMoney" type="text" class="layui-input bt-biz-moneyType" name="gti_payMoney" />
                    <span class=date-mid>~</span>
                    <input style="display: inline-block;width: 30%" data-biz-name="lti_payMoney" type="text" class="layui-input bt-biz-moneyType" name="lti_payMoney" />
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="" lay-filter="search">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>


<table id="datatable" class="layui-table" style="width:100%">
    <thead>
    <tr>
        <th>#springMessage('table.internation.arrival.com.no')</th>##到单号
        <th>#springMessage('international.credit.lcInter')</th>##信用证类型
        <th>#springMessage('international.credit.creditNo')</th>##信用证号
        <th>#springMessage('international.credit.applicant')</th>##开证人
        <th>#springMessage('international.credit.beneficiary')</th>##受益人
        <th>#springMessage('international.credit.contractNo')</th>##合同号
        <th>#springMessage('international.payment.curName')</th>##币别
        <th>#springMessage('international.credit.creditMoney')</th>##开证金额
        <th>#springMessage('international.credit.createDate')</th>##登记日期
        <th>#springMessage('international.credit.delayDates')</th>##远期天数
        <th>#springMessage('table.internation.com.arrival.money')</th>##来单金额
        <th>#springMessage('table.internation.payment.money')</th>##付汇金额
        <th>#springMessage('table.international.arrival.paymentDate')</th>##到单日期
        <th>#springMessage('table.international.pay.date')</th>##付汇日期
        <th>#springMessage('international.lcDeposit.money')</th>##押汇金额
        <th>#springMessage('international.lcDeposit.depositDate')</th>##押汇日期
        <th>#springMessage('international.lcDeposit.expiryDate2')</th>##押汇到期日期
        <th>#springMessage('international.lcDepositRepay.repayMoney')</th>##还押汇金额
##        <th>#springMessage('international.lcDepositRepay.repayDate')</th>##还押汇日期
        <th>#springMessage('international.arrival.com.bankName')</th>##到单银行
        <th>#springMessage('international.credit.status')</th>##状态
        <th>#springMessage('international.lcDeposit.rmk')</th>##备注
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery','dicts','datatable','money','moneyType'], function(){
        $ = bt.jquery;
        bt.dicts.init();
        bt.moneyType.init();
        var datatable = bt.datatable.init({
            elem : "#datatable",
            checkbox : false,
            ajax : {
                url : "queryReportBillArrival",
                dataSrc : "data"
            },
            fixedColumns: {
                rightColumns: 1//代表冻结右边一列
            },
            colReorder : true,
            columns : [
                {
                    data : "arrivalCode",
                    className : "center"
                },{
                    data : "lcInter",
                    className : "center",
                    render : function (data, type, full, meta) {
                        return bt.dict("letter_of_credit_inter",full.lcInter);
                    }
                },{
                    data : "creditNo",
                    className : "center"
                },{
                    data : "applicant",
                    className : "center"
                },{
                    data : "beneficiary",
                    className : "center"
                },{
                    data : "contractNo",
                    className : "center"
                },{
                    data : "curName",
                    className : "center"
                },{
                    data : "creditMoney",
                    className : "textRight",
                    render : function (data, type, full, meta) {
                        return bt.money.format(full.creditMoney);
                    }
                },{
                    data : "createDate",
                    className : "center"
                },{
                    data : "delayDates",
                    className : "center"
                },{
                    data : "billMoney",
                    className : "textRight",
                    render : function (data, type, full, meta) {
                        return bt.money.format(full.billMoney);
                    }
                },{
                    data : "payMoney",
                    className : "textRight",
                    render : function (data, type, full, meta) {
                        return bt.money.format(full.payMoney);
                    }
                },{
                    data : "paymentDate",
                    className : "center"
                },{
                    data : "payDate",
                    className : "center"
                },{
                    data : "depositMoney",
                    className : "textRight",
                    render : function (data, type, full, meta) {
                        return bt.money.format(full.depositMoney);
                    }
                },{
                    data : "depositDate",
                    className : "center"
                },{
                    data : "expiryDate",
                    className : "center"
                },{
                    data : "repayMoney",
                    className : "textRight",
                    render : function (data, type, full, meta) {
                        return bt.money.format(full.repayMoney);
                    }
                }
/*                ,{
                    data : "repayDate",
                    className : "center"
                }*/
                ,{
                    data : "handDocBank",
                    className : "center"
                },{
                    data : "status",
                    className : "center",
                    render : function (data, type, full, meta) {
                        var status = "";
                        if(full.status == 2){
                            status = bt.dict("international.lcPayment.status",full.status2);
                        }else if (full.status == 3) {
                            status = bt.dict("international.deposit.status",full.status2);
                        }else {
                            status = bt.dict("international.lcBillArrival.status", full.status);
                        }
                        return status;
                    }
                },{
                    data : "rmk",
                    className : "center"
                },{
                    data : null,
                    className : "center",
                    render : function (data, type, full, meta) {
                        var  explode = "<span class=\"text-explode\">|</span>"
                        var id = full.id;
                        var html = "<a class=\"\" href=\"#\" data-row=\""+meta.row+"\" onclick=\"view('"+ id +"')\">"+bt.lang("common.button.view")+"</a>";
                        return html;
                    }
                }
            ],
            summary: {
                pageSum: false,//小计功能开启
                allSum: true,
                // selectSum: true,//已选汇总功能开启
                outerData: false, //利用外部数据进行汇总
                format: {
                    decimal: 3
                },
                sumList: [

                    {
                        colNum: '8',
                        dataName: 'creditMoney',
                    }, {
                        colNum: '11',
                        dataName: 'billMoney'
                    }, {
                        colNum: '12',
                        dataName: 'payMoney'
                    }, {
                        colNum: '15',
                        dataName: 'depositMoney'
                    }, {
                        colNum: '18',
                        dataName: 'repayMoney'
                    }
                ]
            },
            btInitComplete:function(setting,json){
            },
            searchForm : {
                formElem : "#searchForm",
                formFilter : "search",
                callback : function (data) {

                }
            }
        });
        //这里填写新的js代码，请参考前端文档
    });

    function view(id){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('international.lcBillArrival.info'),basePath + "/international/credit/billArrival/viewBillArrival?id=" +id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/international/credit/billArrival/viewBillArrival?id="+id,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }
</script>
</body>
</html>

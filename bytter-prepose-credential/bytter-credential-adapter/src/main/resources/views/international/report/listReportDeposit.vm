<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="searchForm">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('international.credit.lcInter')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" id="lcInter" data-type="select" data-group="letter_of_credit_inter"  value="$!{lcEnrol.lcInter}"
                         data-name="eqs_lcInter" data-biz-name="lcInter" >
                    </div>
                </div>
            </td>
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <input type="text" class="layui-input" name="likes_creditNo" />
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('押汇状态')</td>
            <td>
                <div class="layui-inline">
                    <input type="checkbox" lay-skin="primary" name="depositStatus" value="1" title="#springMessage('未完结')">
                    <input type="checkbox" lay-skin="primary" name="depositStatus" value="2" title="#springMessage('已完结')">
                </div>
            </td>
            <td class="textRight"></td>
            <td>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="" lay-filter="search">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="datatable" class="layui-table" style="width:100%">
    <thead>
    <tr>
        <th>#springMessage('table.fcPredrawDtlTemp.orderNo')</th>##流水号
        <th>#springMessage('international.credit.lcInter')</th>##信用证类型
        <th>#springMessage('international.credit.creditNo')</th>##信用证号
        <th>#springMessage('table.internation.arrival.com.no')</th>##到单号
        <th>#springMessage('international.credit.contractNo')</th>##合同号
        <th>#springMessage('international.lcDeposit.money')</th>##押汇金额
        <th>#springMessage('international.credit.repayDepositMoney')</th>##已还押汇金额
        <th>#springMessage('international.credit.leftRepayDepositMoney')</th>##待还押汇金额
        <th>#springMessage('table.international.arrival.curId')</th>##币种
        <th>#springMessage('international.credit.createDate')</th>##登记时间
        <th>#springMessage('table.international.arrival.paymentDate')</th>##到单日期
        <th>#springMessage('international.lcDeposit.depositDate')</th>##押汇时间
        <th>#springMessage('international.lcDeposit.expiryDate')</th>##押汇到期时间
        <th>#springMessage('international.credit.beneficiary')</th>##受益人
        <th>#springMessage('international.arrival.com.bankName')</th>##到单银行
        <th>#springMessage('common.table.status')</th>##单据状态
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
</table>

    #parse("views/common/footer.vm")

<script>
    bt.use(['jquery','datatable','form','dicts'], function(){
        $ = bt.jquery;
        bt.dicts.init();
        var datatable = bt.datatable.init({
            elem: "#datatable",
            checkbox: false,
            ajax: {
                url: "listReportDepositDataTable",
                dataSrc: "data"
            },
            colReorder: true,
            fixedColumns: {
                rightColumns: 1//代表冻结右边一列
            },
            columns: [
                {
                    data: "depositNo",//流水号
                    className: "center",
                    bSortable: false
                }, {
                    data: "lcInter",//信用类型
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("letter_of_credit_inter",full.lcInter);
                    }
                }, {
                    data: "creditNo",//信用证号
                    className: "center"
                }, {
                    data: "arrivalNo",//到单号
                    className: "center",
                    bSortable: false
                }, {
                    data: "contractNo",//合同号
                    className: "center",
                    bSortable: false
                }, {
                    data: "depositMoney",//押汇金额
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.depositMoney);
                    },
                    bSortable: false
                }, {
                    data: "repayDepositMoney",//已还押汇金额
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.money.format(data);
                    },
                    bSortable: false
                }, {
                    data: "leftRepayDepositMoney",//待还押汇金额
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.money.format(data);
                    },
                    bSortable: false
                }, {
                    data: "curName",//币种
                    className: "center",
                    bSortable: false
                }, {
                    data: "depositDate",//登记时间
                    className: "center",
                    bSortable: false
                }, {
                    data: "paymentDate",//到单日期
                    className: "center",
                    bSortable: false
                }, {
                    data: "payDate",//押汇时间
                    className: "center",
                    bSortable: false
                }, {
                    data: "expiryDate",//押汇到期时间
                    className: "center",
                    bSortable: false
                }, {
                    data: "beneficiary",//受益人
                    className: "center",
                    bSortable: false
                }, {
                    data: "handDocBank",//到单银行
                    className: "center",
                    bSortable: false
                }, {
                    data: "status",//状态
                    className: "center",
                    render: function (data, type, full, meta) {
                        if (data == 999) {
                            return bt.dict("international.deposit.reportStatus",2);
                        } else {
                            return bt.dict("international.deposit.reportStatus",1);
                        }
                    },
                    bSortable: false
                }, {
                    data: null,//操作
                    className: "center",
                    render: function (data, type, full, meta) {
                        var id = full.id;
                        var html = "<a class=\"\" href=\"#\" data-row=\"" + meta.row + "\" onclick=\"view('" + id + "')\">" + bt.lang("common.button.view") + "</a>";
                        return html;
                    },
                    bSortable: false
                }
            ],
            btInitComplete: function (setting, json) {
            },
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search",
                callback: function (data) {
                }
            },
            summary:{
                pageSum: false,//小计功能关闭
                allSum: true,//汇总功能开启
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '6',//汇总列序号
                        dataName: 'depositMoney',//汇总列数据
                    }
                ]
            }
        });
        //这里填写新的js代码，请参考前端文档
    });

    function view(id){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.edit'),basePath + "/international/credit/lcDeposit/viewDeposit?id=" +id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/international/credit/lcDeposit/viewDeposit?id="+id,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }
</script>
</body>
</html>
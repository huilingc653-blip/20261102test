<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->

<form class="layui-form" method="post" id="myform">
    #*默认提交*#
    <input type="hidden" name="status" id="status" value="11">
    <input type="hidden" id="depositId" name="depositId" value="$!{lcDeposit.id}">
    <input type="hidden" name="depositNo" value="$!{lcDeposit.depositNo}">
    <input type="hidden" name="corpId" value="$!{lcDeposit.corpId}">
    <input type="hidden" value=" $!date.format("yyyy-MM-dd",$!{lcDeposit.expiryDate})" id="DepositExpiryDate">
    <table class="layui-table">
        <tr>
        ##                到单号
            <td class="textRight" style="width: 15%">#springMessage('table.internation.arrival.com.no')</td>
            <td style="width: 35%">
                <div class="layui-input-inline">
                    $!{lcBillArrival.arrivalNo}
                </div>
            </td>
        ##                信用证号
            <td class="textRight" style="width: 15%">#springMessage('international.credit.creditNo')</td>
            <td style="width: 35%">
                <div class="layui-input-inline">
                    $!{lcEnrol.creditNo}
                </div>
            </td>
        </tr>

        <tr>
        ##                展期日期
            <td class="textRight">#springMessage('international.lcDepositDelay.delayDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" lay-verify="required" name="delayDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="delayDate" data-callback="setDelayDays">
                </div>
            </td>
        ##                到期日期
            <td class="textRight">#springMessage('international.lcDepositDelay.expiryDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" lay-verify="required" name="expiryDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="expiryDate" data-callback="setDelayDays">
                </div>
            </td>
        </tr>

        <tr>
        ##                展期天数
            <td class="textRight">#springMessage('international.lcDepositDelay.delayDays')</td>
            <td>
                <div class="layui-input-inline">
                    <input class="layui-input" id="delayDays" name="delayDays" readonly="readonly">
                </div>
            </td>
        ##                付汇日期
            <td class="textRight">#springMessage('table.international.pay.date')</td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcBillArrival.payDate})
                </div>
            </td>
        </tr>

        <tr>
        ##                汇率
            <td class="textRight">#springMessage('international.credit.exchangeRate')</td>
            <td>
                <div class="layui-input-inline">
                    $!excRateTag.getConvert($!{lcDeposit.exchangeRate})
                </div>
            </td>
        ##                利率
            <td class="textRight">#springMessage('international.lcDeposit.interestRate')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="interestRate" lay-verify="required" data-biz-name="interestRate" class="layui-input bt-biz-rateType" value="$!{lcDeposit.interestRate}">
                </div>
            </td>
        </tr>

        <tr>
        ##                备注
            <td class="textRight">#springMessage('international.lcDeposit.rmk')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="rmk" class="layui-input">
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td>#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" id="gid" name="attachmentId" value="">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" type="button" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'rateType', 'moneyType', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        bt.dicts.init();//字典
        date = bt.dateType.init();//时间
        bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        // 附件功能
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            isExpand: true,
            auto: false,
            gid: gid
        });
        // 提交
        form.on("submit(submit)", function (data) {
            bt.loading.show();
            var url = basePath + "/international/credit/lcDepositDelay/saveLcDepositDelayApply"
            $("#gid").val(up.getGroupId());
            $.ajax({
                url: url,
                data: $("#myform").serialize(),
                dataType: "json",
                type: "POST",
                success: function (data) {
                    parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                    if (data.success) {
                        if (!bt.navtab) {
                            bt.navtab.refreshParentTable();
                        } else {
                            bt.navtab.closeCurrent();
                        }
                    } else {
                        bt.loading.hide();
                    }
                }
            });

            return false;
        });

        // 暂存
        form.on("submit(temp)", function (data) {
            $("#status").val("0");
            bt.loading.show();
            var url = basePath + "/international/credit/lcDepositDelay/saveLcDepositDelayApply"
            $("#gid").val(up.getGroupId());
            $.ajax({
                url: url,
                data: $("#myform").serialize(),
                dataType: "json",
                type: "POST",
                success: function (data) {
                    parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                    if (data.success) {
                        if (!bt.navtab) {
                            bt.navtab.refreshParentTable();
                        } else {
                            bt.navtab.closeCurrent();
                        }
                    } else {
                        bt.loading.hide();
                    }
                }
            });
            return false;
        });

        //这里填写新的js代码，请参考前端文档
    });


    function setDelayDays(data,jq) {
        var startDate = date.get("delayDate").val();
        var endDate = date.get("expiryDate").val();
        var DepositExpiryDate = $("#DepositExpiryDate").val();
        var days = 0;
        /*校验展期日期是否大于押汇日期*/
        if (bt.date.compare(DepositExpiryDate, startDate) > 0) {
            parent.layer ? parent.layer.alert(bt.lang("international.lcDepositDelay.alert.info2"), {icon: 2}) : layer.alert(bt.lang("international.lcDepositDelay.alert.info2"), {icon: 2});
            date.get("delayDate").val("");
        }
        /*校验有效期是否大于展期日期*/
        if (startDate != null && endDate != null && startDate != undefined && endDate != undefined && startDate != "" && endDate != "") {
            if (bt.date.compare(startDate, endDate) < 0) {
                /*判断是否大于最后一次的展期到期日期*/
                var maxDate = getMaxDateBuDepositId();
                if (maxDate != null && maxDate != "" && maxDate != undefined && bt.date.compare(endDate, maxDate) < 0) {
                    parent.layer ? parent.layer.alert(bt.lang("international.lcDepositDelay.alert.info3"), {icon: 2}) : layer.alert(bt.lang("international.lcDepositDelay.alert.info3"), {icon: 2});
                    date.get("expiryDate").val("");
                    return false;
                }
                days = bt.date.getBetweenDay(startDate, endDate);
            } else {
                parent.layer ? parent.layer.alert(bt.lang("international.lcDepositDelay.alert.info1"), {icon: 2}) : layer.alert(bt.lang("international.lcDepositDelay.alert.info1"), {icon: 2});
                date.get("expiryDate").val("");
                return false;
            }
        }
        $("#delayDays").val(days);
    }


    /**
     * 返回该押汇单的最大展期到期日期
     * @returns {*}
     */
    function getMaxDateBuDepositId() {
        var url = basePath+"/international/credit/lcDepositDelay/getMaxDateByDepositId"
        var maxDate = null;
        $.ajax({
            url: url,
            type: "POST",
            dataType: "json",
            data: {
                depositId: $("#depositId").val()
            },
            async: false,
            success: function (data) {
                maxDate = data.MAXDATE
            }
        });
        return maxDate;
    }

</script>
</body>
</html>

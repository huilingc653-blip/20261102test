<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->

<form class="layui-form" method="post" id="myform">
    <input type="hidden" id="id" name="id" value="$!{lcDepositDelay.id}">
    <table class="layui-table">
        <tr>
        ##                到单号
            <td class="textRight" style="width: 15%">#springMessage('table.internation.arrival.com.no')</td>
            <td style="width: 35%">
                <div class="layui-input-inline">
                    $!{lcBillArrival.arrivalNo}
                </div>
            </td>
        ##                信用证号
            <td class="textRight" style="width: 15%">#springMessage('international.credit.creditNo')</td>
            <td style="width: 35%">
                <div class="layui-input-inline">
                    $!{lcEnrol.creditNo}
                </div>
            </td>
        </tr>

        <tr>
        ##                展期日期
            <td class="textRight">#springMessage('international.lcDepositDelay.delayDate')</td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcDepositDelay.delayDate})
                </div>
            </td>
        ##                到期日期
            <td class="textRight">#springMessage('international.lcDepositDelay.expiryDate')</td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcDepositDelay.delayDate})
                </div>
            </td>
        </tr>

        <tr>
        ##                展期天数
            <td class="textRight">#springMessage('international.lcDepositDelay.delayDays')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcDepositDelay.delayDays}
                </div>
            </td>
        ##                付汇日期
            <td class="textRight">#springMessage('table.international.pay.date')</td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcBillArrival.payDate})
                </div>
            </td>
        </tr>

        <tr>
        ##                汇率
            <td class="textRight">#springMessage('international.credit.exchangeRate')</td>
            <td>
                <div class="layui-input-inline">
                    $!excRateTag.getConvert($!{lcDeposit.exchangeRate})
                </div>
            </td>
        ##                利率
            <td class="textRight">#springMessage('international.lcDeposit.interestRate')</td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($math.mul($!{lcDepositDelay.interestRate},100),"#0.0000")%
                </div>
            </td>
        </tr>

        <tr>
        ##                备注
            <td class="textRight">#springMessage('international.lcDeposit.rmk')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcDepositDelay.rmk}
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td>#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" id="gid" name="attachmentId" value="$!{lcDepositDelay.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
    </table>
    #if($!{flag} != 0)
        <div class="layui-input-inline" style="text-align: center;width: 100%">
            <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{lcDepositDelay.id}')">#springMessage('common.button.trackFlow')</button>
        </div>
    #end
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'rateType', 'moneyType', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        bt.dicts.init();//字典
        bt.dateType.init();//时间
        bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        // 附件功能
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });
        //这里填写新的js代码，请参考前端文档
    });
</script>
</body>
</html>

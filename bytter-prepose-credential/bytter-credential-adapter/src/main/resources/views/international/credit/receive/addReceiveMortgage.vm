<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" name="arrivalId" value="$!{arrival.id}">##交单Id  
        <input type="hidden" name="lcId" value="$!{arrival.lcId}">##信用证登记ID
        <input type="hidden" name="corpId" value="$!{arrival.corpId}">
        <input type="hidden" name="mortgageMoney" value="$!{arrival.payMoney}">
        <table class="layui-table">
            <tbody>
            
               <tr>
                   ##抵押日期
                   <td class="textRight">#springMessage('table.internation.pledge.date')</td>
                   <td>
                       <div class="layui-inline">
                           <div class="layui-inline">
                               <input id="mortgageDate" name="mortgageDate"  data-biz-name="mortgageDate" data-type="date"
                                      class="layui-input bt-biz-dateType" lay-verify="required" data-endid="expiryDate" ></input>
                           </div>
                       </div>
                   </td>

                   ##到期日期
                       <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
                       <td>
                           <div class="layui-inline">
                               <div class="layui-inline">
                                   <input id="expiryDate" name="expiryDate"  data-biz-name="expiryDate" data-type="date"
                                          class="layui-input bt-biz-dateType" lay-verify="required" ></input>
                               </div>
                           </div>
                       </td>
                   
               </tr>

               <tr>
               ##利率
                   <td class="textRight">#springMessage('table.bisFinanceExc.interestRate')</td>
                   <td >
                       <div class="layui-inline">
                           <input class="layui-input bt-biz-rateType" data-max="99.9999" data-name="interestRate" lay-verify="required" />
                       </div>
                   </td>
                   <td class="textRight">
                       ##                付息日期
                                    #springMessage('international.lcDeposit.payInterestDate')
                   </td>
                   <td>
                       <div class="layui-input-inline">
                           <input type="text" name="payInterestDate"  class="layui-input bt-biz-dateType" data-type="date" data-biz-name="payInterestDate"  >
                       </div>
                   </td>
               </tr>
               <tr>
                   <td class="textRight">
                       ##                利息
                                    #springMessage('international.lcDeposit.payInterestMoney')
                   </td>
                   <td>
                       <div class="layui-input-inline">
                           <input type="text" data-name="payInterestMoney" id="payInterestMoney"
                                  class="layui-input bt-biz-moneyType" data-minus="true" data-biz-name="payInterestMoney"
                                  data-decimal="2" >
                       </div>
                   </td>
                   ##备注
                   <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
                   <td >
                       <div class="layui-inline">
                           <input class="layui-input-inline layui-input" type="text" name="rmk"></input>
                       </div>
                   </td>
               </tr>
               <tr>
                   <td class="textRight">#springMessage('cms.loan.attachment')</td>
                   <td colspan="3">
                       <input type="hidden" id="gid" name="attachmentId" value="">
                       <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
                   </td>
               </tr>
               <tr>
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" value="11" lay-submit="" lay-filter="submit">#springMessage('table.bisAccBal.btn.confirm')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
#parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form', 'jquery', 'corp', 'dateType', 'moneyType', 'selectType',
        'dicts', 'rateType', 'bankInfo', 'btUpload', 'bondAccInfo', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form(), fun = bt.moneyType.getFun();
        dateTypes = bt.dateType.init();//时间
        moneyTypes = bt.moneyType.init();//金额
        bt.corp.init();//单位
        selectTypes = bt.selectType.init();//下拉框
        dicts = bt.dicts.init();//字典
        rateTypes = bt.rateType.init();//利率
        bt.bankInfo.init();//联行号
        moneyFun = bt.moneyType.getFun();
        // 附件功能
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            isExpand: true,
            auto: false,
            gid: gid
        });

        //监听提交 99 0
        form.on('submit(submit)', function (data) {
            var status = $(this).attr("value");
            var action = "/international/credit/mortgageletter/tempOrSubmit"
            data.field.status = status;
            data.field.attachmentId = up.getGroupId();
            bt.loading.show();
            $.post(basePath + action, data.field, function (result) {
                parent.layer ? parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}) : layer.alert(result.msg, {icon: result.success ? 1 : 2});
                if (result.success) {
                    if (!bt.navtab) {
                        bt.navtab.refreshParentTable();
                        //parent.layer?parent.layer.closeAll():layer.closeAll();
                    } else {
                        bt.navtab.closeCurrent();
                    }
                } else {
                    bt.loading.hide();
                }
            }, 'JSON');
            return false;
        });


    });
</script>
</html>

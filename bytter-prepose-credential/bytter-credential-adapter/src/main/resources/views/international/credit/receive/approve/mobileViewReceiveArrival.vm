<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##信用证类型
    <li class="mui-table-view-cell">
        #springMessage('international.credit.lcInter')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("letter_of_credit_inter",$!{lcInter})
        </span>
    </li>
##信用证号
    <li class="mui-table-view-cell">
        #springMessage('international.credit.creditNo')
        <span class="mui-badge mui-badge-inverted">
            $!{creditNo}
        </span>
    </li>
##交单号
    <li class="mui-table-view-cell">
        #springMessage('table.internation.arrival.no')
        <span class="mui-badge mui-badge-inverted">
            $!{arrival.arrivalNo}
        </span>
    </li>
##登记日期
    <li class="mui-table-view-cell">
        #springMessage('international.credit.createDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!arrival.createDate)
        </span>
    </li>
##交单银行
    <li class="mui-table-view-cell">
        #springMessage('table.internation.arrival.bank')
        <span class="mui-badge mui-badge-inverted">
            $!{arrival.handDocBank}
        </span>
    </li>
##到期日期
    <li class="mui-table-view-cell">
        #springMessage('table.cmsProvideLoanSend.repayDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!arrival.paymentDate)
        </span>
    </li>
##交单行编号
    <li class="mui-table-view-cell">
        #springMessage('table.internation.arrival.bank.no')
        <span class="mui-badge mui-badge-inverted">
            $!{arrival.handDocBank}
        </span>
    </li>
##期限
    <li class="mui-table-view-cell">
        #springMessage('table.tbCreditPeriod.period')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("letter_of_credit_timeLimit",$!{arrival.period})
        </span>
    </li>
##交单金额
    <li class="mui-table-view-cell">
        #springMessage('table.internation.arrival.money')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{arrival.billMoney})
        </span>
    </li>
##币种
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkrationRelief.curCode')
        <span class="mui-badge mui-badge-inverted">
            $!{arrival.curName}
        </span>
    </li>
##汇率
    <li class="mui-table-view-cell">
        #springMessage('table.btCurrency.curExrate')
        <span class="mui-badge mui-badge-inverted">
            $!excRateTag.getConvert($!{arrival.exchange})
        </span>
    </li>
##收款金额：
    <li class="mui-table-view-cell">
        #springMessage('table.internation.proceeds.money')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{arrival.payMoney})
        </span>
    </li>
##手续费
    <li class="mui-table-view-cell">
        #springMessage('table.cmsPrecativeLoanInfo.poundage')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{arrival.handlingCharge})
        </span>
    </li>
##受益人
    <li class="mui-table-view-cell">
        #springMessage('international.credit.beneficiary')
        <span class="mui-badge mui-badge-inverted">
            $!{arrival.beneficiary}
        </span>
    </li>
##开证银行
    <li class="mui-table-view-cell">
        #springMessage('international.credit.issuingBank')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.openingBankName}
        </span>
    </li>
##发票号
    <li class="mui-table-view-cell">
        #springMessage('table.cgsBill.invoiceCode')
        <span class="mui-badge mui-badge-inverted">
            $!{arrival.invoiceNo}
        </span>
    </li>
##备注
    <li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetPeriod.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{arrival.rmk}
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input name="id" type="hidden" value="$!{lcEnrol.id}"/>
        <input type="hidden" name="lcNo" id="lcNo" value="$!{lcEnrol.lcNo}">
        <input type="hidden" id="corpId" name="corpId" value="$!{lcEnrol.corpId}">
        <input id="issuingDate" name="issuingDate" type="hidden" value="$!date.format('yyyy-MM-dd',$!{lcEnrol.issuingDate})">
        <!-- 资金计划参数 -->
        <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
        <input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
        <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
        <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
        <input id="issuingCurId" name="issuingCurId" type="hidden" value="$!{lcEnrol.issuingCurId}">
        <table class="layui-table">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('international.credit.createDate')</td>
                <td>
                    $!date.format('yyyy-MM-dd',$!{lcEnrol.createDate})
                </td>
                <td></td>
                <td></td>
            </tr>
               <tr>
                   ##信用证类型
                   <td class="textRight">#springMessage('taboel.letter.of.credit.inter')</td>
                   <td width="36%">
                       $dictTag.get("letter_of_credit_inter",${lcEnrol.lcInter})
                   </td>
                       
                   ##单位 
                   <td class="textRight" width="14%">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
                   <td width="36%">
                       ${lcEnrol.corpName}
                    </td>
               </tr>
               
               <tr>
                   ##信用证号
                   <td class="textRight">#springMessage('international.credit.creditNo')</td>
                   <td>
                        $!{lcEnrol.creditNo}
                   </td>
                   
                   ##合同号
                   <td class="textRight">#springMessage('table.fbsBudgetDetail.contract')</td> 
                   <td>
                       $!{lcEnrol.contractNo}
                   </td>
               </tr>
               
               <tr>
                   ##开证人
                   <td class="textRight">#springMessage('international.credit.applicant')</td>
                   <td>
                       $!{lcEnrol.applicant}
                   </td>

                   ##开证日期
                   <td class="textRight">#springMessage('international.credit.issuingDate')</td>
                   <td>
                       $!date.format('yyyy-MM-dd',$!lcEnrol.issuingDate)
                   </td>
                   
               </tr>

               <tr>
               ##开证银行
                   <td class="textRight">
                       #springMessage('international.credit.issuingBank')
                   </td>
                   <td>
                       <div class="layui-inline">
                           $!{lcEnrol.openingBankName}
                       </div>
                   </td>

               ##信用证有效期
                   <td class="textRight">#springMessage('international.credit.expiryDate')</td>
                   <td>
                       $!date.format('yyyy-MM-dd',$!lcEnrol.expiryDate)
                   </td>
               </tr>
               <tr>
               ##受益人
                   <td class="textRight">#springMessage('international.credit.beneficiary')</td>
                   <td>##本单位？
                        $!{lcEnrol.beneficiary}
                   </td>
               ##收证银行
                   <td class="textRight">#springMessage('international.credit.receiveIssuingBank')</td>
                   <td>
                       $!{showBank}
                   </td>
               </tr>
               <tr>
               ##币别
                   <td class="textRight">#springMessage('international.credit.issuingCurId')</td>
                   <td > ##默认人民币不能填
                       $!{lcEnrol.curName}
                   </td>

               ##汇率
                   <td class="textRight">#springMessage('table.btCurrency.curExrate')</td>
                   <td >
                       <div class="layui-inline">
                           $!excRateTag.getConvert($!{lcEnrol.ratExchangeRate})
                   </td>
               </tr>
               <tr>
               ##开证金额（小写）：
                   <td class="textRight">#springMessage('international.credit.creditMoney.lower')</td>
                   <td>
                       $!number.formatNumeric($!{lcEnrol.creditMoney})
                   </td>
               ##开证金额（大写）：
                   <td class="textRight">#springMessage('international.credit.creditMoney.big')</td>
                   <td >
                       <div class="layui-input-inline" id="moneyUpper"></div>
                   </td>
               </tr>

               <tr>
               ##转换人民币
                   <td class="textRight">#springMessage('international.convert.curMoney')</td>
                   <td>
                       $!number.formatNumeric($!{lcEnrol.nativeCreditMoney})
                   </td>

               ##货物描述
                   <td class="textRight">#springMessage('international.credit.goodsDescript')</td>
                   <td >
                       $!{lcEnrol.goodsDescript}
                   </td>
               </tr>

               <tr>
               ##期限
                   <td class="textRight">#springMessage('table.tbCreditPeriod.period')</td>
                   <td >
                       $dictTag.get("letter_of_credit_timeLimit",$!{lcEnrol.timeLimit})
                   </td>
                   #if($!{lcEnrol.timeLimit} == 2)
                   ##远期天数
                       <td class="textRight">#springMessage('international.credit.delayDates')</td>
                       <td>
                           $!{lcEnrol.delayDates}
                       </td>
                   #else
                       <td></td>
                       <td></td>
                   #end
               </tr>

               <tr>
               ##有效地
                   <td class="textRight">#springMessage('international.credit.expiryPlace')</td>
                   <td >
                       $!{lcEnrol.expiryPlace}
                   </td>

               ##备注
                   <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
                   <td >
                      $!{lcEnrol.rmk}
                   </td>
               </tr>
            <tr>
                <td class="textRight">#springMessage('cms.loan.attachment')</td>
                <td colspan="3">
                    <input type="hidden" id="gid" name="attachmentId" value="$!{lcEnrol.attachmentId}">
                    <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
                </td>
            </tr>
            </tbody>
        </table>
        <!-- 资金计划 -->
        <div id="tagItemDetail"></div>
        #if($!{flag} != '0')
            <div align="center">
                <a href="#" class="layui-btn layui-btn-small" onClick="doClose()" >#springMessage('common.button.close')</a>
            </div>
        #end
       
    </form>
#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form', 'btUpload', 'dicts', 'moneyType', "btUpload"], function () {
        $ = bt.jquery, form = bt.form();
        fun = bt.moneyType.getFun();
        moneyUpper();
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        /**
         * 生成公共的属性
         * @return
         */
        $genOtherHtml = function (corpId) {
            var url = basePath + "/budget/fbsBudgetProcess/getViewItemDetail";
            var param = {
                corpId: corpId,
                itemCode: $("#payItem").val(),
                billNo: $("#lcNo").val(),
                businessName: $("#businessName").val(),
                processSysname: $("#processSysname").val(),
                processDate: $("#issuingDate").val(),
                curId:$("#issuingCurId").val(),
                type: 'select',
                date: (new Date()).getTime()
            };
            $.ajax({
                url: url, method: 'POST', data: param, async: true, success: function (json) {
                    $("#tagItemDetail").html("");
                    $("#tagItemDetail").html(json);
                    form.render();
                }
            });
        }
        /**
         * 资金计划挂接
         */
        function renderBudget(corpId) {
            //判断支付结算是否挂接资金计划
            var budgetSel = $("#budgetSel").val();
            if (budgetSel == "1") {
                    $genOtherHtml(corpId);
            }
        }

        var corpId = $("#corpId").val();
        renderBudget(corpId);
    });

    /**金额大写*/
    function moneyUpper(){
        var money = fun.toNumber("$!{lcEnrol.creditMoney}");
        $("#moneyUpper").text(bt.money.toChinese(money));
    }
    
    //关闭窗口
    function doClose(){
        if(bt.navtab){
            bt.navtab.closeCurrent();
        }
    }
</script>
</html>

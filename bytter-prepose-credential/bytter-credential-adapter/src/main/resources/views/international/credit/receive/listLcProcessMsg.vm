<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" id="billCode" value="$!{billCode}">
<table id="appTable" class="layui-table layui-form"
		style="width: 100%;">
<colgroup>
	<col width="15%">
    <col width="15%">
	<col width="15%">
	<col width="40%">
</colgroup>
	<thead>
		<tr>
			<td>#springMessage('table.cmsProcessMsg.createDate')</td><!--操作日期  -->
			<td>#springMessage('table.cmsProcessMsg.createBy')</td><!--用户代码  -->
			<td>#springMessage('table.cmsProcessMsg.messageType')</td><!--操作类型  -->
			<td>#springMessage('table.cmsProcessMsg.message')</td><!--操作信息  -->
		</tr>
	</thead>
</table>
<div align="center">
	<a href="#" class="layui-btn layui-btn-small" onClick="doClose()" >#springMessage('common.button.close')</a>
</div>
#parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
bt.use(['form','date','datatable','dicts'], function(){
    $ = bt.jquery,form = bt.form();
    bt.dicts.init();
    datatable = bt.datatable.init({
        elem: "#appTable",
       
        ajax: {
        	url:basePath+"/international/credit/lcprocessmsg/listMsgData?billCode="+$('#billCode').val()
        }
      
        ,columns: [
				{data:"createDate"},
				{data:"createBy"},
				{data:"messageType",
					render: function (data, type, full, meta) {
						return bt.dict("lc.messageType",full.messageType);
					}
				},
				{data:"message"},
           
          
        ]
    });
    /* bt.datatable.init({
    		elem: "#appTable",
       		colReorder: true,
            ordering:false,
            ajax:{
            	url:basePath+"/cms/basedata/cmsprocessmsg/listMsgData?billCode="+$('#billCode').val(),
            },
 
            columns:[
				{data:"createDate"},
                {data:"createBy"},
                {data:"createName"},
                {data:"messageType",
                	render: function (data, type, full, meta) {
                		return bt.dict("cms.messageType",full.messageType);
                	}
                },
                {data:"message"},
            ]
       }); */
  
    });
    
//关闭窗口
function doClose(){
	if(bt.navtab){
		bt.navtab.closeCurrent();
	}
}
</script>

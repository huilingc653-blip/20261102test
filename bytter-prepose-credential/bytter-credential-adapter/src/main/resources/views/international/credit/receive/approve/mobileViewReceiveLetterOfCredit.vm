<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##登记日期
    <li class="mui-table-view-cell">
        #springMessage('international.credit.createDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{lcEnrol.createDate})
        </span>
    </li>
##信用证类型
    <li class="mui-table-view-cell">
        #springMessage('taboel.letter.of.credit.inter')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("letter_of_credit_inter",${lcEnrol.lcInter})
        </span>
    </li>
##单位
    <li class="mui-table-view-cell">
        #springMessage('table.cmsProvideLoanInfo.corpId')
        <span class="mui-badge mui-badge-inverted">
            ${lcEnrol.corpName}
        </span>
    </li>
##信用证号
    <li class="mui-table-view-cell">
        #springMessage('international.credit.creditNo')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.creditNo}
        </span>
    </li>
##合同号
    <li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetDetail.contract')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.contractNo}
        </span>
    </li>
##开证人
    <li class="mui-table-view-cell">
        #springMessage('international.credit.applicant')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.applicant}
        </span>
    </li>
##开证日期
    <li class="mui-table-view-cell">
        #springMessage('international.credit.issuingDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!lcEnrol.issuingDate)
        </span>
    </li>
##开证银行
    <li class="mui-table-view-cell">
        #springMessage('international.credit.issuingBank')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.openingBankName}
        </span>
    </li>
##信用证有效期
    <li class="mui-table-view-cell">
        #springMessage('international.credit.expiryDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!lcEnrol.expiryDate)
        </span>
    </li>
##受益人
    <li class="mui-table-view-cell">
        #springMessage('international.credit.beneficiary')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.beneficiary}
        </span>
    </li>
##开证银行
    <li class="mui-table-view-cell">
        #springMessage('international.credit.receiveIssuingBank')
        <span class="mui-badge mui-badge-inverted">
            $!{showBank}
        </span>
    </li>
##币别
    <li class="mui-table-view-cell">
        #springMessage('international.credit.issuingCurId')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.curName}
        </span>
    </li>
##汇率
    <li class="mui-table-view-cell">
        #springMessage('table.btCurrency.curExrate')
        <span class="mui-badge mui-badge-inverted">
            $!excRateTag.getConvert($!{lcEnrol.exchangeRate})
        </span>
    </li>
##开证金额（小写）：
    <li class="mui-table-view-cell">
        #springMessage('international.credit.creditMoney.lower')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcEnrol.creditMoney})
        </span>
    </li>
##开证金额（大写）：
    <li class="mui-table-view-cell">
        #springMessage('international.credit.creditMoney.big')
        <span class="mui-badge mui-badge-inverted">
            $!{credirMoneyUpper}
        </span>
    </li>
##转换人民币
    <li class="mui-table-view-cell">
        #springMessage('table.internation.conversion.of.RMB')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($math.mul($!{lcEnrol.creditMoney},$!{lcEnrol.exchangeRate}))
        </span>
    </li>
##货物描述
    <li class="mui-table-view-cell">
        #springMessage('international.credit.goodsDescript')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.goodsDescript}
        </span>
    </li>
##期限
    <li class="mui-table-view-cell">
        #springMessage('table.tbCreditPeriod.period')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("letter_of_credit_timeLimit",$!{lcEnrol.timeLimit})
        </span>
    </li>
#if($!{lcEnrol.timeLimit} == 2)
##远期天数
    <li class="mui-table-view-cell">
        #springMessage('international.credit.delayDates')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.delayDates}
        </span>
    </li>
#end
##有效地
    <li class="mui-table-view-cell">
        #springMessage('international.credit.expiryPlace')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.expiryPlace}
        </span>
    </li>
##备注
    <li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetPeriod.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.rmk}
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>

</html>

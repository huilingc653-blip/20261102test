    #parse("views/common/footer.vm")
<script>
    var form, dicts;
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'selectType', 'rateType',
        'moneyType', 'corp', 'verify', 'bondAccInfo', 'externalCorpBankAcc', 'selectTableType', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        dicts = bt.dicts.init();//字典
        dateObj = bt.dateType.init();//时间
        selectType = bt.selectType.init();//下拉选择
        dateType = bt.dateType.init();//日期时间
        rateType = bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        corp = bt.corp.init();//单位
        externalCorpBankAcc = bt.externalCorpBankAcc.init();//客商
        fun = bt.moneyType.getFun()
        bondAccInit = bt.bondAccInfo.init();//保证金账号初始化
        parameters = new Object();
        // 附件功能
        var gid = $("#gid").val();
        up = bt.btUpload.init({
            elem: "#uploader",
            isExpand: true,
            auto: false,
            gid: gid
        });

        form.on("submit(submit)", function (data) {
            // 提交前授信校验
            if (!submitValidate()) {
                return false;
            }
            // 黑白名单校验
            checkBlackWhite(95);
            return false;
        });

        form.on("submit(temp)", function (data) {
            // 提交前授信校验
            if (!submitValidate()) {
                return false;
            }
            // 黑白名单校验
            checkBlackWhite(11);
            return false;
        });

        //复选框监控
        form.on("checkbox(isNativeCur)", function (data) {
            setNativeCreditMoney();
        });

        /**判断字符串是否为空*/
        bt.empty = function (ms) {
            if (typeof (ms) == "undefined" || ms == null || ms == "" || ms == " ") {
                return true;
            }
            return false;
        }

        selectTable = bt.selectTableType.init({
            elem: ".applicantAcc",
            type: 'get',
            paging: true,
            url: basePath + "/international/credit/createCredit/getBankAccsByCorpId",
            columns: [
                {"data": "accName", title: bt.lang("table.btBankAcc.accName")},
                {"data": "bankName", title: bt.lang("table.btBankAcc.bankName")},
                {"data": "bankAcc", title: bt.lang("table.btBankAcc.bankAcc")},
                {"data": "curName", title: bt.lang("international.payment.curName")}
            ],
            clickCallback: function (data, tr, elem, full) {
                // 设置开证人账号银行等信息
                CreateSelectTableType(data, tr, elem, full);
                // 根据币别设置汇率信息
                setCurExcRate(data.curId);
                bt.renderBudget();
            }
        });
        //这里填写新的js代码，请参考前端文档

        /**
         * 生成公共的属性
         * @return
         */
        $genOtherHtml = function () {
            var corpId = $('input[name="applicant"]').val();
            var itemCode = $('input[name="payItem"]').val();
            var processDate = dateType.get("issuingDate").val();
            if(!processDate){
                processDate = new Date();
            }
            var url = basePath + "/budget/fbsBudgetProcess/getItemDetail";
            var param = {
                corpId: corpId,
                itemCode: itemCode ? itemCode : "400",
                defItemCode: '',
                processDate: processDate,
                type: 'select',
                curId: $('[data-biz-name="issuingCurId"]').data('value'),//selectType.get("issuingCurId").val(),
                date: (new Date()).getTime()
            };
            $.ajax({
                url: url, method: 'POST', data: param, async: true, success: function (json) {
                    $("#tagItemDetail").html("");
                    $("#tagItemDetail").html(json);
                }
            });
        };
    });

    function checkLicenceCode(){
        var needLicence = dicts.get('needLicence').val();
        if (needLicence === '1') {
            $("#licenceCode").attr("lay-verify", "required");
        } else {
            $("#licenceCode").removeAttr("lay-verify");
        }
        form.renderIcon();
    }


    /**
     * 资金计划挂接
     */
    bt.renderBudget = function () {
        //判断支付结算是否挂接资金计划
        var budgetSel = $("#budgetSel").val();
        if (budgetSel == "1") {
            $genOtherHtml();
        }
    }

    /**
     * 计划执行输入金额汇总后的回调
     * @param data
     */
    function sumMoneyCallBack(data) {
        bt.moneyType.get("creditMoney").val(data);
    }

    /**
     * 数据提交
     * @param status
     */
    function doSubmit(status) {
        var url;
        if (status == 11) {
            url = basePath + "/international/credit/createCredit/saveTemp";
        } else {
            url = basePath + "/international/credit/createCredit/saveCredit"
        }
        // 担保调用
        setIsGuaranteeEnabled();
        bt.loading.show();
        $("#gid").val(up.getGroupId());
        $.ajax({
            url: url,
            data: $("#myform").serialize(),
            dataType: "json",
            type: "POST",
            success: function (data) {
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                if (data.success) {
                    if (!bt.navtab) {
                        bt.navtab.refreshParentTable();
                    } else {
                        bt.navtab.closeCurrent();
                    }
                } else {
                    bt.loading.hide();
                }
            }
        })
    }
</script>
<script src="${basePath}/static/modules/international/international.lcEnrol.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/guarantee/guaContractSelect.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>
</body>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        /
        /
        这里填写新的样式代码
    </style>
</head>
<body>
<input type="hidden" id="nativeCurId">
<input type="hidden" id="ratBankConfig" value="$!{ratBankConfig}">
<input type="hidden" id="bankCode" value="">
<form class="layui-form" method="post" id="myform">
    <input type="hidden" id="beneficiaryAcc" name="beneficiaryAcc">
    <input type="hidden" id="beneficiaryBank" name="beneficiaryBank">
##        当为否时，则授信项不显示，则是否挂授信为否置为0值
    #if($!{config.international.creditIsHang}==0)<input type="hidden" id="isHangCredit" name="isHangCredit" value="0">#end
##    是否启用保证金参数
    #if($!{config.international.creditIsBond}==1)<input type="hidden" id="creditIsBond" name="creditIsBond" value="1">#end
##    当不开启担保时，则默认值为不挂担保
    #if($!{config.international.isHangGua}==0)<input type="hidden" id="isHangGua" name="isHangGua" value="0">#end
##        保证金id
    <input type="hidden" name="bondId" id="bondId">
    <input  id="bondIdPre"  name="bondIdPre" type="hidden" value="$!{dto.bondId}">
    <input type="hidden" id="bailMoneyPre" name="bailMoneyPre" value="$!{dto.applyMoney}"/>
##        保证账户余额
    <input type="hidden" name="bondAccMoney" id="bondAccMoney">
##        可用余额
    <input type="hidden" name="accAvailMoney" id="accAvailMoney">
    <!-- 资金计划参数 -->
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
    <table class="layui-table">
        <tr>
            <td style="width: 15%">
                <label style="font-weight: bold">#springMessage('international.master.info')</label>
            </td>
            <td style="width: 35%"></td>
            <td style="width: 15%"></td>
            <td style="width: 35%"></td>
        </tr>
        <tr>
        ##                登记日期
            <td class="textRight">
                <div class="layui-input-inline">
                    <label class="layui-form-label">#springMessage('international.credit.createDate')</label>
                </div>
            </td>
            <td>
                <input name="createDate" data-today="true" readonly="readonly" class="layui-input bt-biz-dateType"
                       type="text" data-type="date" data-biz-name="createDate">
            </td>
        ##                信用证类型
            <td class="textRight">#springMessage('international.credit.lcInter')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="layui-input-inline">
                        <input type="hidden" value="1" name="lcInter">
                        $dictTag.get("letter_of_credit_inter",1)
                    </div>
            </td>
        </tr>

        <tr>
        ##                开证人
            <td class="textRight">#springMessage('international.credit.applicant')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="applicant"
                         data-biz-type="applicant"
                         data-type="selectTree"
                         data-name="applicant"
                         data-resource="international:credit:createcredit:add"
                         data-required="true"
                         data-callbackData="setApplicantAcc"
                         style="width: 350px"
                    ></div>
                </div>
            </td>
        ##                信用证号
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="creditNo" class="layui-input" lay-verify="strlength" data-maxlength = "50" >
                </div>
            </td>
        </tr>

        <tr>
        ##                合同号
            <td class="textRight">#springMessage('international.credit.contractNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required|strlength" type="text" name="contractNo" class="layui-input" data-maxlength = "50">
                </div>
            </td>
        ##                受益人
            <td class="textRight">#springMessage('international.credit.beneficiary')</td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required" name="beneficiary" type="text" id="beneficiary"  class="layui-input">
                    <div class="bt-div-search">
                        <button class="bt-biz-externalCorpBankAcc" id="selBeneficiary" type="button" data-beforeClick="bt.externalCorpBankAccParams"
                                data-callback="externalCorpCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
        ##                开证日期
            <td class="textRight">#springMessage('international.credit.issuingDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required" name="issuingDate" class="layui-input bt-biz-dateType" type="text"
                           data-callback="issuingDateCallback"
                           data-type="date" data-biz-name="issuingDate">

                </div>
            </td>
        ##                信用证有效期
            <td class="textRight">#springMessage('international.credit.expiryDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input name="expiryDate" class="layui-input bt-biz-dateType" lay-verify="required" type="text"
                           data-callback="expiryDateValidate"
                           data-type="date" data-biz-name="expiryDate">
                </div>
            </td>
        </tr>
        <tr>
        ##                开证银行
            <td class="textRight">#springMessage('international.credit.issuingBank')</td>
            <td>
                #if($!{config.international.creditIsHang}==1)
                    <div id="xl" #if($!{ratBankConfig} == 1) style="display: none" #end>
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" #if($!{ratBankConfig} == 0) data-required="true" #end data-name="issuingBankXX"
                                 data-callback="bankinfoCallBackTwo"
                                 data-url="${basePath}/cms/provide/loaninfo/getBankName"
                                 data-valuefield="bankCode" data-textfield="bankName" data-biz-name="btBank"></div>
                        </div>
                    </div>
                    <div id="xz" #if($!{ratBankConfig} == 0) style="display: none" #end>
                        <div class="layui-input-inline">
                            <input #if($!{ratBankConfig} == 1) lay-verify="false" #end type="text" id="issuingBankShow" name="issuingBankShow"
                                   class="layui-input" readonly="readonly">
                        </div>
                    </div>
                    <input type="hidden" id="issuingBank" name="issuingBank">
                #elseif($!{config.international.creditIsHang}==0)
                    <div>
                        <div class="layui-input-inline">
                            <input lay-verify="required" type="text" id="issuingBankShow" name="issuingBankShow"
                                   class="layui-input" readonly="readonly">
                        </div>
                    </div>
                    <input type="hidden" id="issuingBank" name="issuingBank">
                #end
            </td>

        ##                开证银行账号
            <td class="textRight">
                #springMessage('international.credit.applicantAcc')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required" type="type" id="applicantAcc" name="applicantAcc"
                           clickCallback="setIssuing" class="layui-input applicantAcc" data-biz-name="applicantAcc">
                    <input type="hidden" id="applicantAccId" name="applicantAccId">
                </div>
            </td>
        </tr>

        <tr>
        ##                开证币种
            <td class="textRight">#springMessage('international.credit.issuingCurId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-name="issuingCurId" data-inputValue="false" data-required="true"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName" data-biz-name="issuingCurId"></div>
                </div>
            </td>

        ##                开证金额
            <td class="textRight">#springMessage('international.credit.creditMoney')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="creditMoney" lay-verify="required" data-callback="setNativeCreditMoneyAndBondMoney"
                           class="layui-input bt-biz-moneyType" data-biz-name="creditMoney"
                           data-decimal="2">
                </div>
            </td>
        </tr>

        <tr>
        ##                期限
            <td class="textRight">#springMessage('international.credit.timeLimit')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" id="radio" data-type="radio" data-group="letter_of_credit_timeLimit"
                         data-defaultvalue="1"
                         data-callback="timeLimitSet" data-biz-name="timeLimit"
                         data-name="timeLimit">
                    </div>
                </div>
            </td>
        ##                远期天数
            <td class="textRight delayDates" style="display: none;">#springMessage('international.credit.delayDates')</td>
            <td>
                <div class="layui-input-inline delayDates"  style="display: none;">
                    <input type="text" id="delayDates" data-name="delayDates" data-biz-name="delayDates" class="layui-input bt-biz-moneyType" data-min="1" data-decimal="0" data-separator="">
                </div>
            </td>
        </tr>

        <tr>
        ##                是否溢短装
            <td class="textRight">#springMessage('international.credit.isSpillOver')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" id="radio" data-type="radio" data-group="international.credit.isSpillOver"
                         data-defaultvalue="0" data-max="100"
                         data-name="isSpillOver" data-biz-name="isSpillOver" data-callback="spillOverSet">
                    </div>
                </div>
            </td>
        ##            溢短装比例
            <td class="textRight">#springMessage('international.credit.spillOverRate')</td>
            <td>
                <div class="layui-input-inline">
                    <input class="layui-input bt-biz-rateType" type="text" data-name="spillOverRate"
                           data-biz-name="spillOverRate" data-decimal="2">
                </div>
            </td>
        </tr>
        #if($!{config.international.creditIsBond}==1)
            <tr>
                <td>
                    <label style="font-weight: bold">#springMessage('international.bondInfo')</label>
                </td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
            ##是否挂保证金
                <td class="textRight">#springMessage('table.fcBond.includeBond')</td>
                <td>
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1"
                         data-name="isHangBond" data-biz-name="isHangBond"
                         data-callback="changeFcBond"></div>
                </td>
            ##保证金额度单
                <td class="textRight bondInfo">#springMessage('table.fcBond.quotas')</td>
                <td class="bondInfo">
                    <div class="layui-inline">
                        <input id="bondBankAcc" name="bondBankAcc" type="text" readonly="true" class="layui-input"
                               lay-verify="required">
                    </div>
                    <div class="layui-inline">
                        <button class="layui-btn bt-biz-bondAccInfo" data-biz-name="bondAcc" type="button"
                                data-callback="bondAccinfoCallback" data-beforeClick="checkCorp">#springMessage(
                            'common.button.select')</button>
                    </div>
                </td>
            </tr>
            <tr>
            ##                    保证金币别
                <td class="textRight">#springMessage('international.credit.bondCurId')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-name="bondCurId" data-inputValue="false" data-callback="changeBondCur"
                             data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-required="true"
                             data-textfield="curName" data-biz-name="bondCurId"></div>
                    </div>
                </td>
            ##保证金比例
                <td class="textRight">#springMessage('table.fcBond.bondPercent')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" data-name="bondPercent" data-decimal="2" lay-verify="required"
                               class="layui-input bt-biz-rateType" data-biz-name="bailmoneyRate"
                               data-callback="setBailMoney">
                    </div>
                </td>
            </tr>
            <tr>
            ##保证金金额
                <td class="textRight">#springMessage('table.fcBond.bondmoney')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="bailmoney" name="bondMoney" data-decimal="2"
                               class="layui-input bt-biz-moneyType" data-biz-name="bailmoney"
                               data-callback="setBailMoneyRate"  lay-verify="required"
                               placeholder="#springMessage('table.cmsProvideLoanInfo.bailmoney')">
                    </div>
                </td>
            ##保证金合同号
                <td class="textRight">#springMessage('table.fcBond.contractNum')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="bondContract" name="bondContract"
                               autocomplete="off" class="layui-input">
                    </div>
                </td>
            </tr>
        ##        保证及利率
            <tr>
                <td class="textRight">#springMessage('table.fcBond.bondRate')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" id="bondRate" data-name="bondRate"  data-biz-name="bondRate" class="layui-input bt-biz-rateType">
                    </div>
                </td>
                <td></td>
                <td></td>
            </tr>
        #end
    ##################################授信挂接###########################################################
        #if($!{config.international.creditIsHang}==1)
                <tr>
                    <td>
                        <label style="font-weight: bold">#springMessage('credit.information')</label>
                    </td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                ##是否挂接授信
                    <td class="textRight">#springMessage('table.cmsProvideLoanInfo.ratmodel')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-dict" id="radio" data-type="radio" data-group="sf_yn" data-defaultvalue="1"
                                 data-name="isHangCredit" data-biz-name="isHangCredit" data-callback="setRatModel">
                            </div>
                        </div>
                    </td>
                #if($!{config.international.isRatOpen} == "1")
                ##			授信敞口
                    <td class="textRight isShow">#springMessage('common.isOpen.ratUration')</td>
                    <td class="isShow">
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="radio" data-group="common.isOpen.ratUration"
                                 data-callback="isOpenRatCallback"
                                 data-defaultvalue="1" data-name="isOpenRat" data-biz-name="isOpenRat"></div>
                        </div>
                    </td>
                    #else
                    <td></td>
                    <td></td>
                #end
                </tr>
            <tr class="isNativeCur" style="display: none">
            ##            是否折合成本位币
                <td class="textRight">#springMessage('international.credit.isNativeCur')</td>
                <td>
                    <div class="layui-inline">
                        <input type="checkbox" id="isNativeCur" name="isNativeCur" value="1" lay-filter="isNativeCur"
                               title="#springMessage('international.credit.info')" lay-skin="primary" onclick="setNativeCreditMoney()">
                        </div>
                    </div>
                </td>
            ##            折合本位币金额
                <td class="textRight nativeCreditMoney">#springMessage('international.credit.nativeCreditMoney')</td>
                <td>
                    <input type="text" data-name="nativeCreditMoney" readonly="readonly"
                           class="layui-input bt-biz-moneyType nativeCreditMoney" data-biz-name="nativeCreditMoney"
                           data-decimal="2">
                </td>
            </tr>

            <tr class="isShow">
            ##                授信品种
                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.itemCode')</td>
                <td>
                    <div class="layui-inline" id="ratItemCodeDiv">
                        <div data-required="true" class="bt-biz-selectType" data-biz-name="ratItemCode"
                             data-url="${basePath}/cms/rat/ratitemcustom/getAllRatItem?type=0"
                             data-valuefield="id" data-textfield="name" data-name="ratItemCode" data-search="true"
                             data-callback="setRationBtn">
                        </div>
                    ##    业务品种
                        #springMessage('cms.business.race')
                        <div class="bt-biz-selectType" data-biz-name="billName" data-initCallback="checkData"
                            #if($!{lcEnrol.itemCode})
                             data-url="${basePath}/cms/rat/ratBusinessRace/getBillByCustomId?customId=$!{lcEnrol.itemCode}"
                            #else
                             data-url=""
                            #end
                             data-valuefield="id" data-textfield="raceName" data-name="billName" data-search="true" data-value="$!{lcEnrol.billName}" data-defaultvalue="first">
                        </div>
                    </div>
                </td>
            ##授信额度单
                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rationSelect')</td>
                <td colspan="3">
                ##浏览按钮
                    <div class="layui-input-inline">
                        <div id="ratChooseBtn">
                            <button type="button" onclick="chooseRatCode()" class="layui-btn">#springMessage(
                                'common.button.browse')</button>
                        </div>
                    </div>
                    <div class="layui-input-inline">
                        <div style="display: none" id="rationBtn">
                            <button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage(
                                'common.button.view')</button>
                        </div>
                    </div>
                ##额度编号
                ##占用授信代码
                    <span id="itemCodeTd"></span>
                </td>
            </tr>
        #end
    ##################################授信挂接###########################################################
        #if($!{isGuarantee}=="1")##授信参数设置挂接担保
            #parse("views/common/guaContractChoose.vm")
        #end

        <tr>
        ##            是否代开信用证
            <td class="textRight">
                #springMessage('international.credit.isReCredit')
            </td>
            <td>
                <div class="bt-biz-dict" id="radio" data-type="radio" data-group="international.credit.isReCredit"
                     data-callback="setIsReCredit"
                     data-defaultvalue="0" data-name="isReCredit" data-biz-name="isReCredit">
                </div>
            </td>
        ##            被带开证单位
            <td class="textRight">
                <div class="hide isReCredit">
                    #springMessage('international.credit.reCorpCode')
                </div>
            </td>
            <td>
                <div class="hide isReCredit">
                    <div class="layui-input-inline" id="reCorpCode">
                        <div class="bt-biz-corp"
                             data-biz-name="reCorpCode"
                             data-biz-type=""
                             data-type="selectTree"
                             data-tree-type="check"
                             data-name="reCorpCode"
                             data-scope="all"
                             data-valueField="code"
                             style="width: 350px"
                        ></div>
                    </div>
                </div>
            </td>
        </tr>

        <tr class="hide isReCredit">
        ##                代开证银行
            <td class="textRight">#springMessage('international.credit.reBank')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="reBank" name="reBank" class="layui-input">
                </div>
            </td>

        ##                代开信用证号
            <td class="textRight">#springMessage('international.credit.reCreditNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="reCreditNo" name="reCreditNo" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            <td>
                <label style="font-weight: bold">#springMessage('international.other.info')</label>
            </td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
        ##                是否需要许可证
            <td class="textRight">#springMessage('international.credit.needLicence')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" id="radio" data-type="radio" data-group="international.credit.needLicence"
                         data-defaultvalue="0" lay-verify=""
                         data-name="needLicence" data-biz-name="needLicence" data-callback="checkLicenceCode">
                    </div>
                </div>
            </td>
        ##                许可证号码
            <td class="textRight">#springMessage('international.credit.licenceCode')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="licenceCode" name="licenceCode" class="layui-input">
                </div>
            </td>
        </tr>


        <tr>
        ##                手续费币别
            <td class="textRight">#springMessage('international.credit.chargeCurId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-name="chargeCurId"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName" data-defaultvalue="first" data-biz-name="chargeCurId"></div>
                </div>
            </td>


        ##                付手续费账号
            <td class="textRight">#springMessage('international.credit.payChargeAacc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="payChargeAacc" class="layui-input">
                </div>
            </td>

        </tr>

        <tr>
        ##                手续费
            <td class="textRight">#springMessage('international.credit.chargeMoney')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="chargeMoney" data-callback="compCostCalculate"
                           class="layui-input bt-biz-moneyType" data-minus="true" data-biz-name="chargeMoney"
                           data-decimal="2">
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>

        <tr>
        ##                承兑费用
            <td class="textRight">#springMessage('international.credit.acceptanceFee')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="acceptanceFee" class="layui-input bt-biz-moneyType" data-minus="true"
                           data-callback="compCostCalculate"
                           data-biz-name="acceptanceFee" data-decimal="2">
                </div>
            </td>
        ##                汇率
            <td class="textRight">#springMessage('international.credit.exchangeRate')</td>
            <td>
                <div class="layui-input-inline">
                    <input class="layui-input bt-biz-moneyType" type="text" data-name="ratExchangeRate"
                           readonly="readonly" data-convert="true"
                           data-biz-name="ratExchangeRate">
                </div>
            </td>
        </tr>

        <tr>
        ##                贴现费率
            <td class="textRight">#springMessage('international.credit.discountRate')</td>
            <td>
                <div class="layui-input-inline">
                    <input class="layui-input bt-biz-rateType" type="text" data-name="discountRate" data-decimal="2">
                </div>
            </td>
        ##                承兑金额
            <td class="textRight">#springMessage('international.credit.acceptanceMoney')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="acceptanceMoney" class="layui-input bt-biz-moneyType"
                           data-callback="compCostCalculate"
                           data-minus="true" data-biz-name="acceptanceMoney" data-decimal="2">
                </div>
            </td>
        </tr>

        <tr>
        ##                贸易亏损
            <td class="textRight">#springMessage('international.credit.tradeDeficit')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="tradeDeficit" class="layui-input bt-biz-moneyType" data-minus="true"
                           data-callback="compCostCalculate"
                           data-biz-name="tradeDeficit" data-decimal="2">
                </div>
            </td>
        ##                其他费用
            <td class="textRight">#springMessage('international.credit.otherFee')</td>
            <td>

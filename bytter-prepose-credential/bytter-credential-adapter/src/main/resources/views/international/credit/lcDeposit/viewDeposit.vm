<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="myform">
##    付汇状态
    <input type="hidden" id="status" name="status">
    <input type="hidden" id="id" name="id" value="$!{lcDeposit.id}">
    <table class="layui-table">
        <tr>
        ##                到单号
            <td class="textRight">#springMessage('table.internation.arrival.com.no')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.arrivalNo}
                </div>
            </td>
        ##                信用证号
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.creditNo}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##               付汇日期
                #springMessage('table.international.pay.date')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcBillArrival.payDate})
                </div>
            </td>
            <td class="textRight">
            ##                币别
                #springMessage('international.payment.curName')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcDeposit.curName}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                到单金额
                                #springMessage('table.international.Arrival.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.billMoney})
                </div>
            </td>
            <td class="textRight">
            ##                需押汇金额
                                #springMessage('table.internation.neddPayment.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.payMoney})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                已押汇金额
                                #springMessage('international.hadDeposited.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{depositedMoney})
                </div>
            </td>

            <td class="textRight">
            ##                押汇在途金额
                                #springMessage('international.depositing.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{depositingMoney})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                受益人
                                #springMessage('international.credit.beneficiary')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.beneficiary}
                </div>
            </td>
            <td class="textRight">
            ##                开证人
                                #springMessage('international.credit.applicant')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{applicantName}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                合同号
                                #springMessage('international.credit.contractNo')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.contractNo}
                </div>
            </td>

            <td class="textRight">
            ##                到单银行
                                #springMessage('international.arrival.com.bankName')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.handDocBank}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                押汇日期
                                #springMessage('international.lcDeposit.depositDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcDeposit.depositDate})
                </div>
            </td>
            <td class="textRight">
            ##                到期日期
                                #springMessage('international.lcDeposit.expiryDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcDeposit.expiryDate})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                汇率
                                #springMessage('international.credit.exchangeRate')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!excRateTag.getConvert($!{lcDeposit.exchangeRate})
                </div>
            </td>
            <td class="textRight">
            ##                押汇金额
                                #springMessage('international.lcDeposit.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcDeposit.depositMoney})
                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">
            ##                期限
                                #springMessage('international.lcDeposit.timeLimit')
            </td>
            <td>
                <div>
                    $!{lcDeposit.timeLimit}
                    #if($!{lcDeposit.timeLimit})
                        $dictTag.get("international.lcDepost.termUnit",$!{lcDeposit.termUnit})
                    #end
                </div>
            </td>
            <td class="textRight">
            ##                利率
                                #springMessage('international.lcDeposit.interestRate')
            </td>
            <td>
                <div class="layui-input-inline">
                    #if($!{lcDeposit.interestRate})
                        $!number.formatNumeric($math.mul($!{lcDeposit.interestRate},100),"#0.0000")%
                    #end
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
                ##                付息日期
                                #springMessage('international.lcDeposit.payInterestDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcDeposit.payInterestDate})
                </div>
            </td>
            <td class="textRight">
                ##                利息
                                    #springMessage('international.lcDeposit.payInterestMoney')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcDeposit.payInterestMoney})
                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">
            ##                是否补录
                                #springMessage('international.lcDeposit.isSkipProcess')
            </td>
            <td>
                <div class="layui-input-inline">
                    $dictTag.get("international.lcDepost.isSkipProcess",$!{lcDeposit.isSkipProcess})
                </div>
            </td>
            <td class="textRight">
            ##                备注
                                #springMessage('international.lcDeposit.rmk')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcDeposit.rmk}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" id="gid" name="attachmentId" value="$!{lcDeposit.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'selectType', 'rateType',
        'moneyType', 'corp', 'verify', 'bondAccInfo', 'externalCorpBankAcc', 'bankInfo', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        bt.dicts.init();//字典
        bt.dateType.init();//时间
        bt.selectType.init();//下拉选择
        bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        bt.corp.init();//单位
        bt.externalCorpBankAcc.init();//客商
        bt.bankInfo.init();//银行
        // 附件功能
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });
        //这里填写新的js代码，请参考前端文档
    });

</script>
</body>
</html>
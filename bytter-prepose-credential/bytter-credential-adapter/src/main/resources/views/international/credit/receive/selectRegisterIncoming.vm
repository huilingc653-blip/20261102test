	<table id="appTable" class="layui-table layui-form"
		style="width: 100%;">
		<thead>
			<tr>
                <th>#springMessage('common.table.thead.operation')</th>
                <th>#springMessage('table.nisPersonnelDetail.corpId')</th>##单位名称
				<th>#springMessage('table.fcPredrawDtlTemp.orderNo')</th>##流水号
				<th>#springMessage('international.credit.lcInter')</th>##信用证类型
				<th>#springMessage('table.internation.arrival.com.no')</th>##到单号
				<th>#springMessage('international.credit.creditNo')</th>##信用证号
                <th>#springMessage('international.credit.issuingBank')</th>##开证银行
				<th>#springMessage('table.internation.proceeds.money')</th>##收款金额
				<th>#springMessage('table.ratBkrationRelief.curCode')</th>##币种
				<th>#springMessage('international.credit.createDate')</th>##登记日期
                <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th>##到期日期
				<th>#springMessage('common.table.status')</th>##单据状态
			</tr>
		</thead>
	</table>
	#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    var selectTypem;
	bt.use(['form','datatable','dateType','moneyType','corp','dicts',"selectType"], function(){
	    $ = bt.jquery,form = bt.form();
	    //时间
	    bt.dateType.init();
	    bt.corp.init();
        bt.dicts.init();
        selectType = bt.selectType.init();

        //生成列表
	    datatable = bt.datatable.init({
	        elem: "#appTable",
	        dom: 'Brtlip',
	        colReorder: true,
	        ordering:false,
            buttonsLayout: false,
            fixedColumns: {
                rightColumns:1//代表冻结右边一列
            },
	        ajax: {
	            'url': basePath+"/international/credit/incomingletter/selectDatatable"
	        },
	        searchForm:{
	            formFilter:"search",
	            formElem:"#searchForm"
	        }
	        , columns: [
                {
                    data: null, bSortable: false, className: 'center',
                    render: function (data, type, full, meta) {
                        return '<a href="javascript:void(0);" class="businessInfo-select" data-row="' + meta.row + '">' + bt.lang("common.button.select") + '</a>';
                    }
                },
                {data: "corpName", className: "center"},
                {data: "arrivalCode", className: "center"},
                {
                    data: "arrivalType", className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("letter_of_credit_inter", full.arrivalType);
                    }
                },
                {data: "arrivalNo", className: "center"},
                {data: "creditNo", className: "center"},
                {data: "openingBankName", className: "center"},
                {
                    data: "payMoney", className: "textRight",
                    render: function (data, type, full, mate) {
                        var payMoney = bt.money.format(full.payMoney);
                        return payMoney;
                    }
                },
                {data: "curName", className: "center"},
                {data: "createDate", className: "center"},
                {data: "paymentDate", className: "center"},
                {
                    data: "status", className: "center",
                    render: function (data, type, full, mate) {
                        return bt.dict("international.lcBillArrival.status", full.status);
                    }
                }
            ]
	    });

        datatable.on('click', '.businessInfo-select', function () {//点击选择触发
            var data = datatable.row($(this).data('row')).data();
            if (data.length <= 0) {
                parent.layer.alert(bt.lang("common.message.confirm.selectData"), {icon: 2});
                return;
            }
            var currentParentIframe = top.$('.layui-tab-content > .layui-show').find('iframe')[0]['name'];
            // 调父页面的回调方法
            top.frames[currentParentIframe].window.busTypeCallback(data,$("#row").val());

        });
	});


/*    function getSelectDate() {
		var data = bt.datatable.getSelectData("#appTable");
        if (data.length <= 0) {
            parent.layer.alert(bt.lang("common.message.confirm.selectData"), {icon: 2});
            return;
        }
		var currentParentIframe = top.$('.layui-tab-content > .layui-show').find('iframe')[0]['name'];
		// 调父页面的回调方法
		top.frames[currentParentIframe].window.busTypeCallback(data[0],$("#row").val());
    }*/
	
    function curIdCallBack() {
        $("#eqscurId").val(selectType.get("curId").val());
    }
	</script>
</html>

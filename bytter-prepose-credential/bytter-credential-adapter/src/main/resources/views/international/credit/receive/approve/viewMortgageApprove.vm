<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
	<div>
		<form id="searchForm" class="layui-form">
            <iframe src="${basePath}/international/credit/arrivalletter/viewArrovalInfo?id=$!{info.arrivalId}&flag=0" frameborder="0" scrolling="no" style="width: 100%;"></iframe>
			<table class="layui-table">
                <tbody>
				<tr>
				##抵押日期
					<td class="textRight" width="%">#springMessage('table.internation.pledge.date')</td>
                    <td width="36%">
						$!date.format('yyyy-MM-dd',$!info.mortgageDate)
					</td>
				
				##到期日期
					<td class="textRight" width="14%">#springMessage('international.lcDeposit.expiryDate')</td>
					<td width="36%">
						$!date.format('yyyy-MM-dd',$!info.expiryDate)
					</td>
				
				</tr>
				
				<tr>
				##利率
					<td class="textRight">#springMessage('international.lcDeposit.interestRate')</td>
					<td >
						$!number.formatNumeric($math.mul($!{info.interestRate},100),"#0.0000")%
					</td>
				
				##备注
					<td class="textRight">#springMessage('table.international.payment.rmk')</td>
					<td >
						$!{info.rmk}
					</td>
				</tr>
				<tr>
					<td>#springMessage('cms.loan.attachment')</td>
					<td colspan="3">
						<input type="hidden" id="gid1" name="attachmentId" value="$!{info.attachmentId}">
						<div id="uploader1" class="layui-input-inline" style="width:100%;"></div>
					</td>
				</tr>
				</tbody>
			</table>
        </form>
	    <script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
	</div>
    #workFlowHtml()
	#parse("views/common/footer.vm")
	#workFlowScript()
</body>
<script type="text/javascript">
	bt.use(['form', 'btUpload', 'dicts', 'moneyType', "btUpload"], function () {
		$ = bt.jquery, form = bt.form();
		fun = bt.moneyType.getFun();
		var gid = $("#gid1").val();
		var up = bt.btUpload.init({
			elem: "#uploader1",
			hasUpload: false,
			hasDelete: false,
			isExpand: true,
			auto: false,
			gid: gid
		});
	});
</script>
</html>
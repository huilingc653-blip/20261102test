<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
	<table class="layui-table">
		<tbody>
        <tr>
			
		##信用证号
            <td  class="textRight" width="50%">#springMessage('international.credit.creditNo')：</td>
            <td width="50%"><input type="text" class="layui-input" name="likes_creditNo" /></td>
            <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <tr>
		   	<tr>
		   		<td colspan="2" style="text-align: center;">
		   			<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
		           	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		   		</td>
		   	</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.sysCorp.corpName')</th>##单位名称
        <th>#springMessage('table.fcPredrawDtlTemp.orderNo')</th>##流水号
        <th>#springMessage('table.internation.arrival.com.no')</th>##到单号
        <th>#springMessage('international.credit.creditNo')</th>##信用证号
        <th>#springMessage('table.internation.payment.money')</th>##付汇金额
        <th>#springMessage('ttpay.currency')</th>##币种
        <th>#springMessage('international.credit.createDate')</th>##登记日期
        <th>#springMessage('international.lcDeposit.expiryDate')</th>##到期日期
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
</table>
#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()
<script>
    bt.use(['form','datatable','corp','moneyType'], function(){
        $ = bt.jquery,form = bt.form();
        bt.corp.init();//单位
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            checkbox:true,
            ajax: {
                'url': basePath+"/international/credit/mortgageletter/getDataInfoApproveTables"
            },
            searchForm:{
                formElem:"#searchForm",
                formFilter:"search"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            columns: [
                {data:"corpName",bSortable:true,className:"center"},
                {data:"mortgageNo",bSortable:true,className:"center"},
                {data:"arrivalNo",bSortable:true,className:"center"},
                {data:"creditNo",bSortable:true,className:"center"},
                {data:"mortgageMoney",bSortable:true,className:"textRight",
                    render: function(data,type,full,mate){
                        var mortgageMoney = bt.money.format(full.mortgageMoney);
                        return mortgageMoney;
                    }},
                {data:"curName",bSortable:true,className:"center"},
                {data:"lcCreateDate",bSortable:true,className:"center"},
                {data:"expiryDate",bSortable:true,className:"center"},
                {data:null,bSortable:false,className:'center',render: function (data, type, full, meta) {
                    var html='';
                    if($("#flowStatus").val()=='todo'){
                        html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
                    }
                    html += '<a class="" href="#" data-row="'+meta.row+'" onclick="bt.workFlow.trackFlow(\''+full.processInstanceId+'\')">'+bt.lang("common.button.trackFlow")+'</a>';
                    return html;
                }}
            ],
            summary:{
                pageSum: false,//小计功能关闭
                allSum: true,//汇总功能开启
                selectSum: true,//已选汇总功能开启
                // groupColumn: 'curName',//分类汇总列参数
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '5',//汇总列序号
                        dataName: 'mortgageMoney',//汇总列数据
                    }
                ]
            }
        });
    });

    /**审批*/
    function approve(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.approve') ,basePath + "/international/credit/mortgageletter/infoApprove?businessId=" + data.id + "&taskId=" + data.taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/international/credit/mortgageletter/infoApprove?businessId=" + data.id + "&taskId=" + data.taskId
        });
    }
</script>
</body>
</html>

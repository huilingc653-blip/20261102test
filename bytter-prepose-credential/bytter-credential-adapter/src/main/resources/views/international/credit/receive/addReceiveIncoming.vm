<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" name="arrivalId" value="$!{arrival.id}">##交单Id  
        <input type="hidden" name="lcId" value="$!{arrival.lcId}">##信用证登记ID
        <input type="hidden" name="corpId" value="$!{arrival.corpId}">
        <input type="hidden" name="curId" value="$!{arrival.curId}">
        <input type="hidden" id="lcInter" value="$!{lcInter}">
        <table class="layui-table">
            <tbody>
               <tr>
                   <td colspan="4" style="text-align: center;">
                       <label><b>#springMessage('international.arrival.receiveInfo')</b></label>
                   </td>                   
               </tr>
               
               <tr>
                   ##实收金额
                   <td class="textRight" width="30%">#springMessage('table.internation.arrival.received.money')</td>
                   <td>
                       <div class="layui-inline">
                           <input class="layui-input bt-biz-moneyType" data-maxlength="20"  data-name="incomingMoney"
                                  lay-verify="required|strlength" data-biz-name="incomingMoney"
                                  data-decimal="2" data-minus="false" type="text" >
                       </div>
                   </td>
                   
               </tr>
               
               <tr>
                   ##手续费
                   <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.poundage')</td>
                   <td>
                        <div class="layui-inline">
                            <input class="layui-input bt-biz-moneyType" data-maxlength="20"  data-name="handlingCharge"
                                   lay-verify="required|strlength" data-biz-name="handlingCharge"
                                   data-decimal="2" data-minus="false" type="text" >
                        </div>
                    </td>
               </tr>
##               汇率
               <tr id="inter">
                   <td class="textRight"> #springMessage('table.btCurrency.curExrate')</td>
                   <td>
                       <div class="layui-inline">
                           <input class="layui-input bt-biz-moneyType" type="text"  value="$!{exchangeRate}" data-convert="true"
                                  data-name="exchangeRate" readonly="readonly" autocomplete="off" data-decimal="4" data-minus="false" >
                       </div>
                   </td>
               </tr>
               
               <tr>
               ##备注
                   <td class="textRight">#springMessage('table.fcInstrateAdjust.rmk')</td>
                   <td >
                       <div class="layui-inline">
                           <input class="layui-input-inline layui-input" type="text" name="rmk"></input>
                       </div>
                   </td>
               </tr>
               <tr>
                   <td class="textRight">#springMessage('cms.loan.attachment')</td>
                   <td colspan="3">
                       <input type="hidden" id="gid" name="attachmentId" value="">
                       <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
                   </td>
               </tr>
               <tr>
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" value="6" lay-submit="" lay-filter="submit">#springMessage('table.bisAccBal.btn.confirm')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
#parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form', 'jquery', 'corp', 'dateType', 'moneyType', 'selectType',
        'dicts', 'rateType', 'bankInfo', 'btUpload', 'bondAccInfo', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form(), fun = bt.moneyType.getFun();
        dateTypes = bt.dateType.init();//时间
        moneyTypes = bt.moneyType.init();//金额
        bt.corp.init();//单位
        selectTypes = bt.selectType.init();//下拉框
        dicts = bt.dicts.init();//字典
        rateTypes = bt.rateType.init();//利率
        bt.bankInfo.init();//联行号
        moneyFun = bt.moneyType.getFun();
        // 附件功能
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            isExpand: true,
            auto: false,
            gid: gid
        });

        //监听提交 99 0
        form.on('submit(submit)', function (data) {
            var status = $(this).attr("value");
            var action = "/international/credit/incomingletter/tempOrSubmit"
            data.field.status = status;
            data.field.attachmentId = up.getGroupId();
            bt.loading.show();
            $.post(basePath + action, data.field, function (result) {
                parent.layer ? parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}) : layer.alert(result.msg, {icon: result.success ? 1 : 2});
                if (result.success) {
                    if (!bt.navtab) {
                        bt.navtab.refreshParentTable();
                        //parent.layer?parent.layer.closeAll():layer.closeAll();
                    } else {
                        bt.navtab.closeCurrent();
                    }
                } else {
                    bt.loading.hide();
                }
            }, 'JSON');
            return false;
        });

        setShift();
    });
    var setShift = function(){
        var lcType = $("#lcInter").val();
        if("0" == lcType){//国内
            $("#inter").hide();
        }else {
            $("#inter").show();
        }
    }
</script>
</html>

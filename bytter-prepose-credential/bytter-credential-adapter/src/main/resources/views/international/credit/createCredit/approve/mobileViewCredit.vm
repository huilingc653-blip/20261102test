<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##                登记日期
    <li class="mui-table-view-cell">
        #springMessage('international.credit.createDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{lcEnrol.createDate})
        </span>
    </li>
##                信用证类型
    <li class="mui-table-view-cell">
        #springMessage('international.credit.lcInter')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("letter_of_credit_inter",0)
        </span>
    </li>

##                开证人
    <li class="mui-table-view-cell">
        #springMessage('international.credit.applicant')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.corpName}
        </span>
    </li>

##                信用证号
    <li class="mui-table-view-cell">
        #springMessage('international.credit.creditNo')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.creditNo}
        </span>
    </li>

##                合同号
    <li class="mui-table-view-cell">
        #springMessage('international.credit.contractNo')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.contractNo}
        </span>
    </li>

##                受益人
    <li class="mui-table-view-cell">
        #springMessage('international.credit.beneficiary')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.beneficiary}
        </span>
    </li>


    #if($!{config.international.creditIsHang}==1)
    ##              是否挂接授信
        <li class="mui-table-view-cell">
            #springMessage('table.cmsProvideLoanInfo.ratmodel')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("sf_yn",$!{lcEnrol.isHangCredit})
            </span>
        </li>
    #end


##                开证日期
    <li class="mui-table-view-cell">
        #springMessage('international.credit.issuingDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{lcEnrol.issuingDate})
        </span>
    </li>

##                信用证有效期
    <li class="mui-table-view-cell">
        #springMessage('international.credit.expiryDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format( 'yyyy-MM-dd',$!{lcEnrol.expiryDate})
        </span>
    </li>

##                开户行
    <li class="mui-table-view-cell">
        #springMessage('international.credit.issuingBank')
        <span class="mui-badge mui-badge-inverted">
            $!{applicantAccShow}
        </span>
    </li>

##                受益人账号
    <li class="mui-table-view-cell">
        #springMessage('international.credit.beneficiaryAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.beneficiaryAcc}
        </span>
    </li>

##                开证人账号
    <li class="mui-table-view-cell">
        #springMessage('international.credit.applicantAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.applicantAcc}
        </span>
    </li>

##                受益人开户行
    <li class="mui-table-view-cell">
        #springMessage('international.credit.beneficiaryBank')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.beneficiaryBank}
        </span>
    </li>

##                开证人地址
    <li class="mui-table-view-cell">
        #springMessage('international.credit.addr')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.addr}
        </span>
    </li>

##                受益人地址
    <li class="mui-table-view-cell">
        #springMessage('international.credit.addrBen')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.addrBen}
        </span>
    </li>

##                开证人邮编
    <li class="mui-table-view-cell">
        #springMessage('international.credit.postNum')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.postNum}
        </span>
    </li>

##                受益人邮编
    <li class="mui-table-view-cell">
        #springMessage('international.credit.postNumBen')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.postNumBen}
        </span>
    </li>

##                开证币种
    <li class="mui-table-view-cell">
        #springMessage('international.credit.issuingCurId')
        <span class="mui-badge mui-badge-inverted">
            $!{curName}
        </span>
    </li>

##                开证金额
    <li class="mui-table-view-cell">
        #springMessage('international.credit.creditMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcEnrol.creditMoney})
        </span>
    </li>

##                开证金额大写
    <li class="mui-table-view-cell">
        #springMessage('international.credit.creditMoney.big')
        <span class="mui-badge mui-badge-inverted">
            $!{creditMoneyUpper}
        </span>
    </li>

    #if($!{config.international.creditIsBond}==1)
    ##                    是否挂保证金
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.includeBond')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("sf_yn",$!{lcEnrol.isHangBond})
            </span>
        </li>
    ##                    保证金额度单
        #if($!{lcEnrol.isHangBond} == 1)
            <li class="mui-table-view-cell">
                #springMessage('table.fcBond.quotas')
                <span class="mui-badge mui-badge-inverted">
                    $!{lcEnrol.bondBankAcc}
                </span>
            </li>
        #end
    ##                    保证金币别
        <li class="mui-table-view-cell">
            #springMessage('international.credit.bondCurId')
            <span class="mui-badge mui-badge-inverted">
                $!{lcEnrol.bondCurName}
            </span>
        </li>

    ##                  保证金比例
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.bondPercent')
            <span class="mui-badge mui-badge-inverted">
        $!number.formatNumeric($math.mul($!{lcEnrol.bondPercent},100),"#0.0000")%
        </span>
        </li>

    ##                  保证金金额
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.bondmoney')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{lcEnrol.bondMoney})
            </span>
        </li>
    ##                  保证金合同号
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.contractNum')
            <span class="mui-badge mui-badge-inverted">
                $!{lcEnrol.bondContract}
            </span>
        </li>
    ##                  保证金账户利率
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.bondRate')
            <span class="mui-badge mui-badge-inverted">
                #if($!{lcEnrol.bondRate})
                    $!number.formatNumeric($math.mul($!{lcEnrol.bondRate},100),"#0.0000")%
                #end
            </span>
        </li>
    #end

    #if($!{lcEnrol.isHangCredit}==1)
        #if($!{lcEnrol.issuingCurId} != $!{nativeCur.id})
        ##            是否折合成本位币
            <li class="mui-table-view-cell">
                #springMessage('international.credit.isNativeCur')
                <span class="mui-badge mui-badge-inverted">
                    #if($!{lcEnrol.isNativeCur} == 1)
                    $dictTag.get("international.credit.isNativeCur",1)
                #else
                        $dictTag.get("international.credit.isNativeCur",0)
                    #end
                </span>
            </li>
            #if($!{lcEnrol.isNativeCur} == 1)
            ##            折合本位币金额
                <li class="mui-table-view-cell">
                    #springMessage('international.credit.nativeCreditMoney')
                    <span class="mui-badge mui-badge-inverted">
                        $!number.formatNumeric($!{lcEnrol.nativeCreditMoney})
                    </span>
                </li>
            #end
        #end
    ##                授信品种
        <li class="mui-table-view-cell">
            #springMessage('table.cmsProvideLoanInfo.itemCode')
            <span class="mui-badge mui-badge-inverted">
                $!{ratUration.ratItemName}
            </span>
        </li>
    #end

##            是否挂担保
    <li class="mui-table-view-cell">
        #springMessage('rat.Is.bkration.gua')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{lcEnrol.isHangGuarantee})
        </span>
    </li>
#if($!{lcEnrol.isHangGuarantee} == 1)
##                    担保合同
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.guaContract')
        <span class="mui-badge mui-badge-inverted">
            $!{guaConstractCode}
        </span>
    </li>

##                    担保方式
    <li class="mui-table-view-cell">
        #springMessage('table.guaContract.guaType')
        <span class="mui-badge mui-badge-inverted">
            $!{guaWayNames}
        </span>
    </li>

##                担保备注
    <li class="mui-table-view-cell">
        #springMessage('table.cmsProvideLoanInfo.itemCode')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.guaranteeRmk}
        </span>
    </li>
#end
##                期限
    <li class="mui-table-view-cell">
        #springMessage('international.credit.timeLimit')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("letter_of_credit_timeLimit",$!{lcEnrol.timeLimit})
        </span>
    </li>
    #if($!{lcEnrol.timeLimit} == 2)
    ##                远期天数
        <li class="mui-table-view-cell">
            #springMessage('international.credit.delayDates')
            <span class="mui-badge mui-badge-inverted">
                $!{lcEnrol.delayDates}
            </span>
        </li>
    #end


##                手续费
    <li class="mui-table-view-cell">
        #springMessage('international.credit.chargeMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcEnrol.chargeMoney})
        </span>
    </li>

##                付手续费账号
    <li class="mui-table-view-cell">
        #springMessage('international.credit.payChargeAacc')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.payChargeAacc}
        </span>
    </li>

##                承兑金额
    <li class="mui-table-view-cell">
        #springMessage('international.credit.acceptanceMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcEnrol.acceptanceMoney})
        </span>
    </li>

##                汇率
    <li class="mui-table-view-cell">
        #springMessage('international.credit.exchangeRate')
        <span class="mui-badge mui-badge-inverted">
            $!excRateTag.getConvert($!{lcEnrol.exchangeRate})
        </span>
    </li>

##                承兑费用
    <li class="mui-table-view-cell">
        #springMessage('international.credit.acceptanceFee')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcEnrol.acceptanceFee})
        </span>
    </li>

##                其他费用
    <li class="mui-table-view-cell">
        #springMessage('international.credit.otherFee')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcEnrol.otherFee})
        </span>
    </li>

##                贴现费率
    <li class="mui-table-view-cell">
        #springMessage('international.credit.discountRate')
        <span class="mui-badge mui-badge-inverted">
            #if($!{lcEnrol.discountRate})
                $!number.formatNumeric($math.mul($!{lcEnrol.discountRate},100),"#0.00")%
            #end
        </span>
    </li>

##                贴现息
    <li class="mui-table-view-cell">
        #springMessage('international.credit.discountInterest')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcEnrol.discountInterest})
        </span>
    </li>

##                贸易亏损
    <li class="mui-table-view-cell">
        #springMessage('international.credit.tradeDeficit')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcEnrol.tradeDeficit})
        </span>
    </li>
##                综合成本
    <li class="mui-table-view-cell">
        #springMessage('international.credit.compCost')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcEnrol.compCost})
        </span>
    </li>
##                应回款金额
    <li class="mui-table-view-cell">
        #springMessage('international.credit.rebackMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcEnrol.rebackMoney})
        </span>
    </li>

##                敞口金额
    <li class="mui-table-view-cell">
        #springMessage('international.credit.openMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcEnrol.openMoney})
        </span>
    </li>

##                用途
    <li class="mui-table-view-cell">
        #springMessage('international.credit.purpose')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.purpose}
        </span>
    </li>

##                备注
    <li class="mui-table-view-cell">
        #springMessage('international.credit.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.rmk}
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="searchForm">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('international.credit.lcInter')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" id="lcInter" data-type="select" data-group="letter_of_credit_inter"  value="$!{lcEnrol.lcInter}"
                         data-name="eqs_lcInter" data-biz-name="lcInter" >
                    </div>
                </div>
            </td>
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <input type="text" class="layui-input" name="likes_creditNo" />
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="" lay-filter="search">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="datatable" class="layui-table" style="width:100%">
    <thead>
    <tr>
        <th>#springMessage('table.fcPredrawDtlTemp.orderNo')</th>##流水号
        <th>#springMessage('international.credit.lcInter')</th>##信用证类型
        <th>#springMessage('international.credit.creditNo')</th>##信用证号
        <th>#springMessage('international.credit.contractNo')</th>##合同号
        <th>#springMessage('table.internation.arrival.com.no')</th>##到单号
        <th>#springMessage('table.internation.payment.money')</th>##付汇金额
        <th>#springMessage('table.international.arrival.curId')</th>##币种
        <th>#springMessage('table.international.arrival.createDate')</th>##登记日期
        <th>#springMessage('table.international.arrival.paymentDate')</th>##到单日期
        <th>#springMessage('table.international.pay.date')</th>##付汇日期
        <th>#springMessage('international.arrival.com.bankName')</th>##到单银行
        <th>#springMessage('international.credit.beneficiary')</th>##受益人
        <th>#springMessage('common.table.status')</th>##单据状态
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
<script>
    bt.use(['jquery','datatable','form','dicts'], function(){
        $ = bt.jquery;
        bt.dicts.init();

        var datatable = bt.datatable.init({
            elem : "#datatable",
            checkbox : false,
            ajax : {
                url : "querySupplementPayment",
                dataSrc : "data"
            },
            colReorder : true,
            fixedColumns: {
                rightColumns: 1//代表冻结右边一列
            },
            columns: [
                {
                    data: "paymentNo",
                    className: "center"
                },
                {
                    data: "lcInter",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("letter_of_credit_inter", full.lcInter);
                    }
                }, {
                    data: "creditNo",
                    className: "center"
                }, {
                    data: "contractNo",
                    className: "center"
                }, {
                    data: "arrivalNo",
                    className: "center"
                }, {
                    data: "paymentMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.paymentMoney);
                    }
                }, {
                    data: "curName"
                }, {
                    data: "createDate"
                }, {
                    data: "billArrivalDate"
                }, {
                    data: "paymentDate",
                    className: "center"
                }, {
                    data: "handDocBank",
                    className: "center"
                }, {
                    data: "beneficiary"
                }, {
                    data: "status",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("international.lcPayment.status", full.status);
                    }
                }, {
                    data: null,
                    className: "center",
                    render: function (data, type, full, meta) {
                        var explode = "<span class=\"text-explode\">|</span>"
                        var id = full.id;
                        var html = "<a class=\"\" href=\"#\" data-row=\"" + meta.row + "\" onclick=\"supplement('" + id + "')\">" + bt.lang("common.button.makeup") + "</a>";

                        return html;
                    }
                }
            ],
            btInitComplete:function(setting,json){
            },
            searchForm : {
                formElem : "#searchForm",
                formFilter : "search",
                callback : function (data) {

                }
            },
            summary:{
                pageSum: false,//小计功能关闭
                allSum: true,//汇总功能开启
                // selectSum: true,//已选汇总功能开启
                // groupColumn: 'curName',//分类汇总列参数
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '6',//汇总列序号
                        dataName: 'paymentMoney',//汇总列数据
                    }
                ]
            }
        });
    });


    function supplement(id){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.makeup'),basePath + "/international/credit/supplementPayment/editSupplementPayment?id=" +id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/international/credit/supplementPayment/editSupplementPayment?id="+id,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }


</script>
</body>
</html>

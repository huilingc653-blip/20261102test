<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="myform">
##    付汇状态
    <input type="hidden" name="id" id="id" value="$!{lcPayment.id}">
    <input type="hidden" id="status" name="status">
    <table class="layui-table">
        <tr>
        ##                到单号
            <td class="textRight">#springMessage('table.internation.arrival.com.no')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.arrivalNo}
                </div>
            </td>
        ##                信用证号
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.creditNo}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##               付汇日期
                #springMessage('table.international.pay.date')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcBillArrival.payDate})
                </div>
            </td>
            <td class="textRight">
            ##                币别
                #springMessage('international.payment.curName')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{curName}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                到单金额
                                #springMessage('table.international.Arrival.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.billMoney})
                </div>
            </td>
            <td class="textRight">
            ##                需付汇金额
                                #springMessage('table.internation.neddPayment.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.payMoney})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##已付汇金额
                #springMessage('internation.hadPaymented.money')
            </td>
            <td>
                $!number.formatNumeric($!{paymentedMoney})
            </td>
            <td class="textRight">
            ##                付汇在途金额
                                #springMessage('internation.paymenting.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{paymentingMoney})
                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">
            ##                受益人
                                #springMessage('international.credit.beneficiary')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.beneficiary}
                </div>
            </td>
            <td class="textRight">
            ##                开证人
                                #springMessage('international.credit.applicant')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{applicantName}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                到单手续费
                                #springMessage('table.international.payment.handlingCharge')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="handlingCharge" id="handlingCharge"
                           class="layui-input bt-biz-moneyType" data-biz-name="handlingCharge"
                           data-decimal="2" value="$!{lcPayment.handlingCharge}">

                </div>
            </td>
            <td class="textRight">
            ##                到单银行
                                #springMessage('international.arrival.com.bankName')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.handDocBank}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                合同号
                                #springMessage('international.credit.contractNo')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.contractNo}
                </div>
            </td>
            <td class="textRight">
            ##                付汇金额
                                #springMessage('table.internation.payment.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="paymentMoney" id="paymentMoney" readonly="readonly"
                           class="layui-input bt-biz-moneyType" data-biz-name="paymentMoney"
                           data-decimal="2" value="$!{lcPayment.paymentMoney}">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                汇率
                                #springMessage('international.credit.exchangeRate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="exchangeRate" id="exchangeRate" value="$!{lcPayment.exchangeRate}"
                           class="layui-input bt-biz-moneyType" data-biz-name="exchangeRate" data-convert="true">
                </div>
            </td>
            <td class="textRight">
            ##                备注
                                #springMessage('table.international.payment.rmk')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="rmk" name="rmk" class="layui-input" value="$!{lcPayment.rmk}">
                </div>
            </td>
        </tr>
        <tr>
            <td>#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" id="gid" name="attachmentId" value="$!{lcPayment.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'selectType', 'rateType',
        'moneyType', 'corp', 'verify', 'bondAccInfo', 'externalCorpBankAcc', 'bankInfo', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        bt.dicts.init();//字典
        bt.dateType.init();//时间
        bt.selectType.init();//下拉选择
        bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        bt.corp.init();//单位
        bt.externalCorpBankAcc.init();//客商
        bt.bankInfo.init();//银行
        // 附件功能
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            isExpand: true,
            auto: false,
            gid: gid
        });

        form.on("submit(submit)", function (data) {
            $("#status").val(11)
            bt.loading.show();
            var url = basePath + "/international/credit/payment/savePayment"
            $("#gid").val(up.getGroupId());
            $.ajax({
                url: url,
                data: $("#myform").serialize(),
                dataType: "json",
                type: "POST",
                success: function (data) {
                    parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                    if (data.success) {
                        if (!bt.navtab) {
                            bt.navtab.refreshParentTable();
                        } else {
                            bt.navtab.closeCurrent();
                        }
                    } else {
                        bt.loading.hide();
                    }
                }
            })
            return false;
        });

        form.on("submit(temp)", function (data) {
            $("#status").val(0)
            bt.loading.show();
            var url = basePath + "/international/credit/payment/savePayment"
            $("#gid").val(up.getGroupId());
            $.ajax({
                url: url,
                data: $("#myform").serialize(),
                dataType: "json",
                type: "POST",
                success: function (data) {
                    parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                    if (data.success) {
                        if (!bt.navtab) {
                            bt.navtab.refreshParentTable();
                        } else {
                            bt.navtab.closeCurrent();
                        }
                    } else {
                        bt.loading.hide();
                    }
                }
            })
            return false;
        });
        //这里填写新的js代码，请参考前端文档
    });

</script>
</body>
</html>
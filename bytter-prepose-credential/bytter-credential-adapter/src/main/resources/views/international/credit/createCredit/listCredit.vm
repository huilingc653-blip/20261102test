<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="searchForm">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('international.credit.lcInter')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" id="lcInter" data-type="select" data-group="letter_of_credit_inter"  value="$!{lcEnrol.lcInter}"
                         data-name="eqs_lcInter" data-biz-name="lcInter" >
                    </div>
                </div>
            </td>
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <input type="text" class="layui-input" name="likes_creditNo" />
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="" lay-filter="search">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="datatable" class="layui-table" style="width:100%">
    <thead>
    <tr>
        <th>#springMessage('table.fcPredrawDtlTemp.orderNo')</th>##流水号
        <th>#springMessage('international.credit.lcInter')</th>##信用证类型
        <th>#springMessage('international.credit.creditNo')</th>##信用证号
        <th>#springMessage('international.credit.contractNo')</th>##合同号
        <th>#springMessage('international.credit.issuingDate')</th>##开证日期
        <th>#springMessage('international.credit.expiryDate')</th>##有效期
        <th>#springMessage('international.credit.creditMoney')</th>##开证金额
        <th>#springMessage('international.credit.issuingCurId')</th>##开证币别
        <th>#springMessage('international.credit.beneficiary')</th>##受益人
        <th>#springMessage('international.credit.purpose')</th>##用途
        <th>#springMessage('common.table.status')</th>##状态
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
    #workFlowScript()
<script>
    bt.use(['jquery','datatable','form','dicts'], function(){
        debugger;


        $ = bt.jquery;
        bt.dicts.init();
        var datatable = bt.datatable.init({
            elem : "#datatable",
            checkbox : false,
            order: [[0,'desc']],
            ajax : {
                url : "queryCredit",
                dataSrc : "data"
            },
            buttons : [
                {
                    text : bt.lang('international.credit.addCredit'),
                    action : function (e, dt, node, config) {
                        add(0);
                    }
                },
                {
                    text : bt.lang('international.credit.addInternationalCredit'),
                    action : function (e, dt, node, config) {
                        add(1);
                    }
                }
            ],
            colReorder : true,
            columns : [
                {data: "lcNo", bSortable: true, className: "center"},
                {
                    data : "lcInter",
                    className : "center",
                    render : function (data, type, full, meta) {
                        return bt.dict("letter_of_credit_inter",full.lcInter);
                    }
                },{
                    data : "creditNo",
                    bSortable: true,
                    className : "center"
                },{
                    data : "contractNo",
                    bSortable: true,
                    className : "center"
                },{
                    data : "issuingDate",
                    bSortable: true,
                    className : "center"
                },{
                    data : "expiryDate",
                    bSortable: true,
                    className : "center"
                },{
                    data : "creditMoney",
                    bSortable: true,
                    className : "textRight",
                    render : function (data, type, full, meta) {
                        return bt.money.format(full.creditMoney);
                    }
                },{
                    data : "curName",
                    bSortable: true,
                    className : "center"
                },{
                    data : "beneficiary",
                    bSortable: true,
                    className : "center"
                },{
                    data : "purpose",

                    bSortable: true,
                    className : "center"
                },{
                    data : "status",
                    bSortable: true,
                    className : "center",
                    render : function (data, type, full, meta) {
                        return bt.dict("international.status",full.status);
                    }
                },{
                    data : null,
                    className : "center",
                    render : function (data, type, full, meta) {
                        var  explode = "<span class=\"text-explode\">|</span>"
                        var id = full.id;
                        var html = null;
                        if (full.status == 0 || full.status == 1 || full.status == -1) {
                            html = "<a class=\"\" href=\"#\" data-row=\""+meta.row+"\" onclick=\"editCredit('"+ id +"')\">"+bt.lang("common.button.edit")+"</a>";
                            html += explode+"<a class=\"\" href=\"#\" data-row=\""+meta.row+"\" onclick=\"deleteCredit('"+ id +"')\">"+bt.lang("common.button.delete")+"</a>"+explode;
                        }
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a>';
                        // html += explode + "<a class=\"\" href=\"#\" data-row=\"" + meta.row + "\" onclick=\"bt.workFlow.trackFlowByBusinessId('" + full.id + "')\">" + bt.lang("common.button.trackFlow") + "</a>";
                        return html;
                    }
                }
            ],
            btInitComplete:function(setting,json){
            },
            searchForm : {
                formElem : "#searchForm",
                formFilter : "search",
                callback : function (data) {

                }
            },
            summary:{
                pageSum: false,//小计功能关闭
                allSum: true,//汇总功能开启
                // selectSum: true,//已选汇总功能开启
                // groupColumn: 'curName',//分类汇总列参数
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '5',//汇总列序号
                        dataName: 'creditMoney',//汇总列数据
                    }
                ]
            }
        });
    });

    function view(el){
        var data = layui.jquery("#datatable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'),basePath + "/international/credit/createCredit/viewCredit?id=" + data.id+"&showCloseBtn=0");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/international/credit/createCredit/viewCredit?id=" + data.id+"&showCloseBtn=0"
        });
    }

    function add(lcInter) {
        var url = basePath + "/international/credit/createCredit/addCredit?lcInter="+lcInter
        if (lcInter == 0) {
            bt.navtab.addNavtab(bt.lang("international.credit.addCredit"), url);
        } else {
            bt.navtab.addNavtab(bt.lang("international.credit.addInternationalCredit"), url);
        }
    }

    
    function editCredit(id) {
        var url = basePath + "/international/credit/createCredit/editCredit?id="+id
        bt.navtab.addNavtab(bt.lang("international.credit.editCredit"),url);
    }

    /**
     * 删除
     * @param id
     */
    function deleteCredit(id) {
        var url = basePath+"/international/credit/createCredit/deleteCredit"
        parent.layer.confirm(bt.lang('common.message.confirm.delete'),function(){
            bt.loading.show();
            $.ajax({
                url : url,
                data : {
                    id : id
                },
                dataType : "json",
                type : "POST",
                success : function (data) {
                    bt.loading.hide();
                    bt.navtab.refreshCurrent();
                    //parent.layer?parent.layer.alert(data.msg, {icon: data.success?1:2}):layer.alert(data.msg, {icon: data.success?1:2});
                }
            });
        });
    }

    //这里填写新的js代码，请参考前端文档
</script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="myform">
    <input type="hidden" value="$!{lcEnrol.id}" name="lcId">
    <input type="hidden" name="beneficiary" value="$!{lcEnrol.beneficiary}">
    <input type="hidden" name="corpId" id="corpId" value="$!{lcEnrol.corpId}">
    #*开证金额*#
    <input type="hidden" id="creditMoney" value="$!{lcEnrol.creditMoney}">
    #*已到单金额*#
    <input type="hidden" id="sumBillMoney" value="$!{sumBillMoney}">

    #*信用证有效期*#
    <input type="hidden" id="expiryDate" value="$!date.format("yyyy-MM-dd",$!{lcEnrol.expiryDate})">
#*    -1 删除
    0 登记
    1 入库
    2 付汇申请
    3 押汇申请
    4 抵押申请
    5 已收款*#
    <input type="hidden" id="status" name="status">
    <table class="layui-table">
        <tr>
        ##                开证人
            <td class="textRight">#springMessage('international.credit.applicant')</td>
            <td>
                <div class="layui-input-inline">
                    $!{corpName}
                </div>
            </td>
        ##                开证金额
            <td class="textRight">#springMessage('international.credit.creditMoney')</td>
            <td>
                <div class="layui-input-inline">
                    $number.formatNumeric($!{lcEnrol.creditMoney})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                受益人
                #springMessage('international.credit.beneficiary')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.beneficiary}
                </div>
            </td>
            <td class="textRight">
            ##                已到单次数
                #springMessage('table.international.haveArrived.times')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{billArrivalCount}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                已到单金额
                                #springMessage('table.international.haveArrived.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $number.formatNumeric($!{sumBillMoney})
                </div>
            </td>
            <td class="textRight">
            ##                已交承兑费用
                                #springMessage('international.arrival.acceptedCharges')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.acceptanceFee}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                期限
                                #springMessage('table.international.arrival.period')
            </td>
            <td>
                <div class="layui-input-inline">
                    <div class="layui-input-inline">
                        $dictTag.get("letter_of_credit_timeLimit",$!{lcEnrol.timeLimit})
                    </div>
                    #*<div class="bt-biz-dict" id="radio" data-type="radio" data-name="period" data-group="letter_of_credit_timeLimit" data-defaultvalue="1">*#
                    <input type="hidden" id="period" name="period" class="layui-input" value="$!{lcEnrol.timeLimit}">
                </div>
            </td>
            #if($!{lcEnrol.timeLimit} == 2)
                <td class="textRight">
                ##远期天数
                #springMessage('international.arrival.delayDates')
                </td>
                <td>
                    $!{lcEnrol.delayDates}
                    <input type="hidden" id="delayDates" name="delayDates" class="layui-input" value="$!{lcEnrol.delayDates}">
                #*<input type="text" id="delayDates" name="delayDates" class="layui-input" readonly="readonly" value="$!{lcEnrol.delayDates}">*#
                </td>
            #else
                <td></td>
                <td></td>
            #end

        </tr>
        <tr>
            <td class="textRight">
            ##                取回日期
                                #springMessage('table.international.arrival.getDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input id="getDate" name="getDate" class="layui-input bt-biz-dateType" type="text"
                           data-type="date" data-biz-name="getDate">
                </div>
            </td>
            <td class="textRight">
            ##                登记日期
                                #springMessage('table.international.arrival.createDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input id="createDate" name="createDate" class="layui-input bt-biz-dateType" type="text" data-today="true"
                           data-type="date" data-biz-name="createDate" readonly="readonly">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                信用证号
                                #springMessage('international.credit.creditNo')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="creditNo" name="creditNo" class="layui-input" readonly="readonly" value=" $!{lcEnrol.creditNo}">
                </div>
            </td>
            <td class="textRight">
            ##                手续费
                                #springMessage('table.international.arrival.handlingCharge')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="handlingCharge" id="handlingCharge"
                           class="layui-input bt-biz-moneyType" data-minus="true" data-biz-name="handlingCharge"
                           data-decimal="2" value="0">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                到单银行
                                #springMessage('international.arrival.com.bankName')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required" type="text" id="handDocBank" name="handDocBank" class="layui-input" readonly="readonly">
                    <div class="bt-div-search" >
                        <button class="bt-biz-bankInfo" type="button"  data-callback="bankinfoCallback" title="#springMessage('common.button.select')" >
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
            <td class="textRight">
            ##                到单行编号
                                #springMessage('international.arrival.com.bankCode')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="docBankNo" name="docBankNo" class="layui-input" readonly="readonly">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                到单日期
                                #springMessage('table.international.arrival.paymentDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input id="paymentDate" name="paymentDate" class="layui-input bt-biz-dateType" type="text" lay-verify="required"
                           data-type="date" data-biz-name="paymentDate" data-callback="paymentDateValidate">
                </div>
            </td>
            <td class="textRight">
            ##                到单号
                                #springMessage('table.internation.arrival.com.no')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="arrivalNo" name="arrivalNo" class="layui-input" value="$!{newCreditNo}" readonly="readonly">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                来单金额
                                #springMessage('table.internation.com.arrival.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="billMoney" lay-verify="required" data-callback = "setPayMoney"
                           class="layui-input bt-biz-moneyType" data-minus="true" data-biz-name="billMoney"
                           data-decimal="2">
                </div>
            </td>

            <td class="textRight">
            ##                付汇金额
                                #springMessage('table.internation.payment.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="payMoney" lay-verify="required" data-callback="payMoneyValidate"
                           class="layui-input bt-biz-moneyType" data-biz-name="payMoney"
                           data-decimal="2">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                币别
                                #springMessage('table.international.arrival.curId')
            </td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-name="curId" data-url="${basePath}/basic/business/btcurrency/json" data-displayData="$!{lcEnrol.issuingCurId}"
                         data-valuefield="id" data-textfield="curName" data-biz-name="curId" data-defaultvalue="$!{lcEnrol.issuingCurId}">

                    </div>
                </div>
            </td>
            <td class="textRight">
            ##                付汇日期
                                #springMessage('table.international.pay.date')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required" id="payDate" name="payDate" class="layui-input bt-biz-dateType" type="text"
                           data-type="date" data-biz-name="payDate">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                缴税日期
                                #springMessage('table.international.arrival.taxDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input id="taxDate" name="taxDate" class="layui-input bt-biz-dateType" type="text"
                           data-type="date" data-biz-name="taxDate">
                </div>
            </td>
            <td class="textRight">
            ##                增值税金额
                                #springMessage('table.international.arrival.addTaxMoney')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="addTaxMoney" id="addTaxMoney"
                           class="layui-input bt-biz-moneyType" data-minus="true" data-biz-name="addTaxMoney"
                           data-decimal="2" value="0">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                关税金额
                                #springMessage('table.international.arrival.taxMoney')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="taxMoney" id="taxMoney"
                           class="layui-input bt-biz-moneyType" data-minus="true" data-biz-name="taxMoney"
                           data-decimal="2" value="0">
                </div>
            </td>
            <td class="textRight">
            ##                汇率
                                #springMessage('international.Arrival.exchange')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="exchange" id="exchange" value="$!{lcEnrol.exchangeRate}"
                           class="layui-input bt-biz-moneyType" data-biz-name="exchange" data-convert="true">
                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">
        ##                关单号
            #springMessage('international.Arrival.closeLcNo')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="closeLcNo" name="closeLcNo" class="layui-input">
                </div>
            </td>
            <td class="textRight">
            ##                备注
                                #springMessage('international.credit.rmk')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="rmk" name="rmk" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            <td>#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" id="gid" name="attachmentId" value="">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.storage')</button>
                <button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('table.internation.arrival.add')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    var up;
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'selectType', 'rateType',
        'moneyType', 'corp', 'verify', 'bondAccInfo', 'externalCorpBankAcc', 'bankInfo', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        bt.dicts.init();//字典
        dateObj = bt.dateType.init();//时间
        bt.selectType.init();//下拉选择
        bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        bt.corp.init();//单位
        bt.externalCorpBankAcc.init();//客商
        bt.bankInfo.init();//银行
        // 附件功能
        var gid = $("#gid").val();
        up = bt.btUpload.init({
            elem: "#uploader",
            isExpand: true,
            auto: false,
            gid: gid
        });

        // 提交
        form.on("submit(submit)", function (data) {
            /*表单校验*/
            if (validateForm()) {
                return false;
            }
            /*0=入库*/
            $("#status").val(1)
            // 已到单金额
            var sumBillMoney = $("#sumBillMoney").val();
            // 开证金额
            var creditMoney = $("#creditMoney").val();
            //本次到单金额
            var billMoney = moneyType.get("billMoney").val();
            if(billMoney < 0){
            	parent.layer?parent.layer.alert("来单金额不能小于0", {icon: 2}):layer.alert("来单金额不能小于0", {icon: 2});
            	return false;
            }
            if ((Number(sumBillMoney) + Number(billMoney)) > Number(creditMoney)) {
                parent.layer?parent.layer.alert(bt.lang("international.lcBillArrival.alert.info4"), {icon: 2}):layer.alert(bt.lang("international.lcBillArrival.alert.info4"), {icon: 2});
            } else {
                // 提交调用
                submitForm();
            }
            return false;
        });

        // 暂存
        form.on("submit(temp)", function (data) {
            /*表单校验*/
            if (validateForm()) {
                return false;
            }
            /*0=登记*/
            $("#status").val(0)
            // 已到单金额
            var sumBillMoney = $("#sumBillMoney").val();
            // 开证金额
            var creditMoney = $("#creditMoney").val();
            //本次到单金额
            var billMoney = moneyType.get("billMoney").val();
            if(billMoney < 0){
            	parent.layer?parent.layer.alert("来单金额不能小于0", {icon: 2}):layer.alert("来单金额不能小于0", {icon: 2});
            	return false;
            }
            if ((Number(sumBillMoney) + Number(billMoney)) > Number(creditMoney)) {
                parent.layer?parent.layer.alert(bt.lang("international.lcBillArrival.alert.info4"), {icon: 2}):layer.alert(bt.lang("international.lcBillArrival.alert.info4"), {icon: 2});
            } else {
                // 提交调用
                submitForm();
            }
            return false;
        });
        //这里填写新的js代码，请参考前端文档
    });

    function bankinfoCallback(data,dom){
        $("#handDocBank").val(data.bankName);
        $("#docBankNo").val(data.bankCode);//联行号
    }

    /*付汇金额赋值操作*/
    function setPayMoney(nextValue , elem,preValue) {
        var billMoney = moneyType.get("billMoney").val();
        moneyType.get("payMoney").val(billMoney);
    }

    /**
     * 表单校验置于此处
     */
    function validateForm() {


        var paymentDate = dateObj.get("paymentDate").val();
        var payDate = dateObj.get("payDate").val();
        if (bt.date.compare(paymentDate,payDate) > 0) {
            parent.layer?parent.layer.alert(bt.lang("international.lcBillArrival.alert.info1"), {icon: 2}):layer.alert(bt.lang("international.lcBillArrival.alert.info1"), {icon: 2});
            return true;
        }
        return false;
    }

    /**
     * 判断开证时间是否在信用证有效期内
     * @param date
     * @param obj
     */
    function paymentDateValidate(nowDate, obj) {
        var expiryDate =$("#expiryDate").val();
        if (bt.date.compare(nowDate,expiryDate) > 0) {
            parent.layer?parent.layer.alert(bt.lang("international.lcBillArrival.alert.info2"), {icon: 2}):layer.alert(bt.lang("international.lcBillArrival.alert.info2"), {icon: 2});
            obj.val("");
        }
    }

    /**
     * 金额判断
     * @param nextValue
     * @param elem
     * @param preValue
     */
    function payMoneyValidate(nextValue, elem, preValue) {
        var billMoney = moneyType.get("billMoney").val();
        var payMoney = moneyType.get("payMoney").val();
        if (Number(payMoney) > Number(billMoney)) {
            parent.layer?parent.layer.alert(bt.lang("international.lcBillArrival.alert.info3"), {icon: 2}):layer.alert(bt.lang("international.lcBillArrival.alert.info3"), {icon: 2});
            moneyType.get("payMoney").val("");
        }
    }


    /**
     * 表单提交函数
     */
    function submitForm() {
        bt.loading.show();
        var url = basePath+"/international/credit/billArrival/saveBillArrival"
        $("#gid").val(up.getGroupId());
        $.ajax({
            url : url,
            data : $("#myform").serialize(),
            dataType : "json",
            type : "POST",
            success : function (data) {
                parent.layer?parent.layer.alert(data.msg, {icon: data.success?1:2}):layer.alert(data.msg, {icon: data.success?1:2});
                if (data.success){
                    if(!bt.navtab){
                        bt.navtab.refreshParentTable();
                    } else {
                        bt.navtab.closeCurrent();
                    }
                }else{
                    bt.loading.hide();
                }
            }
        })
    }
</script>
</body>
</html>
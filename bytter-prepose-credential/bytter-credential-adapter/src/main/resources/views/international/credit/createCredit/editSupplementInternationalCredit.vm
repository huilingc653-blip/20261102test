<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        /
        /
        这里填写新的样式代码
    </style>
</head>
<body>
<input type="hidden" id="nativeCurId" value="$!{corp.curId}">
<input type="hidden" id="ratBankConfig" value="$!{ratBankConfig}">
<input type="hidden" id="bankCode" value="$!{ratUration.bankCode}">
<form class="layui-form" method="post" id="myform">
    <input type="hidden" name="id" value="$!{id}">
    <input type="hidden" name="lcNo" id="lcNo" value="$!{lcEnrol.lcNo}">
    <input type="hidden" name="corpId" value="$!{lcEnrol.corpId}">
    #if($!{config.international.creditIsHang}==0)
        <input type="hidden" id="isHangCredit" name="isHangCredit" value="0">
    #end
##    是否启用保证金参数
    <input type="hidden" id="creditIsBond" name="creditIsBond" value="$!{config.international.creditIsBond}">
##        保证金id
    <input type="hidden" name="bondId" id="bondId" value="$!{dto.bondId}">
    <input  id="bondIdPre"  name="bondIdPre" type="hidden" value="$!{dto.bondId}">
    <input type="hidden" id="bailMoneyPre" name="bailMoneyPre" value="$!{dto.applyMoney}"/>
##        可用余额
    <input type="hidden" name="accAvailMoney" id="accAvailMoney" value="$!{dto.availMoney}">
    <!-- 资金计划参数 -->
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
    <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
    <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
    <table class="layui-table">
        <tr>
            <td style="width: 15%">
                <label style="font-weight: bold">#springMessage('international.master.info')</label>
            </td>
            <td style="width: 35%"></td>
            <td style="width: 15%"></td>
            <td style="width: 35%"></td>
        </tr>
        <tr>
        ##                登记日期
            <td style="text-align: right;width: 15%">
                <div class="layui-input-inline">
                    <label class="layui-form-label">#springMessage('international.credit.createDate')</label>
                </div>
            </td>
            <td style="width: 35%">
                <div class="layui-input-inline">
                    <input name="createDate" data-today="true" readonly="readonly" class="layui-input bt-biz-dateType"
                           type="text" data-type="date" data-biz-name="createDate" value="$!{lcEnrol.createDate}">
                </div>
            </td>
        ##                信用证类型
            <td class="textRight" style="width: 15%">#springMessage('international.credit.lcInter')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" value="$!{lcEnrol.lcInter}" name="lcInter">
                    $dictTag.get("letter_of_credit_inter",1)
                </div>
            </td>
        </tr>

        <tr>
        ##                开证人
            <td class="textRight" style="width: 15%">#springMessage('international.credit.applicant')</td>
            <td>
                <div class="isReCredit">
                    <input type="hidden" id="applicantDef" value="$!{lcEnrol.applicant}">
                    <div class="layui-input-inline" id="reCorpCode">
                        <div class="bt-biz-corp"
                             data-biz-type="applicant"
                             data-type="selectTree"
                             data-name="applicant"
                             data-resource="international:credit:supplementecredit:update"
                             data-defaultvalue="$!{lcEnrol.applicant}"
                             data-required="true"
                             data-biz-name="applicant"
                             data-callbackData="setApplicantAcc"
                        >
                        </div>
                    </div>
                </div>
            </td>
        ##                信用证号
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required" type="text" id="creditNo" name="creditNo" class="layui-input"
                           value="$!{lcEnrol.creditNo}">
                </div>
            </td>
        </tr>

        <tr>
        ##                合同号
            <td class="textRight">#springMessage('international.credit.contractNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required" type="text" name="contractNo" class="layui-input"
                           value="$!{lcEnrol.contractNo}">
                </div>
            </td>
        ##                受益人
            <td class="textRight">#springMessage('international.credit.beneficiary')</td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required" type="text" name="beneficiary" id="beneficiary" class="layui-input"
                           value="$!{lcEnrol.beneficiary}">
                    <div class="bt-div-search">
                        <button class="bt-biz-externalCorpBankAcc" id="selBeneficiary" type="button" data-beforeClick="bt.externalCorpBankAccParams"
                                data-callback="externalCorpCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>

        <tr>
        ##                开证日期
            <td class="textRight">#springMessage('international.credit.issuingDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required" name="issuingDate" class="layui-input bt-biz-dateType" type="text"
                           data-callback="issuingDateCallback"
                           data-type="date" data-biz-name="issuingDate" value="$!{lcEnrol.issuingDate}">
                </div>
            </td>
        ##                信用证有效期
            <td class="textRight">#springMessage('international.credit.expiryDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input name="expiryDate" class="layui-input bt-biz-dateType" lay-verify="required" type="text"
                           data-callback="expiryDateValidate"
                           data-type="date" data-biz-name="expiryDate" value="$!{lcEnrol.expiryDate}">
                </div>
            </td>
        </tr>


        <tr>
        ##                开证银行
            <td class="textRight">#springMessage('international.credit.issuingBank')</td>
            <td>
                <div id="xl" #if($!{lcEnrol.isHangCredit}==0 || ($!{lcEnrol.isHangCredit}==1 && $!{ratBankConfig} == 1))style="display: none"#end>
                    <div class="layui-inline">
                        <div class="bt-biz-selectType"
                            #if($!{lcEnrol.isHangCredit}==1 && $!{ratBankConfig} == 0)
                             data-required="false"
                            #end
                             data-name="issuingBankXX"
                             data-callback="bankinfoCallBackTwo" data-url="${basePath}/cms/provide/loaninfo/getBankName"
                             data-valuefield="bankCode" data-textfield="bankName" data-biz-name="btBank"
                             data-defaultvalue="$!{lcEnrol.issuingBank}"></div>
                    </div>
                </div>
                <div id="xz" #if($!{lcEnrol.isHangCredit}==1 && $!{ratBankConfig} == 0)style="display: none"#end>
                    <div class="layui-input-inline">
                        <input lay-verify="false" type="text" id="issuingBankShow" name="issuingBankShow"
                               class="layui-input" readonly="readonly" value="$!{applicantAccShow}">
                    </div>
                </div>
                <input type="hidden" id="issuingBank" name="issuingBank" value="$!{lcEnrol.issuingBank}">
            </td>
        ##                开证银行账号
            <td class="textRight">
                #springMessage('international.credit.applicantAcc')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required" type="type" id="applicantAcc" name="applicantAcc"
                           clickCallback="setIssuing" class="layui-input applicantAcc" data-biz-name="applicantAcc"
                           value="$!{lcEnrol.applicantAcc}">
                    <input type="hidden" id="applicantAccId" name="applicantAccId" value="$!{lcEnrol.applicantAccId}">
                </div>
            </td>
        </tr>

        <tr>
        ##                开证币种
            <td class="textRight">#springMessage('international.credit.issuingCurId')</td>
            <td>
                <input type="hidden" id="issuingCurIdDef" value="$!{lcEnrol.issuingCurId}">
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-name="issuingCurId" data-inputValue="false" data-required="true"
                         data-url="${basePath}/basic/business/btcurrency/json?corpId=$!{lcEnrol.corpId}"
                         data-valuefield="id" data-displayData = "$!{lcEnrol.issuingCurId}"
                         data-textfield="curName" data-value="$!{lcEnrol.issuingCurId}"
                         data-biz-name="issuingCurId"></div>
                </div>
            </td>
        ##                开证金额
            <td class="textRight">#springMessage('international.credit.creditMoney')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="creditMoney" lay-verify="required"
                           data-callback="setNativeCreditMoneyAndBondMoney"
                           class="layui-input bt-biz-moneyType" data-minus="true" data-biz-name="creditMoney"
                           data-decimal="2" value="$!{lcEnrol.creditMoney}">
                </div>
            </td>
        </tr>
        <tr>
        ##                期限
            <td class="textRight">#springMessage('international.credit.timeLimit')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" id="radio" data-type="radio" data-group="letter_of_credit_timeLimit"
                         data-defaultvalue="$!{lcEnrol.timeLimit}" data-callback="timeLimitSet"
                         data-callback="timeLimitSet" data-biz-name="timeLimit"
                         data-name="timeLimit">
                    </div>
                </div>
            </td>
        ##                远期天数
            <td class="textRight delayDates" #if($!{lcEnrol.timeLimit} == 1)style="display: none;"#end>#springMessage('international.credit.delayDates')</td>
            <td>
                <div class="layui-input-inline delayDates" #if($!{lcEnrol.timeLimit} == 1)style="display: none;"#end>
                    <input #if($!{lcEnrol.timeLimit} == 2)lay-verify="required" value="$!{lcEnrol.delayDates}"#end type="text" data-name="delayDates" data-biz-name="delayDates"
                           data-separator="" class="layui-input bt-biz-moneyType" data-min="1" data-decimal="0">
                </div>
            </td>
        </tr>
        <tr>
        ##                是否溢短装
            <td class="textRight">#springMessage('international.credit.isSpillOver')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" id="radio" data-type="radio" data-group="international.credit.isSpillOver"
                         data-defaultvalue="$!{lcEnrol.isSpillOver}"
                         data-name="isSpillOver" data-biz-name="isSpillOver" data-callback="spillOverSet">
                    </div>
                </div>
            </td>
        ##            溢短装比例
            <td class="textRight">#springMessage('international.credit.spillOverRate')</td>
            <td>
                <div class="layui-input-inline">
                    <input class="layui-input bt-biz-rateType" type="text" data-name="spillOverRate" #if("1"==$!{lcEnrol.isSpillOver}) lay-verify="required" #end
                           value="$!{lcEnrol.spillOverRate}"  data-max="100"
                           data-biz-name="spillOverRate" data-decimal="2">
                </div>
            </td>
        </tr>

    ##################################保证金部分###########################################################
        #if($!{config.international.creditIsBond}==1)
            <tr>
                <td>
                    <label style="font-weight: bold">#springMessage('international.bondInfo')</label>
                </td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
            ##是否挂保证金
                <td class="textRight">#springMessage('table.fcBond.includeBond')</td>
                <td>
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-value="$!{lcEnrol.isHangBond}"
                         data-name="isHangBond" data-biz-name="isHangBond"
                         data-callback="changeFcBond"></div>
                </td>
            ##保证金额度单
                <td class="textRight bondInfo" #if($!{lcEnrol.isHangBond} == 0) style="display: none" #end>#springMessage('table.fcBond.quotas')</td>
                <td class="bondInfo" #if($!{lcEnrol.isHangBond} == 0) style="display: none" #end>
                    <div class="layui-inline">
                        <input id="bondBankAcc" name="bondBankAcc" type="text" readonly="true" class="layui-input" value="$!{lcEnrol.bondBankAcc}"
                            #if($!{lcEnrol.isHangBond} == 1) lay-verify="required" #end>
                    </div>
                    <div class="layui-inline">
                        <button class="layui-btn bt-biz-bondAccInfo" data-biz-name="bondAcc" type="button"
                                data-callback="bondAccinfoCallback" data-beforeClick="checkCorp">#springMessage(
                            'common.button.select')</button>
                    </div>
                </td>
            </tr>
            <tr>
            ##                    保证金币别
                <td class="textRight">#springMessage('international.credit.bondCurId')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-name="bondCurId" data-inputValue="false"
                             data-callback="changeBondCur" data-value="$!{lcEnrol.bondCurId}"
                            #if($!{lcEnrol.isHangBond} == '1' || ($!{lcEnrol.isHangCredit} == 1 && $!{lcEnrol.isOpenRat} == '1'))
                             data-required="true"
                            #end
                            #if($!{lcEnrol.issuingCurId} == $!{corp.curId})
                             data-displayData="$!{lcEnrol.issuingCurId}"
                            #else
                             data-displayData="$!{corp.curId},$!{lcEnrol.issuingCurId}"
                            #end
                             data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                             data-textfield="curName" data-biz-name="bondCurId"></div>
                    </div>
                </td>
            ##保证金比例
                <td class="textRight">#springMessage('table.fcBond.bondPercent')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" data-name="bondPercent" value="$!{lcEnrol.bondPercent}" data-callback="setBailMoney" data-decimal="2"
                               class="layui-input bt-biz-rateType" data-biz-name="bailmoneyRate" #if($!{lcEnrol.isHangBond} == 1) lay-verify="required" #end
                               data-callback="setBailMoney">
                    </div>
                </td>
            </tr>
            <tr>
            ##保证金金额
                <td class="textRight">#springMessage('table.fcBond.bondmoney')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="bailmoney" name="bondMoney" data-decimal="2"
                               value="$!{lcEnrol.bondMoney}" #if($!{lcEnrol.isHangBond} == 1) lay-verify="required" #end
                               class="layui-input bt-biz-moneyType" data-biz-name="bailmoney"
                               data-callback="setBailMoneyRate"
                               placeholder="#springMessage('table.cmsProvideLoanInfo.bailmoney')">
                    </div>
                </td>
            ##保证金合同号
                <td class="textRight">#springMessage('table.fcBond.contractNum')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="bondContract" name="bondContract" value="$!{lcEnrol.bondContract}"
                               autocomplete="off" class="layui-input">
                    </div>
                </td>
            </tr>
        ##        保证及利率
            <tr>
                <td class="textRight">#springMessage('table.fcBond.bondRate')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" id="bondRate" data-name="bondRate"  data-biz-name="bondRate" class="layui-input bt-biz-rateType" value="$!{lcEnrol.bondRate}">
                    </div>
                </td>
                <td></td>
                <td></td>
            </tr>
        #end
    ##################################保证金部分end###########################################################

    ##################################授信挂接###########################################################
        #if($!{config.international.creditIsHang}==1)
            <tr>
                <td>
                    <label style="font-weight: bold">#springMessage('credit.information')</label>
                </td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
            ##是否挂接授信
                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.ratmodel')</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-dict" id="radio" data-type="radio" data-group="sf_yn"
                             data-defaultvalue="$!{lcEnrol.isHangCredit}"
                             data-name="isHangCredit" data-biz-name="isHangCredit" data-callback="setRatModel">
                        </div>
                    </div>
                </td>
                #if($!{config.international.isRatOpen} == "1")
                ##			授信敞口
                    <td class="textRight isShow" #if($!{lcEnrol.isHangCredit}==0)style="display: none"#end>#springMessage('common.isOpen.ratUration')</td>
                    <td class="isShow" #if($!{lcEnrol.isHangCredit}==0)style="display: none"#end>
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="radio" data-group="common.isOpen.ratUration"
                                #if($!{lcEnrol.isOpenRat})
                                 data-value="$!{lcEnrol.isOpenRat}"
                                #else
                                 data-value="1"
                                #end
                                 data-callback="isOpenRatCallback"
                                 data-name="isOpenRat" data-biz-name="isOpenRat"></div>
                        </div>
                    </td>
                #else
                    <td></td>
                    <td></td>
                #end
            </tr>
            <tr class="isNativeCur" #if($!{lcEnrol.isHangCredit}==0 || ($!{lcEnrol.isHangCredit}==1 && $!{lcEnrol.issuingCurId} == $!{corp.curId}))style="display: none"#end>
            ##            是否折合成本位币
                <td class="textRight">#springMessage('international.credit.isNativeCur')</td>
                <td>
                    <div class="layui-inline">
                        <input type="checkbox" id="isNativeCur" name="isNativeCur" value="1" lay-filter="isNativeCur" lay-skin="primary"
                               title="#springMessage('international.credit.info')" #if($!{lcEnrol.isNativeCur} == 1) checked="checked" #end>
                    </div>
                </td>
            ##            折合本位币金额
                <td class="textRight nativeCreditMoney" #if($!{lcEnrol.isNativeCur} != 1) style="display: none" #end>#springMessage('international.credit.nativeCreditMoney')</td>
                <td>
                    <input type="text" data-name="nativeCreditMoney" readonly="readonly"
                           value="$!{lcEnrol.nativeCreditMoney}" #if($!{lcEnrol.isNativeCur} != 1) style="display: none" #end
                           class="layui-input bt-biz-moneyType nativeCreditMoney" data-biz-name="nativeCreditMoney"
                           data-decimal="2">
                </td>
            </tr>

            <tr class="isShow" #if($!{lcEnrol.isHangCredit}==0)style="display: none"#end>
            ##                授信品种
                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.itemCode')</td>
                <td>
                    <div class="layui-inline" id="ratItemCodeDiv">
                        <div #if($!{lcEnrol.isHangCredit}==1)data-required="true"#end class="bt-biz-selectType" data-biz-name="ratItemCode"
                             data-url="${basePath}/cms/rat/ratitemcustom/getAllRatItem?type=0"
                             data-defaultvalue="$!{lcEnrol.itemCode}"
                             data-valuefield="id" data-textfield="name" data-name="ratItemCode" data-search="true"
                             data-callback="setRationBtn">
                        </div>
                    ##    业务品种
                        #springMessage('cms.business.race')
                        <div class="bt-biz-selectType" data-biz-name="billName" data-initCallback="checkData"
                            #if($!{lcEnrol.itemCode})
                             data-url="${basePath}/cms/rat/ratBusinessRace/getBillByCustomId?customId=$!{lcEnrol.itemCode}"
                            #else
                             data-url=""
                            #end
                            #if($!{lcEnrol.isHangCredit}==0)
                             data-value="$!{lcEnrol.billName}"
                            #end
                             data-valuefield="id" data-textfield="raceName" data-name="billName" data-search="true" data-defaultvalue="first">
                        </div>
                    </div>
                </td>
            ##授信额度单
                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rationSelect')</td>
                <td colspan="3">
                ##浏览按钮
                    <div class="layui-input-inline">
                        <div id="ratChooseBtn">
                            <button type="button" onclick="chooseRatCode()" class="layui-btn">#springMessage(
                                'common.button.browse')</button>
                        </div>
                    </div>
                    <div class="layui-input-inline">
                        <div id="rationBtn">
                            <button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage(
                                'common.button.view')</button>
                        </div>
                    </div>
                ##额度编号
                ##占用授信代码
                        <span id="itemCodeTd">
                            <input type="hidden" id="ratIsHangGua" value="$!{ratUration.ratIsHangGua}">
                            <input id="rationCode" name="rationCode" value="$!{lcEnrol.rationCode}" type="hidden"/>
                            <input type="hidden" class="itemMoney" name="itemMoney" value="$!{lcEnrol.itemMoney}">
                            <input type="hidden" id="ratmodel" name="ratmodel" value="$!{lcEnrol.ratmodel}">
                        </span>
                </td>
            </tr>
        #end
    ##################################授信挂接end###########################################################
        #if($!{isGuarantee}=="1")##授信参数设置挂接担保
            #parse("views/common/guaContractChoose.vm")
        #end
        <tr>
        ##            是否代开信用证
            <td class="textRight">
                #springMessage('international.credit.isReCredit')
            </td>
            <td>
                <div class="bt-biz-dict" id="radio" data-type="radio" data-group="international.credit.isReCredit"
                     data-defaultvalue="$!{lcEnrol.isReCredit}" data-name="isReCredit" data-biz-name="isReCredit"
                     data-callback="setIsReCredit">
                </div>
            </td>
        ##            被带开证单位
            <td class="textRight isReCredit #if($!{lcEnrol.isReCredit}==0)hide#end">
                #springMessage('international.credit.reCorpCode')
            </td>
            <td>
                <div class="layui-input-inline isReCredit #if($!{lcEnrol.isReCredit}==0)hide#end" id="reCorpCode">
                <div class="bt-biz-corp"
                     data-biz-name="reCorpCode"
                     data-biz-type=""
                     data-type="selectTree"
                     data-tree-type="check"
                     data-name="reCorpCode"
                     data-scope="all"
                     data-valueField="code"
                     data-defaultvalue="$!{lcEnrol.reCorpCode}"
                     style="width: 350px"
                     #if($!{lcEnrol.isReCredit}==1)data-required="true"#end>
                </div>
                </div>
            </td>
        </tr>

        <tr class="isReCredit #if($!{lcEnrol.isReCredit}==0)hide#end">
        ##                代开信用证号
            <td class="textRight">#springMessage('international.credit.reCreditNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="reCreditNo" class="layui-input" value="$!{lcEnrol.reCreditNo}">
                </div>
            </td>

        ##                代开证银行
            <td class="textRight">#springMessage('international.credit.reBank')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="reBank" class="layui-input" value="$!{lcEnrol.reBank}">
                </div>
            </td>
            </tr>
        <tr>
            <td>
                <label style="font-weight: bold">#springMessage('international.other.info')</label>
            </td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
        ##                是否需要许可证
            <td class="textRight">#springMessage('international.credit.needLicence')</td>
            <td>
                <div class="layui-input-inline">

<script>
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'selectType', 'rateType',
        'moneyType', 'corp', 'verify', 'bondAccInfo', 'externalCorpBankAcc', 'selectTableType', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        dicts = bt.dicts.init();//字典
        dateObj = bt.dateType.init();//时间
        selectType = bt.selectType.init();//下拉选择
        rateType = bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        corp = bt.corp.init();//单位
        externalCorpBankAcc = bt.externalCorpBankAcc.init();//客商
        fun = bt.moneyType.getFun()
        bondAccInit = bt.bondAccInfo.init();//保证金账号初始化
        parameters = new Object();
        // 附件功能
        var gid = $("#gid").val();
        up = bt.btUpload.init({
            elem: "#uploader",
            isExpand: true,
            auto: false,
            gid: gid
        });

        // 提交
        form.on("submit(submit)", function (data) {
            // 提交前授信校验
            if (!submitValidate()) {
                return false;
            }
            // 黑白名单校验
            checkBlackWhite(95);
            return false;
        });

        // 暂存
        form.on("submit(temp)", function (data) {
            // 提交前授信校验
            if (!submitValidate()) {
                return false;
            }
            // 黑白名单校验
            checkBlackWhite(11);
            return false;
        });

        var creditNo = $("#creditNo");
        if (creditNo.val() != null && creditNo.val() != "" && creditNo.val() != undefined) {
            creditNo.attr("readonly", "readonly");
        }

        //复选框监控
        form.on("checkbox(isNativeCur)", function (data) {
            setNativeCreditMoney();
        });

        /**判断字符串是否为空*/
        bt.empty = function (ms) {
            if (typeof (ms) == "undefined" || ms == null || ms == "" || ms == " ") {
                return true;
            }
            return false;
        }

        selectTable = bt.selectTableType.init({
            elem: ".applicantAcc",
            type: 'get',
            paging: true,
            url: basePath + "/international/credit/createCredit/getBankAccsByCorpId?corpId=$!{lcEnrol.corpId}&bankCode=$!{lcEnrol.issuingBank}",
            columns: [
                {"data": "accName", title: bt.lang("table.btBankAcc.accName")},
                {"data": "bankName", title: bt.lang("table.btBankAcc.bankName")},
                {"data": "bankAcc", title: bt.lang("table.btBankAcc.bankAcc")},
                {"data": "curName", title: bt.lang("international.payment.curName")}
            ],
            clickCallback: function (data, tr, elem, full) {
                CreateSelectTableType(data, tr, elem, full);
                // 根据币别设置汇率信息
                setCurExcRate(data.curId);
            }
        });
        // 设置500毫秒后执行。由于无法判断表单渲染是否完成
        setTimeout(setIsGuaranteeEnabled, 500);

        /**
         * 生成公共的属性
         * @return
         */
        $genOtherHtml = function (flag) {
            var url = basePath + "/budget/fbsBudgetProcess/getEditItemDetail";
            var curId = $("#issuingCurIdDef").val();
            if(selectType.get("issuingCurId").val()){
                curId = selectType.get("issuingCurId").val();
            }
            var corpId = $("#applicantDef").val();
            if($('input[name="applicant"]').val()){
                corpId = $('input[name="applicant"]').val();
            }
            var param = {
                corpId: corpId,
                itemCode: $("#payItem").val() ? $("#payItem").val() : "400",
                billNo: $("#lcNo").val(),
                businessName: $("#businessName").val(),
                processSysname: $("#processSysname").val(),
                processDate: bt.dateType.get("issuingDate").val(),
                curId: curId,
                type: 'select',
                date: (new Date()).getTime()
            };
            if (flag) {
                param.billNo = "";
            }
            $.ajax({
                url: url, method: 'POST', data: param, async: true, success: function (json) {
                    $("#tagItemDetail").html("");
                    $("#tagItemDetail").html(json);
                    form.render();
                }
            });
        }
        bt.renderBudget(false);
    });

    /**
     * 资金计划挂接
     */
    bt.renderBudget = function(flag) {
        //判断支付结算是否挂接资金计划
        var budgetSel = $("#budgetSel").val();
        if (budgetSel == "1") {
                $genOtherHtml(flag);
        }
    }

    /**
     * 预算执行输入金额汇总后的回调
     * @param data
     */
    function sumMoneyCallBack(data) {
        bt.moneyType.get("creditMoney").val(data);
    }

    /**
     * 数据提交
     * @param status
     */
    function doSubmit(status) {
        var url;
        if (status == 11) {
            url = basePath + "/international/credit/supplementCredit/saveTmp";
        } else {
            url = basePath + "/international/credit/supplementCredit/saveSpplementCredit";
        }
        // 担保调用
        setIsGuaranteeEnabled();
        bt.loading.show();
        $("#gid").val(up.getGroupId());
        $.ajax({
            url: url,
            data: $("#myform").serialize(),
            dataType: "json",
            type: "POST",
            success: function (data) {
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                if (data.success) {
                    if (!bt.navtab) {
                        bt.navtab.refreshParentTable();
                    } else {
                        bt.navtab.closeCurrent();
                    }
                } else {
                    bt.loading.hide();
                }
            }
        });
    }
</script>
<script src="${basePath}/static/modules/international/international.lcEnrol.js?_btv=${resourceVersion}"></script>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="myform">
    <table class="layui-table">
        <tr>
        ##                开证人
            <td class="textRight" style="width: 15%">#springMessage('international.credit.applicant')</td>
            <td style="width: 35%">
                <div class="layui-input-inline">
                    $!{corpName}
                </div>
            </td>
        ##                开证金额
            <td class="textRight" style="width: 15%">#springMessage('international.credit.creditMoney')</td>
            <td style="width: 35%">
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcEnrol.creditMoney})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                受益人
                #springMessage('international.credit.beneficiary')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.beneficiary}
                </div>
            </td>
            <td class="textRight">
            ##                已到单次数
                #springMessage('table.international.haveArrived.times')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{billArrivalCount}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                已到单金额
                                #springMessage('table.international.haveArrived.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{sumBillMoney})
                </div>
            </td>
            <td class="textRight">
            ##                已交承兑费用
                                #springMessage('international.arrival.acceptedCharges')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.acceptanceFee}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                期限
                                #springMessage('table.international.arrival.period')
            </td>
            <td>
                <div class="layui-input-inline">
                    $dictTag.get("letter_of_credit_timeLimit",$!{lcEnrol.timeLimit})
                </div>
            </td>
            #if($!{lcEnrol.timeLimit} == 2)
                <td class="textRight">
                ##远期天数
                            #springMessage('international.arrival.delayDates')
                </td>
                <td>
                    $!{lcEnrol.delayDates}
                </td>
            #else
                <td></td>
                <td></td>
            #end
        </tr>
        <tr>
            <td class="textRight">
            ##                取回日期
                                #springMessage('table.international.arrival.getDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcBillArrival.getDate})
                </div>
            </td>
            <td class="textRight">
            ##                登记日期
                                #springMessage('table.international.arrival.createDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    $date.format("yyyy-MM-dd",$!{lcBillArrival.createDate})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                信用证号
                                #springMessage('international.credit.creditNo')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.creditNo}
                </div>
            </td>
            <td class="textRight">
            ##                手续费
                                #springMessage('table.international.arrival.handlingCharge')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.handlingCharge})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                到单银行
                                #springMessage('international.arrival.com.bankName')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.handDocBank}
                </div>
            </td>
            <td class="textRight">
            ##                到单行编号
                                #springMessage('international.arrival.com.bankCode')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.docBankNo}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                到单日期
                                #springMessage('table.international.arrival.paymentDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    $date.format("yyyy-MM-dd",$!{lcBillArrival.paymentDate})
                </div>
            </td>
            <td class="textRight">
            ##                到单号
                                #springMessage('table.internation.arrival.com.no')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.arrivalNo}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                付汇金额
                                #springMessage('table.internation.payment.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.payMoney})
                </div>
            </td>
            <td class="textRight">
            ##                来单金额
                                #springMessage('table.internation.com.arrival.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.billMoney})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                币别
                                #springMessage('table.international.arrival.curId')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.curName}
                </div>
            </td>
            <td class="textRight">
            ##                付汇日期
                                #springMessage('table.international.pay.date')
            </td>
            <td>
                <div class="layui-input-inline">
                    $date.format("yyyy-MM-dd",$!{lcBillArrival.payDate})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                缴税日期
                                #springMessage('table.international.arrival.taxDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcBillArrival.taxDate})
                </div>
            </td>
            <td class="textRight">
            ##                增值税金额
                                #springMessage('table.international.arrival.addTaxMoney')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.addTaxMoney})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                关税金额
                                #springMessage('table.international.arrival.taxMoney')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.taxMoney})
                </div>
            </td>
            <td class="textRight">
            ##                汇率
                                #springMessage('international.Arrival.exchange')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!excRateTag.getConvert($!{lcBillArrival.exchange})
                </div>
            </td>
        </tr>
        <tr>

            <td class="textRight">
            ##                关单号
                                #springMessage('international.Arrival.closeLcNo')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.closeLcNo}
                </div>
            </td>
            <td class="textRight">
            ##                备注
                                #springMessage('international.credit.rmk')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.rmk}
                </div>
            </td>
        </tr>
        <tr>
            <td>#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" id="gid" name="attachmentId" value="$!{lcBillArrival.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <div class="layui-input-inline">
                    <button type="button" class="layui-btn" onclick="bt.navtab.closeCurrent()">#springMessage('common.button.close')</button>
                </div>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'selectType', 'rateType',
        'moneyType', 'corp', 'verify', 'bondAccInfo', 'externalCorpBankAcc', 'bankInfo', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        bt.dicts.init();//字典
        bt.dateType.init();//时间
        bt.selectType.init();//下拉选择
        bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        bt.corp.init();//单位
        bt.externalCorpBankAcc.init();//客商
        bt.bankInfo.init();//银行
        // 附件功能
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });
        //这里填写新的js代码，请参考前端文档

    });

</script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="myform">
##    付汇状态
    <input type="hidden" name="id" id="id" value="$!{lcPayment.id}">

    <table class="layui-table">
        <tr>
        ##                到单号
            <td class="textRight">#springMessage('table.internation.arrival.com.no')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.arrivalNo}
                </div>
            </td>
        ##                信用证号
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.creditNo}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##               付汇日期
                #springMessage('table.international.pay.date')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcBillArrival.payDate})
                </div>
            </td>
            <td class="textRight">
            ##                币别
                #springMessage('international.payment.curName')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{curName}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                到单金额
                                #springMessage('table.international.Arrival.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.billMoney})
                </div>
            </td>
            <td class="textRight">
            ##                付汇金额
                                #springMessage('table.internation.payment.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.payMoney})
                    <input type="hidden" id="payMentMoney" value="$!{lcBillArrival.payMoney}">
                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">
            ##                结算汇率
                                #springMessage('international.payment.settleRate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="settleRate" id="settleRate" lay-verify="required" value="$!{lcPayment.exchangeRate}"
                           class="layui-input bt-biz-moneyType" data-biz-name="settleRate" data-convert="true">
                </div>
            </td>
            <td class="textRight">
            ##                当日汇率
                                #springMessage('international.payment.dayRate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="dayRate" id="dayRate" lay-verify="required" value="$!{lcPayment.dayRate}"
                           class="layui-input bt-biz-moneyType" data-biz-name="dayRate" data-convert="true">
                </div>
            </td>
        </tr>
        #if($!{lcEnrol.isHangCredit}==1)
            #if($!{ratCreditType}=="0")
                <tr>

                </tr>
               #else##占用授信为循环授信的时候显示
                   <tr>
                       <td class="textRight">
                       ##                是否释放剩余授信额度
                                #springMessage('international.lcPayment.isAllRelease')
                       </td>
                       <td>
                           <div class="layui-input-inline">
                               <div class="bt-biz-dict" id="radio" data-type="radio" data-group="international.is.all.release" data-defaultvalue="0"
                                    data-name="isAllRelease" data-biz-name="isAllRelease">
                               </div>
                           </div>
                       </td>
                       <td></td>
                       <td></td>
                   </tr>
            #end
        #end
        <tr>
            <td colspan="4">
                <table id="lcPaymentCost" style="width:100%">
                    <thead>
                    <tr>
                        <th style="width: 48%">费用类型</th>
                        <th style="width: 48%">费用金额</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </td>
        </tr>
        <tr>
            <td>#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" id="gid" name="attachmentId" value="$!{lcPayment.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                #*<button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>*#
            </td>
        </tr>
    </table>

</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'selectType', 'rateType',
        'moneyType', 'corp', 'verify', 'bondAccInfo', 'externalCorpBankAcc', 'bankInfo', 'bttable', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        bt.dicts.init();//字典
        bt.dateType.init();//时间
        bt.selectType.init();//下拉选择
        bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        bt.corp.init();//单位
        bt.externalCorpBankAcc.init();//客商
        bt.bankInfo.init();//银行
        // 附件功能
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            isExpand: true,
            auto: false,
            gid: gid
        });
        form.on("submit(submit)", function (data) {
            deleteFeeMoneyInput();
            var feeMoneys = $("input[name ^= 'feeMoney']");
            var totalFeemoneys = 0;
            $.each(feeMoneys, function (index, item) {
                totalFeemoneys += Number($(this).val());
                $("#myform").append("<input type=\"hidden\" name=\"feeMoney\" value=\"" + $(this).val() + "\">")
            });
            if (totalFeemoneys > Number($("#payMentMoney").val())) {
                parent.layer ? parent.layer.alert(bt.lang("international.SupplementPayment.alert.info1"), {icon: 2}) : layer.alert(bt.lang("international.SupplementPayment.alert.info1"), {icon: 2});
                return false;
            }
            bt.loading.show();
            var url = basePath + "/international/credit/supplementPayment/saveSupplementPayment";
            $("#gid").val(up.getGroupId());
            $.ajax({
                url: url,
                data: $("#myform").serialize(),
                dataType: "json",
                type: "POST",
                success: function (data) {
                    parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                    if (data.success) {
                        if (!bt.navtab) {
                            bt.navtab.refreshParentTable();
                        } else {
                            bt.navtab.closeCurrent();
                        }
                    } else {
                        bt.loading.hide();
                    }
                }
            })
            return false;
        });

        var rowid = 1;
        bt.bttable.init({
            elem: "#lcPaymentCost",
            url: "querySupplementPaymentCost?id=" + $("#id").val(),
            checkbox: true,//带checkboxs
            mulselect: true,//true支持多选
            buttons: [//表格上面按钮功能
                {
                    text: bt.lang('common.button.add'),
                    action: function (e, dt, node, config) {
                        var html = "<tr>";
                        html += "<td class=\"center\"><input data-required=\"true\" type=\"checkbox\" name=\"checkChildren\" lay-filter=\"checkChildren\" lay-skin=\"primary\" class=\"checkchild\"></td>"
                        html += "<td><div class=\"bt-biz-dict\" data-type=\"select\" data-group=\"international.payment.paymentCost.type\" data-name=\"feeType\" data-biz-name=\"feeType\" data-width=\"300px\"></div></td>";
                        html += "<td><input data-required=\"true\" type=\"text\" data-name=\"feeMoney" + rowid + "\" class=\"layui-input bt-biz-moneyType\" value=\"0\"></td>";
                        html += "</tr>";
                        $("#lcPaymentCost > tbody").append(html)
                        bt.dicts.render();
                        moneyType.render()
                        form.render()
                        rowid++
                    }
                },
                {
                    text: bt.lang('common.button.delete'),
                    action: function (e, dt, node, config) {
                        var mytr = $("#lcPaymentCost").find("tr");
                        $.each(mytr, function (index, item) {
                            if (index != 0) {
                                if ($(this).find("input[type='checkbox']")[0].checked) {
                                    $(this).remove();
                                }
                            }
                        });
                    }
                }
            ],
            // btInitComplete:function(setting,json){
            tableInitCallback: function () {
                bt.dicts.render();
                moneyType.render();
                form.render();
            },
            columns: [
                {
                    "data": "feeType",
                    render: function (data, type, full, meta) {
                        var html = "<div class=\"bt-biz-dict\" data-type=\"select\" data-defaultvalue=\"" + data.feeType + "\" data-group=\"international.payment.paymentCost.type\" data-name=\"feeType\" data-biz-name=\"feeType\" data-width=\"300px\"></div>";
                        return html
                    }
                }, {
                    "data": "feeMoney",
                    render: function (data, type, full, meta) {
                        var html = "<input data-required=\"true\" type=\"text\" data-name=\"feeMoney" + rowid + "\" class=\"layui-input bt-biz-moneyType\" value=\"" + data.feeMoney + "\">";
                        rowid++
                        return html
                        // return bt.money.format(data.feeMoney);
                    }
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });

    function deleteFeeMoneyInput() {
        var feeMoneys = $("input[name = 'feeMoney']");
        $.each(feeMoneys, function (index, item) {
            $(this).remove();
        });
    }
</script>
</body>
</html>
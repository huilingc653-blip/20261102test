<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="myform">
##    付汇状态
    <input type="hidden" id="depositId" name="depositId" value="$!{lcDeposit.id}">
    <input type="hidden" id="depositNo" name="depositNo" value="$!{lcDeposit.depositNo}">
    <input type="hidden" id="curId" name="curId" value="$!{lcDeposit.curId}">
    <input type="hidden" id="corpId" name="corpId" value="$!{lcDeposit.corpId}">

    <table class="layui-table">
        <tr>
        ##                到单号
            <td class="textRight">#springMessage('table.internation.arrival.com.no')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.arrivalNo}
                </div>
            </td>
        ##                信用证号
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.creditNo}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                到单金额
                                #springMessage('table.international.Arrival.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.billMoney})
                </div>
            </td>
            <td class="textRight">
            ##                押汇金额
                                #springMessage('international.lcDeposit.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcDeposit.depositMoney})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                已还押汇金额
                                #springMessage('international.hadDepositedRepay.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcDeposit.reapyMoney})
                </div>
            </td>
            <td class="textRight">
            ##待还押汇金额
                #springMessage('international.notDepositedRepay.money')
            </td>
            <td>
                $!number.formatNumeric($!{lcDeposit.leftMoney})
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                开证人
                                #springMessage('international.credit.applicant')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{applicantName}
                </div>
            </td>
            <td class="textRight">
            ##                到单银行
                                #springMessage('international.arrival.com.bankName')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.handDocBank}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                押汇到期日期
                                #springMessage('international.lcDeposit.expiryDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcDeposit.expiryDate})
                </div>
            </td>
            <td class="textRight">
            ##                展期到期日期
                                #springMessage('international.lcDepositDelay.delayDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcDepositDelay.expiryDate})
                </div>
            </td>
        </tr>

        <tr>
##            还押汇金额
            <td class="textRight">
                #springMessage('international.lcDepositRepay.repayMoney')
            </td>
            <td>
                <input type="text" data-name="repayMoney" id="repayMoney" lay-verify="required" value="$!{lcDeposit.leftMoney}"
                       class="layui-input bt-biz-moneyType" data-biz-name="repayMoney" data-max="$!{lcDeposit.leftMoney}"
                       data-decimal="2">
            </td>
##                还押汇时间
            <td class="textRight">
                #springMessage('international.lcDepositRepay.repayDate')
            </td>
            <td>
                <input type="text" name="reapyDate" data-today="true" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="reapyDate">
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                汇率
                                #springMessage('international.credit.exchangeRate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="exchangeRate" id="exchangeRate" value="$!{lcDeposit.exchangeRate}"
                           class="layui-input bt-biz-moneyType" data-biz-name="exchangeRate" data-convert="true">
                </div>
            </td>
            <td class="textRight">
            ##                币别
                #springMessage('international.payment.curName')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{curName}
                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">
            ##                备注
                                #springMessage('international.lcDeposit.rmk')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="rmk" name="rmk" class="layui-input" value="$!{lcDeposit.rmk}">
                </div>
            </td>
            #if($!{lcEnrol.isHangCredit}==1)
                #if($!{ratCreditType}=="0")
                    <td></td>
                    <td></td>
                #else##占用授信为循环授信的时候显示
                    <td class="textRight">
                    ##                是否释放剩余授信额度
                                        #springMessage('international.lcDepositRepay.isAllRelease')
                    </td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" id="radio" data-type="radio" data-group="international.is.all.release" data-defaultvalue="0"
                                 data-name="isAllRelease" data-biz-name="isAllRelease">
                            </div>
                        </div>
                    </td>
                #end

            #else
                <td></td>
                <td></td>
            #end
        </tr>
        <tr>
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" id="gid" name="attachmentId" value="">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'selectType', 'rateType',
        'moneyType', 'corp', 'verify', 'bondAccInfo', 'externalCorpBankAcc', 'bankInfo', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        bt.dicts.init();//字典
        bt.dateType.init();//时间
        bt.selectType.init();//下拉选择
        bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        bt.corp.init();//单位
        bt.externalCorpBankAcc.init();//客商
        bt.bankInfo.init();//银行
        // 附件功能
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            isExpand: true,
            auto: false,
            gid: gid
        });

        form.on("submit(submit)", function (data) {
            var url = basePath + "/international/credit/lcDeposit/saveLcDepositRepay"
            $("#gid").val(up.getGroupId());
            $.ajax({
                url: url,
                data: $("#myform").serialize(),
                dataType: "json",
                type: "POST",
                success: function (data) {
                    parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                    if (data.success) {
                        if (!bt.navtab) {
                            bt.navtab.refreshParentTable();
                        } else {
                            bt.navtab.closeCurrent();
                        }
                    } else {
                        bt.loading.hide();
                    }
                }
            })
            return false;
        });
        //这里填写新的js代码，请参考前端文档
    });

</script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##                到单号
    <li class="mui-table-view-cell">
        #springMessage('table.internation.arrival.com.no')
        <span class="mui-badge mui-badge-inverted">
            $!{lcBillArrival.arrivalNo}
        </span>
    </li>

##                信用证号
    <li class="mui-table-view-cell">
        #springMessage('international.credit.creditNo')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.creditNo}
        </span>
    </li>

##               付汇日期
    <li class="mui-table-view-cell">
        #springMessage('table.international.pay.date')
        <span class="mui-badge mui-badge-inverted">
            $!date.format("yyyy-MM-dd",$!{lcBillArrival.payDate})
        </span>
    </li>

##                币别
    <li class="mui-table-view-cell">
        #springMessage('international.payment.curName')
        <span class="mui-badge mui-badge-inverted">
            $!{lcDeposit.curName}
        </span>
    </li>
##                到单金额
    <li class="mui-table-view-cell">
        #springMessage('table.international.Arrival.money')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcBillArrival.billMoney})
        </span>
    </li>
##                需押汇金额
    <li class="mui-table-view-cell">
        #springMessage('table.internation.neddPayment.money')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcBillArrival.payMoney})
        </span>
    </li>
##                已押汇金额
    <li class="mui-table-view-cell">
        #springMessage('international.hadDeposited.money')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{depositedMoney})
        </span>
    </li>
##                押汇在途金额
    <li class="mui-table-view-cell">
        #springMessage('international.depositing.money')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{depositingMoney})
        </span>
    </li>
##                受益人
    <li class="mui-table-view-cell">
        #springMessage('international.credit.beneficiary')
        <span class="mui-badge mui-badge-inverted">
            $!{lcBillArrival.beneficiary}
        </span>
    </li>
##                开证人
    <li class="mui-table-view-cell">
        #springMessage('international.credit.applicant')
        <span class="mui-badge mui-badge-inverted">
            $!{applicantName}
        </span>
    </li>
##                合同号
    <li class="mui-table-view-cell">
        #springMessage('international.credit.contractNo')
        <span class="mui-badge mui-badge-inverted">
            $!{lcEnrol.contractNo}
        </span>
    </li>
##                到单银行
    <li class="mui-table-view-cell">
        #springMessage('international.arrival.com.bankName')
        <span class="mui-badge mui-badge-inverted">
            $!{lcBillArrival.handDocBank}
        </span>
    </li>
##                押汇日期
    <li class="mui-table-view-cell">
        #springMessage('international.lcDeposit.depositDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format("yyyy-MM-dd",$!{lcDeposit.depositDate})
        </span>
    </li>
##                到期日期
    <li class="mui-table-view-cell">
        #springMessage('international.lcDeposit.expiryDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format("yyyy-MM-dd",$!{lcDeposit.expiryDate})
        </span>
    </li>
##                汇率
    <li class="mui-table-view-cell">
        #springMessage('international.credit.exchangeRate')
        <span class="mui-badge mui-badge-inverted">
            $!excRateTag.getConvert($!{lcDeposit.exchangeRate})
        </span>
    </li>
##                押汇金额
    <li class="mui-table-view-cell">
        #springMessage('international.lcDeposit.money')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{lcDeposit.depositMoney})
        </span>
    </li>
##                期限
    <li class="mui-table-view-cell">
        #springMessage('international.lcDeposit.timeLimit')
        <span class="mui-badge mui-badge-inverted">
        $!{lcDeposit.timeLimit}
        #if($!{lcDeposit.timeLimit})
            $dictTag.get("international.lcDepost.termUnit",$!{lcDeposit.termUnit})
        #end
        </span>
    </li>
##                利率
    <li class="mui-table-view-cell">
        #springMessage('international.lcDeposit.interestRate')
        <span class="mui-badge mui-badge-inverted">
            #if($!{lcDeposit.interestRate})
                $!number.formatNumeric($math.mul($!{lcDeposit.interestRate},100),"#0.0000")%
            #end
        </span>
    </li>
##                是否补录
    <li class="mui-table-view-cell">
        #springMessage('international.lcDeposit.isSkipProcess')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("international.lcDepost.isSkipProcess",$!{lcDeposit.isSkipProcess})
        </span>
    </li>
##                备注
    <li class="mui-table-view-cell">
        #springMessage('international.lcDeposit.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{lcDeposit.rmk}
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>
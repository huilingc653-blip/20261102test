<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
#*单位id*#
<input type="hidden" id="corpId" name="corpId" value="$!{lcEnrol.corpId}">
#*开证币别*#
<input type="hidden" id="curCode" name="curCode" value="$!{lcEnrol.issuingCurId}">
#*开证银行*#
<input type="hidden" id="bankCode" name="bankCode" value="$!{ratUration.bankCode}">
#*占授信代码*#
<input type="hidden" id="ratItemCode" name="ratItemCode" value="$!{lcEnrol.itemCode}">
#*开证日期*#
<input type="hidden" id="beginDate" name="beginDate" value="$!{lcEnrol.issuingDate}">
#*额度编号*#
<input type="hidden" id="ratCode" name="ratCode" value="$!{lcEnrol.rationCode}">
#*授信模式*#
<input type="hidden" id="ratmodel" name="ratmodel" value="$!{lcEnrol.ratmodel}">
#*授信金额*#
<input type="hidden" id="itemMoney" name="itemMoney" value="$!{lcEnrol.itemMoney}">
##是否折算成本位币
<input type="hidden" id="isNativeCur" name="isNativeCur" value="$!{lcEnrol.isNativeCur}">

    ##授信银行控制参数
<input type="hidden" id="ratBankConfig" value="$!{ratBankConfig}">
    <form class="layui-form" method="post" id="myform">
        <input type="hidden" name="id" value="$!{lcEnrol.id}">
        <table class="layui-table breakRow">
            <tr>
                <td style="width: 15%">
                    <label style="font-weight: bold">#springMessage('international.master.info')</label>
                </td>
                <td style="width: 35%"></td>
                <td style="width: 15%"></td>
                <td style="width: 35%"></td>
            </tr>
            <tr>
            ##                登记日期
                <td class="textRight">
                    <div class="layui-input-inline">
                        #springMessage('international.credit.createDate')
                    </div>
                </td>
                <td >
                    <div class="layui-input-inline">
                        $!date.format('yyyy-MM-dd',$!{lcEnrol.createDate})
                    </div>
                </td>
            ##                信用证类型
                <td class="textRight">#springMessage('international.credit.lcInter')</td>
                <td>
                    <div class="layui-input-inline">
                        $dictTag.get("letter_of_credit_inter",$!{lcEnrol.lcInter})
                    </div>
                </td>
            </tr>
            <tr>
            ##                信用证号
                <td class="textRight">#springMessage('international.credit.creditNo')</td>
                <td>
                    <div class="layui-input-inline">
                        $!{lcEnrol.creditNo}
                    </div>
                </td>
            ##                合同号
                <td class="textRight">#springMessage('international.credit.contractNo')</td>
                <td>
                    <div class="layui-input-inline">
                        $!{lcEnrol.contractNo}
                    </div>
                </td>
            </tr>

            <tr>
            ##                开证人
                <td class="textRight" style="width: 15%">#springMessage('international.credit.applicant')</td>
                <td>
                    <div class="layui-input-inline">
                        $!{corpName}
                    </div>
                    </div>
                </td>
            ##                受益人
                <td class="textRight">#springMessage('international.credit.beneficiary')</td>
                <td>
                    <div class="layui-input-inline">
                        $!{lcEnrol.beneficiary}
                    </div>
                </td>
            </tr>
            <tr>
            ##                开证日期
                <td class="textRight">#springMessage('international.credit.issuingDate')</td>
                <td>
                    <div class="layui-input-inline">
                        $!date.format('yyyy-MM-dd',$!{lcEnrol.issuingDate})
                    </div>
                </td>
            ##                信用证有效期
                <td class="textRight">#springMessage('international.credit.expiryDate')</td>
                <td>
                    <div class="layui-input-inline">
                        $!date.format('yyyy-MM-dd',$!{lcEnrol.expiryDate})
                    </div>
                </td>
            </tr>
            <tr>
            ##                开户行
                <td class="textRight">#springMessage('international.credit.issuingBank')</td>
                <td>
                    $!{applicantAccShow}
                </td>

            ##                受益人账号
                <td class="textRight">#springMessage('international.credit.beneficiaryAcc')</td>
                <td>
                    <div class="layui-input-inline">
                        $!{lcEnrol.beneficiaryAcc}
                    </div>
                </td>
            </tr>
            <tr>
            ##                开证人账号
                <td class="textRight">#springMessage('international.credit.applicantAcc')</td>
                <td>
                    $!{lcEnrol.applicantAcc}
                </td>
            ##                受益人开户行
                <td class="textRight">#springMessage('international.credit.beneficiaryBank')</td>
                <td>
                    <div class="layui-input-inline">
                        $!{lcEnrol.beneficiaryBank}
                    </div>
                </td>
            </tr>

            <tr>
            ##                开证人地址
                <td class="textRight">#springMessage('international.credit.addr')</td>
                <td>
                    $!{lcEnrol.addr}
                </td>
            ##                受益人地址
                <td class="textRight">#springMessage('international.credit.addrBen')</td>
                <td>
                    $!{lcEnrol.addrBen}
                </td>
            </tr>

            <tr>
            ##                开证人邮编
                <td class="textRight">#springMessage('international.credit.postNum')</td>
                <td>
                    $!{lcEnrol.postNum}
                </td>
            ##                受益人邮编
                <td class="textRight">#springMessage('international.credit.postNumBen')</td>
                <td>
                    $!{lcEnrol.postNumBen}
                </td>
            </tr>


            <tr>
            ##                开证币种
                <td class="textRight">#springMessage('international.credit.issuingCurId')</td>
                <td>
                    <div class="layui-input-inline">
                        $!{curName}
                    </div>
                </td>
            ##                开证金额
                <td class="textRight">#springMessage('international.credit.creditMoney')</td>
                <td>
                    <div class="layui-input-inline">
                        $!number.formatNumeric($!{lcEnrol.creditMoney})
                        <input type="hidden" data-toup="upperMoney" disabled="disabled"
                               class="layui-input bt-biz-moneyType" data-minus="true" data-biz-name="creditMoney"
                               data-decimal="2" value="$!{lcEnrol.creditMoney}">
                    </div>
                </td>
            </tr>
            <tr>
            ##                开证金额大写
                <td class="textRight">#springMessage('international.credit.creditMoney.big')</td>
                <td>
                    <div id="upperMoney"></div>
                </td>
                <td></td>
                <td></td>
            </tr>
            <tr>
            ##                期限
                <td class="textRight">#springMessage('international.credit.timeLimit')</td>
                <td>
                    <div class="layui-input-inline">
                        $dictTag.get("letter_of_credit_timeLimit",$!{lcEnrol.timeLimit})
                    </div>
                </td>
                #if($!{lcEnrol.timeLimit} == 2)
                ##                远期天数
                    <td class="textRight">#springMessage('international.credit.delayDates')</td>
                    <td>
                        <div class="layui-input-inline">
                            $!{lcEnrol.delayDates}
                        </div>
                    </td>
                #else
                    <td></td>
                    <td></td>
                #end
            </tr>
            #if($!{config.international.creditIsBond}==1)
                <tr>
                    <td>
                        <label style="font-weight: bold">#springMessage('international.bondInfo')</label>
                    </td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                ##是否挂保证金
                    <td class="textRight">#springMessage('table.fcBond.includeBond')</td>
                    <td>
                        $dictTag.get("sf_yn",$!{lcEnrol.isHangBond})
                    </td>
                    #if($!{lcEnrol.isHangBond} == 1)
                    ##保证金额度单
                        <td class="textRight bondInfo">#springMessage('table.fcBond.quotas')</td>
                        <td>
                            $!{lcEnrol.bondBankAcc}
                        </td>
                    #else
                        <td></td>
                        <td></td>
                    #end
                </tr>
                <tr>
                ##                    保证金币别
                    <td class="textRight">#springMessage('international.credit.bondCurId')</td>
                    <td>
                        <div class="layui-input-inline">
                            $!{bondCurName}
                        </div>
                    </td>
                ##保证金比例
                    <td class="textRight">#springMessage('table.fcBond.bondPercent')</td>
                    <td>
                        <div class="layui-input-inline">
                            $!number.formatNumeric($math.mul($!{lcEnrol.bondPercent},100),"#0.00")%
                        </div>
                    </td>
                </tr>
                <tr>
                ##保证金金额
                    <td class="textRight">#springMessage('table.fcBond.bondmoney')</td>
                    <td>
                        <div class="layui-input-inline">
                            $!number.formatNumeric($!{lcEnrol.bondMoney})
                        </div>
                    </td>
                ##保证金合同号
                    <td class="textRight">#springMessage('table.fcBond.contractNum')</td>
                    <td>
                        <div class="layui-input-inline">
                            $!{lcEnrol.bondContract}
                        </div>
                    </td>
                </tr>
            ##        保证及利率
                <tr>
                    <td class="textRight">#springMessage('table.fcBond.bondRate')</td>
                    <td>
                        <div class="layui-inline">
                            #if($!{lcEnrol.bondRate})
                                $!number.formatNumeric($math.mul($!{lcEnrol.bondRate},100),"#0.0000")%
                            #end
                        </div>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
            #end
        ##################################授信挂接###########################################################
            #if($!{config.international.creditIsHang}==1)
                <tr>
                    <td>
                        <label style="font-weight: bold">#springMessage('credit.information')</label>
                    </td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                ##是否挂接授信
                    <td class="textRight">#springMessage('table.cmsProvideLoanInfo.ratmodel')</td>
                    <td>
                        <div class="layui-inline">
                            $dictTag.get("sf_yn",$!{lcEnrol.isHangCredit})
                        </div>
                    </td>
                    #if($!{config.international.isRatOpen} == "1")
                    ##			授信敞口
                        <td class="textRight" #if($!{lcEnrol.isHangCredit}==0)style="display: none"#end>#springMessage('common.isOpen.ratUration')</td>
                        <td>
                            <div class="layui-inline" #if($!{lcEnrol.isHangCredit}==0)style="display: none"#end>
                                $dictTag.get("common.isOpen.ratUration",$!{lcEnrol.isOpenRat})
                            </div>
                        </td>
                    #else
                        <td></td>
                        <td></td>
                    #end
                </tr>
                #if($!{lcEnrol.isHangCredit}==1)
                    <tr class="isShow isNativeCur" #if($!{lcEnrol.issuingCurId} == $!{nativeCur.id})style="display: none"#end>
                    ##            是否折合成本位币
                        <td class="textRight">#springMessage('international.credit.isNativeCur')</td>
                        <td>
                            <div class="layui-inline">
                                #if($!{lcEnrol.isNativeCur} == 1)
                                        $dictTag.get("international.credit.isNativeCur",1)
                                    #else
                                    $dictTag.get("international.credit.isNativeCur",0)
                                #end
                            </div>
                        </td>
                        #if($!{lcEnrol.isNativeCur} == 1)
                        ##            折合本位币金额
                            <td class="textRight">#springMessage('international.credit.nativeCreditMoney')</td>
                            <td>
                                $!number.formatNumeric($!{lcEnrol.nativeCreditMoney})
                            </td>
                        #else
                            <td></td>
                            <td></td>
                        #end
                    </tr>
                    <tr>
                    ##                授信品种
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.itemCode')</td>
                        <td>
                            <div class="layui-inline" id="ratItemCodeDiv">
                                $!{ratUration.ratItemName}&nbsp;
                                <label style="padding-left: 10px">
                                    #springMessage('cms.business.race')：
                                </label>
                                &nbsp;$!{ratUration.raceName}
                            </div>
                        </td>
                    ##授信额度单
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rationSelect')</td>
                        <td colspan="3">
                            <div class="layui-input-inline">
                                <div id="rationBtn">
                                    <button type="button" onclick="viewRationDtl()" class="layui-btn">#springMessage(
                                        'common.button.view')</button>
                                </div>
                            </div>
                        ##额度编号
                        ##占用授信代码
                            <span id="itemCodeTd"></span>
                        </td>
                    </tr>
                #end
            #end
        ##################################授信挂接###########################################################
        ##        担保部分
            <tr>
                <td class="textRight">
                ##            是否挂担保
                #springMessage('rat.Is.bkration.gua')
                </td>
                <td>
                    <div class="layui-input-inline">
                        $dictTag.get("sf_yn",$!{lcEnrol.isHangGuarantee})
                    </div>
                </td>
                #if($!{lcEnrol.isHangGuarantee} == 1)
                    <td class="textRight">#springMessage('cms.guarantee.rmk')</td>
                    <td colspan="3">
                        <div class="layui-input-inline">
                            $!{lcEnrol.guaranteeRmk}
                        </div>
                    </td>
                #else
                    <td></td>
                    <td></td>
                #end
            </tr>

            <tr>
                <td>
                    <label style="font-weight: bold">#springMessage('international.other.info')</label>
                </td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
            ##                手续费
                <td class="textRight">#springMessage('international.credit.chargeMoney')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" data-name="chargeMoney"  data-callback="compCostCalculate"
                               class="layui-input bt-biz-moneyType" data-minus="true" data-biz-name="chargeMoney"
                               data-decimal="2" value="$!{lcEnrol.chargeMoney}">
                    </div>
                </td>
            ##                付手续费账号
                <td class="textRight">#springMessage('international.credit.payChargeAacc')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="payChargeAacc" class="layui-input" value="$!{lcEnrol.payChargeAacc}">
                    </div>
                </td>
            </tr>
            <tr>
            ##                承兑金额
                <td class="textRight">#springMessage('international.credit.acceptanceMoney')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" data-name="acceptanceMoney" class="layui-input bt-biz-moneyType"  data-callback="compCostCalculate"
                               data-minus="true" data-biz-name="acceptanceMoney" data-decimal="2" value="$!{lcEnrol.acceptanceMoney}">
                    </div>
                </td>
            ##                汇率
                <td class="textRight">#springMessage('international.credit.exchangeRate')</td>
                <td>
                    <div class="layui-input-inline">
                        $!excRateTag.getConvert($!{lcEnrol.exchangeRate})
                    </div>
                </td>
            </tr>

            <tr>
            ##                承兑费用
                <td class="textRight">#springMessage('international.credit.acceptanceFee')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" data-name="acceptanceFee" class="layui-input bt-biz-moneyType"  data-callback="compCostCalculate"
                               data-minus="true" data-biz-name="acceptanceFee" data-decimal="2" value="$!{lcEnrol.acceptanceFee}">
                    </div>
                </td>
            ##                其他费用
                <td class="textRight">#springMessage('international.credit.otherFee')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" data-name="otherFee" class="layui-input bt-biz-moneyType" data-minus="true"  data-callback="compCostCalculate"
                               data-biz-name="otherFee" data-decimal="2" value="$!{lcEnrol.otherFee}">
                    </div>
                </td>
            </tr>

            <tr>
            ##                贴现费率
                <td class="textRight">#springMessage('international.credit.discountRate')</td>
                <td>
                    <div class="layui-input-inline">
                        <input class="layui-input bt-biz-rateType" type="text" data-name="discountRate" value="$!{lcEnrol.discountRate}" data-decimal="2">
                    </div>
                </td>
            ##                贴现息
                <td class="textRight">#springMessage('international.credit.discountInterest')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" data-name="discountInterest" class="layui-input bt-biz-moneyType"  data-callback="compCostCalculate"
                               data-minus="true" data-biz-name="discountInterest" data-decimal="2" value="$!{lcEnrol.discountInterest}">
                    </div>
                </td>
            </tr>


            <tr>
            ##                贸易亏损
                <td class="textRight">#springMessage('international.credit.tradeDeficit')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" data-name="tradeDeficit" class="layui-input bt-biz-moneyType"  data-callback="compCostCalculate"
                               data-minus="true" data-biz-name="tradeDeficit" data-decimal="2" value="$!{lcEnrol.tradeDeficit}">
                    </div>
                </td>
            ##                综合成本
                <td class="textRight">#springMessage('international.credit.compCost')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" data-name="compCost" class="layui-input bt-biz-moneyType" data-minus="true"
                               data-biz-name="compCost" data-decimal="2" value="$!{lcEnrol.compCost}">
                    </div>
                </td>
            </tr>

            <tr>
            ##                应回款金额
                <td class="textRight">#springMessage('international.credit.rebackMoney')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" data-name="rebackMoney" class="layui-input bt-biz-moneyType"
                               data-minus="true" data-biz-name="rebackMoney" data-decimal="2" value="$!{lcEnrol.rebackMoney}">
                    </div>
                </td>
            ##                敞口金额
                <td class="textRight">#springMessage('international.credit.openMoney')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" data-name="openMoney" class="layui-input bt-biz-moneyType" data-minus="true"
                               data-biz-name="openMoney" data-decimal="2" value="$!{lcEnrol.openMoney}">
                    </div>
                </td>
            </tr>

            <tr>
            ##                用途
                <td class="textRight">#springMessage('international.credit.purpose')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-name="purpose" data-url="${basePath}/international/credit/createCredit/getPurpose?corpId=$!{lcEnrol.corpId}" data-inputvalue="true" data-search="true"
                             data-valuefield="purpose" data-textfield="purpose" data-biz-name="purpose" data-defaultvalue="$!{lcEnrol.purpose}"></div>
                    </div>
                </td>
            ##                备注
                <td class="textRight">#springMessage('international.credit.rmk')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="rmk" class="layui-input" value="$!{lcEnrol.rmk}">
                    </div>
                </td>
            </tr>
            <tr>
                <td>#springMessage('cms.loan.attachment')</td>
                <td colspan="3">
                    <input type="hidden" id="gid" name="attachmentId" value="$!{lcEnrol.attachmentId}">
                    <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
                </td>
            </tr>
        </table>
        #if($!{isGuarantee}=="1")##授信参数设置挂接担保
        ##担保合同信息
            #if(${lcEnrol.isHangGuarantee}=="1")
                <h2 class="layui-colla-title">#springMessage('table.guaContract.ContractMsg')</h2>
                #set($guaContractUseDTO=$guaContractTag.getGuaContractOccupyDetail($!{lcEnrol.id},$!{lcEnrol.lcNo}))
                #if($!{guaContractUseDTO})
                    #parse("views/common/guaContractDetail.vm")
                #end
            #end
        #end
        <div class="layui-input-inline" style="text-align: center;width: 100%">
            <button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.storage')</button>
            <button class="layui-btn" onclick="closeNavtab()">#springMessage('common.button.revert')</button>
            <button type="button" class="layui-btn" onclick="bt.navtab.refreshCurrent();">#springMessage('common.button.reset')</button>
        </div>
    </form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'selectType', 'rateType',
        'moneyType', 'corp', 'verify', 'externalCorpBankAcc', 'selectTableType', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        bt.dicts.init();//字典
        dateObj = bt.dateType.init();//时间
        selectType = bt.selectType.init();//下拉选择
        bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        corp = bt.corp.init();//单位
        bt.externalCorpBankAcc.init();//客商
        fun = bt.moneyType.getFun()
        // 附件功能
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });
        form.on("submit(submit)", function (data) {
            bt.loading.show();
            var url = basePath + "/international/credit/supplementCredit/storageCredit"
            $.ajax({
                url: url,
                data: $("#myform").serialize(),
                dataType: "json",
                type: "POST",
                success: function (data) {
                    parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                    if (data.success) {
                        if (!bt.navtab) {
                            bt.navtab.refreshParentTable();
                        } else {
                            bt.navtab.closeCurrent();
                        }
                    } else {
                        bt.loading.hide();
                    }
                }
            })
            return false;
        });
        /**判断字符串是否为空*/
        bt.empty = function (ms) {
            if (typeof (ms) == "undefined" || ms == null || ms == "" || ms == " ") {
                return true;
            }
            return false;
        }
    });
</script>

<script src="${basePath}/static/modules/international/international.viewLcEnrol.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="searchForm">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('international.credit.lcInter')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" id="lcInter" data-type="select" data-group="letter_of_credit_inter"  value="$!{lcEnrol.lcInter}"
                         data-name="eqs_lcInter" data-biz-name="lcInter" >
                    </div>
                </div>
            </td>
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <input type="text" class="layui-input" name="likes_creditNo" />
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="" lay-filter="search">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="datatable" class="layui-table" style="width:100%">
    <thead>
    <tr>
        <th>#springMessage('table.fcPredrawDtlTemp.orderNo')</th>##流水号
        <th>#springMessage('international.credit.lcInter')</th>##信用证类型
        <th>#springMessage('international.credit.creditNo')</th>##信用证号
        <th>#springMessage('international.credit.contractNo')</th>##合同号
        <th>#springMessage('international.credit.issuingDate')</th>##开证日期
        <th>#springMessage('international.credit.expiryDate')</th>##有效期
        <th>#springMessage('international.credit.creditMoney')</th>##开证金额
        <th>#springMessage('table.international.haveArrived.money')</th>##已到单金额
        <th>#springMessage('table.international.notArrivaled.mone')</th>##未到单金额
        <th>#springMessage('table.internation.payment.money')</th>##付汇金额
        <th>#springMessage('international.credit.issuingCurId')</th>##开证币别
        <th>#springMessage('international.credit.issuingBank')</th>##开证银行类别
        <th>#springMessage('international.credit.beneficiary')</th>##受益人
        <th>#springMessage('common.table.status')</th>##状态
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
<script>
    bt.use(['jquery','datatable','form','dicts'], function(){
        $ = bt.jquery;
        bt.dicts.init();
        var datatable = bt.datatable.init({
            elem : "#datatable",
            checkbox : false,
            ajax : {
                url : "queryStorageCredit",
                dataSrc : "data"
            },
            colReorder : true,
            fixedColumns: {
                rightColumns: 1//代表冻结右边一列
            },
            columns: [
                {
                    data: "lcNo",
                    className: "center"
                },
                {
                    data: "lcInter",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("letter_of_credit_inter", full.lcInter);
                    }
                }, {
                    data: "creditNo",
                    className: "center"
                }, {
                    data: "contractNo",
                    className: "center"
                }, {
                    data: "issuingDate",
                    className: "center"
                }, {
                    data: "expiryDate",
                    className: "center"
                }, {
                    data: "creditMoney",
                    className: "center",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.creditMoney)
                    }
                }, {
                    data: "hadbillMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.hadbillMoney)
                    }
                }, {
                    data: "hadNotbillMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.hadNotbillMoney)
                    }
                }, {
                    data: "sumPaymentMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.sumPaymentMoney)
                    }
                }, {
                    data: "curName",
                    className: "center"
                }, {
                    data: "issuingBankName",
                    className: "center"
                }, {
                    data: "beneficiary",
                    className: "center"
                }, {
                    data: "status",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("international.supplement.status", full.status);
                    }
                }, {
                    data: null,
                    className: "center",
                    render: function (data, type, full, meta) {
                        var explode = "<span class=\"text-explode\">|</span>"
                        var id = full.id;
                        var html = "<a class=\"\" href=\"#\" data-row=\"" + meta.row + "\" onclick=\"add('" + id + "')\">" + bt.lang("table.internation.billArrival") + "</a>";
                        html += explode + "<a class=\"\" href=\"#\" data-row=\"" + meta.row + "\" onclick=\"viewCredit('" + id + "')\">" + bt.lang("common.button.view") + "</a>";
                        return html;
                    }
                }
            ],
            btInitComplete:function(setting,json){
            },
            searchForm : {
                formElem : "#searchForm",
                formFilter : "search",
                callback : function (data) {

                }
            },
            summary:{
                pageSum: false,//小计功能关闭
                allSum: true,//汇总功能开启
                // selectSum: true,//已选汇总功能开启
                // groupColumn: 'curName',//分类汇总列参数
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '7',//汇总列序号
                        dataName: 'creditMoney',//汇总列数据
                    },
                    {
                        colNum: '8',//汇总列序号
                        dataName: 'hadbillMoney',//汇总列数据
                    },
                    {
                        colNum: '9',//汇总列序号
                        dataName: 'hadNotbillMoney',//汇总列数据
                    },
                    {
                        colNum: '10',//汇总列序号
                        dataName: 'sumPaymentMoney',//汇总列数据
                    },
                ]
            }
        });
    });


    function add(id){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('table.internation.billArrival'),basePath + "/international/credit/billArrival/addBillArrival?id=" +id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/international/credit/billArrival/addBillArrival?id="+id,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }

    function viewCredit(id){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('international.lcEnrol.info'),basePath + "/international/credit/createCredit/viewCredit?id=" + id + "&showCloseBtn=1");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/international/credit/createCredit/viewCredit?id=" + id + "&showCloseBtn=1",
            end:function(){
                datatable && datatable.draw();
            }
        });
    }


    function edit(id){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.edit'),basePath + "/international/credit/billArrival/editBillArrival?id=" +id);
            return;
        }
    }
</script>
</body>
</html>

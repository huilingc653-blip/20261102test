<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="myform">
##    押汇补录96
    <input type="hidden" id="status" name="status" value="96">
    <input type="hidden" id="id" name="id" value="$!{lcDeposit.id}">
    <table class="layui-table">
        <tr>
        ##                到单号
            <td class="textRight">#springMessage('table.internation.arrival.com.no')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.arrivalNo}
                </div>
            </td>
        ##                信用证号
            <td class="textRight">#springMessage('international.credit.creditNo')</td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.creditNo}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##               到单日期
                #springMessage('table.international.arrival.paymentDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{lcBillArrival.payDate})
                </div>
            </td>
            <td class="textRight">
            ##                币别
                #springMessage('international.payment.curName')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{curName}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                到单金额
                                #springMessage('table.international.Arrival.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.billMoney})
                </div>
            </td>
            <td class="textRight">
            ##                需押汇金额
                                #springMessage('table.internation.neddDeposit.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{lcBillArrival.payMoney})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                已押汇金额
                                #springMessage('international.hadDeposited.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{paymentedMoney})
                </div>
            </td>
            <td class="textRight">
            ##                押汇在途金额
                                #springMessage('international.depositing.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!number.formatNumeric($!{paymentingMoney})
                </div>
            </td>

        </tr>
        <tr>
            <td class="textRight">
            ##                受益人
                                #springMessage('international.credit.beneficiary')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.beneficiary}
                </div>
            </td>
            <td class="textRight">
            ##                开证人
                                #springMessage('international.credit.applicant')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{applicantName}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                合同号
                                #springMessage('international.credit.contractNo')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcEnrol.contractNo}
                </div>
            </td>

            <td class="textRight">
            ##                到单银行
                                #springMessage('international.arrival.com.bankName')
            </td>
            <td>
                <div class="layui-input-inline">
                    $!{lcBillArrival.handDocBank}
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                押汇日期
                                #springMessage('international.lcDeposit.depositDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" id="depositDate" name="depositDate" value="$!date.format("yyyy-MM-dd",$!{lcDeposit.depositDate})">
                    $!date.format("yyyy-MM-dd",$!{lcDeposit.depositDate})
                </div>
            </td>
            <td class="textRight">
            ##                到期日期
                                #springMessage('international.lcDeposit.expiryDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="expiryDate" id="expiryDate" lay-verify="required" value="$!date.format("yyyy-MM-dd",$!{lcDeposit.expiryDate})" data-callback="setTimeLimit"
                           class="layui-input bt-biz-dateType" data-minus="true" data-biz-name="expiryDate">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
            ##                汇率
                                #springMessage('international.credit.exchangeRate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="exchangeRate" id="exchangeRate" value="$!{lcDeposit.exchangeRate}"
                           class="layui-input bt-biz-moneyType" data-biz-name="exchangeRate" data-convert="true">
                </div>
            </td>
            <td class="textRight">
            ##                押汇金额
                                #springMessage('international.lcDeposit.money')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="depositMoney" id="depositMoney" lay-verify="required" value="$!{lcDeposit.depositMoney}"
                           class="layui-input bt-biz-moneyType" data-minus="true" data-biz-name="depositMoney"
                           data-decimal="4">
                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">
            ##                期限
                                #springMessage('international.lcDeposit.timeLimit')
            </td>
            <td>
                <div>
                    <input style="display: inline-block" type="text" id="timeLimit" name="timeLimit" class="layui-input" value="$!{lcDeposit.timeLimit}" readonly="readonly">
                    <div class="bt-biz-dict" data-type="select" data-group="international.lcDepost.termUnit" data-defaultvalue="$!{lcDeposit.termUnit}" data-name="termUnit" data-biz-name="termUnit" data-width="80px" data-callback="setTimeLimit2"></div>
                </div>
            </td>
            <td class="textRight">
            ##                利率
                                #springMessage('international.lcDeposit.interestRate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="interestRate" name="interestRate" class="layui-input bt-biz-rateType" lay-verify="required" value="$!{lcDeposit.interestRate}">
                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">
                ##                付息日期
                                    #springMessage('international.lcDeposit.payInterestDate')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="payInterestDate"  class="layui-input bt-biz-dateType" data-type="date" data-biz-name="payInterestDate" value="$!{lcDeposit.payInterestDate}">
                </div>
            </td>
            <td class="textRight">
                ##                利息
                                    #springMessage('international.lcDeposit.payInterestMoney')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="payInterestMoney" id="payInterestMoney"
                           class="layui-input bt-biz-moneyType" data-minus="true" data-biz-name="payInterestMoney"
                           data-decimal="2" value="$!{lcDeposit.payInterestMoney}">
                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">
            ##                备注
                                #springMessage('international.lcDeposit.rmk')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="rmk" name="rmk" class="layui-input" value="$!{lcDeposit.rmk}">
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td>#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" id="gid" name="attachmentId" value="$!{lcDeposit.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'selectType', 'rateType',
        'moneyType', 'corp', 'verify', 'bondAccInfo', 'externalCorpBankAcc', 'bankInfo', "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        dicts = bt.dicts.init();//字典
        date = bt.dateType.init();//时间
        bt.selectType.init();//下拉选择
        bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        bt.corp.init();//单位
        bt.externalCorpBankAcc.init();//客商
        bt.bankInfo.init();//银行
        // 附件功能
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            isExpand: true,
            auto: false,
            gid: gid
        });


        form.on("submit(submit)", function (data) {
            /*表单校验函数*/
            if (!validateForm()) {
                return false;
            }
            bt.loading.show();
            var url = basePath + "/international/credit/lcDeposit/saveOrTmpDeposit"
            $("#gid").val(up.getGroupId());
            $.ajax({
                url: url,
                data: $("#myform").serialize(),
                dataType: "json",
                type: "POST",
                success: function (data) {
                    parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                    if (data.success) {
                        if (!bt.navtab) {
                            bt.navtab.refreshParentTable();
                        } else {
                            bt.navtab.closeCurrent();
                        }
                    } else {
                        bt.loading.hide();
                    }
                }
            })
            return false;
        });
        //这里填写新的js代码，请参考前端文档
    });


    function validateForm() {
        var flag = true;
        var startDate = $("#depositDate").val();
        var endDate =  date.get("expiryDate").val();
        var termUnit = dicts.get("termUnit").val();
        var timeLimit = 0;
        if (bt.date.compare(startDate, endDate) > 0) {
            parent.layer ? parent.layer.alert(bt.lang("international.lcDeposit.alert.info1"), {icon: 2}) : layer.alert(data.msg, {icon: 2});
            flag = false;

        } else {
            if (1 == termUnit) {
                timeLimit = bt.date.getBetweenMonth(startDate,endDate)
            } else {
                timeLimit = bt.date.getBetweenDay(startDate,endDate)
            }
            $("#timeLimit").val(timeLimit);
        }
        return flag;
    }


    /**
     * 到期时间校验
     * @param data
     * @param currItem
     */
    function setTimeLimit(data,currItem) {
        validateForm();
    }


    /**
     * 到期时间校验
     * @param data
     * @param text
     * @param selectedData
     * @param beforeValue
     */
    function setTimeLimit2(data,text,selectedData,beforeValue) {
        validateForm();
    }

</script>
</body>
</html>
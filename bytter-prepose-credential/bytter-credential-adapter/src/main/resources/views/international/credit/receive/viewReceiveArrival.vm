<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" name="lcId" value="$!{arrival.lcId}">
        <input type="hidden" name="corpId" value="$!{arrival.corpId}">
        <input type="hidden" name="curId" value="$!{arrival.curId}">
        <input type="hidden" name="id" value="$!{arrival.id}">
        <input type="hidden" name="arrivalType" value="$!{arrival.arrivalType}">
        <table class="layui-table">
            <tbody>
                <tr>
                ##信用证类型
                    <td class="textRight">#springMessage('international.credit.lcInter')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="layui-input-inline">
                                $dictTag.get("letter_of_credit_inter",$!{lcInter})
                            </div>
                        </div>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
               <tr>
                    ##信用证号
                   <td class="textRight">#springMessage('international.credit.creditNo')</td>
                   <td width="36%">
                       $!{creditNo}
                   </td>
                       
                   </td>
                       
                   ##交单号
                   <td class="textRight" width="14%">#springMessage('table.internation.arrival.no')</td>
                   <td width="36%">
                       $!{arrival.arrivalNo}
                    </td>
               </tr>
               
               <tr>
                   ##登记日期
                   <td class="textRight">#springMessage('international.credit.createDate')</td>
                   <td>
                       $!date.format('yyyy-MM-dd',$!arrival.createDate)
                   </td>
                   
                   ##交单银行
                   <td class="textRight">#springMessage('table.internation.arrival.bank')</td> 
                   <td>
                       $!{arrival.handDocBank}
                   </td>
               </tr>
               
               <tr>
                   ##到期日期 
                   <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
                   <td>
                      $!date.format('yyyy-MM-dd',$!arrival.paymentDate)
                    </td>

                   ##交单行编号
                       <td class="textRight">#springMessage('table.internation.arrival.bank.no')</td>
                       <td>
                           $!{arrival.handDocBank}
                       </td>
                   
               </tr>
               
               <tr>
               ##期限
                   <td class="textRight">#springMessage('table.tbCreditPeriod.period')</td>
                   <td >
                       $dictTag.get("letter_of_credit_timeLimit",$!{arrival.period})
                   </td>
                   
                ##交单金额
                   <td class="textRight">#springMessage('table.internation.arrival.money')</td>
                   <td >
                       $!number.formatNumeric($!{arrival.billMoney})
                   </td>
              
               </tr>

               <tr>
               ##币种
                   <td class="textRight">#springMessage('table.ratBkrationRelief.curCode')</td>
                   <td>
                       $!{arrival.curName}
                   </td>
               ##汇率
                   <div id="inter">
                       <td class="textRight">#springMessage('table.btCurrency.curExrate')</td>
                       <td>
                           <div class="layui-inline">
                               $!excRateTag.getConvert($!{arrival.exchange})
                           </div>
                       </td>
                   </div>

               </tr>

               <tr>

               ##收款金额：
                   <td class="textRight">#springMessage('table.internation.proceeds.money')</td>
                   <td >
                       $!number.formatNumeric($!{arrival.payMoney})
                   </td>

               ##手续费
                   <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.poundage')</td>
                    <td >
                        $!number.formatNumeric($!{arrival.handlingCharge})
                    </td>

               </tr>

                <tr>
                ##受益人
                    <td class="textRight">#springMessage('international.credit.beneficiary')</td>
                    <td >
                        $!{arrival.beneficiary}
                    </td>
                ##开证银行
                    <td class="textRight">
                        #springMessage('international.credit.issuingBank')
                    </td>
                    <td>
                        <div class="layui-inline">
                            $!{lcEnrol.openingBankName}
                        </div>
                    </td>
                </tr>

               <tr>
##                   发票号
                   <td class="textRight">#springMessage('table.cgsBill.invoiceCode')</td>
                   <td>
                       $!{arrival.invoiceNo}
                   </td>
               ##备注
                   <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
                   <td >
                      $!{arrival.rmk}
                   </td>
               </tr>
                <tr>
                    <td class="textRight">#springMessage('cms.loan.attachment')</td>
                    <td colspan="3">
                        <input type="hidden" id="gid" name="attachmentId" value="$!{arrival.attachmentId}">
                        <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
                    </td>
                </tr>
            </tbody>
        </table>
        #if(${flag} != '0')
            <div align="center">
                <a href="#" class="layui-btn layui-btn-small" onClick="doClose()" >#springMessage('common.button.close')</a>
            </div>
        #end
       
    </form>
#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form', 'btUpload', 'dicts', 'moneyType', "btUpload"], function () {
        $ = bt.jquery, form = bt.form();
        fun = bt.moneyType.getFun();
        moneyUpper();
        var gid = $("#gid").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });
    });
    /**金额大写*/
    function moneyUpper(){
        var money = fun.toNumber("$!{lcEnrol.creditMoney}");
        $("#moneyUpper").text(bt.money.toChinese(money));
    }

    //关闭窗口
    function doClose(){
        if(bt.navtab){
            bt.navtab.closeCurrent();
        }
    }
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
 <table class="layui-table">
        <thead>
        <tr>

            <td width="20%" class="textRight">#springMessage('config.common.paramName')</td>
			<td width="80%">#springMessage('config.common.paramValue')</td>
		</tr>
        </thead>
		<tbody>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.nis.budgetSel')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="radio" name="receive.budgetSel" value="1" #if($config.receive.budgetSel == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                    <input type="radio" name="receive.budgetSel" value="0" #if($config.receive.budgetSel == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('config.exp.payItem')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="receive.incItem" autocomplete="off" class="layui-input" data-decimal="0" data-separator="" value="$!{config.receive.incItem}">
                </div>
                <div class="layui-input-inline" style="color:red">#springMessage('config.nis.incItem.desc')</div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
	       	 	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery','dicts'], function(){
        $  = bt.jquery;
        var form = bt.form();
        var dicts = bt.dicts.init();
        //监听提交
        form.on('submit(configSubmit)', function(data){
            bt.loading.show();
            $.post(basePath + "/sys/config/save",data.field,function(result){
                bt.loading.hide();
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            return false;
        });
    });
</script>
</body>
</html>

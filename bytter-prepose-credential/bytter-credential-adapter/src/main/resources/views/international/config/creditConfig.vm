<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
 <table class="layui-table">
        <thead>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.common.paramName')</td>
			<td width="80%">#springMessage('config.common.paramValue')</td>
		</tr>
        </thead>
		<tbody>
		##信用证到期提醒天数
        <tr>
            <td class="textRight">#springMessage('international.credit.expirty.days')</td>
            <td>
            <div class="layui-input-inline">
				<input type="text" name="international.expiryDays" style="text-align:right;padding-right: 5px;" data-name="international.expiryDays" lay-verify="required|number"
							 autocomplete="off" class="layui-input" value="$!{config.international.expiryDays}">
			</div>
			<div class="layui-input-inline">#springMessage('config.nis.day')</div>
			</td>
        </tr>
        ##信用证挂接授信参数配置
        <tr>
            <td class="textRight">#springMessage('international.credit.isHang')</td>
            <td>
                <div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="radio" data-group="international.credit.isHang" data-defaultvalue="$!{config.international.creditIsHang}" data-name="international.creditIsHang" data-biz-name="isHang"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##是否启用授信敞口
            <td class="textRight">#springMessage('common.isOpen.ratUration')</td>
            <td>

                <input title="#springMessage('common.sc_yn.yes')" name="international.isRatOpen" value="1"
                       #if($config.international.isRatOpen == 1)checked="checked"#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage('common.sc_yn.yes')</span>
                </div>
                <input title="#springMessage('common.sc_yn.no')" name="international.isRatOpen" value="0"
                       #if($config.international.isRatOpen != 1)checked="checked"#end  type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage('common.sc_yn.no')</span>
                </div>
            </td>
        </tr>
        ##信用证挂接保证金
        <tr>
            <td class="textRight">#springMessage('international.credit.isBond')</td>
            <td>
                <div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="radio" data-group="international.credit.isBond" data-defaultvalue="$!{config.international.creditIsBond}" data-name="international.creditIsBond" data-biz-name="isBond"></div>
                </div>
            </td>
        </tr>
        ##是否挂担保
        <tr>
            <td class="textRight">#springMessage('config.accebill.isbear')</td>
            <td>
                <div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="radio" data-group="common.config.isHangGua" data-defaultvalue="$!{config.international.isHangGua}" data-name="international.isHangGua" data-biz-name="isHangGua"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.nis.budgetSel')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="radio" name="international.budgetSel" value="1" #if($config.international.budgetSel == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                    <input type="radio" name="international.budgetSel" value="0" #if($config.international.budgetSel == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('config.exp.payItem')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="international.payItem" autocomplete="off" class="layui-input" data-decimal="0" data-separator="" value="$!{config.international.payItem}">
                </div>
                <div class="layui-input-inline" style="color:red">#springMessage('config.nis.payItem.desc')</div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
	       	 	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery','dicts'], function(){
        $  = bt.jquery;
        var form = bt.form();
        var dicts = bt.dicts.init();
        //监听提交
        form.on('submit(configSubmit)', function(data){
            bt.loading.show();
            $.post(basePath + "/sys/config/save",data.field,function(result){
                bt.loading.hide();
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            return false;
        });
    });
</script>
</body>
</html>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.bytter</groupId>
    <artifactId>bytter-all-client</artifactId>
    <version>2.0.0.RELEASE</version>
    <name>bytter-all-client</name>
    <packaging>pom</packaging>
    <description>用于管理所有需要依赖的client模块</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>1.8</java.version>
    </properties>

    <modules>
        <!-- 基础设施（client 模块的父 POM 和公共框架依赖） -->
        <module>../bytter-parent</module>
        <module>../bytter-common-base</module>
        <!-- 平台服务 client -->
        <module>../bytter-system/bytter-system-client</module>
        <module>../bytter-auth-parent/bytter-auth-client</module>
        <module>../bytter-workflow/bytter-workflow-client</module>
        <!-- 业务服务 client -->
        <module>../bytter-manager-plan/bytter-plan-client</module>
        <module>../bytter-manager-account/bytter-finacial-client</module>
        <module>../bytter-prepose-check/bytter-check-client</module>
        <module>../bytter-prepose-credential/bytter-credential-client</module>
        <module>../bytter-prepose-bill/bytter-bill-client</module>
        <module>../bytter-prepose-erp/bytter-erp-client</module>
        <module>../bytter-prepose-accountReceivable/bytter-accountReceivable-client</module>
        <module>../bytter-prepose-cashvoucher/bytter-cashvoucher-client</module>
        <module>../bytter-service-fundwarn/bytter-fundwarn-client</module>
        <module>../bytter-service-increment/bytter-increment-client</module>
        <module>../bytter-service-payment/bytter-payment-client</module>
        <module>../bytter-service-report/bytter-report-client</module>
        <module>../bytter-service-bdlink/bytter-bdlink-client</module>
        <module>../bytter-service-creditRating/bytter-creditRating-client</module>
        <module>../bytter-service-ras/bytter-ras-client</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>